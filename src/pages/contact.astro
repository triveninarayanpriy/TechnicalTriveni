---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { SITE } from '../lib/site';
import { getPage, getSetting } from '../lib/db';
import { renderMarkdown } from '../lib/format';
import { turnstileEnabled } from '../lib/turnstile';

const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error');
const csrf = Astro.locals.csrfToken;
const initialTopic = Astro.url.searchParams.get('topic') || '';
const initialProject = Astro.url.searchParams.get('project') || '';

import { getEffectiveContent } from '../lib/pages';

const tsOn = turnstileEnabled(env);
const tsKey = env.TURNSTILE_SITE_KEY;

const [pageData, replyTime] = await Promise.all([
  getEffectiveContent(env.DB, 'contact'),
  getSetting(env.DB, 'reply_time'),
]);
if (pageData.published === 0) return Astro.redirect('/404');
const customHtml = pageData.is_custom ? renderMarkdown(pageData.markdown) : null;
---

<Base title={pageData.meta_title || pageData.title || 'Contact'} description={pageData.meta_description || "Questions, project support, or collaboration inquiries — get in direct touch with Technical Triveni."}>
  <section class="contact-section">
    <div class="container contact-grid">
      <!-- LEFT: INTRO & DETAILS -->
      <div class="contact-intro">
        <span class="contact-eyebrow">DIRECT CONTACT</span>
        <h1 class="contact-title">{pageData?.title || "Let's talk builds."}</h1>

        <!-- Order ID and Razorpay Payment ID Note -->
        <div class="order-support-note">
          <div class="order-support-note__icon">
            <Icon name="info" size={18} />
          </div>
          <div class="order-support-note__text">
            <strong>Order & Download Support:</strong>
            <span>Please include your <strong>Order ID</strong> or <strong>Razorpay Payment ID</strong> so we can verify your purchase and send replacement files instantly.</span>
          </div>
        </div>

        {customHtml ? (
          <div class="contact-prose">
            <Fragment set:html={customHtml} />
          </div>
        ) : (
          <p class="contact-lead">
            Have a question about a project pack, component sourcing, or your download link? Want to suggest a future build or collaborate? Send a message — every message is read directly.
          </p>
        )}

        {replyTime && (
          <div class="reply-badge">
            <Icon name="clock" size={16} />
            <span>Typically replies within <strong>{replyTime}</strong></span>
          </div>
        )}

        <div class="contact-cards">
          <div class="contact-card">
            <div class="contact-card__icon"><Icon name="mail" size={20} /></div>
            <div class="contact-card__info">
              <span class="contact-card__label">Direct email</span>
              <a href="mailto:technicaltriveniyt@gmail.com" class="contact-card__val">technicaltriveniyt@gmail.com</a>
            </div>
          </div>
          <div class="contact-card">
            <div class="contact-card__icon"><Icon name="play" size={20} /></div>
            <div class="contact-card__info">
              <span class="contact-card__label">Demonstrations & builds</span>
              <a href={SITE.socials.youtube} target="_blank" rel="noopener" class="contact-card__val">YouTube Channel &rarr;</a>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: MESSAGE FORM -->
      <div class="contact-form-wrap">
        {sent && (
          <div class="contact-alert contact-alert--success" role="status">
            <Icon name="check-circle" size={20} />
            <div>
              <strong>Message received!</strong> We will reply to your email as soon as possible.
            </div>
          </div>
        )}
        {error && (
          <div class="contact-alert contact-alert--error" role="alert">
            <Icon name="close" size={20} />
            <div>
              <strong>Could not send.</strong> Please verify all required fields and try again.
            </div>
          </div>
        )}

        <form method="post" action="/api/contact" class="contact-form" id="contact-form">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="source_page" value="/contact" />

          <div class="grid-2">
            <div class="field">
              <label class="field-label" for="name">Your Name</label>
              <input class="field-input" id="name" name="name" required maxlength="80" autocomplete="name" placeholder="Name" />
            </div>
            <div class="field">
              <label class="field-label" for="email">Email Address</label>
              <input class="field-input" id="email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="name@example.com" />
            </div>
          </div>

          <div class="grid-2">
            <div class="field">
              <label class="field-label" for="topic">Topic</label>
              <select class="field-select" id="topic" name="topic">
                <option value="">Select topic...</option>
                <option value="pre-sales" selected={initialTopic === 'pre-sales'}>Question before buying</option>
                <option value="support" selected={initialTopic === 'support'}>Help with a download/project</option>
                <option value="collab" selected={initialTopic === 'collab'}>Partnership / Collaboration</option>
                <option value="other" selected={initialTopic === 'other'}>Other inquiry</option>
              </select>
            </div>
            <div class="field" id="order-field" style="display: none;">
              <label class="field-label" for="order_id">Order ID or Razorpay Payment ID</label>
              <input class="field-input" id="order_id" name="order_id" maxlength="50" placeholder="e.g. ord_12345 or pay_xyz" />
            </div>
          </div>

          <div class="field">
            <label class="field-label" for="subject">Subject</label>
            <input class="field-input" id="subject" name="subject" required maxlength="120" placeholder="What is this about?" value={initialProject ? `Question regarding ${initialProject}` : ''} />
          </div>

          <div class="field">
            <label class="field-label" for="message">Message</label>
            <textarea class="field-textarea" id="message" name="message" required maxlength="4000" rows="5" placeholder="Include as much detail as possible (components used, error messages, code behavior)…"></textarea>
          </div>

          <!-- Newsletter consent: UNTICKED by default with one-line note -->
          <div class="consent-row">
            <input type="checkbox" id="newsletter" name="newsletter" value="1" class="consent-checkbox" />
            <label for="newsletter" class="consent-label">
              Send me occasional project updates and new releases. Unsubscribe anytime.
            </label>
          </div>

          <!-- Sponsorship note below fields -->
          <div class="sponsorship-note">
            <Icon name="spark" size={16} />
            <span>Interested in hardware sponsorships, component reviews, or custom kits? Select <strong>Partnership / Collaboration</strong> in the topic dropdown above.</span>
          </div>

          <!-- honeypot -->
          <input type="text" name="company" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

          {tsOn && (
            <div class="cf-turnstile" data-sitekey={tsKey} data-theme="light"></div>
          )}

          <!-- In-flow submit button for desktop -->
          <button type="submit" class="btn btn-primary btn-submit btn-submit-inline">
            <Icon name="mail" size={18} /> Send message
          </button>
        </form>
      </div>
    </div>

    <!-- Sticky Bottom Bar for mobile devices (≤768px) -->
    <div class="mobile-sticky-submit" id="mobile-sticky-bar">
      <button type="submit" form="contact-form" class="btn btn-primary btn-submit-sticky">
        <Icon name="mail" size={18} /> Send message
      </button>
    </div>
  </section>

  {tsOn && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <script>
    const topicSelect = document.getElementById('topic') as HTMLSelectElement | null;
    const orderField = document.getElementById('order-field');
    if (topicSelect && orderField) {
      const toggleOrder = () => {
        orderField.style.display = topicSelect.value === 'support' ? 'block' : 'none';
      };
      topicSelect.addEventListener('change', toggleOrder);
      toggleOrder();
    }
  </script>
</Base>

<style>
  .contact-section {
    padding: clamp(3rem, 6vw, 6rem) 0;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 3rem;
    align-items: start;
  }
  .contact-intro,
  .contact-form-wrap {
    min-width: 0;
  }
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.25rem;
    }
  }

  /* Intro */
  .contact-intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .contact-eyebrow {
    font-size: max(12px, 0.75rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--red);
  }
  .contact-title {
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }
  .contact-lead {
    font-size: 1rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
  }
  .contact-prose {
    font-size: 1rem;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .reply-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--ink);
    width: fit-content;
  }
  .reply-badge :global(svg) {
    color: var(--red);
  }

  /* Contact Cards */
  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
  }
  .contact-card__icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    background: rgba(233, 36, 36, 0.08);
    color: var(--red);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .contact-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }
  .contact-card__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-3);
  }
  .contact-card__val {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    word-break: break-all;
  }
  .contact-card__val:hover {
    color: var(--red);
  }

  /* Form Wrap */
  .contact-form-wrap {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: clamp(1.5rem, 5vw, 2.5rem);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 600px) {
    .grid-2 {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .field-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }
  .field-input,
  .field-select {
    height: 3rem;
    border-radius: 0.625rem;
    border: 1px solid var(--line);
    padding: 0 0.875rem;
    font-size: 0.9375rem;
    color: var(--ink);
    background: var(--bg);
    width: 100%;
    box-sizing: border-box;
  }
  .field-textarea {
    border-radius: 0.625rem;
    border: 1px solid var(--line);
    padding: 0.75rem 0.875rem;
    font-size: 0.9375rem;
    color: var(--ink);
    background: var(--bg);
    width: 100%;
    box-sizing: border-box;
    font-family: inherit;
    resize: vertical;
  }
  .field-input:focus,
  .field-select:focus,
  .field-textarea:focus {
    outline: none;
    border-color: var(--red);
    box-shadow: 0 0 0 2px rgba(233, 36, 36, 0.15);
  }

  /* Consent Row */
  .consent-row {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin-top: 0.25rem;
  }
  .consent-checkbox {
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 0.25rem;
    border: 1px solid var(--line);
    accent-color: var(--red);
    margin-top: 0.125rem;
    flex-shrink: 0;
    cursor: pointer;
  }
  .consent-label {
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.4;
    cursor: pointer;
  }

  .btn-submit {
    height: 3rem;
    border-radius: 0.625rem;
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    cursor: pointer;
    margin-top: 0.5rem;
  }

  .hp {
    position: absolute;
    left: -624.9375rem;
    width: 0.0625rem;
    height: 1px;
    opacity: 0;
  }

  .contact-alert {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: 0.625rem;
    margin-bottom: 1.25rem;
    font-size: 0.9375rem;
  }
  .contact-alert--success {
    background: rgba(14, 143, 79, 0.1);
    border: 1px solid rgba(14, 143, 79, 0.3);
    color: var(--success);
  }
  .contact-alert--error {
    background: rgba(233, 36, 36, 0.1);
    border: 1px solid rgba(233, 36, 36, 0.3);
    color: var(--red);
  }

  /* Order & Download Note */
  .order-support-note {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 0.875rem;
    background: rgba(217, 31, 38, 0.05);
    border: 1px solid rgba(217, 31, 38, 0.2);
    border-radius: 0.75rem;
    margin-top: 0.25rem;
  }
  .order-support-note__icon {
    color: var(--red);
    flex-shrink: 0;
    margin-top: 0.0625rem;
  }
  .order-support-note__text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.45;
  }
  .order-support-note__text strong {
    color: var(--ink);
  }

  /* Sponsorship Note */
  .sponsorship-note {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.75rem 0.875rem;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 0.625rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
    line-height: 1.45;
  }
  .sponsorship-note :global(svg) {
    color: var(--red);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .sponsorship-note a {
    color: var(--red);
    text-decoration: underline;
  }

  /* Mobile Sticky Submit Bar */
  .mobile-sticky-submit {
    display: none;
  }
  @media (max-width: 768px) {
    .contact-section {
      padding-top: 2.25rem;
      padding-bottom: 6.25rem; /* Room for sticky bottom bar */
    }
    .contact-title {
      font-size: 2rem;
    }
    .contact-lead {
      font-size: 0.9375rem;
    }
    .contact-form-wrap {
      padding: 1.25rem 1rem;
      border-radius: 0.875rem;
    }
    .btn-submit-inline {
      display: none;
    }
    .mobile-sticky-submit {
      display: block;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--bg);
      border-top: 1px solid var(--line);
      padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
      z-index: 100;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
    }
    .btn-submit-sticky {
      width: 100%;
      height: 3rem;
      border-radius: 0.75rem;
      font-size: 1rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      cursor: pointer;
    }
    .field-input,
    .field-select {
      height: 3rem;
      font-size: 1rem; /* Prevents auto zoom */
    }
    .field-textarea {
      font-size: 1rem;
    }
  }
</style>
