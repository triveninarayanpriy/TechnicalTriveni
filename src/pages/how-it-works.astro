---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { getPage } from '../lib/db';
import { renderMarkdown } from '../lib/format';

const page = await getPage(env.DB, 'how-it-works');
const customContent = page?.content_md ? renderMarkdown(page.content_md) : '';

const steps = [
  { n: '01', icon: 'play', title: 'Watch & get inspired', text: 'Catch one of our builds on YouTube or Instagram. If you want to make it yourself, you are in the right place.' },
  { n: '02', icon: 'search', title: 'Explore the full project', text: 'Every project includes a free overview, wiring guide, parts list, and specs. Read everything before you decide to build.' },
  { n: '03', icon: 'cart', title: 'Grab the resources', text: 'When ready, purchase the one-time pack securely using UPI, cards, or net banking. Instant access, no account required.' },
  { n: '04', icon: 'download', title: 'Download & build', text: 'Instantly download the source code, schematics, 3D printable files, and step-by-step PDF guide. Order components and build.' },
];

const faqs = [
  { q: 'How do I receive the files?', a: 'Instantly. The moment your payment is confirmed, a secure download page opens with every file in the pack — and the link is yours to keep.' },
  { q: 'Do I need the paid pack to follow along?', a: 'No. The project overview, wiring diagram, parts list and specs are free on every project page. The pack is for the ready-to-use files (code, schematics, 3D, guide).' },
  { q: 'What payment methods are supported?', a: 'UPI, cards, net-banking and wallets, handled securely by Razorpay. We never see or store your payment details.' },
];
---

<Base title={page?.title || 'How it works'} description="From video demonstration to verified workbench build in four simple steps.">
  <section class="hiw-hero">
    <div class="container center">
      <span class="hiw-eyebrow">SIMPLE 4-STEP PROCESS</span>
      <h1 class="hiw-title">{page?.title || 'How It Works'}</h1>
      <p class="hiw-lead">No guesswork, no missing files, no dead ends. Everything you need to turn a project demonstration into a finished, bench-verified hardware build.</p>
    </div>
  </section>

  <section class="hiw-section">
    <div class="container container-narrow">
      <div class="hiw-steps">
        {steps.map((step) => (
          <div class="hiw-card">
            <div class="hiw-card__icon">
              <Icon name={step.icon} size={22} />
            </div>
            <div class="hiw-card__content">
              <span class="hiw-card__num">{step.n}</span>
              <h2 class="hiw-card__heading">{step.title}</h2>
              <p class="hiw-card__text">{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hiw-section hiw-section--alt">
    <div class="container container-narrow">
      <div class="hiw-section-head center">
        <span class="hiw-eyebrow">QUESTIONS & ANSWERS</span>
        <h2 class="hiw-h2">Frequently Asked Questions</h2>
      </div>
      <div class="hiw-faq">
        {faqs.map((f) => (
          <details class="hiw-faq__item">
            <summary class="hiw-faq__summary">
              <span>{f.q}</span>
              <Icon name="chevron-down" size={18} />
            </summary>
            <div class="hiw-faq__body">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="hiw-cta-box center">
        <h3 class="hiw-cta-title">Ready to build your next project?</h3>
        <p class="hiw-cta-sub">Browse all verified hardware packs, pinouts, and component guides.</p>
        <a href="/projects" class="btn btn-primary btn-lg">Explore all project packs →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hiw-hero {
    padding: clamp(48px, 6vw, 80px) 0 clamp(24px, 4vw, 40px);
    background: var(--bg);
  }
  .center {
    text-align: center;
  }
  .hiw-eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--red);
    margin-bottom: 12px;
  }
  .hiw-title {
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3.75rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 16px;
  }
  .hiw-lead {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    color: var(--ink-2);
    line-height: 1.6;
    max-width: 58ch;
    margin: 0 auto;
  }

  .hiw-section {
    padding: clamp(32px, 5vw, 64px) 0;
  }
  .hiw-section--alt {
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
  }
  .hiw-section-head {
    margin-bottom: 32px;
  }
  .hiw-h2 {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }

  /* Steps */
  .hiw-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .hiw-card {
    display: flex;
    gap: 20px;
    background: var(--bg);
    padding: 24px;
    border-radius: 16px;
    border: 1px solid var(--line);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    align-items: flex-start;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  @media (min-width: 1024px) {
    .hiw-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    }
  }
  .hiw-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(233, 36, 36, 0.08);
    color: var(--red);
    flex-shrink: 0;
  }
  .hiw-card__content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .hiw-card__num {
    font-size: 12px;
    color: var(--ink-3);
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .hiw-card__heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }
  .hiw-card__text {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  @media (max-width: 600px) {
    .hiw-card {
      flex-direction: column;
      gap: 12px;
      padding: 20px;
    }
  }

  /* FAQ */
  .hiw-faq {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 48px;
  }
  .hiw-faq__item {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 150ms ease;
  }
  .hiw-faq__item[open] {
    border-color: var(--ink);
  }
  .hiw-faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    cursor: pointer;
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink);
    list-style: none;
    min-height: 44px;
  }
  .hiw-faq__summary::-webkit-details-marker {
    display: none;
  }
  .hiw-faq__summary :global(svg) {
    transition: transform 150ms ease;
    color: var(--ink-3);
    flex-shrink: 0;
  }
  .hiw-faq__item[open] .hiw-faq__summary :global(svg) {
    transform: rotate(180deg);
    color: var(--red);
  }
  .hiw-faq__body {
    padding: 0 20px 20px;
  }
  .hiw-faq__body p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* Bottom CTA */
  .hiw-cta-box {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: clamp(28px, 5vw, 44px) 24px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }
  .hiw-cta-title {
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.5rem);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .hiw-cta-sub {
    font-size: 0.9375rem;
    color: var(--ink-2);
    margin: 0 0 24px;
  }
  .btn-lg {
    height: 48px;
    padding: 0 28px;
    font-size: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  @media (max-width: 600px) {
    .btn-lg {
      width: 100%;
    }
  }
</style>
