---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { getPage } from '../lib/db';
import { renderMarkdown } from '../lib/format';

const page = await getPage(env.DB, 'how-it-works');
const customContent = page?.content_md ? renderMarkdown(page.content_md) : '';

const steps = [
  { n: '01', icon: 'play', title: 'Watch & get inspired', text: 'Catch one of our builds on YouTube or Instagram. If you want to make it yourself, you are in the right place.' },
  { n: '02', icon: 'search', title: 'Explore the full project', text: 'Every project includes a free overview, wiring guide, parts list, and specs. Read everything before you decide to build.' },
  { n: '03', icon: 'cart', title: 'Grab the resources', text: 'When ready, purchase the one-time combo securely using UPI, cards, or net banking. Instant access, no account required.' },
  { n: '04', icon: 'download', title: 'Download & build', text: 'Instantly download the source code, schematics, 3D printable files, and step-by-step PDF guide. Order components and build.' },
];

const faqs = [
  { q: 'How do I receive the files?', a: 'Instantly. The moment your payment is confirmed, a secure download page opens with every file in the combo — and the link is yours to keep.' },
  { q: 'Do I need the paid combo to follow along?', a: 'No. The project overview, wiring diagram, parts list and specs are free on every project page. The combo is for the ready-to-use files (code, schematics, 3D, guide).' },
  { q: 'What payment methods are supported?', a: 'UPI, cards, net-banking and wallets, handled securely by Razorpay. We never see or store your payment details.' },
];
---

<Base title={page?.title || 'How it works'} description="From a 30-second reel to a finished build.">
  
  <section class="page-hero grid-bg">
    <div class="container center">
      <h1 class="hero-title">{page?.title || 'How It Works'}</h1>
      <p class="hero-lead">No guesswork, no missing files, no dead ends. Everything you need to turn a video into a finished build.</p>
    </div>
  </section>

  <!-- Custom Markdown Content from Admin -->
  {customContent && (
    <section class="section pt-0">
      <div class="container container-narrow prose">
        <Fragment set:html={customContent} />
      </div>
    </section>
  )}

  <section class="section pt-0">
    <div class="container center">
      <img src="/how-it-works-diagram.png" alt="How it works process from YouTube to your build" class="workflow-diagram" data-reveal />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container-narrow">
      <div class="section-head center" data-reveal>
        <span class="eyebrow" style="justify-content:center">FAQ</span>
        <h2>Common Questions</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq__item" data-reveal>
            <summary><span>{f.q}</span><Icon name="chevron-down" size={18} /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container center" data-reveal>
      <h2>Ready to start?</h2>
      <p class="muted" style="margin:0.5rem 0 1.5rem">Browse the library and pick your first build.</p>
      <a href="/projects" class="btn btn-primary btn-lg">Explore projects <Icon name="arrow-right" size={18} /></a>
    </div>
  </section>

</Base>

<style>
  .page-hero { padding: 4rem 0 3rem; text-align: center; }
  .hero-title { font-size: clamp(2rem, 5vw, 3rem); font-family: var(--font-display); letter-spacing: -0.02em; margin-bottom: 1rem; }
  .hero-lead { font-size: var(--fs-lg); color: var(--text-muted); max-width: 50ch; margin: 0 auto; }
  
  .pt-0 { padding-top: 0; }
  .section--alt { background: linear-gradient(180deg, var(--surface-2), var(--surface)); border-top: 1px solid var(--border); }
  .section-head { margin-bottom: 2.5rem; }

  .workflow-diagram {
    display: block;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    border-radius: var(--r-xl);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-xl);
    background: var(--surface);
  }

  /* FAQ */
  .faq { display: flex; flex-direction: column; gap: 0.75rem; }
  .faq__item { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden; }
  .faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.25rem 1.5rem; cursor: pointer; font-family: var(--font-display); font-weight: 600; list-style: none; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary :global(svg) { transition: transform 0.2s; color: var(--text-dim); }
  .faq__item[open] summary :global(svg) { transform: rotate(180deg); color: var(--brand-red); }
  .faq__item p { padding: 0 1.5rem 1.25rem; color: var(--text-muted); font-size: var(--fs-sm); line-height: 1.6; }
</style>
