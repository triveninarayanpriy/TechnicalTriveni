---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { SITE } from '../lib/site';
import { getSetting } from '../lib/db';
import { renderMarkdown } from '../lib/format';
import { getEffectiveContent } from '../lib/pages';
import { getSiteAssets, buildSrcSet } from '../lib/site-assets';

const [pageData, siteAssets] = await Promise.all([
  getEffectiveContent(env.DB, 'how-it-works'),
  getSiteAssets(env.DB),
]);
if (pageData.published === 0) return Astro.redirect('/404');
const customHtml = pageData.is_custom ? renderMarkdown(pageData.markdown) : null;

const hiwSlot = siteAssets.how_it_works_image;
const hiwImage = hiwSlot?.url || pageData.image_url || '';
const hasHiwImage = !!hiwImage.trim();
const hiwAlt = hiwSlot?.alt || 'Electronics project pack contents';
const hiwSrcSet = buildSrcSet(hiwSlot || { url: '' });
const ytLink = siteAssets.social_links?.youtube !== undefined ? siteAssets.social_links.youtube : SITE.socials.youtube;

const steps = [
  {
    n: '1',
    icon: 'play',
    title: 'Watch the build',
    text: 'Every project is documented end-to-end on YouTube, so you see it working before you spend anything.',
  },
  {
    n: '2',
    icon: 'cube',
    title: 'Choose your pack',
    text: 'Open a pack to see its parts list, wiring and build steps. Filter by price, category and format.',
  },
  {
    n: '3',
    icon: 'lock',
    title: 'Pay securely',
    text: 'Checkout runs on Razorpay with UPI, cards or net banking. No account to create.',
  },
  {
    n: '4',
    icon: 'download',
    title: 'Get your files',
    text: 'Your download link is emailed instantly. Lost it? Use My downloads, no password needed.',
  },
  {
    n: '5',
    icon: 'check-circle',
    title: 'Build and get help',
    text: 'Follow the parts list, wiring tables and staged steps. Stuck? Email the maker, with a 7-day build guarantee.',
  },
];

const mobileInsidePack = [
  { icon: 'code', title: 'Tested source code' },
  { icon: 'schematic', title: 'Wiring and schematics' },
  { icon: 'cart', title: 'Parts list with buy links' },
  { icon: 'play', title: 'Full build videos' },
];

const assurances = [
  {
    icon: 'lock',
    title: 'Secure checkout',
    sub: 'Razorpay: UPI, cards, net banking',
    text: 'Razorpay handles payment: UPI, cards and net banking.',
  },
  {
    icon: 'check-circle',
    title: '7-day build guarantee',
    sub: 'Email the maker if a pack fails',
    text: 'If a pack does not work as described, email the maker and get it sorted.',
  },
  {
    icon: 'message-square',
    title: 'Direct support',
    sub: 'Help from the person who built it',
    text: 'Ask questions and get help from the person who built it.',
  },
];

const faqs = [
  {
    q: 'Do I need an account?',
    a: 'No. Enter your email at checkout and your download link arrives by email. You can request it again any time on My downloads.',
    open: true,
  },
  {
    q: 'How do I get my files again?',
    a: 'Go to My downloads in the top navigation, enter the email address you purchased with, and a direct access link will be emailed immediately.',
    open: false,
  },
  {
    q: 'Which payment methods work?',
    a: 'UPI (GPay, PhonePe, Paytm, BHIM), Indian & international credit/debit cards, NetBanking, and major mobile wallets via Razorpay.',
    open: false,
  },
  {
    q: 'Are the parts included?',
    a: 'No, these are digital project packs containing source code, verified circuit schematics, 3D print models, and parts lists with direct vendor buy links.',
    open: false,
  },
  {
    q: 'What if my build does not work?',
    a: 'Every project has a 7-day build guarantee. If you encounter an issue, email technicaltriveniyt@gmail.com with your order details and get direct maker support.',
    open: false,
  },
];
---

<Base
  title="How it works | Technical Triveni"
  description="From video demonstration to verified workbench build in five simple steps. No account, no subscription."
>
  <div class="hiw-page">
    <!-- HERO SECTION -->
    <section class="hiw-hero">
      <div class="container">
        <div class="hiw-hero__content">
          <span class="hiw-eyebrow">How it works</span>
          <h1 class="hiw-title">From video to working build in five steps.</h1>
          <p class="hiw-sub">
            Watch it work, grab the pack, build it with verified files. No account, no subscription.
          </p>
          <div class="hiw-hero-actions">
            <a href="/projects" class="btn-hiw-primary">Browse packs</a>
            <a href={ytLink || '#'} target="_blank" rel="noopener noreferrer" class="btn-hiw-secondary">
              <Icon name="play" size={16} /> <span>Watch</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {customHtml && (
      <section class="hiw-custom-section" style="padding: 2rem 0; background: var(--bg);">
        <div class="container" style="max-width: 50rem;">
          <div class="hiw-custom-card" style="background: var(--surface, #FFF); border: 1px solid var(--border, #E5E7EB); border-radius: 1rem; padding: 2rem; box-shadow:  0 2px 8px rgba(0,0,0,0.04);">
            <div class="prose" set:html={customHtml} />
          </div>
        </div>
      </section>
    )}

    <!-- 5-STEP STEPPER (Horizontal Desktop, Vertical Timeline Mobile) -->
    <section class="hiw-stepper-section">
      <div class="container">
        <div class="hiw-stepper-wrap">
          <div class="hiw-stepper-line" aria-hidden="true"></div>
          <div class="hiw-steps-track">
            {steps.map((s, idx) => (
              <div class="hiw-step-item">
                <div class="hiw-step-badge-col">
                  <div class="hiw-step-badge">{s.n}</div>
                  {idx < steps.length - 1 && <div class="hiw-v-line" aria-hidden="true"></div>}
                </div>
                <div class="hiw-step-body">
                  <div class="hiw-step-icon">
                    <Icon name={s.icon} size={20} />
                  </div>
                  <h3 class="hiw-step-title">{s.title}</h3>
                  <p class="hiw-step-text">{s.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- MOBILE: "INSIDE EVERY PACK" 2x2 TILES (media_1791940525157_df7b57cb.png) -->
    <section class="hiw-mobile-inside-section">
      <div class="container">
        <h2 class="hiw-mobile-section-heading">Inside every pack</h2>
        <div class="hiw-mobile-tiles-grid">
          {mobileInsidePack.map((tile) => (
            <div class="hiw-mobile-tile">
              <span class="hiw-mobile-tile-icon"><Icon name={tile.icon} size={20} /></span>
              <span class="hiw-mobile-tile-title">{tile.title}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- MOBILE: SINGLE ASSURANCE CARD WITH 3 ROWS (media_1791940525157_df7b57cb.png) -->
    <section class="hiw-mobile-assurance-section">
      <div class="container">
        <div class="hiw-mobile-assurance-card">
          {assurances.map((a) => (
            <div class="hiw-mobile-assure-row">
              <span class="hiw-mobile-assure-icon"><Icon name={a.icon} size={20} /></span>
              <div class="hiw-mobile-assure-text">
                <h4 class="hiw-mobile-assure-title">{a.title}</h4>
                <p class="hiw-mobile-assure-sub">{a.sub}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- DESKTOP: SPLIT FEATURE SHOWCASE (media_1791937969571_be4d4038.png) -->
    <section class="hiw-desktop-showcase-section">
      <div class="container">
        <div class="hiw-showcase-grid">
          <!-- Left: Image with 3 floating pills -->
          <div class="hiw-image-col">
            <div class="hiw-image-card">
              {hasHiwImage && (
                <img
                  src={hiwImage}
                  srcset={hiwSrcSet || undefined}
                  sizes="(max-width: 768px) 100vw, 640px"
                  alt={hiwAlt}
                  class="hiw-pack-img"
                  width={hiwSlot?.width || 1400}
                  height={hiwSlot?.height || 1000}
                  loading="lazy"
                  onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                />
              )}
              <div class="hiw-pack-fallback" style={hasHiwImage ? 'display: none;' : 'display: flex;'} aria-hidden={hasHiwImage ? 'true' : 'false'}>
                <div class="hiw-fallback-blueprint">
                  <Icon name="schematic" size={56} />
                  <span class="hiw-fallback-title">Hardware · Firmware · Mechanics</span>
                </div>
              </div>
              <div class="hiw-float-chip hiw-float-chip--top">
                <Icon name="code" size={14} /> Tested source code
              </div>
              <div class="hiw-float-chip hiw-float-chip--mid">
                <Icon name="layers" size={14} /> Wiring tables
              </div>
              <div class="hiw-float-chip hiw-float-chip--bot">
                <Icon name="cart" size={14} /> Parts list with buy links
              </div>
            </div>
          </div>

          <!-- Right: Checklist -->
          <div class="hiw-checklist-col">
            <h2 class="hiw-showcase-h2">Everything you need to finish the build</h2>
            <div class="hiw-checklist-items">
              <div class="hiw-check-item">
                <span class="hiw-check-icon"><Icon name="check-circle" size={18} /></span>
                <div>
                  <h4 class="hiw-item-title">Tested source code</h4>
                  <p class="hiw-item-desc">Clean, commented firmware and sketches that compile and run.</p>
                </div>
              </div>
              <div class="hiw-check-item">
                <span class="hiw-check-icon"><Icon name="check-circle" size={18} /></span>
                <div>
                  <h4 class="hiw-item-title">Wiring and schematics</h4>
                  <p class="hiw-item-desc">Clear circuit diagrams and pin tables, so you never guess a connection.</p>
                </div>
              </div>
              <div class="hiw-check-item">
                <span class="hiw-check-icon"><Icon name="check-circle" size={18} /></span>
                <div>
                  <h4 class="hiw-item-title">Verified parts list</h4>
                  <p class="hiw-item-desc">Exact component specs with direct buy links and Indian retail prices.</p>
                </div>
              </div>
              <div class="hiw-check-item">
                <span class="hiw-check-icon"><Icon name="check-circle" size={18} /></span>
                <div>
                  <h4 class="hiw-item-title">Build videos</h4>
                  <p class="hiw-item-desc">The full bring-up on YouTube, step by step.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DESKTOP: 3 ASSURANCE TILES (media_1791937969571_be4d4038.png) -->
    <section class="hiw-desktop-assurances-section">
      <div class="container">
        <div class="hiw-assurances-grid">
          {assurances.map((a) => (
            <div class="hiw-assurance-card">
              <span class="hiw-assurance-icon">
                <Icon name={a.icon} size={20} />
              </span>
              <h3 class="hiw-assurance-title">{a.title}</h3>
              <p class="hiw-assurance-text">{a.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ SECTION (media_1791940525157_df7b57cb.png & media_1791937969571_be4d4038.png) -->
    <section class="hiw-faq-section">
      <div class="container">
        <div class="hiw-faq-grid">
          <!-- Left Desktop Col -->
          <div class="hiw-faq-intro">
            <h2 class="hiw-faq-h2">Questions, answered</h2>
            <p class="hiw-faq-lead">Cannot find what you need? Write to the maker directly.</p>
            <a href="/contact" class="hiw-contact-link">Contact the maker &rarr;</a>
          </div>

          <!-- Accordion list -->
          <div class="hiw-faq-accordion">
            <h2 class="hiw-faq-mobile-title">Questions, answered</h2>
            {faqs.map((f) => (
              <details class="hiw-faq-details" open={f.open}>
                <summary class="hiw-faq-summary">
                  <span>{f.q}</span>
                  <span class="hiw-faq-chevron"><Icon name="chevron-down" size={18} /></span>
                </summary>
                <div class="hiw-faq-answer">
                  <p>{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- DARK CTA BAND (#111418) -->
    <section class="hiw-cta-band">
      <div class="container">
        <div class="hiw-cta-card">
          <div class="hiw-cta-text">
            <h2 class="hiw-cta-title">Ready to build something that works?</h2>
            <p class="hiw-cta-sub">Pick a pack, watch the build, and start with verified files.</p>
          </div>
          <div class="hiw-cta-buttons">
            <a href="/projects" class="btn-cta-red">Browse packs</a>
            <a href="/contact" class="btn-cta-white hiw-desktop-only">Contact us</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .hiw-page {
    background: #FFFFFF;
    color: var(--ink);
  }

  /* ==================== HERO ==================== */
  .hiw-hero {
    padding: 4rem 0 2.75rem;
  }
  .hiw-hero__content {
    text-align: center;
  }
  .hiw-eyebrow {
    display: inline-block;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.375rem 1rem;
    font-size: max(12px, 0.8125rem);
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  .hiw-title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink);
    margin: 0 0 1rem;
  }
  .hiw-sub {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: 38.75rem;
    margin: 0 auto 1.75rem;
  }
  .hiw-hero-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.875rem;
    flex-wrap: wrap;
  }
  .btn-hiw-primary {
    background: var(--red);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.75rem 1.625rem;
    border-radius: 0.875rem;
    text-decoration: none;
    transition: opacity 150ms ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .btn-hiw-primary:hover {
    opacity: 0.92;
  }
  .btn-hiw-secondary {
    background: #FFFFFF;
    color: var(--ink);
    border: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.875rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 150ms ease;
  }
  .btn-hiw-secondary:hover {
    border-color: var(--ink);
  }

  /* ==================== 5-STEP STEPPER ==================== */
  .hiw-stepper-section {
    padding: 2.25rem 0 3.75rem;
  }
  .hiw-stepper-wrap {
    position: relative;
  }
  .hiw-stepper-line {
    position: absolute;
    top: 1.125rem;
    left: 2.5rem;
    right: 2.5rem;
    height: 0.125rem;
    background: var(--line);
    z-index: 1;
  }
  .hiw-steps-track {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    position: relative;
    z-index: 2;
  }
  .hiw-step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hiw-step-badge-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }
  .hiw-step-badge {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--red);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.9375rem;
    display: grid;
    place-items: center;
    margin-bottom: 1.25rem;
    box-shadow: 0 0 0 4px #FFFFFF;
    z-index: 2;
  }
  .hiw-v-line {
    display: none;
  }
  .hiw-step-body {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1.125rem;
    padding: 1.375rem 1.125rem;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 13.125rem;
  }
  .hiw-step-icon {
    color: var(--red);
    margin-bottom: 0.75rem;
    display: inline-flex;
  }
  .hiw-step-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }
  .hiw-step-text {
    font-size: max(12px, 0.8125rem);
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
  }

  /* ==================== MOBILE TILES & ASSURANCE ==================== */
  .hiw-mobile-inside-section,
  .hiw-mobile-assurance-section {
    display: none;
  }

  /* ==================== DESKTOP SHOWCASE ==================== */
  .hiw-desktop-showcase-section {
    padding: 3rem 0 4rem;
  }
  .hiw-showcase-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
    align-items: center;
  }
  .hiw-image-col,
  .hiw-checklist-col {
    min-width: 0;
  }
  .hiw-image-card {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    aspect-ratio: 16 / 10;
  }
  .hiw-pack-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hiw-pack-fallback {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 40%, #1E232D 0%, var(--dark) 100%);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hiw-fallback-blueprint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    opacity: 0.85;
    color: #A3AAB8;
  }
  .hiw-fallback-title {
    font-family: var(--font-mono);
    font-size: max(12px, 0.8125rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--line);
  }
  .hiw-float-chip {
    position: absolute;
    background: #FFFFFF;
    color: var(--ink);
    font-size: max(12px, 0.8125rem);
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    z-index: 2;
  }
  .hiw-float-chip--top { top: 1.5rem; left: 1.5rem; }
  .hiw-float-chip--mid { top: 50%; right: 1.5rem; transform: translateY(-50%); }
  .hiw-float-chip--bot { bottom: 1.5rem; left: 1.5rem; }

  .hiw-showcase-h2 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 1.75rem;
    color: var(--ink);
  }
  .hiw-checklist-items {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .hiw-check-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .hiw-check-icon {
    color: var(--red);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .hiw-item-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.25rem;
  }
  .hiw-item-desc {
    font-size: max(12px, 0.875rem);
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
  }

  /* ==================== DESKTOP 3 ASSURANCES ==================== */
  .hiw-desktop-assurances-section {
    padding: 2.25rem 0 4rem;
  }
  .hiw-assurances-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .hiw-assurance-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1.125rem;
    padding: 1.5rem;
  }
  .hiw-assurance-icon {
    color: var(--red);
    display: inline-flex;
    margin-bottom: 0.75rem;
  }
  .hiw-assurance-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.375rem;
    color: var(--ink);
  }
  .hiw-assurance-text {
    font-size: max(12px, 0.875rem);
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
  }

  /* ==================== FAQ ==================== */
  .hiw-faq-section {
    padding: 3.75rem 0 4.75rem;
    border-top: 1px solid var(--line);
  }
  .hiw-faq-grid {
    display: grid;
    grid-template-columns: 20rem 1fr;
    gap: 4rem;
    align-items: start;
  }
  .hiw-faq-intro {
    display: block;
  }
  .hiw-faq-mobile-title {
    display: none;
  }
  .hiw-faq-h2 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
    color: var(--ink);
  }
  .hiw-faq-lead {
    font-size: 0.9375rem;
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .hiw-contact-link {
    color: var(--red);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .hiw-contact-link:hover {
    text-decoration: underline;
  }

  .hiw-faq-accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }
  .hiw-faq-details {
    border-bottom: 1px solid var(--line);
  }
  .hiw-faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .hiw-faq-summary::-webkit-details-marker {
    display: none;
  }
  .hiw-faq-chevron {
    color: var(--muted);
    transition: transform 150ms ease;
    display: inline-flex;
  }
  .hiw-faq-details[open] .hiw-faq-chevron {
    transform: rotate(180deg);
  }
