---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { renderMarkdown } from '../../lib/format';
import { getEffectiveContent } from '../../lib/pages';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const pageContent = await getEffectiveContent(env.DB, slug);
if (pageContent.published === 0) return Astro.redirect('/404');

const title = pageContent.meta_title || pageContent.title;
const description = pageContent.meta_description || `Official ${pageContent.title} for Technical Triveni.`;
const html = renderMarkdown(pageContent.markdown || '');

const legalLinks = [
  { label: 'Terms & Conditions', slug: 'terms' },
  { label: 'Privacy Policy', slug: 'privacy' },
  { label: 'Refund Policy', slug: 'refund' },
  { label: 'Cookie Policy', slug: 'cookies' },
  { label: 'Safety Disclaimer', slug: 'disclaimer' },
  { label: 'Affiliate Disclosure', slug: 'affiliate' },
  { label: 'Digital Delivery', slug: 'digital-delivery' },
];
---

<Base title={`${title} | Technical Triveni`} description={description}>
  <section class="legal-hero">
    <div class="container container-narrow">
      <nav class="legal-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Legal & Policies</span>
      </nav>
      <span class="legal-eyebrow">OFFICIAL POLICY</span>
      <h1 class="legal-title">{pageContent.title}</h1>
    </div>
  </section>

  <section class="legal-body-section">
    <div class="container container-narrow">
      <article class="legal-card">
        <div class="legal-prose" set:html={html} />
      </article>

      <div class="legal-nav-box">
        <h2 class="legal-nav-title">All Policies & Terms</h2>
        <div class="legal-nav-pills">
          {legalLinks.map((item) => (
            <a
              href={`/legal/${item.slug}`}
              class:list={['legal-pill', { 'is-active': item.slug === slug }]}
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .legal-hero {
    padding: clamp(2.25rem, 5vw, 4rem) 0 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .legal-crumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
    margin-bottom: 1rem;
  }
  .legal-crumbs a {
    color: var(--ink-3);
    text-decoration: none;
  }
  .legal-crumbs a:hover {
    color: var(--ink);
  }
  .crumb-sep {
    color: var(--line);
  }
  .crumb-current {
    color: var(--ink);
    font-weight: 500;
  }
  .legal-eyebrow {
    display: inline-block;
    font-size: max(12px, 0.6875rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--red);
    margin-bottom: 0.5rem;
  }
  .legal-title {
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }

  .legal-body-section {
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(3rem, 8vw, 6rem);
    background: var(--bg-soft);
  }
  .legal-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .legal-prose {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .legal-prose :global(h2) {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--ink);
    margin: 2rem 0 0.75rem;
    line-height: 1.25;
  }
  .legal-prose :global(h3) {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    margin: 1.5rem 0 0.5rem;
  }
  .legal-prose :global(p) {
    margin: 0 0 1rem;
  }
  .legal-prose :global(ul),
  .legal-prose :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }
  .legal-prose :global(li) {
    margin-bottom: 0.375rem;
  }
  .legal-prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .legal-prose :global(a) {
    color: var(--red);
    text-decoration: underline;
  }
  .legal-prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2rem 0;
  }

  /* Policy Links Grid */
  .legal-nav-box {
    margin-top: 2.25rem;
    padding: 1.5rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 1rem;
  }
  .legal-nav-title {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink);
    margin: 0 0 1rem;
  }
  .legal-nav-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .legal-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-2);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: all 150ms ease;
  }
  .legal-pill:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }
  .legal-pill.is-active {
    background: var(--ink);
    color: #ffffff;
    border-color: var(--ink);
  }
</style>
