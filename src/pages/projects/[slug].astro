/* ===== Layout fixes (apply everywhere) ===== */
/* minmax(0, 1fr) lets the column shrink; plain 1fr grows to fit wide tables/code and overflows the phone. */
.dp .proj-layout { grid-template-columns: minmax(0, 1fr) 340px; }
.dp .proj-layout > * { min-width: 0; }
.pin-arrow { display: none; }
.pin-mod { font-size: 0.65rem; margin-left: 0.4rem; }
/* Sticky sidebar ONLY on desktop (this used to apply on phones too -> floating buy card). */
@media (min-width: 901px) {
  .dp .proj-sidebar { position: sticky; top: calc(var(--header-h, 70px) + 1.5rem); align-self: start; }
}

/* ===== Phone / small tablet layout ===== */
@media (max-width: 900px) {
  .dp { padding-block: 0.75rem 2rem; }
  .dp .proj-layout {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "title" "media" "facts" "content";
    gap: 1.25rem;
  }
  .dp .proj-sidebar { position: static; }
  .dp .toc { display: none; }

  /* Header */
  .dp .crumbs { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: var(--fs-xs); }
  .dp .hero-title { font-size: clamp(1.35rem, 6vw, 1.75rem); line-height: 1.2; margin-bottom: 0.5rem; }
  .dp .hero-outcome { font-size: 1rem; margin-bottom: 0.5rem; }
  .dp .hero-summary { font-size: 0.95rem; }
  .dp .viewer__stage { border-radius: var(--r-md); }
  .dp .viewer__thumb { width: 60px; height: 44px; }

  /* Facts: tidy 2-column grid instead of a ragged wrap */
  .dp .facts-strip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; padding: 0.9rem; }
  .dp .facts-strip > div:last-child:not(.fact) { grid-column: 1 / -1; }
  .dp .fact { gap: 0.5rem; }

  /* Sections */
  .dp .sec { margin-bottom: 2.5rem; scroll-margin-top: calc(var(--header-h, 70px) + 60px); }
  .dp .sec__title { font-size: 1.15rem; margin-bottom: 0.9rem; }
  .dp .safety { padding: 0.85rem 1rem; }
  .dp .bom-tools { justify-content: flex-start; }

  /* Long words / code / tables inside prose must never widen the page */
  .dp .prose { overflow-wrap: anywhere; }
  .dp .prose pre { max-width: 100%; font-size: 0.8rem; }
  .dp .prose table { display: block; max-width: 100%; overflow-x: auto; }
  .dp .content img { max-width: 100%; height: auto; }

  /* Parts list -> cards (same DOM, so the cost checkboxes keep working) */
  .dp .proj-layout .bom-table-wrapper { border: 0; background: none; overflow: visible; }
  .dp .proj-layout .bom-table thead { display: none; }
  .dp .proj-layout .bom-table,
  .dp .proj-layout .bom-table tbody,
  .dp .proj-layout .bom-table tfoot { display: block; width: 100%; }
  .dp .proj-layout .bom-table tr.bom-item-row {
    display: grid; grid-template-columns: 24px minmax(0, 1fr) auto;
    grid-template-areas: "chk name price" "chk qty buy";
    column-gap: 0.75rem; row-gap: 0.3rem; align-items: center;
    padding: 0.8rem 0.9rem; margin-bottom: 0.5rem;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md);
  }
  .dp .proj-layout .bom-table tr.bom-item-row td { display: block; padding: 0; border: 0; width: auto; }
  .dp .proj-layout .bom-item-row td:nth-child(1) { grid-area: chk; align-self: start; padding-top: 2px; }
  .dp .proj-layout .bom-item-row td:nth-child(2) { grid-area: name; }
  .dp .proj-layout .bom-item-row td:nth-child(3) { grid-area: qty; font-size: var(--fs-xs); color: var(--text-muted); }
  .dp .proj-layout .bom-item-row td:nth-child(3)::before { content: "Qty "; font-family: var(--font-sans); }
