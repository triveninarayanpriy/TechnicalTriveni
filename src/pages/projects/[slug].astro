---
import Base from '../../layouts/Base.astro';
import ErrorBoundary from '../../components/ErrorBoundary.astro';
import ProjectLayoutV2 from '../../components/ProjectLayoutV2.astro';
import { env } from 'cloudflare:workers';
import { getProjectFull, listProjects } from '../../lib/db';
import { SITE } from '../../lib/site';
import { renderMarkdown, youtubeId, formatDate } from '../../lib/format';
import { razorpayConfigured } from '../../lib/razorpay';

const { slug } = Astro.params;
const project = await getProjectFull(env.DB, slug!);

if (!project || (!project.published && !Astro.url.searchParams.get('preview'))) {
  return Astro.rewrite('/404');
}

// Single price model: price_inr > 0 defines paid
const paid = (project.price_inr ?? 0) > 0;
const paymentsOn = razorpayConfigured(env);

// Media and 3D check
const hasModel =
  (project.images || []).some((m) => m.kind === 'model') ||
  (project.files || []).some((f) => f.kind === 'model' || f.kind === '3d') ||
  !!project.model_url;

const yt = youtubeId(project.video_url);

// Calculate real verified rating if any
let ratingAvg = 0;
let ratingCount = 0;
try {
  const avgRatingRes = await env.DB.prepare(
    'SELECT AVG(rating) as avg, COUNT(rating) as cnt FROM orders WHERE project_id = ? AND rating IS NOT NULL'
  )
    .bind(project.id)
    .first<{ avg: number | null; cnt: number }>();
  if (avgRatingRes && avgRatingRes.cnt > 0) {
    ratingAvg = parseFloat(Number(avgRatingRes.avg || 0).toFixed(1));
    ratingCount = avgRatingRes.cnt;
  }
} catch {}

// Render markdown fields safely
const descHtml = project.description ? renderMarkdown(project.description) : '';
const safetyHtml = project.safety_note ? renderMarkdown(project.safety_note) : '';

// Pre-render step body markdown so ProjectLayoutV2 can safely use set:html
if (project.steps) {
  project.steps = project.steps.map((step) => ({
    ...step,
    body: step.body ? renderMarkdown(step.body) : '',
  }));
}

// Fetch 3 related project packs
let relatedPacks: any[] = [];
try {
  const allPub = await listProjects(env.DB, { publishedOnly: true, limit: 6 });
  relatedPacks = allPub.filter((p) => p.id !== project.id).slice(0, 3);
} catch {}

// JSON-LD schema
const productJson = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: project.title,
  description: project.meta_description || project.summary,
  image: project.og_image || project.cover_image || SITE.ogImage,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'INR',
    price: paid ? project.price_inr : 0,
    availability: 'https://schema.org/InStock',
    url: Astro.url.href,
  },
  ...(ratingCount > 0
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: ratingAvg,
          reviewCount: ratingCount,
        },
      }
    : {}),
};

const howToJson =
  project.steps && project.steps.length > 0
    ? {
        '@context': 'https://schema.org/',
        '@type': 'HowTo',
        name: project.title,
        description: project.summary,
        image: project.cover_image,
        step: project.steps.map((step, index) => ({
          '@type': 'HowToStep',
          position: index + 1,
          name: step.title || `Step ${index + 1}`,
          text: step.body || step.title || `Step ${index + 1}`,
          image: step.image_url ? step.image_url : undefined,
        })),
      }
    : null;

const jsonLd = howToJson ? [productJson, howToJson] : productJson;
---

<Base
  title={project.meta_title || `${project.title} | Technical Triveni`}
  description={project.meta_description || project.summary}
  ogImage={project.og_image || project.cover_image || '/og-default.png'}
  jsonLd={jsonLd}
>
  <ErrorBoundary>
    {hasModel && (
      <script
        type="module"
        src="https://cdn.jsdelivr.net/npm/@google/model-viewer@4.0.0/dist/model-viewer.min.js"
      ></script>
    )}
    {paid && <script src="https://checkout.razorpay.com/v1/checkout.js"></script>}
    {yt && (
      <script
        type="module"
        src="https://cdn.jsdelivr.net/npm/@justinribeiro/lite-youtube-embed@2.1.2/lite-youtube.js"
      ></script>
    )}

    <ProjectLayoutV2
      project={project}
      paid={paid}
      descHtml={descHtml}
      safetyHtml={safetyHtml}
      yt={yt}
      ratingAvg={ratingAvg}
      ratingCount={ratingCount}
      relatedPacks={relatedPacks}
    />
  </ErrorBoundary>
</Base>
