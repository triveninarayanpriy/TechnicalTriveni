---
import Base from '../../layouts/Base.astro';
import ProjectLayoutV2 from '../../components/ProjectLayoutV2.astro';
import Icon from '../../components/Icon.astro';
import BomTable from '../../components/BomTable.astro';
import StageCard from '../../components/StageCard.astro';
import TroubleTable from '../../components/TroubleTable.astro';
import ProjectMobileShell from '../../components/ProjectMobileShell.astro';
import { env } from 'cloudflare:workers';
import { getProjectFull } from '../../lib/db';
import { SITE, FILE_KINDS } from '../../lib/site';
import { formatINR, renderMarkdown, parseTags, difficultyClass, formatBytes, youtubeId, formatDate } from '../../lib/format';
import { razorpayConfigured } from '../../lib/razorpay';

const { slug } = Astro.params;
const project = await getProjectFull(env.DB, slug!);
if (!project) {
  return Astro.rewrite('/404');
}

const tags = parseTags(project.tags);
const paid = project.combo_enabled === 1 && project.price_inr > 0;
const paymentsOn = razorpayConfigured(env);
const media = project.images.length > 0 
  ? project.images 
  : project.cover_image 
    ? [{ id: 0, project_id: project.id, url: project.cover_image, caption: project.title, sort: 0, kind: 'image' }] 
    : [];
const first = media[0] || {};
const hasModel = media.some(m => m.kind === 'model');
const codeFiles = project.files.filter((f) => f.kind === 'code' || f.kind === 'hex' || f.kind === 'sketch');
const freeFiles = project.files.filter((f) => f.is_free === 1);
const comboFiles = project.files.filter((f) => f.in_combo === 1);
const kindLabel = (k: string) => FILE_KINDS.find((x) => x.key === k)?.label ?? 'File';
const kindIcon = (k: string) => FILE_KINDS.find((x) => x.key === k)?.icon ?? 'file';
const yt = youtubeId(project.video_url);

const descHtml = renderMarkdown(project.description).replace(/^<h2[^>]*>\s*Overview\s*<\/h2>\s*/i, '');
const safetyHtml = project.safety_note ? renderMarkdown(project.safety_note) : '';
const creditsHtml = project.credits ? renderMarkdown(project.credits) : '';
const lastUpdated = formatDate(project.updated_at);

const estCost = project.bom.reduce((sum, b) => {
  const q = parseInt(b.qty, 10);
  const qty = Number.isFinite(q) && q > 0 ? q : 1;
  return sum + (b.unit_price_inr > 0 ? b.unit_price_inr * qty : 0);
}, 0);

const hasAffiliate = project.bom.some(b => b.is_affiliate === 1 && b.affiliate_url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: project.title,
  description: project.summary,
  image: project.cover_image ? new URL(project.cover_image, Astro.site ?? Astro.url.origin).toString() : undefined,
  brand: {
    '@type': 'Brand',
    name: SITE.name
  },
  ...(paid ? { offers: {
    '@type': 'Offer',
    price: project.price_inr,
    priceCurrency: 'INR',
    availability: 'https://schema.org/InStock',
    url: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString()
  }} : {})
};
---

<Base title={project.title} description={project.summary} ogImage={project.cover_image || '/og-default.png'} jsonLd={jsonLd}>
  {hasModel && <script type="module" src="https://cdn.jsdelivr.net/npm/@google/model-viewer@4.0.0/dist/model-viewer.min.js"></script>}
  {paid && <script src="https://checkout.razorpay.com/v1/checkout.js"></script>}

  <div id="read-progress" class="read-progress"></div>
  {project.layout_version === 2 ? (
    <ProjectLayoutV2 project={project} estCost={estCost} paid={paid} descHtml={descHtml} safetyHtml={safetyHtml} />
  ) : (


  <div class="container dp">
    <!-- Breadcrumbs -->
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span>/</span>
      <a href="/projects">Projects</a> <span>/</span>
      <span class="muted">{project.title}</span>
    </nav>

    <!-- ========== MAIN LAYOUT ========== -->
    <div class="proj-layout">
      
      <!-- 1. Title & Meta -->
      <div class="proj-header" style="grid-area: title;">
        <div class="hero-meta">
          <span class="chip chip--cat">{project.category}</span>
          <span class:list={['badge', difficultyClass(project.difficulty)]}>{project.difficulty}</span>
          {project.build_time && <span class="chip"><Icon name="clock" size={13} /> {project.build_time}</span>}
          {estCost > 0 && <span class="chip"><Icon name="cart" size={13} /> Estimated build cost &#8377;{Number(estCost).toLocaleString('en-IN')}</span>}
        </div>
        
        <h1 class="hero-title">{project.title}</h1>
        {project.outcome_line && <p class="hero-outcome">{project.outcome_line}</p>}
        <p class="hero-summary">{project.summary}</p>

        {lastUpdated && <p class="hero-updated dim" style="margin-top:0.5rem;"><Icon name="check" size={12} /> Updated {lastUpdated}</p>}
      </div>

      <!-- 2. Media Viewer -->
      <div class="hero-media" style="grid-area: media;">
        {media.length > 0 && (
          <section class="viewer" data-viewer>
            <div class:list={['viewer__stage', { 'has-model': first.kind === 'model' }]} data-stage>
              {first.kind === 'model' ? (
                <model-viewer
                  src={first.url}
                  camera-controls
                  auto-rotate
                  auto-rotate-delay="400"
                  rotation-per-second="20deg"
                  shadow-intensity="1"
                  shadow-softness="0.8"
                  exposure="1.3"
                  environment-image="neutral"
                  interaction-prompt="auto"
                  camera-orbit="45deg 65deg auto"
                  min-camera-orbit="auto auto auto"
                  max-camera-orbit="auto auto auto"
                  ar
                  aria-label={`3D model of ${project.title}`}
                  class="viewer__model"
                ></model-viewer>
              ) : (
                <img src={first.url} alt={first.caption || project.title} class="viewer__img" width="960" height="600" />
              )}
              {first.kind === 'model' && (
                <span class="viewer__hint mono"><Icon name="cube" size={13} /> Drag to rotate &bull; scroll to zoom</span>
              )}
            </div>

            {media.length > 1 && (
              <div class="viewer__thumbs" role="tablist">
                {media.map((m, i) => (
                  <button 
                    class:list={['viewer__thumb', { 'is-active': i === 0 }]}
                    data-index={i}
                    data-url={m.url}
                    data-kind={m.kind}
                    data-caption={m.caption || ''}
                    aria-label={m.kind === 'model' ? '3D model' : `Photo ${i + 1}`}
                  >
                    {m.kind === 'model' 
                      ? <span class="viewer__thumb-3d"><Icon name="cube" size={16} /> <span>3D</span></span>
                      : <img src={m.url} alt={m.caption || ''} loading="lazy" />
                    }
                  </button>
                ))}
              </div>
            )}
          </section>
        )}
      </div>

      <!-- 3. Sidebar (Buy Card + ToC) -->
      <aside class="proj-sidebar" style="grid-area: sidebar;">
        <div class="proj-sidebar-inner">
          
          <!-- Inline Buy / Free card -->
          <div class="cta-card panel" id="buy" data-buy data-project-id={project.id} data-slug={project.slug} data-payments={paymentsOn ? '1' : '0'}>
            {paid ? (
              <>
                <div class="cta-card__row">
                  <div>
                    <span class="cta-card__kicker mono">{project.combo_title || 'Full Combo Pack'}</span>
                    <div class="cta-card__price">Pack {formatINR(project.price_inr)} <span>one-time &bull; digital pack</span></div>
                  </div>
                </div>
                
                <details class="cta-card__details">
                  <summary><span>What's included?</span> <Icon name="chevron-down" size={14} /></summary>
                  <div class="cta-card__details-body">
                    {project.combo_description && <p class="cta-card__desc">{project.combo_description}</p>}
                    <ul class="cta-card__list">
                      {comboFiles.map(f => (
                        <li><Icon name={kindIcon(f.kind)} size={14} /> <span>{f.label || kindLabel(f.kind)}</span></li>
                      ))}
                    </ul>
                  </div>
                </details>

                <div class="cta-card__action">
                  <div class="input-wrap">
                    <input type="email" id="buy-email" class="input input--sm" placeholder="Your email address..." required />
                  </div>
                  <button type="button" class="btn btn-primary btn-block btn-buy" data-buy-btn><Icon name="lock" size={14} /> Buy &amp; download</button>
                </div>
                
                <div class="cta-card__trust">
                  <div class="trust-row"><Icon name="check-circle" size={12} /> Secure payment &bull; UPI, cards &amp; more</div>
                  <a href="/account/downloads" class="trust-row"><Icon name="download" size={12} /> Already purchased? Retrieve your files</a>
                  {!paymentsOn && <p class="cta-card__note">Payments being set up. <a href="/contact">Contact us</a> to purchase now.</p>}
                </div>
              </>
            ) : (
              <>
                <div class="cta-card__row">
                  <div>
                    <span class="cta-card__kicker mono">Open resource</span>
                    <div class="cta-card__free">Free</div>
                  </div>
                </div>
                <p class="cta-card__desc">All resources for this project are free to download.</p>
                <a href="#downloads" class="btn btn-primary btn-block"><Icon name="download" size={15} /> Get files</a>
                {(project.code_repo_url || codeFiles.length > 0) && (
                  <a href="#code" class="btn btn-ghost btn-block"><Icon name="github" size={15} /> Source code</a>
                )}
              </>
            )}
          </div>

          <nav class="toc hide-sm" aria-label="Table of contents">
            <span class="toc-title">On this page</span>
            <ul class="toc-list" id="toc-list">
              {descHtml && <li><a href="#overview" class="toc-link">Overview</a></li>}
              {project.bom.length > 0 && <li><a href="#parts" class="toc-link">Components &amp; parts</a></li>}
              {project.pins.length > 0 && <li><a href="#wiring" class="toc-link">Wiring &amp; connections</a></li>}
              {project.steps.length > 0 && <li><a href="#build" class="toc-link">Step-by-step build</a></li>}
              {(project.code_repo_url || codeFiles.length > 0) && <li><a href="#code" class="toc-link">Code</a></li>}
              {project.troubleshooting.length > 0 && <li><a href="#troubleshooting" class="toc-link">Troubleshooting</a></li>}
              {freeFiles.length > 0 && <li><a href="#downloads" class="toc-link">Downloads</a></li>}
            </ul>
          </nav>
        </div>
      </aside>

      <!-- 4. Quick facts strip -->
      <div class="facts-strip" style="grid-area: facts;">
        <div class="fact">
          <Icon name="layers" size={16} /> <span><strong>Category</strong>{project.category}</span>
        </div>
        <div class="fact">
          <Icon name="zap" size={16} /> <span><strong>Difficulty</strong>{project.difficulty}</span>
        </div>
        {project.build_time && (
          <div class="fact">
            <Icon name="clock" size={16} /> <span><strong>Build time</strong>{project.build_time}</span>
          </div>
        )}
        <div class="fact">
          <Icon name="cart" size={16} /> <span><strong>Parts</strong>{project.bom.length} items</span>
        </div>
        <div class="fact">
          <Icon name="download" size={16} /> <span><strong>Files</strong>{project.files.length} resources</span>
        </div>
        {tags.length > 0 && (
          <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap; margin-top:0.25rem;">
            {tags.map((t: string) => <span class="chip" style="font-size:0.7rem; color:var(--text-muted); background:var(--surface); border: 1px solid var(--border); border-radius:100px; padding: 0.15rem 0.5rem;">{t}</span>)}
          </div>
        )}
      </div>

      <!-- 5. Content -->
      <div class="content" style="grid-area: content;">
        <nav class="m-secnav" aria-label="Jump to section">
          <div class="m-secnav__track" data-m-secnav-track>
            {descHtml && <a href="#overview" class="m-secnav__chip" data-m-chip="overview">Overview</a>}
            {project.bom.length > 0 && <a href="#parts" class="m-secnav__chip" data-m-chip="parts">Parts</a>}
            {project.pins.length > 0 && <a href="#wiring" class="m-secnav__chip" data-m-chip="wiring">Wiring</a>}
            {project.steps.length > 0 && <a href="#build" class="m-secnav__chip" data-m-chip="build">Build</a>}
            {(project.code_repo_url || codeFiles.length > 0) && <a href="#code" class="m-secnav__chip" data-m-chip="code">Code</a>}
            {project.troubleshooting.length > 0 && <a href="#troubleshooting" class="m-secnav__chip" data-m-chip="troubleshooting">Help</a>}
            {freeFiles.length > 0 && <a href="#downloads" class="m-secnav__chip" data-m-chip="downloads">Files</a>}
          </div>
        </nav>
        {safetyHtml && (
          <div class="safety panel" style="background: rgba(245, 158, 11, 0.05); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: var(--r-md); margin-bottom: 2rem; padding: 1rem 1.25rem;">
            <div class="safety__head" style="color: #d97706; display: flex; align-items: center; gap: 0.5rem; font-weight: 600; margin-bottom: 0.5rem;">
              <Icon name="shield-alert" size={18} /><span>Safety first &mdash; read before you build</span>
            </div>
            <details class="safety__body prose prose--tight">
              <summary style="cursor: pointer; color: var(--text-muted); font-size: 0.9rem; font-weight: 500;">Read all safety rules</summary>
              <div style="margin-top: 0.75rem; padding-left: 1rem; border-left: 2px solid rgba(245, 158, 11, 0.3);">
                <Fragment set:html={safetyHtml} />
              </div>
            </details>
          </div>
        )}

        {descHtml && (
          <section id="overview" class="sec">
            <h2 class="sec__title"><Icon name="loader" size={20} style="color:var(--brand-red)" /> Overview</h2>
            <div class="prose">
              <Fragment set:html={descHtml} />
            </div>
          </section>
        )}

        {yt && (
          <section class="sec">
            <h2 class="sec__title"><Icon name="play" size={20} /> Watch the build</h2>
            <div class="video-embed">
              <iframe 
                src={`https://www.youtube-nocookie.com/embed/${yt}`} 
                title="YouTube video player" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                allowfullscreen>
              </iframe>
            </div>
          </section>
        )}

        {project.bom.length > 0 && (
          <section id="parts" class="sec">
            <h2 class="sec__title"><Icon name="cpu" size={20} /> Components &amp; parts</h2>
            
            <div class="bom-tools">
              <button class="btn btn-ghost btn-sm" id="bom-check-all"><Icon name="check-square" size={14} /> Check all</button>
              <button class="btn btn-ghost btn-sm" id="bom-uncheck-all"><Icon name="square" size={14} /> Clear</button>
            </div>
            
            <BomTable items={project.bom} />
          </section>
        )}

        {project.pins.length > 0 && (
          <section id="wiring" class="sec">
            <h2 class="sec__title"><Icon name="git-merge" size={20} /> Wiring &amp; connections</h2>
            
            {project.wiring_diagrams?.length > 0 && (
              <div class="wiring-diagrams" style="display:flex; flex-direction:column; gap:1rem; margin-bottom:1.5rem;">
                {project.wiring_diagrams.map(wd => (
                  <div class="wiring-diagram-card panel" style="padding:1rem;">
                    <h3 style="font-size:1rem; margin-bottom:0.75rem;">{wd.label} {wd.module && <span class="chip chip--cat" style="font-size:0.7rem; margin-left:0.5rem;">{wd.module}</span>}</h3>
                    <img src={wd.url} alt={wd.label} style="max-width:100%; border-radius:var(--r-md); border:1px solid var(--border);" loading="lazy" />
                  </div>
                ))}
              </div>
            )}
            
            <div class="table-wrap pins-wrap">
              <table class="pins">
                <thead>
                  <tr>
                    <th>From (Pin/Pad)</th>
                    <th>Connects to</th>
                    <th>Notes</th>
                  </tr>
                </thead>
                <tbody>
                  {project.pins.map(p => (
                    <tr class="pin-row">
                      <td class="pin-from"><span class="mono">{p.from_pin}</span> {p.module && <span class="chip chip--cat pin-mod">{p.module}</span>}</td>
                      <td class="pin-to"><span class="pin-arrow" aria-hidden="true">&rarr;</span> <span class="mono">{p.to_pin}</span></td>
                      <td class="muted pin-note">{p.note || '-'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {project.steps.length > 0 && (
          <section id="build" class="sec">
            <h2 class="sec__title"><Icon name="tool" size={20} /> Step-by-step build</h2>
            
            <div class="steps">
              {project.steps.map((s, i) => (
                <StageCard step={s} index={i} />
              ))}
            </div>
          </section>
        )}

        {(project.code_repo_url || codeFiles.length > 0) && (
          <section id="code" class="sec">
            <h2 class="sec__title"><Icon name="code" size={20} /> Code &amp; firmware</h2>
            
            {project.code_repo_url && (
              <div style="margin-bottom: 1.5rem;">
                <a href={project.code_repo_url} target="_blank" rel="noopener noreferrer" class="repo-link">
                  <Icon name="github" size={18} /> View repository on GitHub
                </a>
              </div>
            )}

            {codeFiles.length > 0 && (
              <div class="files">
                {codeFiles.map(f => (
                  <a href={f.url} class="file-row" target="_blank" rel="noopener">
                    <div class="file-row__icon"><Icon name={kindIcon(f.kind)} size={20} /></div>
                    <div class="file-row__meta">
                      <span class="file-row__label">{f.label || kindLabel(f.kind)}</span>
                      <span class="file-row__sub">{formatBytes(f.size_bytes)}</span>
                    </div>
                    <Icon name="download" size={16} />
                  </a>
                ))}
              </div>
            )}
          </section>
        )}

        {project.troubleshooting.length > 0 && (
          <section id="troubleshooting" class="sec">
            <h2 class="sec__title"><Icon name="life-buoy" size={20} /> Troubleshooting</h2>
            <TroubleTable items={project.troubleshooting} />
          </section>
        )}

        {freeFiles.length > 0 && (
          <section id="downloads" class="sec">
            <h2 class="sec__title"><Icon name="download" size={20} /> Downloads</h2>
            <div class="files">
              {freeFiles.map(f => (
                <a href={f.url} class="file-row" target="_blank" rel="noopener">
                  <div class="file-row__icon"><Icon name={kindIcon(f.kind)} size={20} /></div>
                  <div class="file-row__meta">
                    <span class="file-row__label">{f.label || kindLabel(f.kind)}</span>
                    <span class="file-row__sub">{formatBytes(f.size_bytes)}</span>
                  </div>
                  <Icon name="download" size={16} />
                </a>
              ))}
            </div>
          </section>
        )}

        {project.links.length > 0 && (
          <section class="sec" style="margin-top: 2rem;">
            <h3 class="sec__title" style="font-size:1.1rem;"><Icon name="external-link" size={18} /> External resources</h3>
            <div class="ext-links">
              {project.links.map(l => (
                <a href={l.url} target="_blank" rel="noopener noreferrer" class="ext-link">
                  <Icon name="link" size={14} /> {l.label}
                </a>
              ))}
            </div>
          </section>
        )}

      </div>
    </div>

    <!-- Mobile-only: bottom bar + bottom sheet (hosts the #buy card) -->
    <ProjectMobileShell
      paid={paid}
      priceLabel={paid ? `Pack ${formatINR(project.price_inr)}` : 'Free'}
      comboTitle={project.combo_title}
      includedCount={comboFiles.length}
    />

  </div>
  )}
</Base>

<script>
// UI Scripts: viewer, etc.
const stage = document.querySelector('[data-stage]');
const thumbs = document.querySelectorAll('[data-index]');
const modelEl = stage?.querySelector('model-viewer');

thumbs.forEach(btn => {
  btn.addEventListener('click', () => {
    thumbs.forEach(t => t.classList.remove('is-active'));
    btn.classList.add('is-active');
    
    const url = (btn as HTMLElement).dataset.url;
    const isModel = (btn as HTMLElement).dataset.kind === 'model';
    const cap = (btn as HTMLElement).dataset.caption;

    if (!stage || !url) return;
    
    if (isModel) {
      stage.classList.add('has-model');
      stage.innerHTML = `<model-viewer src="${url}" camera-controls auto-rotate shadow-intensity="1" ar class="viewer__model"></model-viewer><span class="viewer__hint mono"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.29 7 12 12 20.71 7"></polyline><line x1="12" y1="22" x2="12" y2="12"></line></svg> Drag to rotate &bull; scroll to zoom</span>`;
    } else {
      stage.classList.remove('has-model');
      stage.innerHTML = `<img src="${url}" alt="${cap || ''}" class="viewer__img" />`;
    }
  });
});

// Scroll progress
const bar = document.getElementById('read-progress');
if (bar) {
  window.addEventListener('scroll', () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    bar.style.width = (winScroll / height) * 100 + "%";
  }, { passive: true });
}

// Payment trigger
document.querySelector('[data-buy-btn]')?.addEventListener('click', async (e) => {
  const cta = document.getElementById('buy');
  const emailInput = document.getElementById('buy-email') as HTMLInputElement;
  const btn = e.currentTarget as HTMLButtonElement;
  
  if (!cta || !emailInput) return;
  const { projectId, slug, payments } = cta.dataset;
  
  if (!emailInput.value || !emailInput.checkValidity()) {
    emailInput.reportValidity();
    return;
  }
  
  if (payments !== '1') {
    alert("Payments are currently being configured. Please check back later.");
    return;
  }
  
  btn.disabled = true;
  btn.innerHTML = `<svg class="spinner" viewBox="0 0 50 50"><circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle></svg> Processing...`;
  
  try {
    const res = await fetch('/api/razorpay/create-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ projectId: parseInt(projectId!), email: emailInput.value })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed to start payment');
    
    const rzp = new (window as any).Razorpay({
      key: data.keyId,
      amount: data.amount,
      currency: "INR",
      name: "Technical Triveni",
      description: "Project Files",
      order_id: data.razorpayOrderId,
      handler: async function (response: any) {
        btn.innerHTML = `<svg class="spinner" viewBox="0 0 50 50"><circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle></svg> Verifying...`;
        try {
          const vres = await fetch('/api/razorpay/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              orderId: data.orderId,
              razorpay_order_id: response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature: response.razorpay_signature
            })
          });
          const vdata = await vres.json();
          if (!vres.ok) throw new Error(vdata.error || 'Verification failed');
          if (vdata.redirect) window.location.href = vdata.redirect;
        } catch (err: any) {
          alert("Payment processed, but verification failed: " + err.message + ". If you didn't receive an email, please contact support.");
          window.location.href = '/account/downloads';
        }
      },
      prefill: { email: emailInput.value },
      theme: { color: "#e7242a" }
    });
    
    rzp.on('payment.failed', function () {
      btn.disabled = false;
      btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="icon"><rect x="4.5" y="10.5" width="15" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg> Buy & download`;
      alert("Payment failed or cancelled.");
    });
    
    rzp.open();
  } catch (err: any) {
    btn.disabled = false;
    btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="icon"><rect x="4.5" y="10.5" width="15" height="10" rx="2"></rect><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path></svg> Buy & download`;
    alert(err.message);
  }
});

// Build Progress Tracking (Phase 3)
const ctaEl = document.getElementById('buy');
if (ctaEl && ctaEl.dataset.projectId) {
  const projId = ctaEl.dataset.projectId;
  const storageKey = `tt-progress-${projId}`;
  
  // Load saved progress
  let completed = [];
  try {
    const saved = localStorage.getItem(storageKey);
    if (saved) completed = JSON.parse(saved);
  } catch (e) {}

  const checkboxes = document.querySelectorAll('.stage-done-cb');
  checkboxes.forEach((el) => {
    const cb = el as HTMLInputElement;
    const sid = cb.dataset.stageId;
    if (completed.includes(sid)) {
      cb.checked = true;
      cb.closest('.stage-card')?.classList.add('is-done');
    }
    
    cb.addEventListener('change', (e) => {
      const isChecked = (e.target as HTMLInputElement).checked;
      if (isChecked) {
        if (!completed.includes(sid)) completed.push(sid);
        cb.closest('.stage-card')?.classList.add('is-done');
      } else {
        completed = completed.filter(id => id !== sid);
        cb.closest('.stage-card')?.classList.remove('is-done');
      }
      try {
        localStorage.setItem(storageKey, JSON.stringify(completed));
      } catch (err) {}
    });
  });
}
</script>

