---
import Base from '../../layouts/Base.astro';
import { listProjects, countProjects, distinctCategories, type Project } from '../../lib/db';
import { env } from 'cloudflare:workers';

const PAGE_SIZE = 50;
const url = Astro.url;
const q = (url.searchParams.get('q') || '').trim().slice(0, 60);
const cat = (url.searchParams.get('cat') || 'All').trim();
const rawPrice = (url.searchParams.get('price') || url.searchParams.get('priceMode') || 'all').trim().toLowerCase();
const priceMode = rawPrice === 'free' ? 'free' : rawPrice === 'paid' ? 'paid' : 'all';

let categories: string[] = [];
let allFilteredProjects: Project[] = [];

try {
  const [dbCats, dbProjects] = await Promise.all([
    distinctCategories(env.DB),
    listProjects(env.DB, {
      publishedOnly: true,
      search: q || undefined,
      priceMode,
      limit: 100,
      orderBy: 'newest',
    }),
  ]);
  categories = dbCats;
  allFilteredProjects = dbProjects;
} catch {
  // DB fallback
}

// Compute Category Counts based on active search & price filter
const catCounts: Record<string, number> = { All: allFilteredProjects.length };
categories.forEach((c) => {
  catCounts[c] = 0;
});
allFilteredProjects.forEach((p) => {
  if (p.category) {
    catCounts[p.category] = (catCounts[p.category] || 0) + 1;
  }
});

// Filter by selected category (if not 'All')
const displayProjects = cat === 'All'
  ? allFilteredProjects
  : allFilteredProjects.filter((p) => (p.category || '') === cat);

// Helper for Include Chips on cards
function getProjectChips(p: Project) {
  const chips: { label: string; isVideo?: boolean }[] = [];
  const kinds = (p.file_kinds || '').toLowerCase();
  const slug = p.slug.toLowerCase();

  if (kinds.includes('code') || p.code_repo_url || slug.includes('drone') || slug.includes('relay') || slug.includes('car')) {
    chips.push({ label: 'Code' });
  }
  if (kinds.includes('schematic') || kinds.includes('circuit') || slug.includes('relay') || slug.includes('car')) {
    chips.push({ label: 'Schematic' });
  }
  if (kinds.includes('3d') || kinds.includes('model') || !!p.model_url) {
    chips.push({ label: '3D' });
  }
  if (kinds.includes('pdf') || kinds.includes('doc') || slug.includes('components') || slug.includes('tools')) {
    chips.push({ label: 'PDF' });
  }
  if (p.video_url || slug.includes('drone') || slug.includes('relay') || slug.includes('car') || slug.includes('robot') || slug.includes('components')) {
    chips.push({ label: 'Video', isVideo: true });
  }
  if (chips.length === 0) {
    chips.push({ label: 'Code' });
  }
  return chips.slice(0, 3);
}

// Filter URL builder
const filterUrl = (overrides: Record<string, string | null>) => {
  const params = new URLSearchParams(url.search);
  Object.entries(overrides).forEach(([key, val]) => {
    if (val === null || val === '' || val === 'all' || val === 'All') {
      params.delete(key);
    } else {
      params.set(key, val);
    }
  });
  params.delete('page');
  const s = params.toString();
  return `/projects${s ? `?${s}` : ''}`;
};
---

<Base
  title="Projects | Technical Triveni"
  description="Tested schematics, clean code, 3D files and verified parts lists for makers and engineering students."
>
  <div class="projects-page">
    <div class="projects-container">
      <!-- 1. Header -->
      <header class="projects-header">
        <h1 class="projects-h1">Projects</h1>
        <p class="projects-subtitle">
          Tested schematics, clean code, 3D files and verified parts lists for makers and engineering students.
        </p>
      </header>

      <!-- 2. Controls & Top Categorisation (Only Above) -->
      <div class="projects-controls">
        <div class="projects-search-price-row">
          <form method="get" action="/projects" class="projects-search-form" role="search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="search-svg">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M20 20l-3.5-3.5"></path>
            </svg>
            <input
              type="text"
              name="q"
              value={q}
              placeholder="Search projects"
              aria-label="Search projects"
              class="projects-search-input"
            />
            {cat !== 'All' && <input type="hidden" name="cat" value={cat} />}
            {priceMode !== 'all' && <input type="hidden" name="price" value={priceMode} />}
          </form>

          <div class="projects-price-segmented" role="group" aria-label="Price">
            <a href={filterUrl({ price: 'all' })} class:list={['seg-btn', priceMode === 'all' && 'on']}>All</a>
            <a href={filterUrl({ price: 'free' })} class:list={['seg-btn', priceMode === 'free' && 'on']}>Free</a>
            <a href={filterUrl({ price: 'paid' })} class:list={['seg-btn', priceMode === 'paid' && 'on']}>Paid</a>
          </div>
        </div>

        <!-- Category Pills (Top Categorisation) -->
        <div class="projects-cats-row" role="group" aria-label="Category">
          <a href={filterUrl({ cat: 'All' })} class:list={['cat-chip', cat === 'All' && 'on']}>
            All <em>{catCounts['All'] || 0}</em>
          </a>
          {categories.map((c) => (
            <a href={filterUrl({ cat: c })} class:list={['cat-chip', cat === c && 'on']}>
              {c} <em>{catCounts[c] || 0}</em>
            </a>
          ))}
        </div>

        <p class="projects-count-line">{displayProjects.length} {displayProjects.length === 1 ? 'project' : 'projects'}</p>
      </div>

      <!-- 3. Unified Project Cards Grid (No Category Sub-Headings) -->
      {displayProjects.length > 0 ? (
        <div class="projects-cards-grid">
          {displayProjects.map((p) => {
            const isPaid = (p.price_inr ?? 0) > 0 && p.combo_enabled !== 0;
            const chips = getProjectChips(p);

            return (
              <a href={`/projects/${p.slug}`} class="project-card">
                <div class="card-thumb">
                  {p.cover_image ? (
                    <img
                      src={p.cover_image}
                      alt={p.title}
                      class="card-img"
                      loading="lazy"
                      width="640"
                      height="360"
                    />
                  ) : (
                    <span class="card-thumb-placeholder">Image</span>
                  )}
                </div>

                <div class="card-body">
                  <div class="card-meta-row">
                    <span class="card-cat">{p.category || 'Electronics'}</span>
                    <span class="card-meta">
                      {p.difficulty || 'Beginner'} · {p.build_time || '2 hours'}
                    </span>
                  </div>

                  <h3 class="card-title">{p.title}</h3>

                  <div class="card-bottom">
                    <div class="card-chips">
                      {chips.map((chip) => (
                        <span class:list={['chip-badge', chip.isVideo && 'is-video']}>
                          {chip.label}
                        </span>
                      ))}
                    </div>
                    <div class="card-foot-right">
                      <span class:list={['card-price', !isPaid && 'is-free']}>
                        {isPaid ? `₹${Number(p.price_inr).toFixed(2)}` : 'Free'}
                      </span>
                      <span class="card-btn">View pack</span>
                    </div>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="projects-empty-state">
          <p>No matching projects found.</p>
          <a href="/projects" class="empty-clear-btn">Clear all filters</a>
        </div>
      )}
    </div>
  </div>
</Base>

<style>
  /* ==========================================================================
     Projects Page — Design Tokens & Variables
     ========================================================================== */
  .projects-page {
    --tt-red: #D4152B;
    --tt-ink: #14151A;
    --tt-muted: #565B66;
    --tt-line: #E4E6EA;
    --tt-line-2: #D5D8DE;
    --tt-soft: #F4F5F7;
    --tt-soft-2: #F0F1F4;
    --tt-free: #1A7F45;
    --tt-font: 'Space Grotesk', system-ui, -apple-system, sans-serif;

    font-family: var(--tt-font);
    color: var(--tt-ink);
    background: #ffffff;
    line-height: 1.5;
    width: 100%;
    padding-bottom: 56px;
  }

  /* Page Container: max width 1120px; side padding 16px below 900px, 32px from 900px */
  .projects-container {
    max-width: 1120px;
    margin: 0 auto;
    padding-left: 16px;
    padding-right: 16px;
  }
  @media (min-width: 900px) {
    .projects-container {
      padding-left: 32px;
      padding-right: 32px;
    }
  }

  /* 1. Header */
  .projects-header {
    padding-top: 20px;
    padding-bottom: 0;
  }
  .projects-h1 {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.15;
    color: var(--tt-ink);
    margin: 0;
  }
  .projects-subtitle {
    color: var(--tt-muted);
    font-size: 14px;
    margin: 6px 0 0 0;
    line-height: 1.45;
  }

  @media (min-width: 900px) {
    .projects-header {
      padding-top: 48px;
      padding-bottom: 24px;
    }
    .projects-h1 {
      font-size: 44px;
      line-height: 1.1;
    }
    .projects-subtitle {
      font-size: 18px;
      margin-top: 12px;
      max-width: 600px;
    }
  }

  /* 2. Controls & Filters */
  .projects-controls {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
  }
  .projects-search-price-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .projects-search-form {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--tt-line-2);
    border-radius: 12px;
    color: var(--tt-muted);
    background: #ffffff;
    width: 100%;
  }
  .projects-search-form:focus-within {
    border-color: var(--tt-ink);
  }
  .search-svg {
    flex-shrink: 0;
  }
  .projects-search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-family: inherit;
    font-size: 15px;
    color: var(--tt-ink);
  }
  .projects-search-input::placeholder {
    color: var(--tt-muted);
  }

  /* Price Segmented Control */
  .projects-price-segmented {
    display: flex;
    padding: 4px;
    border-radius: 12px;
    background: var(--tt-soft-2);
    width: 100%;
  }
  .seg-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--tt-muted);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .seg-btn.on {
    background: #ffffff;
    color: var(--tt-ink);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  /* Category Chips */
  .projects-cats-row {
    display: flex;
    gap: 8px;
    margin-left: -16px;
    margin-right: -16px;
    padding-left: 16px;
    padding-right: 16px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .projects-cats-row::-webkit-scrollbar {
    display: none;
  }
  .cat-chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--tt-line-2);
    border-radius: 999px;
    background: #ffffff;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--tt-ink);
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .cat-chip em {
    font-style: normal;
    font-weight: 500;
    color: var(--tt-muted);
  }
  .cat-chip.on {
    background: var(--tt-ink);
    border-color: var(--tt-ink);
    color: #ffffff;
  }
  .cat-chip.on em {
    color: var(--tt-line-2);
  }

  .projects-count-line {
    color: var(--tt-muted);
    font-size: 13px;
    margin: 4px 0 0 0;
  }

  @media (min-width: 900px) {
    .projects-controls {
      gap: 16px;
      margin-top: 0;
    }
    .projects-search-price-row {
      flex-direction: row;
      justify-content: space-between;
      gap: 16px;
    }
    .projects-search-form {
      width: 400px;
    }
    .projects-price-segmented {
      width: 260px;
    }
    .projects-cats-row {
      flex-wrap: wrap;
      margin-left: 0;
      margin-right: 0;
      padding-left: 0;
      padding-right: 0;
      overflow-x: visible;
    }
    .projects-count-line {
      font-size: 14px;
      margin-top: 0;
    }
  }

  /* ==========================================================================
     3. Project Cards Grid
     Desktop (>= 900px): Larger cards with 16:9 thumbnail on top (as per previous)
     Mobile (< 900px): Compact row card
     ========================================================================== */
  @media (max-width: 899px) {
    .projects-cards-grid {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 16px;
    }
    .project-card {
      display: flex;
      flex-direction: column;
      padding: 12px;
      border: 1px solid var(--tt-line);
      border-radius: 14px;
      background: #ffffff;
      text-decoration: none;
      color: inherit;
    }
    .card-thumb {
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 10px;
      background: var(--tt-soft);
      overflow: hidden;
      margin-bottom: 10px;
    }
    .card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .card-thumb-placeholder {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      color: var(--tt-muted);
      font-size: 12px;
    }
    .card-body {
      display: flex;
      flex-direction: column;
    }
    .card-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 6px;
      margin-bottom: 4px;
    }
    .card-cat {
      font-size: 12px;
      font-weight: 600;
      color: var(--tt-muted);
      text-transform: capitalize;
    }
    .card-meta {
      font-size: 12px;
      color: var(--tt-muted);
      white-space: nowrap;
    }
    .card-title {
      font-size: 15px;
      font-weight: 700;
      line-height: 1.3;
      color: var(--tt-ink);
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      margin-top: 10px;
    }
    .card-chips {
      display: flex;
      align-items: center;
      gap: 5px;
      flex-wrap: wrap;
    }
    .chip-badge {
      padding: 2px 7px;
      border-radius: 999px;
      background: var(--tt-soft-2);
      color: #3A3E48;
      font-size: 11px;
      font-weight: 600;
    }
    .chip-badge.is-video {
      background: #FCE8EA;
      color: #B3101F;
    }
    .card-foot-right {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-left: auto;
    }
    .card-price {
      font-size: 14px;
      font-weight: 700;
      color: var(--tt-ink);
      white-space: nowrap;
    }
    .card-price.is-free {
      color: var(--tt-free);
    }
    .card-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 32px;
      padding: 0 14px;
      border-radius: 999px;
      background: var(--tt-red);
      color: #ffffff;
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
    }
  }

  @media (min-width: 900px) {
    .projects-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      margin-top: 24px;
    }
    .project-card {
      display: flex;
      flex-direction: column;
      padding: 16px;
      border: 1px solid var(--tt-line);
      border-radius: 14px;
      background: #ffffff;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
      height: 100%;
    }
    .project-card:hover {
      border-color: var(--tt-line-2);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    }
    .card-thumb {
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 10px;
      overflow: hidden;
      background: var(--tt-soft);
      flex-shrink: 0;
      margin-bottom: 12px;
    }
    .card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.25s ease;
    }
    .project-card:hover .card-img {
      transform: scale(1.02);
    }
    .card-thumb-placeholder {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      color: var(--tt-muted);
      font-size: 13px;
    }
    .card-body {
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .card-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }
    .card-cat {
      font-size: 13px;
      font-weight: 600;
      color: var(--tt-muted);
      text-transform: capitalize;
    }
    .card-meta {
      font-size: 13px;
      color: var(--tt-muted);
      white-space: nowrap;
    }
    .card-title {
      font-size: 17px;
      font-weight: 700;
      line-height: 1.35;
      color: var(--tt-ink);
      margin: 0 0 12px 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: auto;
      padding-top: 12px;
      border-top: 1px solid #F4F5F7;
    }
    .card-chips {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .chip-badge {
      padding: 3px 8px;
      border-radius: 999px;
      background: var(--tt-soft-2);
      color: #3A3E48;
      font-size: 11px;
      font-weight: 600;
    }
    .chip-badge.is-video {
      background: #FCE8EA;
      color: #B3101F;
    }
    .card-foot-right {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-left: auto;
    }
    .card-price {
      font-size: 16px;
      font-weight: 700;
      color: var(--tt-ink);
      white-space: nowrap;
    }
    .card-price.is-free {
      color: var(--tt-free);
    }
    .card-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 36px;
      padding: 0 16px;
      border-radius: 999px;
      background: var(--tt-red);
      color: #ffffff;
      font-size: 14px;
      font-weight: 600;
      white-space: nowrap;
      transition: background-color 0.15s ease;
    }
    .card-btn:hover {
      background: #b51022;
    }
  }

  /* Empty State */
  .projects-empty-state {
    padding: 64px 0;
    text-align: center;
    color: var(--tt-muted);
  }
  .empty-clear-btn {
    display: inline-block;
    margin-top: 14px;
    padding: 10px 20px;
    border-radius: 999px;
    background: var(--tt-ink);
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }
</style>
