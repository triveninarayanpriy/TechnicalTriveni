---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE, PROFILE } from '../lib/site';
import { listProjects, type Project } from '../lib/db';
import { formatINR } from '../lib/format';
import { env } from 'cloudflare:workers';

let allProjects: Project[] = [];
try {
  allProjects = await listProjects(env.DB, { publishedOnly: true, limit: 12 });
} catch {
  /* DB not ready */
}

// Select the Drone or ESP32 as hero project
const heroProject = allProjects.find((p) => p.slug === 'arduino-drone') || allProjects[0];

// Select 4 featured projects for the grid
const featuredPacks = allProjects.filter((p) => p.slug !== heroProject?.slug).slice(0, 4);
if (featuredPacks.length < 4 && heroProject) {
  featuredPacks.unshift(heroProject);
}
const displayPacks = featuredPacks.slice(0, 4);

const heroPaid = (heroProject?.price_inr ?? 0) > 0;
const heroBadges = ['Code', 'Schematic'];
if (heroProject?.model_url || heroProject?.file_kinds?.includes('3d')) heroBadges.push('3D');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.description,
  url: Astro.site?.toString() || 'https://www.technicaltriveni.me',
  sameAs: [SITE.socials.youtube, SITE.socials.instagram, SITE.socials.github, SITE.socials.linkedin].filter(Boolean),
};
---

<Base jsonLd={jsonLd}>
  <!-- ============================ HERO ============================ -->
  <section class="home-hero">
    <div class="container home-hero__grid">
      <!-- Left Column (7 cols) -->
      <div class="home-hero__copy">
        <span class="home-hero__eyebrow">Electronics · Software · AI</span>
        <h1 class="home-hero__title">
          Engineering project packs you can <span class="text-red">actually build.</span>
        </h1>
        <p class="home-hero__lead">
          Full schematics, source code, 3D files, and verified parts lists — everything you need to go from watching a video to holding a working build.
        </p>
        <div class="home-hero__buttons">
          <a href="/projects" class="btn btn-primary btn-lg">
            Browse packs <Icon name="arrow-right" size={16} />
          </a>
          <a href="/how-it-works" class="btn btn-secondary btn-lg">
            How it works
          </a>
        </div>
      </div>

      <!-- Right Column (5 cols): Featured Project Card -->
      {heroProject && (
        <div class="home-hero__card-col">
          <article class="hero-card">
            <a href={`/projects/${heroProject.slug}`} class="hero-card__stretch" aria-label={`View ${heroProject.title}`}></a>
            <div class="hero-card__media">
              {heroProject.cover_image ? (
                <img src={heroProject.cover_image} alt={heroProject.title} width="640" height="400" loading="eager" />
              ) : (
                <div class="hero-card__ph">
                  <Icon name="cube" size={48} />
                </div>
              )}
              <div class="hero-card__badges">
                {heroBadges.slice(0, 2).map((b) => (
                  <span class="hero-card__badge">{b}</span>
                ))}
              </div>
            </div>
            <div class="hero-card__body">
              <span class="hero-card__cat">{heroProject.category || 'FEATURED PACK'}</span>
              <h3 class="hero-card__title">{heroProject.title}</h3>
              <p class="hero-card__summary">{heroProject.summary}</p>
              <div class="hero-card__foot">
                <span class="hero-card__price">
                  {heroPaid ? formatINR(heroProject.price_inr) : <span class="text-success">Free</span>}
                </span>
                <span class="hero-card__cta">View pack &rarr;</span>
              </div>
            </div>
          </article>
        </div>
      )}
    </div>
  </section>

  <!-- ======================== THREE VALUES ======================== -->
  <section class="values-section">
    <div class="container values-grid">
      <div class="value-item">
        <div class="value-item__icon"><Icon name="cpu" size={24} /></div>
        <h3 class="value-item__title">Tested circuit</h3>
        <p class="value-item__text">Every schematic and pin connection verified on real hardware.</p>
      </div>
      <div class="value-item">
        <div class="value-item__icon"><Icon name="layers" size={24} /></div>
        <h3 class="value-item__title">Complete files</h3>
        <p class="value-item__text">Code, 3D STLs, schematics and parts lists in one download.</p>
      </div>
      <div class="value-item">
        <div class="value-item__icon"><Icon name="mail" size={24} /></div>
        <h3 class="value-item__title">Direct support</h3>
        <p class="value-item__text">Ask questions, get help from the builder.</p>
      </div>
    </div>
  </section>

  <!-- ======================= FEATURED PACKS ======================= -->
  {displayPacks.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head-row">
          <div>
            <h2 class="section-heading">Featured project packs</h2>
            <p class="section-subtext">Verified builds with schematics, code, 3D files, and parts lists.</p>
          </div>
          <a href="/projects" class="section-link">
            View all {allProjects.length > 0 ? allProjects.length : '4'} packs &rarr;
          </a>
        </div>

        <div class="packs-grid">
          {displayPacks.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ================== WHAT EVERY PACK INCLUDES ================== -->
  <section class="section bg-soft">
    <div class="container">
      <div class="section-center-head">
        <h2 class="section-heading">What every pack includes</h2>
        <p class="section-subtext">No guessing, no missing libraries, no broken links.</p>
      </div>

      <div class="includes-grid">
        <div class="includes-card">
          <div class="includes-card__icon"><Icon name="code" size={30} /></div>
          <h3 class="includes-card__title">Source code</h3>
          <p class="includes-card__text">Clean, commented firmware and sketches ready to flash to your board.</p>
        </div>
        <div class="includes-card">
          <div class="includes-card__icon"><Icon name="schematic" size={30} /></div>
          <h3 class="includes-card__title">Wiring & schematics</h3>
          <p class="includes-card__text">Clear circuit diagrams and pin tables so you never cross a wire.</p>
        </div>
        <div class="includes-card">
          <div class="includes-card__icon"><Icon name="cart" size={30} /></div>
          <h3 class="includes-card__title">Complete parts list</h3>
          <p class="includes-card__text">Exact component specifications with direct local purchase links.</p>
        </div>
        <div class="includes-card">
          <div class="includes-card__icon"><Icon name="play" size={30} /></div>
          <h3 class="includes-card__title">Video walkthrough</h3>
          <p class="includes-card__text">Full build videos on YouTube showing the physical bring-up step by step.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= YOUTUBE CHANNEL ======================= -->
  <section class="section">
    <div class="container yt-grid">
      <div class="yt-copy">
        <span class="yt-label">THE CHANNEL</span>
        <h2 class="section-heading">Watch every build before you buy.</h2>
        <p class="yt-text">
          Every project on Technical Triveni is documented end-to-end on YouTube so you can watch the physical prototype come to life before downloading the pack.
        </p>
        <a href={SITE.socials.youtube} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <Icon name="youtube" size={18} /> Visit channel &rarr;
        </a>
      </div>
      <div class="yt-player">
        <lite-youtube videoid="qWj0V1c1_bU" style="border-radius: var(--r-card); overflow: hidden; box-shadow: var(--shadow);"></lite-youtube>
      </div>
    </div>
  </section>

  <!-- =================== COMMUNITY / ABOUT STRIP =================== -->
  <section class="about-strip">
    <div class="container about-strip__inner">
      <img src={PROFILE.photo} alt={PROFILE.name} class="about-strip__avatar" width="96" height="96" loading="lazy" />
      <div class="about-strip__copy">
        <h3 class="about-strip__name">{PROFILE.name}</h3>
        <p class="about-strip__bio">
          {PROFILE.lead} YouTube shows the highlight reel, but Technical Triveni is where you get the complete verified code, schematics, and parts lists to actually finish the build.
        </p>
        <a href="/about" class="about-strip__link">Read more about Triveni &rarr;</a>
      </div>
    </div>
  </section>

  <script type="module" src="https://cdn.jsdelivr.net/npm/@justinribeiro/lite-youtube-embed@2.1.2/lite-youtube.js"></script>
</Base>

<style>
  /* ---------------- Hero Section ---------------- */
  .home-hero {
    padding-top: 96px;
    padding-bottom: 80px;
    background: var(--bg);
  }
  .home-hero__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 48px;
    align-items: center;
  }
  .home-hero__copy {
    display: flex;
    flex-direction: column;
  }
  .home-hero__eyebrow {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    font-weight: 600;
    margin-bottom: 16px;
  }
  .home-hero__title {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 20px 0;
  }
  .text-red {
    color: var(--red);
  }
  .text-success {
    color: var(--success);
  }
  .home-hero__lead {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 52ch;
    margin: 0 0 32px 0;
  }
  .home-hero__buttons {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Right Hero Card */
  .home-hero__card-col {
    display: flex;
    justify-content: flex-end;
  }
  .hero-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 16px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    transition: transform 180ms var(--ease), border-color 180ms var(--ease), box-shadow 180ms var(--ease);
  }
  @media (hover: hover) and (min-width: 768px) {
    .hero-card:hover {
      transform: translateY(-2px);
      border-color: var(--ink-2);
    }
  }
  .hero-card__stretch {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }
  .hero-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-soft);
  }
  .hero-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-card__ph {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--ink-3);
  }
  .hero-card__badges {
    position: absolute;
    top: 8px;
    left: 8px;
    display: flex;
    gap: 6px;
    z-index: 1;
  }
  .hero-card__badge {
    font-size: 11px;
    font-weight: 550;
    padding: 3px 7px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(4px);
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--ink);
  }
  .hero-card__body {
    display: flex;
    flex-direction: column;
    padding-top: 14px;
    gap: 6px;
  }
  .hero-card__cat {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    font-weight: 600;
  }
  .hero-card__title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hero-card__summary {
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hero-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .hero-card__price {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
  }
  .hero-card__cta {
    font-size: 14px;
    font-weight: 600;
    color: var(--red);
  }

  /* ---------------- Three Values Section ---------------- */
  .values-section {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg-soft);
    padding: 48px 0;
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .value-item {
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .value-item:not(:last-child) {
    border-right: 1px solid var(--line);
  }
  .value-item__icon {
    color: var(--red);
    margin-bottom: 4px;
  }
  .value-item__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }
  .value-item__text {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    line-height: 1.5;
    margin: 0;
  }

  /* ---------------- Section Headers ---------------- */
  .section-head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .section-center-head {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 36px;
  }
  .section-heading {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.15;
    color: var(--ink);
    margin: 0 0 8px 0;
  }
  .section-subtext {
    font-size: var(--fs-base);
    color: var(--ink-2);
    margin: 0;
    line-height: 1.5;
  }
  .section-link {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--red);
    white-space: nowrap;
    text-decoration: none;
  }
  .section-link:hover {
    text-decoration: underline;
  }
  .bg-soft {
    background: var(--bg-soft);
  }

  /* ---------------- Packs Grid ---------------- */
  .packs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  /* ---------------- What Every Pack Includes ---------------- */
  .includes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }
  .includes-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 24px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .includes-card__icon {
    color: var(--red);
    margin-bottom: 8px;
  }
  .includes-card__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }
  .includes-card__text {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    line-height: 1.5;
    margin: 0;
  }

  /* ---------------- YouTube Channel ---------------- */
  .yt-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .yt-copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .yt-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    font-weight: 600;
  }
  .yt-text {
    font-size: var(--fs-base);
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0 0 16px 0;
  }
  .yt-copy .btn {
    align-self: flex-start;
  }
  .yt-player {
    width: 100%;
  }

  /* ---------------- Community / About Strip ---------------- */
  .about-strip {
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
    padding: 48px 0;
  }
  .about-strip__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    max-width: 860px;
  }
  .about-strip__avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--line);
    flex-shrink: 0;
  }
  .about-strip__copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .about-strip__name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }
  .about-strip__bio {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
  }
  .about-strip__link {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--red);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-top: 4px;
    align-self: flex-start;
  }

  /* ============================ Responsive ============================ */
  @media (max-width: 1024px) {
    .home-hero {
      padding-top: 64px;
      padding-bottom: 64px;
    }
    .home-hero__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .home-hero__card-col {
      justify-content: flex-start;
    }
    .packs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .yt-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* Mobile Phones (< 640px) */
  @media (max-width: 640px) {
    .home-hero {
      padding-top: 48px;
      padding-bottom: 48px;
    }
    .home-hero__buttons {
      flex-direction: column;
      width: 100%;
    }
    .home-hero__buttons .btn {
      width: 100%;
    }

    .values-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .value-item {
      padding: 0;
    }
    .value-item:not(:last-child) {
      border-right: none;
      border-bottom: 1px solid var(--line);
      padding-bottom: 20px;
    }

    .packs-grid {
      grid-template-columns: 1fr;
    }

    .includes-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .includes-card {
      padding: 16px 12px;
    }

    .about-strip__inner {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }
    .about-strip__link {
      align-self: center;
    }
  }
</style>
