<script>
  // Client-side instant filter tabs for Featured Projects (no page reload)
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('[data-home-tab]');
  const packItems = document.querySelectorAll<HTMLElement>('.pack-card-item');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.homeTab;
      tabBtns.forEach((b) => b.classList.toggle('on', b === btn));

      packItems.forEach((card) => {
        const type = card.dataset.priceType;
        if (target === 'all' || target === type) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

