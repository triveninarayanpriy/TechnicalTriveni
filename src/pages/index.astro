---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE, PROFILE } from '../lib/site';
import { listProjects, type Project } from '../lib/db';
import { formatINR } from '../lib/format';
import { env } from 'cloudflare:workers';
import { getSiteAssets, buildSrcSet } from '../lib/site-assets';

let allProjects: Project[] = [];
try {
  allProjects = await listProjects(env.DB, { publishedOnly: true, limit: 12 });
} catch {
  /* DB not ready */
}

const siteAssets = await getSiteAssets(env.DB);

// Select Drone as hero project or fallback to first
const heroProject = allProjects.find((p) => p.slug === 'arduino-drone') || allProjects[0];

// Select up to 4 featured packs for grid
const featuredPacks = allProjects.filter((p) => p.slug !== heroProject?.slug).slice(0, 4);
if (featuredPacks.length < 4 && heroProject) {
  featuredPacks.unshift(heroProject);
}
const displayPacks = featuredPacks.slice(0, 4);

const scImgs = siteAssets.channel_showcase?.images || [];
const mosaicCovers = [
  scImgs[0]?.url || displayPacks[0]?.cover_image || '/covers/esp32-weather.png',
  scImgs[1]?.url || displayPacks[1]?.cover_image || '/covers/line-robot.png',
  scImgs[2]?.url || displayPacks[2]?.cover_image || '/covers/ai-camera.png',
];
const mosaicAlts = [
  scImgs[0]?.alt || siteAssets.channel_showcase?.alt || displayPacks[0]?.title || 'ESP32 Weather Station',
  scImgs[1]?.alt || siteAssets.channel_showcase?.alt || displayPacks[1]?.title || 'Line Following Robot',
  scImgs[2]?.alt || siteAssets.channel_showcase?.alt || displayPacks[2]?.title || 'AI Camera System',
];
const mosaicSrcSets = [
  buildSrcSet(scImgs[0] || { url: '' }),
  buildSrcSet(scImgs[1] || { url: '' }),
  buildSrcSet(scImgs[2] || { url: '' }),
];

const makerPhotoUrl = siteAssets.maker_photo?.url || PROFILE.photo || '/brand/profile.jpg';
const makerPhotoAlt = siteAssets.maker_photo?.alt || PROFILE.name;
const makerPhotoSrcSet = buildSrcSet(siteAssets.maker_photo || { url: '' });

const ytLink = siteAssets.social_links?.youtube !== undefined ? siteAssets.social_links.youtube : SITE.socials.youtube;
const igLink = siteAssets.social_links?.instagram !== undefined ? siteAssets.social_links.instagram : SITE.socials.instagram;
const ghLink = siteAssets.social_links?.github !== undefined ? siteAssets.social_links.github : SITE.socials.github;
const liLink = siteAssets.social_links?.linkedin !== undefined ? siteAssets.social_links.linkedin : SITE.socials.linkedin;
const showIcons = siteAssets.social_links?.show_icons !== false;

const makerSocials = showIcons
  ? [
      { label: 'YouTube', href: ytLink, icon: 'youtube' },
      { label: 'Instagram', href: igLink, icon: 'instagram' },
      { label: 'GitHub', href: ghLink, icon: 'github' },
      { label: 'LinkedIn', href: liLink, icon: 'linkedin' },
    ].filter((s) => s.href && s.href.trim())
  : [];

const rawCategories = Array.from(new Set(allProjects.map((p) => p.category).filter(Boolean)));
const categories = ['All', ...rawCategories];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.description,
  url: Astro.site?.toString() || 'https://www.technicaltriveni.me',
  sameAs: [ytLink, igLink, ghLink, liLink].filter(Boolean),
};
---

<Base jsonLd={jsonLd}>
  <!-- =========================================================================
       DESKTOP HOMEPAGE (>= 769px)
       Matches media_1791937885605_5f77abfa.png
       ========================================================================= -->
  <div class="desktop-home-only">
    <!-- HERO SECTION -->
    <section class="home-hero">
      <div class="container home-hero__grid">
        <!-- Left Column -->
        <div class="home-hero__copy">
          <span class="home-hero__pill">Electronics, Software, AI</span>
          <h1 class="home-hero__title">
            Engineering project packs you can <span class="text-red">actually build.</span>
          </h1>
          <p class="home-hero__lead">
            Schematics, source code, 3D files and verified parts lists, everything you need to go from watching a video to holding a working build.
          </p>
          <div class="home-hero__buttons">
            <a href="/projects" class="btn btn-primary btn-hero">Browse packs</a>
            <a href="/how-it-works" class="btn btn-secondary btn-hero">How it works</a>
          </div>

          <div class="home-hero__proof-row">
            <div class="proof-tick">
              <Icon name="check-circle" size={16} />
              <span>100% hardware tested</span>
            </div>
            <div class="proof-tick">
              <Icon name="check-circle" size={16} />
              <span>Build video for every pack</span>
            </div>
            <div class="proof-tick">
              <Icon name="check-circle" size={16} />
              <span>Instant download</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Featured Pack Card -->
        {heroProject && (
          <div class="home-hero__card-col">
            <div class="hero-pack-wrap">
              <ProjectCard project={heroProject} priority={true} />
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- FEATURED PACKS -->
    {displayPacks.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="featured-head-row">
            <h2 class="section-heading">Featured packs</h2>
            <div class="featured-nav-right">
              <div class="category-chips">
                {categories.map((c, i) => (
                  <a
                    href={c === 'All' ? '/projects' : `/projects?cat=${encodeURIComponent(c)}`}
                    class:list={['cat-chip', { 'is-active': i === 0 }]}
                  >
                    {c}
                  </a>
                ))}
              </div>
              <a href="/projects" class="view-all-link">
                View all {allProjects.length} packs
              </a>
            </div>
          </div>

          <div class="packs-grid-4">
            {displayPacks.map((p) => (
              <ProjectCard project={p} priority={true} />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- EVERY PACK INCLUDES -->
    <section class="section">
      <div class="container">
        <h2 class="section-heading" style="margin-bottom: 24px;">Every pack includes</h2>
        <div class="includes-tiles-row">
          <div class="include-tile">
            <div class="include-tile__icon"><Icon name="code" size={20} /></div>
            <h3 class="include-tile__title">Tested source code</h3>
            <p class="include-tile__desc">Clean, commented firmware and sketches ready to flash.</p>
          </div>
          <div class="include-tile">
            <div class="include-tile__icon"><Icon name="schematic" size={20} /></div>
            <h3 class="include-tile__title">Wiring and schematics</h3>
            <p class="include-tile__desc">Clear circuit diagrams and pin tables, so you never guess.</p>
          </div>
          <div class="include-tile">
            <div class="include-tile__icon"><Icon name="cart" size={20} /></div>
            <h3 class="include-tile__title">Verified parts list</h3>
            <p class="include-tile__desc">Exact component specifications with direct buy links.</p>
          </div>
          <div class="include-tile">
            <div class="include-tile__icon"><Icon name="play" size={20} /></div>
            <h3 class="include-tile__title">Full build videos</h3>
            <p class="include-tile__desc">Watch the physical bring-up on YouTube, step by step.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- DARK CHANNEL BAND -->
    <section class="section">
      <div class="container">
        <div class="channel-band">
          <div class="channel-band__copy">
            <h2 class="channel-band__title">Watch every build before you buy.</h2>
            <p class="channel-band__desc">
              Every project is documented end to end on YouTube, so you can watch the physical prototype come to life before downloading the pack.
            </p>
            <a href={ytLink || '#'} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-channel">
              <Icon name="play" size={16} /> Visit channel
            </a>
          </div>
          <div class="channel-band__media">
            <div class="band-covers-collage">
              <img
                src={mosaicCovers[0]}
                srcset={mosaicSrcSets[0] || undefined}
                sizes="(max-width: 768px) 100vw, 500px"
                alt={mosaicAlts[0]}
                class="collage-cover collage-cover--1"
                loading="lazy"
                width="1600"
                height="900"
                onerror="this.onerror=null;this.src='/covers/esp32-weather.png';"
              />
              <img
                src={mosaicCovers[1]}
                srcset={mosaicSrcSets[1] || undefined}
                sizes="(max-width: 768px) 100vw, 500px"
                alt={mosaicAlts[1]}
                class="collage-cover collage-cover--2"
                loading="lazy"
                width="1600"
                height="900"
                onerror="this.onerror=null;this.src='/covers/line-robot.png';"
              />
              <img
                src={mosaicCovers[2]}
                srcset={mosaicSrcSets[2] || undefined}
                sizes="(max-width: 768px) 100vw, 500px"
                alt={mosaicAlts[2]}
                class="collage-cover collage-cover--3"
                loading="lazy"
                width="1600"
                height="900"
                onerror="this.onerror=null;this.src='/covers/ai-camera.png';"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MEET THE MAKER -->
    <section class="section maker-section">
      <div class="container maker-grid">
        <div class="maker-photo-wrap">
          <img
            src={makerPhotoUrl}
            srcset={makerPhotoSrcSet || undefined}
            sizes="(max-width: 768px) 100vw, 480px"
            alt={makerPhotoAlt}
            class="maker-photo"
            width={siteAssets.maker_photo?.width || 480}
            height={siteAssets.maker_photo?.height || 600}
            loading="lazy"
            onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
          />
          <div class="maker-photo-fallback" style="display: none;" aria-hidden="true">
            <span>TNP</span>
          </div>
        </div>
        <div class="maker-info">
          <span class="maker-eyebrow">Meet the maker</span>
          <h2 class="maker-title">{PROFILE.name}</h2>
          <p class="maker-bio">
            I'm a B.Tech ECE (VLSI) student at NIT Patna. Every electronics, software and AI project on Technical Triveni is built and tested by me. YouTube shows the highlight reel; this is where you get the complete verified code, schematics and parts lists to actually finish the build.
          </p>
          <div class="maker-socials">
            {makerSocials.map((s) => (
              <a href={s.href} class="maker-social-btn" target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                <Icon name={s.icon} size={18} />
              </a>
            ))}
          </div>
          <a href="/about" class="maker-link">Read more about Triveni &rarr;</a>
        </div>
      </div>
    </section>
  </div>

  <!-- =========================================================================
       MOBILE HOMEPAGE (<= 768px)
       ========================================================================= -->
  <div class="m-home-only">
    <!-- Short Hero -->
    <section class="m-hero">
      <h1 class="m-hero__title">
        Engineering project packs you can <span class="text-red">actually build.</span>
      </h1>
      <p class="m-hero__lead">
        Schematics, source code, 3D files, and verified parts lists, everything you need to go from watching a video to holding a working build.
      </p>
      <div class="m-hero__buttons">
        <a href="/projects" class="m-hero__btn-primary">Browse packs</a>
        <a href="/how-it-works" class="m-hero__btn-secondary">How it works</a>
      </div>
    </section>

    <!-- Category Chips Track -->
    <nav class="m-chips-track" aria-label="Project categories">
      {categories.map((c, i) => (
        <a
          href={c === 'All' ? '/projects' : `/projects?cat=${encodeURIComponent(c)}`}
          class:list={['m-chip-pill', { 'is-active': i === 0 }]}
        >
          {c}
        </a>
      ))}
    </nav>

    <!-- Featured Packs Carousel -->
    {allProjects.length > 0 && (
      <section class="m-section">
        <div class="m-section-head">
          <h2 class="m-section-title">Featured packs</h2>
          <a href="/projects" class="m-section-viewall">
            View all {allProjects.length}
          </a>
        </div>
        <div class="m-carousel">
          {allProjects.map((p) => (
            <div class="m-carousel-card-wrap">
              <ProjectCard project={p} />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Every Pack Includes (2x2 Grid) -->
    <section class="m-section">
      <div class="m-section-head">
        <h2 class="m-section-title">Every pack includes</h2>
      </div>
      <div class="m-includes-grid">
        <div class="m-include-tile">
          <span class="m-include-tile__icon"><Icon name="code" size={22} /></span>
          <span class="m-include-tile__text">Tested source code</span>
        </div>
        <div class="m-include-tile">
          <span class="m-include-tile__icon"><Icon name="schematic" size={22} /></span>
          <span class="m-include-tile__text">Wiring and schematics</span>
        </div>
        <div class="m-include-tile">
          <span class="m-include-tile__icon"><Icon name="cart" size={22} /></span>
          <span class="m-include-tile__text">Verified parts list</span>
        </div>
        <div class="m-include-tile">
          <span class="m-include-tile__icon"><Icon name="play" size={22} /></span>
          <span class="m-include-tile__text">Full build videos</span>
        </div>
      </div>
    </section>

    <!-- Dark Channel Card -->
    <section class="m-section">
      <div class="m-channel-box">
        <h3 class="m-channel-box__title">Watch every build before you buy.</h3>
        <p class="m-channel-box__desc">
          Every project is documented end to end on YouTube, so you can watch the physical prototype come to life before downloading the pack.
        </p>
        <a href={ytLink || '#'} target="_blank" rel="noopener noreferrer" class="m-channel-box__btn">
          Visit channel
        </a>
      </div>
    </section>

    <!-- Creator Row -->
    <section class="m-section">
      <div class="m-creator-row">
        <img
          src={makerPhotoUrl}
          srcset={makerPhotoSrcSet || undefined}
          alt={makerPhotoAlt}
          class="m-creator-avatar"
          width="60"
          height="60"
          loading="lazy"
          onerror="this.onerror=null;this.src='/brand/profile.jpg';"
        />
        <div class="m-creator-info">
          <strong class="m-creator-name">{PROFILE.name}</strong>
          <p class="m-creator-bio">
            B.Tech ECE (VLSI) student at NIT Patna. Every pack is built and tested by me.
          </p>
          <a href="/about" class="m-creator-link">Read more about Triveni</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Visibility toggles */
  .m-home-only {
    display: none;
  }
  .desktop-home-only {
    display: block;
  }
  @media (max-width: 768px) {
    .desktop-home-only {
      display: none;
    }
    .m-home-only {
      display: block;
    }
  }

  /* =========================================================================
     DESKTOP HERO STYLES (>= 769px)
     ========================================================================= */
  .home-hero {
    padding-top: 72px;
    padding-bottom: 72px;
    background: #FFFFFF;
  }
  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 56px;
    align-items: center;
  }
  .home-hero__copy {
    display: flex;
    flex-direction: column;
  }
  .home-hero__pill {
    display: inline-flex;
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 999px;
    background: #F4F5F7;
    border: 1px solid var(--line);
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .home-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 2rem + 2vw, 3.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 20px 0;
  }
  .text-red {
    color: var(--red);
  }
  .home-hero__lead {
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 52ch;
    margin: 0 0 32px 0;
  }
  .home-hero__buttons {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 36px;
  }
  .btn-hero {
    height: 52px;
    padding: 0 28px;
    font-size: 16px;
    font-weight: 600;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .home-hero__proof-row {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .proof-tick {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 550;
    color: var(--ink);
  }
  .proof-tick svg {
    color: var(--red);
  }

  .home-hero__card-col {
    display: flex;
    justify-content: flex-end;
  }
  .hero-pack-wrap {
    width: 100%;
    max-width: 440px;
  }

  /* Featured Packs Desktop */
  .featured-head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }
  .featured-nav-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .category-chips {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cat-chip {
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--muted);
    background: #FFFFFF;
    border: 1px solid var(--line);
    text-decoration: none;
    transition: all 150ms ease;
  }
  .cat-chip:hover {
    color: var(--ink);
  }
  .cat-chip.is-active {
    background: var(--ink);
    color: #FFFFFF;
    border-color: var(--ink);
  }
  .view-all-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--red);
    text-decoration: none;
  }

  .packs-grid-4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 1180px) and (min-width: 769px) {
    .packs-grid-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Every pack includes Desktop */
  .includes-tiles-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .include-tile {
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .include-tile__icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #FDE9EA;
    color: var(--red);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }
  .include-tile__title {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }
  .include-tile__desc {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
  }

  /* Dark Channel Band Desktop */
  .channel-band {
    background: var(--dark);
    border-radius: 24px;
    padding: 48px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    color: #FFFFFF;
  }
  .channel-band__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .channel-band__title {
    font-size: 32px;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.2;
    margin: 0;
  }
  .channel-band__desc {
    font-size: 16px;
    color: #A3AAB8;
    line-height: 1.6;
    margin: 0;
  }
  .btn-channel {
    align-self: flex-start;
    height: 48px;
    padding: 0 24px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .channel-band__media {
    min-width: 0;
    height: 316px;
    overflow: hidden;
  }
  .band-covers-collage {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    grid-template-rows: 152px 152px;
    gap: 12px;
    height: 316px;
    min-width: 0;
  }
  .collage-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: block;
  }
  .collage-cover--1 {
    grid-row: 1 / 3;
    grid-column: 1 / 2;
  }
  .collage-cover--2 {
    grid-row: 1 / 2;
    grid-column: 2 / 3;
  }
  .collage-cover--3 {
    grid-row: 2 / 3;
    grid-column: 2 / 3;
  }

  /* Meet the Maker Desktop */
  .maker-section {
    padding-top: clamp(64px, 7vw, 96px);
    padding-bottom: clamp(72px, 8vw, 112px);
    background: #FFFFFF;
  }
  .maker-grid {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .maker-photo-wrap {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--surface-2);
    border: 1px solid var(--line);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.07);
    max-width: 360px;
    width: 100%;
  }
  .maker-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }
  .maker-photo-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--dark) 0%, #2A303C 100%);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-weight: 700;
    font-family: var(--font-display);
  }
  .maker-info {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .maker-eyebrow {
    font-size: 13px;
    font-weight: 700;
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .maker-title {
    font-size: clamp(28px, 3.2vw, 36px);
    font-weight: 700;
    color: var(--ink);
    margin: 0;
    line-height: 1.15;
  }
  .maker-bio {
    font-size: 16px;
