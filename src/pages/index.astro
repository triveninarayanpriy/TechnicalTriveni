---
import Base from '../layouts/Base.astro';
import { SITE, PROFILE } from '../lib/site';
import { listProjects, type Project } from '../lib/db';
import { youtubeId } from '../lib/format';
import { env } from 'cloudflare:workers';
import { getSiteAssets } from '../lib/site-assets';
import { getAboutPageData, getHomePageData } from '../lib/site-content';

// Load live admin settings & content
const homeData = await getHomePageData(env.DB);
const aboutData = await getAboutPageData(env.DB);
const siteAssets = await getSiteAssets(env.DB);

// Fetch published projects
let publishedProjects: Project[] = [];
try {
  publishedProjects = await listProjects(env.DB, { publishedOnly: true, limit: 50 });
} catch {
  /* DB not ready */
}

const totalProjectsCount = publishedProjects.length || 5;

// Hero Featured Pack: chosen in admin, default newest paid pack
let heroPack: Project | undefined;
if (homeData.hero.featured_pack_slug) {
  heroPack = publishedProjects.find((p) => p.slug === homeData.hero.featured_pack_slug);
}
if (!heroPack) {
  heroPack = publishedProjects.find((p) => (p.price_inr ?? 0) > 0 && p.combo_enabled !== 0);
}
if (!heroPack) {
  heroPack = publishedProjects[0];
}

// 4 Featured Projects for the grid
let featuredList: Project[] = [];
if (homeData.featured_projects.mode === 'manual' && homeData.featured_projects.project_slugs?.length > 0) {
  featuredList = homeData.featured_projects.project_slugs
    .map((slug) => publishedProjects.find((p) => p.slug === slug))
    .filter(Boolean) as Project[];
}

if (featuredList.length < 4) {
  // Add newest published packs that are not the hero pack
  const pool = publishedProjects.filter((p) => p.slug !== heroPack?.slug);
  for (const p of pool) {
    if (featuredList.length >= 4) break;
    if (!featuredList.some((item) => item.slug === p.slug)) {
      featuredList.push(p);
    }
  }
  // If still under 4, add any remaining
  for (const p of publishedProjects) {
    if (featuredList.length >= 4) break;
    if (!featuredList.some((item) => item.slug === p.slug)) {
      featuredList.push(p);
    }
  }
}

// Free packs for "Free to download" section
const freePacks = publishedProjects
  .filter((p) => (p.price_inr ?? 0) <= 0 || p.combo_enabled === 0)
  .slice(0, 3);

// 3 Featured Videos
const fallbackVideoCovers = [
  '/brand/home-v2/f391bdb09af830810fae62a31b3665c9.jpg',
  '/brand/home-v2/abb4db3ba33b53acb13ec170bd64ff5d.jpg',
  '/brand/home-v2/49ce8935ab9c488f44385d3de41d4c70.jpg',
];

const resolvedVideos = homeData.featured_videos.map((v, i) => {
  const vId = youtubeId(v.url);
  const thumb = vId ? `https://img.youtube.com/vi/${vId}/hqdefault.jpg` : fallbackVideoCovers[i % 3];
  return {
    title: v.title || `Featured Video ${i + 1}`,
    url: v.url || 'https://youtube.com/@TechnicalTriveni',
    thumb,
  };
});

// Helper for Include Chips on cards
function getProjectChips(p: Project) {
  const chips: { label: string; isVideo?: boolean }[] = [];
  const kinds = (p.file_kinds || '').toLowerCase();
  const slug = p.slug.toLowerCase();

  if (kinds.includes('code') || p.code_repo_url || slug.includes('drone') || slug.includes('relay') || slug.includes('line')) {
    chips.push({ label: 'Code' });
  }
  if (kinds.includes('schematic') || kinds.includes('circuit') || slug.includes('relay')) {
    chips.push({ label: 'Schematic' });
  }
  if (kinds.includes('pdf') || kinds.includes('doc') || slug.includes('line') || slug.includes('components') || slug.includes('tools')) {
    chips.push({ label: 'PDF' });
  }
  if (p.video_url || slug.includes('drone') || slug.includes('relay') || slug.includes('components')) {
    chips.push({ label: 'Video', isVideo: true });
  }
  if (chips.length === 0) {
    chips.push({ label: 'Code' });
    if (p.video_url) chips.push({ label: 'Video', isVideo: true });
  }
  return chips.slice(0, 3);
}

// Maker Info from About Hero
const makerName = aboutData.hero.name || PROFILE.name;
const makerCreds = aboutData.hero.credentials?.length ? aboutData.hero.credentials : ['NIT Patna, ECE (VLSI)', 'Manager, Innovation Hub'];
const makerBio = "Every project here is built and tested on my own workbench. YouTube shows the high-light reel; this is where you get the complete verified code, schematics, and parts lists to finish the build.";
const makerPhoto = siteAssets.maker_photo?.url || '/brand/home-v2/1e2ad315960dc87dac027605d2efdff3.jpg';

// Social Links
const ytLink = siteAssets.social_links?.youtube !== undefined ? siteAssets.social_links.youtube : SITE.socials.youtube;
const igLink = siteAssets.social_links?.instagram !== undefined ? siteAssets.social_links.instagram : SITE.socials.instagram;
const ghLink = siteAssets.social_links?.github !== undefined ? siteAssets.social_links.github : SITE.socials.github;
const liLink = siteAssets.social_links?.linkedin !== undefined ? siteAssets.social_links.linkedin : SITE.socials.linkedin;

const socials = [
  { label: 'YouTube', href: ytLink, icon: 'youtube' },
  { label: 'Instagram', href: igLink, icon: 'instagram' },
  { label: 'GitHub', href: ghLink, icon: 'github' },
  { label: 'LinkedIn', href: liLink, icon: 'linkedin' },
].filter((s) => s.href && s.href.trim());

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.description,
  url: Astro.site?.toString() || 'https://www.technicaltriveni.me',
  sameAs: socials.map((s) => s.href),
};
---

<Base
  title={`${SITE.name} — Engineering Project Packs You Can Actually Build`}
  description={homeData.hero.subline}
  jsonLd={jsonLd}
>
  <div class="home-page">
    <!-- =========================================================================
         1. HERO SECTION
         ========================================================================= -->
    <section class="home-w home-hero-section">
      <div class="home-hero-text">
        <span class="home-pill">{homeData.hero.eyebrow}</span>
        <h1 class="home-hero-headline" set:html={homeData.hero.headline}></h1>
        <p class="home-hero-subline">{homeData.hero.subline}</p>

        <div class="home-hero-buttons">
          <a href={homeData.hero.btn1_url || '/projects'} class="home-btn home-btn-red">
            {homeData.hero.btn1_text || 'Browse all projects'}
          </a>
          <a href={homeData.hero.btn2_url || '/projects?price=free'} class="home-btn home-btn-outline">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="home-btn-svg">
              <path d="M12 4v11M7 11l5 5 5-5M5 20h14"></path>
            </svg>
            <span class="home-btn-free-desktop">{homeData.hero.btn2_text || 'Free downloads'}</span>
            <span class="home-btn-free-mobile">Free</span>
          </a>
        </div>

        <div class="home-proof-ticks">
          {homeData.hero.proof_ticks.map((tick) => (
            <span class="home-proof-item">
              <span class="home-proof-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="proof-svg">
                  <path d="M12 3a9 9 0 100 18 9 9 0 000-18zM8 12l3 3 5-6"></path>
                </svg>
              </span>
              <span>{tick}</span>
            </span>
          ))}
        </div>
      </div>

      <!-- Featured Pack Card (Chosen in Admin, default newest paid pack) -->
      {heroPack && (
        <article class="home-card home-hero-pack-card">
          <a href={`/projects/${heroPack.slug}`} class="pack-card-media-link">
            <img
              src={heroPack.cover_image || '/brand/home-v2/abb4db3ba33b53acb13ec170bd64ff5d.jpg'}
              alt={heroPack.title}
              class="pack-card-img"
              loading="eager"
              fetchpriority="high"
            />
          </a>
          <div class="pack-card-body">
            <div class="pack-card-cat">{heroPack.category || 'Electronics'}</div>
            <h3 class="pack-card-title">
              <a href={`/projects/${heroPack.slug}`}>{heroPack.title}</a>
            </h3>
            <div class="pack-card-meta">
              <span class="pack-card-meta-item">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="pack-meta-svg">
                  <path d="M5 20v-5M12 20V10M19 20V4"></path>
                </svg>
                {heroPack.difficulty || 'Advanced'}
              </span>
              <span class="pack-card-meta-item">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="pack-meta-svg">
                  <path d="M12 7v5l3 2M12 3a9 9 0 100 18 9 9 0 000-18z"></path>
                </svg>
                {heroPack.build_time || '5 hours'}
              </span>
            </div>
            <div class="pack-card-chips">
              {getProjectChips(heroPack).map((chip) => (
                <span class:list={['home-tg', chip.isVideo && 'home-tg--v']}>
                  {chip.label === 'Code' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="tg-svg">
                      <path d="M8 8l-4 4 4 4M16 8l4 4-4 4"></path>
                    </svg>
                  )}
                  {chip.label === 'Schematic' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="tg-svg">
                      <path d="M4 6h5v5H4zM15 13h5v5h-5zM9 8h4a2 2 0 012 2v3"></path>
                    </svg>
                  )}
                  {chip.label === 'PDF' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="tg-svg">
                      <path d="M7 3h7l5 5v13H7zM14 3v5h5"></path>
                    </svg>
                  )}
                  {chip.label === 'Video' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="tg-svg">
                      <path d="M7 4l13 8-13 8z"></path>
                    </svg>
                  )}
                  {chip.label}
                </span>
              ))}
            </div>
            <div class="pack-card-footer">
              <span class="pack-card-price">
                {(heroPack.price_inr ?? 0) > 0 && heroPack.combo_enabled !== 0 ? (
                  `₹${heroPack.price_inr}`
                ) : (
                  <span class="price-free">Free</span>
                )}
              </span>
              <a
                href={`/projects/${heroPack.slug}`}
                class:list={['home-btn', 'home-btn-sm', (heroPack.price_inr ?? 0) > 0 ? 'home-btn-red' : 'home-btn-outline']}
              >
                {(heroPack.price_inr ?? 0) > 0 ? 'View pack' : 'Get free'}
              </a>
            </div>
          </div>
        </article>
      )}
    </section>

    <!-- =========================================================================
         2. START HERE (THREE PATH CARDS)
         ========================================================================= -->
    <section class="home-w home-start-here-section">
      <!-- Desktop: 3 Grid Cards -->
      <div class="home-start-grid-desktop">
        <a href="/projects?price=free" class="home-card start-card">
          <div class="start-card-icon-box">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="start-icon-svg">
              <path d="M12 4v11M7 11l5 5 5-5M5 20h14"></path>
            </svg>
          </div>
          <h3 class="start-card-title">Free downloads</h3>
          <p class="start-card-desc">Starter projects and reference sheets. No signup and no email.</p>
          <span class="start-card-link">
            See free downloads
            <svg viewBox="0 0 24 24" aria-hidden="true" class="arrow-svg"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </span>
        </a>

        <a href="/projects" class="home-card start-card">
          <div class="start-card-icon-box">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="start-icon-svg">
              <path d="M7 7h10v10H7zM9 3v4M15 3v4M9 17v4M15 17v4M3 9h4M3 15h4M17 9h4M17 15h4"></path>
            </svg>
          </div>
          <h3 class="start-card-title">Project packs</h3>
          <p class="start-card-desc">Code, schematics, wiring tables and parts links for each build.</p>
          <span class="start-card-link">
            Browse packs
            <svg viewBox="0 0 24 24" aria-hidden="true" class="arrow-svg"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </span>
        </a>

        <a href={ytLink || 'https://youtube.com/@TechnicalTriveni'} target="_blank" rel="noopener noreferrer" class="home-card start-card">
          <div class="start-card-icon-box">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="start-icon-svg">
              <path d="M7 4l13 8-13 8z"></path>
            </svg>
          </div>
          <h3 class="start-card-title">Watch the builds</h3>
          <p class="start-card-desc">Every project is documented end to end on YouTube.</p>
          <span class="start-card-link">
            Open the channel
            <svg viewBox="0 0 24 24" aria-hidden="true" class="arrow-svg"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </span>
        </a>
      </div>

      <!-- Mobile: 3 Stacked Cards with Chevron -->
      <div class="home-start-list-mobile">
        <a href="/projects?price=free" class="home-card start-card-m">
          <div class="start-card-icon-box">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="start-icon-svg">
              <path d="M12 4v11M7 11l5 5 5-5M5 20h14"></path>
            </svg>
          </div>
          <div class="start-card-m-text">
            <b>Free downloads</b>
            <div class="start-card-m-sub">No signup, no email</div>
          </div>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="chevron-svg"><path d="M9 5l7 7-7 7"></path></svg>
        </a>

        <a href="/projects" class="home-card start-card-m">
          <div class="start-card-icon-box">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="start-icon-svg">
              <path d="M7 7h10v10H7zM9 3v4M15 3v4M9 17v4M15 17v4M3 9h4M3 15h4M17 9h4M17 15h4"></path>
            </svg>
          </div>
          <div class="start-card-m-text">
            <b>Project packs</b>
            <div class="start-card-m-sub">Code, wiring, parts links</div>
          </div>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="chevron-svg"><path d="M9 5l7 7-7 7"></path></svg>
        </a>

        <a href={ytLink || 'https://youtube.com/@TechnicalTriveni'} target="_blank" rel="noopener noreferrer" class="home-card start-card-m">
          <div class="start-card-icon-box">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="start-icon-svg">
              <path d="M7 4l13 8-13 8z"></path>
            </svg>
          </div>
          <div class="start-card-m-text">
            <b>Watch the builds</b>
            <div class="start-card-m-sub">Every project on YouTube</div>
          </div>
          <svg viewBox="0 0 24 24" aria-hidden="true" class="chevron-svg"><path d="M9 5l7 7-7 7"></path></svg>
        </a>
      </div>
    </section>

    <!-- =========================================================================
         3. FEATURED PROJECTS (TABS: ALL / FREE / PAID, 4 PACK CARDS)
         ========================================================================= -->
    <section class="home-w home-featured-section">
      <div class="home-featured-header">
        <h2 class="home-section-title">Featured projects</h2>

        <div class="home-featured-controls">
          <div class="home-filter-tabs">
            <button type="button" class="home-tab-btn on" data-home-tab="all">All</button>
            <button type="button" class="home-tab-btn" data-home-tab="free">Free</button>
            <button type="button" class="home-tab-btn" data-home-tab="paid">Paid</button>
          </div>
          <a href="/projects" class="home-link-red home-view-all-link">
            View all {totalProjectsCount} projects
          </a>
        </div>
      </div>

      <!-- 4 Pack Cards Container (Desktop Grid / Mobile Horizontal Scroll-Snap Carousel) -->
      <div class="home-pack-cards-container" id="featured-pack-container">
        {featuredList.map((p) => {
          const isPaid = (p.price_inr ?? 0) > 0 && p.combo_enabled !== 0;
          const priceType = isPaid ? 'paid' : 'free';
          const chips = getProjectChips(p);

          return (
            <article class="home-card pack-card-item" data-price-type={priceType}>
              <a href={`/projects/${p.slug}`} class="pack-card-media-link">
                <img
                  src={p.cover_image || '/covers/arduino-drone.png'}
                  alt={p.title}
                  class="pack-card-img"
                  loading="lazy"
                />
              </a>
              <div class="pack-card-body">
                <div class="pack-card-cat">{p.category || 'Electronics'}</div>
                <h3 class="pack-card-title">
                  <a href={`/projects/${p.slug}`}>{p.title}</a>
                </h3>
                <div class="pack-card-meta">
                  <span class="pack-card-meta-item">
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="pack-meta-svg">
                      <path d="M5 20v-5M12 20V10M19 20V4"></path>
                    </svg>
                    {p.difficulty || 'Intermediate'}
                  </span>
                  <span class="pack-card-meta-item">
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="pack-meta-svg">
                      <path d="M12 7v5l3 2M12 3a9 9 0 100 18 9 9 0 000-18z"></path>
                    </svg>
                    {p.build_time || '2-3 hours'}
                  </span>
                </div>
                <div class="pack-card-chips">
                  {chips.map((chip) => (
                    <span class:list={['home-tg', chip.isVideo && 'home-tg--v']}>
                      {chip.label === 'Code' && (
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="tg-svg">
                          <path d="M8 8l-4 4 4 4M16 8l4 4-4 4"></path>
                        </svg>
                      )}
                      {chip.label === 'Schematic' && (
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="tg-svg">
                          <path d="M4 6h5v5H4zM15 13h5v5h-5zM9 8h4a2 2 0 012 2v3"></path>
                        </svg>
                      )}
                      {chip.label === 'PDF' && (
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="tg-svg">
                          <path d="M7 3h7l5 5v13H7zM14 3v5h5"></path>
                        </svg>
                      )}
                      {chip.label === 'Video' && (
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="tg-svg">
                          <path d="M7 4l13 8-13 8z"></path>
                        </svg>
                      )}
                      {chip.label}
                    </span>
                  ))}
                </div>
                <div class="pack-card-footer">
                  <span class="pack-card-price">
                    {isPaid ? (
                      `₹${p.price_inr}`
                    ) : (
                      <span class="price-free">Free</span>
                    )}
                  </span>
                  <a
                    href={`/projects/${p.slug}`}
                    class:list={['home-btn', 'home-btn-sm', isPaid ? 'home-btn-red' : 'home-btn-outline']}
                  >
                    {isPaid ? 'View pack' : 'Get free'}
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- =========================================================================
         4. FREE TO DOWNLOAD (TINTED BAND)
         ========================================================================= -->
    <section class="home-w home-free-band-section">
      <div class="home-free-band-card">
        <div class="home-free-band-left">
          <div class="home-eyebrow">Free to download</div>
          <h2 class="home-free-band-title">Start with something free</h2>
          <p class="home-free-band-desc">
            Reference sheets and starter builds with code and guides. Instant download, no signup, no email.
          </p>
          <a href="/projects?price=free" class="home-link-red home-free-more-link">
            <span>See all free downloads</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="arrow-svg"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>

        <div class="home-free-band-right">
          {freePacks.map((p) => {
            const chips = getProjectChips(p);
            return (
              <div class="free-pack-row">
                <img
                  src={p.cover_image || '/covers/line-robot.png'}
                  alt={p.title}
                  class="free-pack-thumb"
                  loading="lazy"
                />
                <div class="free-pack-info">
                  <div class="free-pack-name">{p.title}</div>
                  <div class="free-pack-chips">
                    {chips.map((chip) => (
                      <span class:list={['home-tg', chip.isVideo && 'home-tg--v']}>
                        {chip.label === 'PDF' && (
                          <svg viewBox="0 0 24 24" aria-hidden="true" class="tg-svg">
                            <path d="M7 3h7l5 5v13H7zM14 3v5h5"></path>
                          </svg>
                        )}
                        {chip.label === 'Code' && (
                          <svg viewBox="0 0 24 24" aria-hidden="true" class="tg-svg">
                            <path d="M8 8l-4 4 4 4M16 8l4 4-4 4"></path>
                          </svg>
                        )}
                        {chip.label === 'Video' && (
                          <svg viewBox="0 0 24 24" aria-hidden="true" class="tg-svg">
                            <path d="M7 4l13 8-13 8z"></path>
                          </svg>
                        )}
                        {chip.label}
                      </span>
                    ))}
                  </div>
                </div>
                <!-- Desktop button -->
                <a href={`/projects/${p.slug}`} class="home-btn home-btn-red free-pack-btn-desktop">
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="home-btn-svg">
                    <path d="M12 4v11M7 11l5 5 5-5M5 20h14"></path>
                  </svg>
                  <span>Download</span>
                </a>
                <!-- Mobile round icon button -->
                <a href={`/projects/${p.slug}`} class="free-pack-btn-mobile" aria-label={`Download ${p.title}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="home-btn-svg">
                    <path d="M12 4v11M7 11l5 5 5-5M5 20h14"></path>
                  </svg>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- =========================================================================
         5. HOW IT WORKS (THREE STEPS & GUIDE LINK)
         ========================================================================= -->
    <section class="home-w home-how-it-works-section">
      <div class="home-section-header">
        <h2 class="home-section-title">How it works</h2>
        <a href="/how-it-works" class="home-link-red">Read the full guide</a>
      </div>

      <!-- Desktop: 3 Columns Grid -->
      <div class="how-grid-desktop">
        <div class="how-step-item">
          <span class="how-step-badge">1</span>
          <div class="how-step-text">
            <h3 class="how-step-title">Pick a project</h3>
            <p class="how-step-desc">Browse free and paid packs. Each page shows exactly what is inside before you download.</p>
          </div>
        </div>

        <div class="how-step-item">
          <span class="how-step-badge">2</span>
          <div class="how-step-text">
            <h3 class="how-step-title">Download instantly</h3>
            <p class="how-step-desc">Free packs download straight away. Paid packs arrive by email right after payment.</p>
          </div>
        </div>

        <div class="how-step-item">
          <span class="how-step-badge">3</span>
          <div class="how-step-text">
            <h3 class="how-step-title">Build with confidence</h3>
            <p class="how-step-desc">Follow the wiring tables and steps, buy parts from the links, and email me if you get stuck.</p>
          </div>
        </div>
      </div>

      <!-- Mobile: Vertical Timeline with Connecting Lines -->
      <div class="how-timeline-mobile">
        <div class="how-timeline-row">
          <div class="how-timeline-left">
            <span class="how-timeline-dot">1</span>
            <span class="how-timeline-line"></span>
