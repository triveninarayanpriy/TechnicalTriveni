---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { SITE, PROFILE } from '../lib/site';
import { listProjects } from '../lib/db';
import { renderMarkdown } from '../lib/format';
import { getEffectiveContent } from '../lib/pages';
import { getSiteAssets, buildSrcSet } from '../lib/site-assets';

const pageData = await getEffectiveContent(env.DB, 'about');
if (pageData.published === 0) return Astro.redirect('/404');

const siteAssets = await getSiteAssets(env.DB);
const profilePhoto = pageData.image_url || siteAssets.maker_photo?.url || '/brand/profile.jpg';
const profileAlt = siteAssets.maker_photo?.alt || PROFILE.name;
const profileSrcSet = buildSrcSet(siteAssets.maker_photo || { url: '' });
const bioHtml = renderMarkdown(pageData.markdown);

// Fetch projects for count and closing card covers
let packCount = 5;
let featuredCovers: string[] = ['/covers/esp32-weather.png', '/covers/line-robot.png', '/covers/ai-camera.png'];
try {
  const allProjects = await listProjects(env.DB, { publishedOnly: true });
  if (allProjects.length > 0) {
    packCount = allProjects.length;
    const covers = allProjects.map((p) => p.cover_image).filter(Boolean) as string[];
    if (covers.length > 0) {
      featuredCovers = covers.slice(0, 3);
    }
  }
} catch {}

const ytLink = siteAssets.social_links?.youtube !== undefined ? siteAssets.social_links.youtube : SITE.socials.youtube;
const igLink = siteAssets.social_links?.instagram !== undefined ? siteAssets.social_links.instagram : SITE.socials.instagram;
const ghLink = siteAssets.social_links?.github !== undefined ? siteAssets.social_links.github : SITE.socials.github;
const liLink = siteAssets.social_links?.linkedin !== undefined ? siteAssets.social_links.linkedin : SITE.socials.linkedin;
const showIcons = siteAssets.social_links?.show_icons !== false;

const socials = showIcons
  ? [
      { label: 'YouTube', href: ytLink, icon: 'youtube' },
      { label: 'Instagram', href: igLink, icon: 'instagram' },
      { label: 'GitHub', href: ghLink, icon: 'github' },
      { label: 'LinkedIn', href: liLink, icon: 'linkedin' },
    ].filter((s) => s.href && s.href.trim())
  : [];

const proofCards = [
  {
    icon: 'check-circle',
    title: 'Hardware verified',
    text: 'Built on a real breadboard or PCB, programmed and bench-tested before any files are released.',
  },
  {
    icon: 'play',
    title: 'Video proof',
    text: 'Every build is demonstrated on YouTube. You see it working before you order parts.',
  },
  {
    icon: 'layers',
    title: 'Complete project packs',
    text: 'Source code, wiring pinouts, a verified parts list with store links, and 3D printable STL files.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PROFILE.name,
  jobTitle: PROFILE.title,
  worksFor: { '@type': 'Organization', name: SITE.name },
  url: Astro.site?.toString(),
  sameAs: socials.map((s) => s.href),
};
---

<Base
  title={pageData?.title || 'About | Technical Triveni'}
  description={`About ${PROFILE.name} — the maker behind Technical Triveni. Real builds tested on the workbench.`}
  jsonLd={jsonLd}
>
  <div class="about-page">
    <!-- HERO: SPLIT MAKER BIO & PHOTO (media_1791937896363_108477b4.png) -->
    <section class="about-hero">
      <div class="container">
        <div class="about-hero-grid">
          <!-- Left: Bio & Stats -->
          <div class="about-bio-col">
            <span class="about-eyebrow">About the maker</span>
            <h1 class="about-title">Real builds. Tested on the workbench.</h1>
            <p class="about-lead">
              {PROFILE.lead || "I'm Triveni, a B.Tech ECE (VLSI) student at NIT Patna. Every electronics, software and AI project on Technical Triveni is built and tested by me."}
            </p>

            <div class="about-stats-row">
              <div class="about-stat-tile">
                <span class="stat-number">100%</span>
                <span class="stat-label">Hardware verified</span>
              </div>
              <div class="about-stat-tile">
                <span class="stat-number">Direct</span>
                <span class="stat-label">Maker support</span>
              </div>
              <div class="about-stat-tile">
                <span class="stat-number">{packCount}</span>
                <span class="stat-label">Project packs</span>
              </div>
            </div>

            <div class="about-socials">
              {socials.map((s) => (
                <a href={s.href} class="about-social-btn" target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                  <Icon name={s.icon} size={18} />
                </a>
              ))}
            </div>
          </div>

          <!-- Right: Portrait Photo -->
          <div class="about-photo-col">
            <div class="about-photo-wrap">
              <img
                src={profilePhoto}
                srcset={profileSrcSet || undefined}
                sizes="(max-width: 768px) 100vw, 480px"
                alt={profileAlt}
                class="about-portrait"
                width={siteAssets.maker_photo?.width || 480}
                height={siteAssets.maker_photo?.height || 560}
                loading="eager"
                onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
              />
              <div class="about-photo-fallback" style="display: none;" aria-hidden="true">
                <span>TNP</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DARK STORY BAND (#111418) -->
    <section class="about-story-section">
      <div class="container">
        <div class="about-story-band">
          {pageData.is_custom ? (
            <div class="about-story-prose prose-dark" set:html={bioHtml} />
          ) : (
            <>
              <div class="story-left">
                <h2 class="story-headline">
                  I was tired of electronics tutorials that don't actually work.
                </h2>
              </div>
              <div class="story-right">
                <p class="story-body">
                  Most guides leave out critical pinouts, skip power decoupling, or share untested code that throws errors the moment you clone it.
                </p>
                <p class="story-body">
                  So there is one promise here: <span class="story-highlight">complete transparency and physical proof</span>.
                </p>
              </div>
            </>
          )}
        </div>
      </div>
    </section>

    <!-- PROOF, NOT PROMISES SECTION -->
    <section class="about-proof-section">
      <div class="container">
        <h2 class="about-sec-heading">Proof, not promises</h2>
        <div class="about-proof-grid">
          {proofCards.map((c) => (
            <div class="about-proof-card">
              <span class="proof-card-icon">
                <Icon name={c.icon} size={20} />
              </span>
              <h3 class="proof-card-title">{c.title}</h3>
              <p class="proof-card-text">{c.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FOLLOW THE BUILDS (4 SOCIAL PILLS) -->
    <section class="about-socials-section">
      <div class="container">
        <h2 class="about-sec-heading">Follow the builds</h2>
        <div class="about-socials-grid">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="social-pill-card">
              <span>{s.label}</span>
              <span class="social-arrow">&gt;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- EXPLORE THE PROJECT PACKS CLOSING CARD -->
    <section class="about-closing-section">
      <div class="container">
        <div class="about-closing-card">
          <div class="closing-text-col">
            <h2 class="closing-title">Explore the project packs</h2>
            <p class="closing-desc">
              From flight controllers to autonomous robotics, full documentation ready for your workbench.
            </p>
            <a href="/projects" class="btn-closing-red">Browse all projects</a>
          </div>

          <div class="closing-covers-col">
            {featuredCovers.map((src, i) => (
              <img
                src={src}
                alt={`Project pack ${i + 1}`}
                class="closing-thumb"
                width="160"
                height="100"
                loading="lazy"
                onerror="this.src='/brand/og-image.png'"
              />
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .about-page {
    background: #FFFFFF;
    color: var(--ink);
  }

  /* Hero Section */
  .about-hero {
    padding: 3rem 0 2.25rem;
  }
  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 3.5rem;
    align-items: center;
  }
  .about-bio-col,
  .about-photo-col {
    min-width: 0;
  }
  @media (max-width: 900px) {
    .about-hero {
      padding: 1.75rem 0 2rem;
    }
    .about-hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
      text-align: center;
    }
    .about-eyebrow {
      margin-inline: auto;
    }
    .about-title {
      font-size: clamp(24px, 5vw, 32px);
      margin: 0 0 0.75rem;
    }
    .about-lead {
      font-size: 0.9375rem;
      line-height: 1.5;
      margin: 0 0 1.25rem;
    }
    .about-stats-row {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
      margin-bottom: 1.25rem;
    }
    .about-stat-tile {
      padding: 0.75rem 0.375rem;
      border-radius: 0.75rem;
    }
    .stat-number {
      font-size: 1rem;
      white-space: nowrap;
      margin-bottom: 0.125rem;
    }
    .stat-label {
      font-size: max(12px, 0.6875rem);
      line-height: 1.2;
    }
    .about-socials {
      justify-content: center;
      gap: 0.625rem;
      margin-top: 0.25rem;
    }
    .about-social-btn {
      width: 2.375rem;
      height: 2.375rem;
    }
    .about-photo-col {
      display: flex;
      justify-content: center;
    }
    .about-photo-wrap {
      max-width: 16.875rem;
      width: 100%;
      margin: 0 auto;
      border-radius: 1.25rem;
      aspect-ratio: 4 / 5;
    }
  }

  .about-eyebrow {
    font-size: max(12px, 0.75rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--red);
    display: block;
    margin-bottom: 0.75rem;
  }
  .about-title {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 1.125rem;
  }
  .about-lead {
    font-size: 1.0313rem;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 1.75rem;
  }

  .about-stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.875rem;
    margin-bottom: 1.5rem;
  }
  .about-stat-tile {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1rem 1.125rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .stat-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }
  .stat-label {
    font-size: max(12px, 0.7813rem);
    font-weight: 500;
    color: var(--muted);
  }

  .about-socials {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .about-social-btn {
    width: 2.625rem;
    height: 2.625rem;
    border-radius: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 180ms ease;
    text-decoration: none;
  }
  .about-social-btn:hover {
    color: var(--red);
    border-color: var(--red);
    background: #FDE9EA;
    transform: translateY(-0.125rem);
  }

  .about-photo-wrap {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--line);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    aspect-ratio: 4 / 5;
  }
  .about-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }
  .about-photo-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--dark) 0%, #2A303C 100%);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    font-weight: 700;
    font-family: var(--font-display);
  }

  /* Dark Story Band */
  .about-story-section {
    padding: 1.25rem 0 3rem;
  }
  .about-story-band {
    background: var(--dark);
    border-radius: 1.5rem;
    padding: 3rem 2.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }
  @media (max-width: 820px) {
    .about-story-section {
      padding: 0.75rem 0 2.25rem;
    }
    .about-story-band {
      grid-template-columns: 1fr;
      padding: 1.75rem 1.25rem;
      gap: 1rem;
      border-radius: 1.125rem;
    }
    .story-headline {
      font-size: 1.25rem;
    }
    .story-body {
      font-size: max(12px, 0.9063rem);
      margin-bottom: 0.75rem;
    }
    .about-story-prose :global(h2) {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }
    .about-story-prose :global(h3) {
      font-size: 1rem;
      margin: 1.25rem 0 0.5rem;
    }
    .about-story-prose :global(p) {
      font-size: max(12px, 0.875rem);
      line-height: 1.55;
      margin-bottom: 0.75rem;
    }
  }
  .story-headline {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    line-height: 1.25;
    color: #FFFFFF;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .story-body {
    font-size: 0.9688rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 1rem;
  }
  .story-body:last-child {
    margin-bottom: 0;
  }
  .about-story-prose {
    grid-column: 1 / -1;
    max-width: 45rem;
  }
  .about-story-prose :global(h2) {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    line-height: 1.25;
    color: #FFFFFF;
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }
  .about-story-prose :global(h3) {
    font-size: clamp(17px, 2.2vw, 22px);
    font-weight: 600;
    color: #FFFFFF;
    margin: 1.5rem 0 0.625rem;
  }
  .about-story-prose :global(p) {
    font-size: 0.9688rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 0.875rem;
  }
  .about-story-prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .about-story-prose :global(strong) {
    color: #FFFFFF;
  }
  .about-story-prose :global(a) {
    color: var(--brand-red, #E11D48);
    text-decoration: underline;
  }
  .story-highlight {
    color: #FFFFFF;
    font-weight: 600;
    border-bottom: 2px solid var(--red);
    padding-bottom: 0.125rem;
  }

  /* Proof Section */
  .about-proof-section {
    padding: 1.25rem 0 3rem;
  }
  .about-sec-heading {
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }
  .about-proof-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 820px) {
    .about-proof-section {
      padding: 0.75rem 0 2rem;
    }
    .about-sec-heading {
      font-size: 1.375rem;
      margin-bottom: 1rem;
      text-align: center;
    }
    .about-proof-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .about-proof-card {
      padding: 1.125rem 1rem;
      border-radius: 1rem;
    }
  }
  .about-proof-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1.125rem;
    padding: 1.5rem 1.25rem;
  }
  .proof-card-icon {
    color: var(--red);
    display: inline-flex;
    margin-bottom: 0.875rem;
  }
  .proof-card-title {
    font-size: 1.0313rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.375rem;
  }
  .proof-card-text {
    font-size: max(12px, 0.875rem);
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
  }

  /* Socials Section */
  .about-socials-section {
    padding: 0 0 3rem;
  }
  .about-socials-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  @media (max-width: 820px) {
    .about-socials-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.625rem;
    }
    .social-pill-card {
      padding: 0.75rem 0.875rem;
      font-size: max(12px, 0.875rem);
      border-radius: 0.75rem;
    }
  }
  .social-pill-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0.875rem;
    padding: 0.875rem 1.125rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--ink);
    font-weight: 600;
    font-size: max(12px, 0.9063rem);
    text-decoration: none;
    transition: all 150ms ease;
  }
  .social-pill-card:hover {
    border-color: var(--ink);
  }
  .social-arrow {
    color: var(--muted);
    font-weight: 700;
  }

  /* Closing Card */
  .about-closing-section {
    padding: 0 0 4rem;
  }
  .about-closing-card {
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    padding: 2.25rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2.25rem;
    flex-wrap: wrap;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }
  @media (max-width: 820px) {
    .about-closing-section {
      padding: 0 0 2.25rem;
    }
    .about-closing-card {
      padding: 1.5rem 1.125rem;
      border-radius: 1.125rem;
      text-align: center;
      gap: 1.25rem;
    }
    .closing-text-col {
      margin-inline: auto;
    }
    .closing-title {
      font-size: 1.25rem;
    }
    .closing-desc {
      font-size: max(12px, 0.875rem);
      margin-bottom: 1.125rem;
    }
    .btn-closing-red {
      width: 100%;
      text-align: center;
      padding: 0.75rem 1.25rem;
    }
    .closing-covers-col {
      justify-content: center;
      gap: 0.5rem;
    }
    .closing-thumb {
      width: 5.5rem;
      height: 3.4375rem;
      border-radius: 0.5rem;
    }
  }
  .closing-text-col {
    max-width: 30rem;
  }
  .closing-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }
  .closing-desc {
    font-size: max(12px, 0.9063rem);
    color: var(--muted);
    margin: 0 0 1.25rem;
    line-height: 1.5;
  }
  .btn-closing-red {
    background: var(--red);
    color: #FFFFFF;
    font-weight: 600;
    font-size: max(12px, 0.9063rem);
    padding: 0.75rem 1.5rem;
    border-radius: 0.75rem;
    text-decoration: none;
    display: inline-block;
  }

  .closing-covers-col {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .closing-thumb {
    width: 8.125rem;
    height: 4.875rem;
    object-fit: cover;
    border-radius: 0.625rem;
    border: 1px solid var(--line);
  }
</style>
