---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { SITE, PROFILE } from '../lib/site';
import { listProjects } from '../lib/db';
import { renderMarkdown } from '../lib/format';
import { getEffectiveContent } from '../lib/pages';
import { getSiteAssets } from '../lib/site-assets';
import { getAboutPageData } from '../lib/site-content';

const pageData = await getEffectiveContent(env.DB, 'about');
if (pageData.published === 0) return Astro.redirect('/404');

const aboutData = await getAboutPageData(env.DB);
const siteAssets = await getSiteAssets(env.DB);

// Fetch projects for live stats and workbench mosaic
let publishedProjects = [];
try {
  publishedProjects = await listProjects(env.DB, { publishedOnly: true, limit: 50 });
} catch {}

const totalProjectsCount = publishedProjects.length || 5;
const freeDownloadsCount = publishedProjects.filter((p) => (p.price_inr ?? 0) <= 0 || p.combo_enabled === 0).length || 3;

// Default workbench items from the design files
const defaultMosaic = [
  {
    title: 'DIY Arduino Drone',
    shortTitle: 'Drone',
    cover: '/brand/about-v2/abb4db3ba33b53acb13ec170bd64ff5d.jpg',
    slug: 'arduino-drone',
  },
  {
    title: 'ESP32 Blynk Smart Relay',
    shortTitle: 'ESP32 relay switch',
    cover: '/brand/about-v2/f391bdb09af830810fae62a31b3665c9.jpg',
    slug: 'esp32-blynk-iot-smart-relay-switch',
  },
  {
    title: 'Line-Following Robot',
    shortTitle: 'Line follower',
    cover: '/brand/about-v2/49ce8935ab9c488f44385d3de41d4c70.jpg',
    slug: 'line-following-robot-arduino-obstacle-gate',
  },
  {
    title: '100+ Electronics Components',
    shortTitle: 'Components',
    cover: '/brand/about-v2/545c85731cd6c2d8dbaa1ebfa768a7da.jpg',
    slug: '100-electronics-components',
  },
];

function resolveShortTitle(title: string, slug: string): string {
  if (slug.includes('drone')) return 'Drone';
  if (slug.includes('relay') || slug.includes('switch') || slug.includes('blynk')) return 'ESP32 relay switch';
  if (slug.includes('line') || slug.includes('obstacle')) return 'Line follower';
  if (slug.includes('100') || slug.includes('component')) return 'Components';
  return title.split(':')[0].split('(')[0].trim();
}

const resolvedWorkbench = [0, 1, 2, 3].map((i) => {
  const customSlug = aboutData.workbench?.project_slugs?.[i];
  if (customSlug) {
    const found = publishedProjects.find((p) => p.slug === customSlug || String(p.id) === customSlug);
    if (found) {
      return {
        title: found.title,
        shortTitle: resolveShortTitle(found.title, found.slug),
        cover: found.cover_image || defaultMosaic[i].cover,
        slug: found.slug,
      };
    }
  }
  return defaultMosaic[i];
});

// Social links - shown ONCE on the page
const ytLink = siteAssets.social_links?.youtube !== undefined ? siteAssets.social_links.youtube : SITE.socials.youtube;
const igLink = siteAssets.social_links?.instagram !== undefined ? siteAssets.social_links.instagram : SITE.socials.instagram;
const ghLink = siteAssets.social_links?.github !== undefined ? siteAssets.social_links.github : SITE.socials.github;
const liLink = siteAssets.social_links?.linkedin !== undefined ? siteAssets.social_links.linkedin : SITE.socials.linkedin;

const socials = [
  { platform: 'YouTube', handle: 'New builds and walkthroughs', url: ytLink, icon: 'youtube' },
  { platform: 'Instagram', handle: 'Reels and behind the scenes', url: igLink, icon: 'instagram' },
  { platform: 'GitHub', handle: 'Source code', url: ghLink, icon: 'github' },
  { platform: 'LinkedIn', handle: 'Updates and projects', url: liLink, icon: 'linkedin' },
].filter((s) => s.url && s.url.trim());

// Maker photo: prioritize the designer photo, or custom upload from admin
const profilePhoto = siteAssets.maker_photo?.url || '/brand/about-v2/1e2ad315960dc87dac027605d2efdff3.jpg';
const profileAlt = siteAssets.maker_photo?.alt || aboutData.hero.name || PROFILE.name;

// Render Story Markdown ONLY (hero headline and intro are kept out of this)
const storyHtml = renderMarkdown(aboutData.story.body_md);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: aboutData.hero.name || PROFILE.name,
  jobTitle: PROFILE.title,
  worksFor: { '@type': 'Organization', name: SITE.name },
  url: Astro.site?.toString() || 'https://www.technicaltriveni.me',
  sameAs: socials.map((s) => s.url),
};
---

<Base
  title={pageData?.title || 'About | Technical Triveni'}
  description={`About ${aboutData.hero.name || PROFILE.name} — the maker behind Technical Triveni. Real builds tested on the workbench.`}
  jsonLd={jsonLd}
>
  <div class="about-page">
    <!-- 1. HERO SECTION -->
    <section class="about-w about-hero-wrap">
      <div class="about-hero-text">
        <div class="about-eyebrow">{aboutData.hero.eyebrow}</div>
        <h1 class="about-hero-headline">{aboutData.hero.headline}</h1>
        <p class="about-hero-intro">{aboutData.hero.intro}</p>

        {aboutData.hero.credentials?.length > 0 && (
          <div class="about-chips-row">
            {aboutData.hero.credentials.map((cred) => (
              <span class="about-pill">{cred}</span>
            ))}
          </div>
        )}

        <div class="about-hero-btns">
          <a href={aboutData.hero.btn1_url || '/projects'} class="about-btn about-btn-red">
            {aboutData.hero.btn1_text || 'Browse projects'}
          </a>
          <a
            href={aboutData.hero.btn2_url || ytLink || 'https://youtube.com/@TechnicalTriveni'}
            target="_blank"
            rel="noopener noreferrer"
            class="about-btn about-btn-outline"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="btn-play-icon">
              <path d="M7 4l13 8-13 8z"></path>
            </svg>
            <span class="btn-yt-text-desktop">{aboutData.hero.btn2_text || 'Watch on YouTube'}</span>
            <span class="btn-yt-text-mobile">YouTube</span>
          </a>
        </div>
      </div>

      <div class="about-hero-photo-col">
        <div class="about-photo-wrap">
          <img
            src={profilePhoto}
            alt={profileAlt}
            width="540"
            height="600"
            class="about-photo-img"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          {aboutData.hero.badge_text && (
            <span class="about-photo-badge">{aboutData.hero.badge_text}</span>
          )}
        </div>
      </div>
    </section>

    <!-- 2. NUMBERS STRIP -->
    <section class="about-w about-numbers-wrap">
      <div class="about-numbers-grid">
        <div class="about-stat-item">
          <div class="about-stat-val">{totalProjectsCount}</div>
          <div class="about-stat-label about-stat-label-desktop">Projects built and documented</div>
          <div class="about-stat-label about-stat-label-mobile">Projects documented</div>
        </div>
        <div class="about-stat-item">
          <div class="about-stat-val">{freeDownloadsCount}</div>
          <div class="about-stat-label about-stat-label-desktop">Free downloads, no signup</div>
          <div class="about-stat-label about-stat-label-mobile">Free downloads</div>
        </div>
        <div class="about-stat-item">
          <div class="about-stat-val">{aboutData.numbers.stat3_val}</div>
          <div class="about-stat-label about-stat-label-desktop">{aboutData.numbers.stat3_label}</div>
          <div class="about-stat-label about-stat-label-mobile">Tested on hardware</div>
        </div>
        <div class="about-stat-item">
          <div class="about-stat-val">{aboutData.numbers.stat4_val}</div>
          <div class="about-stat-label about-stat-label-desktop">{aboutData.numbers.stat4_label}</div>
          <div class="about-stat-label about-stat-label-mobile">Maker answering emails</div>
        </div>
      </div>
    </section>

    <!-- 3. MY STORY -->
    <section class="about-w about-story-wrap">
      <div class="about-story-left">
        <div class="about-eyebrow">{aboutData.story.eyebrow || 'My story'}</div>
        <h2 class="about-story-title">{aboutData.story.heading}</h2>
        {aboutData.story.pull_quote && (
          <div class="about-pull-quote">{aboutData.story.pull_quote}</div>
        )}
      </div>

      <div class="about-story-right">
        <div class="about-story-prose" set:html={storyHtml}></div>
      </div>
    </section>

    <!-- 4. HOW EVERY PACK IS MADE -->
    <section class="about-w about-steps-wrap">
      <div class="about-section-header">
        <h2 class="about-section-h2">How every pack is made</h2>
        <p class="about-section-sub">Nothing is published until it has survived the workbench.</p>
      </div>

      <!-- Desktop 4-card grid -->
      <div class="about-steps-grid-desktop">
        {aboutData.steps.map((st, i) => (
          <div class="about-step-card">
            <div class="about-step-icon-box">
              {i === 0 && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class="step-svg">
                  <path d="M7 7h10v10H7zM9 3v4M15 3v4M9 17v4M15 17v4M3 9h4M3 15h4M17 9h4M17 15h4"></path>
                </svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class="step-svg">
                  <path d="M14 6a4 4 0 004 4l-8 8a2 2 0 01-3-3l8-8a4 4 0 00-1-1z"></path>
                </svg>
              )}
              {i === 2 && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class="step-svg">
                  <path d="M4 5h16v14H4zM8 5v14M16 5v14M4 9h4M4 15h4M16 9h4M16 15h4"></path>
                </svg>
              )}
              {i === 3 && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class="step-svg">
                  <path d="M4 4h6a3 3 0 013 3v13a2 2 0 00-2-2H4zM20 4h-6a3 3 0 00-3 3v13a2 2 0 012-2h7z"></path>
                </svg>
              )}
            </div>
            <div class="about-step-sublabel">Step {i + 1}</div>
            <h3 class="about-step-title">{st.title}</h3>
            <p class="about-step-text">{st.text}</p>
          </div>
        ))}
      </div>

      <!-- Mobile vertical timeline with connecting lines -->
      <div class="about-steps-timeline-mobile">
        {aboutData.steps.map((st, i) => (
          <div class="about-timeline-row">
            <div class="about-timeline-left">
              <span class="about-timeline-dot">{i + 1}</span>
              {i < aboutData.steps.length - 1 && <span class="about-timeline-line"></span>}
            </div>
            <div class="about-timeline-content">
              <h3 class="about-timeline-title">{st.title}</h3>
              <div class="about-timeline-desc">{st.text}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. ON THE WORKBENCH -->
    <section class="about-w about-workbench-wrap">
      <div class="about-workbench-header">
        <div>
          <h2 class="about-section-h2">On the workbench</h2>
          <p class="about-section-sub">A few of the builds behind the packs.</p>
        </div>
        <a href="/projects" class="about-link-red">See all projects</a>
      </div>

      <!-- Desktop 4-tile Asymmetric Mosaic -->
      <div class="about-workbench-mosaic-desktop">
        <a href={`/projects/${resolvedWorkbench[0].slug}`} class="mosaic-tile-hero">
          <img src={resolvedWorkbench[0].cover} alt={resolvedWorkbench[0].title} class="mosaic-img" />
        </a>
        <a href={`/projects/${resolvedWorkbench[1].slug}`} class="mosaic-tile-top-left">
          <img src={resolvedWorkbench[1].cover} alt={resolvedWorkbench[1].title} class="mosaic-img" />
        </a>
        <a href={`/projects/${resolvedWorkbench[2].slug}`} class="mosaic-tile-top-right">
          <img src={resolvedWorkbench[2].cover} alt={resolvedWorkbench[2].title} class="mosaic-img" />
        </a>
        <a href={`/projects/${resolvedWorkbench[3].slug}`} class="mosaic-tile-bottom-wide">
          <img src={resolvedWorkbench[3].cover} alt={resolvedWorkbench[3].title} class="mosaic-img" />
        </a>
      </div>

      <!-- Mobile Horizontal Carousel -->
      <div class="about-workbench-carousel-mobile">
        {resolvedWorkbench.map((item) => (
          <a href={`/projects/${item.slug}`} class="carousel-card-mobile">
            <img src={item.cover} alt={item.title} class="carousel-img-mobile" />
            <div class="carousel-label-mobile">{item.shortTitle}</div>
          </a>
        ))}
      </div>
    </section>

    <!-- 6. WHAT YOU CAN EXPECT -->
    <section class="about-w about-expect-wrap">
      <div class="about-section-header">
        <h2 class="about-section-h2 about-expect-h2-desktop">What you can expect from me</h2>
        <h2 class="about-section-h2 about-expect-h2-mobile">What you can expect</h2>
      </div>

      <div class="about-expect-grid">
        <div class="about-expect-card">
          <div class="about-expect-icon-box">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="expect-svg">
              <path d="M12 3a9 9 0 100 18 9 9 0 000-18zM8 12l3 3 5-6"></path>
            </svg>
          </div>
          <div class="about-expect-text">
            <h3 class="about-expect-title">{aboutData.expect_cards[0]?.title || 'Nothing untested'}</h3>
            <p class="about-expect-desc">{aboutData.expect_cards[0]?.text || 'Every pack was built and bench-tested before any file is released.'}</p>
          </div>
        </div>

        <div class="about-expect-card">
          <div class="about-expect-icon-box">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="expect-svg">
              <path d="M4 4h6a3 3 0 013 3v13a2 2 0 00-2-2H4zM20 4h-6a3 3 0 00-3 3v13a2 2 0 012-2h7z"></path>
            </svg>
          </div>
          <div class="about-expect-text">
            <h3 class="about-expect-title">{aboutData.expect_cards[1]?.title || 'Everything documented'}</h3>
            <p class="about-expect-desc">{aboutData.expect_cards[1]?.text || 'Source code, wiring pinouts and parts links with every project.'}</p>
          </div>
        </div>

        <div class="about-expect-card">
          <div class="about-expect-icon-box">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="expect-svg">
              <path d="M4 6h16v12H4zM4 7l8 6 8-6"></path>
            </svg>
          </div>
          <div class="about-expect-text">
            <h3 class="about-expect-title">{aboutData.expect_cards[2]?.title || 'A real person replies'}</h3>
            <p class="about-expect-desc">{aboutData.expect_cards[2]?.text || 'Questions go straight to me. Include your Order ID and I will help.'}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. WORK WITH ME -->
    <section class="about-w about-work-wrap">
      <div class="about-work-card">
        <div class="about-work-left">
          <h2 class="about-work-title">{aboutData.work_with_me.heading}</h2>
          <p class="about-work-desc">{aboutData.work_with_me.text}</p>
        </div>
        <div class="about-work-right">
          <a href={aboutData.work_with_me.btn_url || '/contact'} class="about-btn about-btn-red about-work-btn">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="work-mail-svg">
              <path d="M4 6h16v12H4zM4 7l8 6 8-6"></path>
            </svg>
            <span>{aboutData.work_with_me.btn_text || 'Get in touch'}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 8. FOLLOW THE BUILDS -->
    <section class="about-w about-socials-wrap">
      <div class="about-section-header">
        <h2 class="about-section-h2">Follow the builds</h2>
      </div>

      <div class="about-socials-grid">
        {socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="about-social-card">
            <span class="about-social-icon-box">
              {s.icon === 'youtube' && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class="social-svg">
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
                  <path d="M9.75 15.02 15.5 11.75 9.75 8.48z"></path>
                </svg>
              )}
              {s.icon === 'instagram' && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class="social-svg">
                  <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <path d="M17.5 6.5h.01"></path>
                </svg>
              )}
              {s.icon === 'github' && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class="social-svg">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                </svg>
              )}
              {s.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class="social-svg">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              )}
            </span>
            <span class="about-social-meta">
              <b class="about-social-platform">{s.platform}</b>
              <span class="about-social-handle">{s.handle}</span>
            </span>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="about-social-chevron">
              <path d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- 9. CLOSING CALL TO ACTION -->
    <section class="about-w about-cta-wrap">
      <div class="about-cta-card">
        <div class="about-cta-left">
          <h2 class="about-cta-title">{aboutData.cta.heading}</h2>
          <p class="about-cta-sub">{aboutData.cta.subline}</p>
        </div>
        <div class="about-cta-right">
          <a href={aboutData.cta.btn1_url || '/projects?price=free'} class="about-btn about-btn-red about-cta-btn">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="cta-download-svg">
              <path d="M12 4v11M7 11l5 5 5-5M5 20h14"></path>
            </svg>
            <span>{aboutData.cta.btn1_text || 'Free downloads'}</span>
          </a>
          <a href={aboutData.cta.btn2_url || '/projects'} class="about-btn about-btn-white-outline about-cta-btn-secondary">
            <span>{aboutData.cta.btn2_text || 'Browse all projects'}</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap');

  .about-page {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    color: #0F1115;
    background: #ffffff;
    overflow-x: clip;
    width: 100%;
  }

  /* Global Container from Design: padding 0 120px on desktop */
  .about-w {
    max-width: 1440px;
    margin: 0 auto;
    padding-left: clamp(20px, 8vw, 120px);
    padding-right: clamp(20px, 8vw, 120px);
  }

  .about-eyebrow {
    color: #D91F26;
    font-size: 14px;
    font-weight: 600;
  }
  .about-link-red {
    color: #D91F26;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }
  .about-link-red:hover {
    text-decoration: underline;
  }

  /* Base buttons from design */
  .about-btn {
    border: 0;
    border-radius: 14px;
    height: 54px;
    padding: 0 28px;
    font-weight: 700;
    font-size: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.15s, transform 0.15s;
  }
  .about-btn:hover {
    opacity: 0.94;
    transform: translateY(-1px);
  }
  .about-btn-red {
    background: #D91F26;
    color: #ffffff;
  }
  .about-btn-outline {
    background: #ffffff;
    color: #0F1115;
    border: 1.5px solid #0F1115;
  }
  .about-btn-white-outline {
    background: transparent;
    color: #ffffff;
    border: 1.5px solid #3B4350;
  }
  .about-btn-white-outline:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .btn-play-icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .btn-yt-text-mobile {
    display: none;
  }

  /* 1. HERO SECTION */
  .about-hero-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    gap: 72px;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 72px;
  }
  .about-hero-headline {
    margin: 14px 0 20px;
    font-size: clamp(34px, 3.8vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 700;
    color: #0F1115;
  }
  .about-hero-intro {
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.55;
    color: #5A6270;
    margin: 0;
    max-width: 560px;
  }
  .about-chips-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 22px 0 30px;
  }
  .about-pill {
    display: inline-block;
    background: #F4F5F7;
    border-radius: 99px;
    padding: 6px 14px;
    font-size: 14px;
    font-weight: 600;
    color: #0F1115;
  }
  .about-hero-btns {
    display: flex;
    gap: 12px;
  }

  .about-hero-photo-col {
    position: relative;
  }
  .about-photo-wrap {
    position: relative;
    width: 100%;
  }
  .about-photo-img {
    width: 100%;
    aspect-ratio: 0.9;
    object-fit: cover;
    object-position: 50% 25%;
