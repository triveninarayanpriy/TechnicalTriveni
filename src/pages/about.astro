---
import Base from '../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { SITE, PROFILE } from '../lib/site';
import { listProjects } from '../lib/db';
import { getEffectiveContent } from '../lib/pages';
import { getSiteAssets } from '../lib/site-assets';
import { getAboutPageData } from '../lib/site-content';

const pageData = await getEffectiveContent(env.DB, 'about');
if (pageData.published === 0) return Astro.redirect('/404');

const aboutData = await getAboutPageData(env.DB);
const siteAssets = await getSiteAssets(env.DB);

// Live project counts for stats
let publishedProjects = [];
try {
  publishedProjects = await listProjects(env.DB, { publishedOnly: true, limit: 100 });
} catch {
  // Fallback if DB query fails
}

const totalProjectsCount = publishedProjects.length || 6;
const freeDownloadsCount = publishedProjects.filter((p) => (p.price_inr ?? 0) <= 0 || p.combo_enabled === 0).length || 3;

// Social links in strict order: YouTube, Instagram, GitHub, LinkedIn
const ytLink = siteAssets.social_links?.youtube !== undefined ? siteAssets.social_links.youtube : SITE.socials.youtube;
const igLink = siteAssets.social_links?.instagram !== undefined ? siteAssets.social_links.instagram : SITE.socials.instagram;
const ghLink = siteAssets.social_links?.github !== undefined ? siteAssets.social_links.github : SITE.socials.github;
const liLink = siteAssets.social_links?.linkedin !== undefined ? siteAssets.social_links.linkedin : SITE.socials.linkedin;

const socials = [
  { name: 'YouTube', url: ytLink || 'https://youtube.com/@TechnicalTriveni' },
  { name: 'Instagram', url: igLink || 'https://instagram.com/technicaltriveni' },
  { name: 'GitHub', url: ghLink || 'https://github.com/triveninarayanpriy' },
  { name: 'LinkedIn', url: liLink || 'https://linkedin.com/in/triveninarayanpriy' },
];

// Profile photo & exact name string
const profilePhoto = siteAssets.maker_photo?.url || '/brand/about-v2/1e2ad315960dc87dac027605d2efdff3.jpg';
const profileName = aboutData.hero.name || 'Triveni Narayan Priy';

// Expect cards items
const expectItems = [
  {
    title: aboutData.expect_cards?.[0]?.title || 'Nothing untested',
    text: aboutData.expect_cards?.[0]?.text || 'Every pack was built and bench-tested before any file is released.',
  },
  {
    title: aboutData.expect_cards?.[1]?.title || 'Everything documented',
    text: aboutData.expect_cards?.[1]?.text || 'Source code, wiring pinouts and parts links with every project.',
  },
  {
    title: aboutData.expect_cards?.[2]?.title || 'A real person replies',
    text: aboutData.expect_cards?.[2]?.text || 'Questions go straight to me. Include your Order ID and I will help.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profileName,
  jobTitle: PROFILE.title,
  worksFor: { '@type': 'Organization', name: SITE.name },
  url: Astro.site?.toString() || 'https://www.technicaltriveni.me',
  sameAs: socials.map((s) => s.url),
};
---

<Base
  title={pageData?.title || 'About | Technical Triveni'}
  description={`About ${profileName} — the maker behind Technical Triveni. Tested electronics builds, schematics and code.`}
  jsonLd={jsonLd}
>
  <div class="about-page">
    <!-- 1. INTRO SECTION -->
    <section class="about-container about-intro-section">
      <div class="about-intro-grid">
        <div class="about-photo-col">
          <img
            src={profilePhoto}
            alt={profileName}
            width="200"
            height="200"
            class="about-photo"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            data-testid="about-photo"
          />
        </div>
        <div class="about-intro-text">
          <p class="about-eyebrow">About me</p>
          <h1 class="about-h1">{profileName}</h1>
          <p class="about-tagline">Electronics, Software, AI</p>
          <p class="about-intro-para">
            Every project shown here is built and tested by me. New video every week, with three Shorts.
          </p>
          <ul class="about-intro-list">
            <li>Hardware projects: Arduino, ESP32, IoT, home automation, robotics</li>
            <li>Software projects: Python, C, Flutter applications, AI-assisted development</li>
            <li>AI tools and agents that are genuinely useful for students and engineers</li>
            <li>Engineering guidance: VLSI, projects, placements, and student life at an NIT</li>
          </ul>
          <p class="about-inquiries">
            Business inquiries: <a href="mailto:technicaltriveniyt@gmail.com" class="about-inquiries-link">technicaltriveniyt@gmail.com</a>
          </p>
          <div class="about-intro-btns">
            <a href="/projects" class="about-btn about-btn-solid">Browse projects</a>
            <a
              href={ytLink || 'https://youtube.com/@TechnicalTriveni'}
              target="_blank"
              rel="noopener noreferrer"
              class="about-btn about-btn-outline"
            >
              Watch on YouTube
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. STATS ROW -->
    <section class="about-container">
      <div class="about-stats-row">
        <div class="about-stat-item">
          <b class="about-stat-number">{totalProjectsCount}</b>
          <span class="about-stat-label">Projects built and documented</span>
        </div>
        <div class="about-stat-item">
          <b class="about-stat-number">{freeDownloadsCount}</b>
          <span class="about-stat-label">Free downloads, no signup</span>
        </div>
        <div class="about-stat-item">
          <b class="about-stat-number">100%</b>
          <span class="about-stat-label">Tested on real hardware</span>
        </div>
        <div class="about-stat-item">
          <b class="about-stat-number">1</b>
          <span class="about-stat-label">Maker answering your emails</span>
        </div>
      </div>
    </section>

    <!-- 3. MY STORY -->
    <section class="about-container about-story-section">
      <div class="about-story-grid">
        <div class="about-story-left">
          <p class="about-eyebrow">My story</p>
          <h2 class="about-story-h2">Why I started Technical Triveni</h2>
          <p class="about-story-quote">
            I was tired of electronics tutorials that don’t actually work.
          </p>
        </div>
        <div class="about-story-right">
          <p>
            Most guides online leave out critical pinouts, skip power decoupling, or share untested code that throws errors the moment you clone it.
          </p>
          <p>
            So I started building the projects myself, on a real breadboard or PCB, and fixing every problem until the build actually worked. Then I filmed it and wrote it all down: the code, the wiring, the parts.
          </p>
          <p>
            Technical Triveni is built on a single promise: <strong>complete transparency and physical proof.</strong>
          </p>
        </div>
      </div>
    </section>

    <!-- 4. WHAT YOU CAN EXPECT FROM ME -->
    <section class="about-container about-expect-section">
      <h2 class="about-section-h2">What you can expect from me</h2>
      <div class="about-expect-list">
        {expectItems.map((item) => (
          <div class="about-expect-item">
            <h3 class="about-expect-title">{item.title}</h3>
            <p class="about-expect-desc">{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. FOLLOW THE BUILDS -->
    <section class="about-container about-follow-section">
      <h2 class="about-section-h2">Follow the builds</h2>
      <div class="about-follow-grid">
        {socials.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="about-follow-card"
          >
            <span class="about-follow-name">{s.name}</span>
            <span class="about-follow-chevron" aria-hidden="true"></span>
          </a>
        ))}
      </div>
    </section>

    <!-- 6. FREE PACK BAND -->
    <section class="about-container about-cta-section">
      <div class="about-cta-band">
        <div class="about-cta-text">
          <h2 class="about-cta-h2">Start with a free pack</h2>
          <p class="about-cta-sub">
            No signup, no email. Download the code and guide, then build.
          </p>
        </div>
        <div class="about-cta-btns">
          <a href="/projects?price=free" class="about-btn about-btn-solid">Free downloads</a>
          <a href="/projects" class="about-btn about-btn-white-outline">Browse all projects</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* ==========================================================================
     About Page — Design Tokens & Variables
     ========================================================================== */
  .about-page {
    --tt-red: #D4152B;
    --tt-ink: #14151A;
    --tt-muted: #565B66;
    --tt-line: #E4E6EA;
    --tt-line-2: #D5D8DE;
    --tt-soft: #F4F5F7;
    --tt-dark: #111318;
    --tt-font: 'Space Grotesk', system-ui, -apple-system, sans-serif;

    font-family: var(--tt-font);
    color: var(--tt-ink);
    background: #ffffff;
    line-height: 1.5;
    width: 100%;
  }

  /* Page Container: max width 1120px; side padding 16px below 900px, 32px from 900px */
  .about-container {
    max-width: 1120px;
    margin: 0 auto;
    padding-left: 16px;
    padding-right: 16px;
  }
  @media (min-width: 900px) {
    .about-container {
      padding-left: 32px;
      padding-right: 32px;
    }
  }

  /* Typography primitives */
  .about-eyebrow {
    color: var(--tt-red);
    font-weight: 600;
    font-size: 13px;
    margin: 0 0 6px 0;
  }
  @media (min-width: 900px) {
    .about-eyebrow {
      font-size: 14px;
      margin-bottom: 8px;
    }
  }

  .about-section-h2 {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--tt-ink);
    margin: 0;
  }
  @media (min-width: 900px) {
    .about-section-h2 {
      font-size: 26px;
      line-height: 1.2;
    }
  }

  /* Shared Button Styles (height 48px, radius 999px) */
  .about-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 20px;
    border-radius: 999px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    cursor: pointer;
  }
  @media (min-width: 900px) {
    .about-btn {
      padding: 0 24px;
      font-size: 16px;
    }
  }

  .about-btn-solid {
    background: var(--tt-red);
    color: #ffffff;
    border: 2px solid var(--tt-red);
  }
  .about-btn-solid:hover {
    background: #b51022;
    border-color: #b51022;
  }

  .about-btn-outline {
    background: #ffffff;
    color: var(--tt-ink);
    border: 2px solid var(--tt-ink);
  }
  .about-btn-outline:hover {
    background: #f4f5f7;
  }

  .about-btn-white-outline {
    background: transparent;
    color: #ffffff;
    border: 2px solid #ffffff;
  }
  .about-btn-white-outline:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* ==========================================================================
     1. INTRO SECTION
     ========================================================================== */
  .about-intro-section {
    padding-top: 24px;
    padding-bottom: 24px;
  }
  .about-intro-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .about-photo-col {
    display: flex;
  }
  .about-photo {
    width: 96px;
    height: 96px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 20%;
    border: 1px solid var(--tt-line);
    flex: none;
  }
  .about-h1 {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.15;
    color: var(--tt-ink);
    margin: 0;
  }
  .about-tagline {
    color: var(--tt-muted);
    font-size: 15px;
    margin: 6px 0 0 0;
  }
  .about-intro-para {
    font-size: 16px;
    line-height: 1.5;
    color: var(--tt-ink);
    margin: 16px 0 0 0;
  }
  .about-intro-list {
    margin: 12px 0 0 0;
    padding-left: 20px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--tt-ink);
  }
  .about-intro-list li {
    margin-bottom: 4px;
  }
  .about-inquiries {
    color: var(--tt-muted);
    font-size: 14px;
    margin: 12px 0 0 0;
  }
  .about-inquiries-link {
    color: inherit;
    text-decoration: underline;
  }
  .about-intro-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .about-intro-btns .about-btn {
    flex: 1 1 150px;
  }

  @media (min-width: 900px) {
    .about-intro-section {
      padding-top: 64px;
      padding-bottom: 56px;
    }
    .about-intro-grid {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 56px;
      align-items: center;
    }
    .about-photo {
      width: 200px;
      height: 200px;
    }
    .about-h1 {
      font-size: 44px;
      line-height: 1.1;
    }
    .about-tagline {
      font-size: 17px;
      margin-top: 8px;
    }
    .about-intro-para {
      font-size: 18px;
      margin-top: 20px;
      max-width: 640px;
    }
    .about-intro-list {
      margin-top: 16px;
      font-size: 17px;
      line-height: 1.6;
      max-width: 640px;
    }
    .about-inquiries {
      font-size: 15px;
      margin-top: 16px;
    }
    .about-intro-btns {
      flex-wrap: nowrap;
      gap: 12px;
      margin-top: 24px;
    }
    .about-intro-btns .about-btn {
      flex: 0 0 auto;
    }
  }

  /* ==========================================================================
     2. STATS ROW
     ========================================================================== */
  .about-stats-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 16px;
    padding: 24px 0;
    border-top: 1px solid var(--tt-line);
    border-bottom: 1px solid var(--tt-line);
  }
  .about-stat-item {
    display: flex;
    flex-direction: column;
  }
  .about-stat-number {
    display: block;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--tt-ink);
  }
  .about-stat-label {
    color: var(--tt-muted);
    font-size: 13px;
    line-height: 1.35;
    margin-top: 4px;
  }

  @media (min-width: 900px) {
    .about-stats-row {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      padding: 32px 0;
    }
    .about-stat-number {
      font-size: 34px;
    }
    .about-stat-label {
      font-size: 16px;
      margin-top: 6px;
    }
  }

  /* ==========================================================================
     3. MY STORY
     ========================================================================== */
  .about-story-section {
    padding-top: 32px;
    padding-bottom: 32px;
  }
  .about-story-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .about-story-h2 {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--tt-ink);
    margin: 0;
  }
  .about-story-quote {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--tt-ink);
    margin: 12px 0 0 0;
  }
  .about-story-right {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--tt-ink);
  }
  .about-story-right p {
    margin: 0;
  }
  .about-story-right strong {
    font-weight: 700;
  }

  @media (min-width: 900px) {
    .about-story-section {
      padding-top: 56px;
      padding-bottom: 56px;
    }
    .about-story-grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 64px;
      align-items: start;
    }
    .about-story-h2 {
      font-size: 30px;
      line-height: 1.2;
    }
    .about-story-quote {
      font-size: 18px;
      margin-top: 16px;
    }
    .about-story-right {
      gap: 18px;
      font-size: 18px;
    }
  }

  /* ==========================================================================
     4. WHAT YOU CAN EXPECT FROM ME
     ========================================================================== */
  .about-expect-section {
    padding-top: 0;
    padding-bottom: 32px;
  }
  .about-expect-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 14px;
  }
  .about-expect-item {
    display: flex;
    flex-direction: column;
  }
  .about-expect-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--tt-ink);
    margin: 0 0 4px 0;
  }
  .about-expect-desc {
    color: var(--tt-muted);
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
  }

  @media (min-width: 900px) {
    .about-expect-section {
      padding-bottom: 56px;
    }
    .about-expect-list {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 18px;
    }
    .about-expect-title {
      font-size: 18px;
      margin-bottom: 6px;
    }
    .about-expect-desc {
      font-size: 15px;
    }
  }

  /* ==========================================================================
     5. FOLLOW THE BUILDS
     ========================================================================== */
  .about-follow-section {
    padding-top: 0;
    padding-bottom: 32px;
  }
  .about-follow-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 14px;
  }
  .about-follow-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    padding: 0 14px;
    border: 1px solid var(--tt-line-2);
    border-radius: 12px;
    color: var(--tt-ink);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    background: #ffffff;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .about-follow-card:hover {
    border-color: var(--tt-ink);
  }
  .about-follow-chevron {
    width: 7px;
    height: 7px;
    border: solid var(--tt-muted);
    border-width: 2px 2px 0 0;
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  @media (min-width: 900px) {
    .about-follow-section {
      padding-bottom: 56px;
    }
    .about-follow-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-top: 20px;
    }
    .about-follow-card {
      height: 56px;
      padding: 0 20px;
      border-radius: 14px;
      font-size: 16px;
    }
    .about-follow-chevron {
      width: 8px;
      height: 8px;
    }
  }

  /* ==========================================================================
     6. FREE PACK BAND
     ========================================================================== */
  .about-cta-section {
    padding-top: 0;
    padding-bottom: 32px;
  }
  .about-cta-band {
    background: var(--tt-dark);
    color: #ffffff;
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .about-cta-h2 {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    color: #ffffff;
    margin: 0;
  }
  .about-cta-sub {
    margin: 8px 0 0 0;
    color: #C9CCD3;
    font-size: 15px;
    line-height: 1.5;
  }
  .about-cta-btns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }
  .about-cta-btns .about-btn {
    width: 100%;
  }

  @media (min-width: 900px) {
    .about-cta-section {
      padding-bottom: 56px;
    }
    .about-cta-band {
      border-radius: 24px;
      padding: 48px;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
    }
    .about-cta-h2 {
      font-size: 30px;
    }
    .about-cta-sub {
      font-size: 17px;
      max-width: 440px;
    }
    .about-cta-btns {
      display: flex;
      flex-direction: row;
      gap: 12px;
    }
    .about-cta-btns .about-btn {
      width: auto;
    }
  }
</style>
