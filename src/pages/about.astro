---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { SITE, PROFILE } from '../lib/site';
import { getPage } from '../lib/db';
import { renderMarkdown } from '../lib/format';

const pageData = await getPage(env.DB, 'about');
const profilePhoto = pageData?.image_url || PROFILE.photo;
const customBioHtml = pageData?.content_md ? renderMarkdown(pageData.content_md) : null;

const socials = [
  { label: 'YouTube', href: SITE.socials.youtube, icon: 'youtube' },
  { label: 'Instagram', href: SITE.socials.instagram, icon: 'instagram' },
  { label: 'GitHub', href: SITE.socials.github, icon: 'github' },
  { label: 'LinkedIn', href: SITE.socials.linkedin, icon: 'linkedin' },
].filter((s) => s.href);

const values = [
  { icon: 'check-circle', title: 'Nothing hidden', text: 'Full schematics, code and wiring — not just a highlight reel. If I built it, you can build it.' },
  { icon: 'shield', title: 'Built & tested', text: 'Every project is made and verified by me before it goes up. Guides are written to be followed.' },
  { icon: 'users', title: 'Made for students', text: 'Beginner-friendly where it counts, with the depth to actually understand the why.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PROFILE.name,
  jobTitle: PROFILE.title,
  worksFor: { '@type': 'Organization', name: SITE.name },
  url: Astro.site?.toString(),
  sameAs: socials.map((s) => s.href),
};
---

<Base title={pageData?.title || "About"} description={`About ${PROFILE.name} — the maker behind Technical Triveni. ${PROFILE.lead}`} jsonLd={jsonLd}>
  <section class="page-hero grid-bg">
    <div class="container">
      <span class="eyebrow" data-reveal>About</span>
      <h1 data-reveal>The maker behind the builds.</h1>
      <p class="page-hero__lead" data-reveal>{PROFILE.lead}</p>
    </div>
  </section>

  
  <!-- ===================== PROOF & PHILOSOPHY ===================== -->
  <section class="section" style="padding: 4rem 0;">
    <div class="container about-me">
      <div class="am-photo" data-reveal>
        <div class="am-photo__ring">
          <img src={profilePhoto} alt={PROFILE.name} class="am-photo__img" loading="eager" />
        </div>
      </div>
      
      <div class="am-content">
        <h2 class="h2" data-reveal style="margin-bottom: 1.5rem;">Why I build Technical Triveni</h2>
        <div class="prose" data-reveal>
          {customBioHtml ? <Fragment set:html={customBioHtml} /> : (
            <p>I started Technical Triveni because I was tired of electronics tutorials that don't work. Most guides online leave out crucial steps, skip the messy parts, and never show the troubleshooting process.</p>
          )}
          <p>This store is different. Every pack is based on a philosophy of absolute transparency and proof.</p>
        </div>

        <div class="am-values" style="display: grid; gap: 1.5rem; margin-top: 2rem;">
          {values.map((v: any, i: number) => (
            <div class="value-card" data-reveal style={`animation-delay: ${i * 0.1}s; display: flex; gap: 1rem; background: var(--surface); padding: 1.5rem; border-radius: var(--r-md); border: 1px solid var(--border);`} >
              <Icon name={v.icon} size={28} style="color: var(--brand-red); flex-shrink: 0;" />
              <div>
                <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; font-weight: 600;">{v.title}</h3>
                <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.5;">{v.text}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="am-socials" data-reveal style="margin-top: 2.5rem;">
          <p class="am-socials__label" style="font-weight: 600; margin-bottom: 1rem;">Verify the builds on:</p>
          <div class="am-socials__list" style="display: flex; gap: 1rem; flex-wrap: wrap;">
            {socials.map((s: any) => (
              <a href={s.href} target="_blank" rel="noopener" class="btn btn-ghost" style="border: 1px solid var(--border);">
                <Icon name={s.icon} size={18} /> {s.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== THE STANDARD ===================== -->
  <section class="section" style="background: var(--surface-2); padding: 4rem 0; border-top: 1px solid var(--border);">
    <div class="container">
      <h2 class="h2" style="text-align: center; margin-bottom: 3rem;">The Technical Triveni Standard</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
        <div style="background: var(--bg); padding: 2rem; border-radius: var(--r-md); border: 1px solid var(--border);">
          <div style="background: var(--success); color: #fff; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
            <Icon name="check" size={20} />
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 1rem; font-weight: 600;">Hardware Verified</h3>
          <p style="color: var(--text-muted); line-height: 1.6;">I don't sell theory. Every single project is built on a breadboard or PCB, programmed, and tested in the real world before the pack is published.</p>
        </div>
        <div style="background: var(--bg); padding: 2rem; border-radius: var(--r-md); border: 1px solid var(--border);">
          <div style="background: #3b82f6; color: #fff; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
            <Icon name="youtube" size={20} />
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 1rem; font-weight: 600;">Video Proof</h3>
          <p style="color: var(--text-muted); line-height: 1.6;">Look for the YouTube proof link on every paid project. I show the final result working so you know exactly what you're getting.</p>
        </div>
        <div style="background: var(--bg); padding: 2rem; border-radius: var(--r-md); border: 1px solid var(--border);">
          <div style="background: #fbbf24; color: #fff; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
            <Icon name="star" size={20} />
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 1rem; font-weight: 600;">Verified Reviews</h3>
          <p style="color: var(--text-muted); line-height: 1.6;">Ratings can only be submitted by people who actually bought and downloaded the pack via an encrypted email link. No fake counters, no bots.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
