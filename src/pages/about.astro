---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { SITE, PROFILE } from '../lib/site';
import { listProjects } from '../lib/db';
import { renderMarkdown } from '../lib/format';
import { getEffectiveContent } from '../lib/pages';

const pageData = await getEffectiveContent(env.DB, 'about');
if (pageData.published === 0) return Astro.redirect('/404');

const profilePhoto = pageData.image_url || '/brand/profile.jpg';
const bioHtml = renderMarkdown(pageData.markdown);

// Fetch projects for count and closing card covers
let packCount = 5;
let featuredCovers: string[] = ['/covers/drone-pack.jpg', '/covers/blynk-iot.jpg', '/covers/esp32-cam.jpg'];
try {
  const allProjects = await listProjects(env.DB, { publishedOnly: true, limit: 3 });
  if (allProjects.length > 0) {
    packCount = allProjects.length;
    featuredCovers = allProjects.map((p) => p.cover_image).filter(Boolean) as string[];
  }
} catch {}

const socials = [
  { label: 'YouTube', href: SITE.socials.youtube, icon: 'youtube' },
  { label: 'Instagram', href: SITE.socials.instagram, icon: 'instagram' },
  { label: 'GitHub', href: SITE.socials.github, icon: 'github' },
  { label: 'LinkedIn', href: SITE.socials.linkedin, icon: 'linkedin' },
].filter((s) => s.href);

const proofCards = [
  {
    icon: 'check-circle',
    title: 'Hardware verified',
    text: 'Built on a real breadboard or PCB, programmed and bench-tested before any files are released.',
  },
  {
    icon: 'play',
    title: 'Video proof',
    text: 'Every build is demonstrated on YouTube. You see it working before you order parts.',
  },
  {
    icon: 'layers',
    title: 'Complete project packs',
    text: 'Source code, wiring pinouts, a verified parts list with store links, and 3D printable STL files.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PROFILE.name,
  jobTitle: PROFILE.title,
  worksFor: { '@type': 'Organization', name: SITE.name },
  url: Astro.site?.toString(),
  sameAs: socials.map((s) => s.href),
};
---

<Base
  title={pageData?.title || 'About | Technical Triveni'}
  description={`About ${PROFILE.name} — the maker behind Technical Triveni. Real builds tested on the workbench.`}
  jsonLd={jsonLd}
>
  <div class="about-page">
    <!-- HERO: SPLIT MAKER BIO & PHOTO (media_1791937896363_108477b4.png) -->
    <section class="about-hero">
      <div class="container">
        <div class="about-hero-grid">
          <!-- Left: Bio & Stats -->
          <div class="about-bio-col">
            <span class="about-eyebrow">About the maker</span>
            <h1 class="about-title">Real builds. Tested on the workbench.</h1>
            <p class="about-lead">
              {PROFILE.lead || "I'm Triveni, a B.Tech ECE (VLSI) student at NIT Patna. Every electronics, software and AI project on Technical Triveni is built and tested by me."}
            </p>

            <div class="about-stats-row">
              <div class="about-stat-tile">
                <span class="stat-number">100%</span>
                <span class="stat-label">Hardware verified</span>
              </div>
              <div class="about-stat-tile">
                <span class="stat-number">Direct</span>
                <span class="stat-label">Maker support</span>
              </div>
              <div class="about-stat-tile">
                <span class="stat-number">{packCount}</span>
                <span class="stat-label">Project packs</span>
              </div>
            </div>
          </div>

          <!-- Right: Portrait Photo -->
          <div class="about-photo-col">
            <div class="about-photo-wrap">
              <img
                src={profilePhoto}
                alt={PROFILE.name}
                class="about-portrait"
                width="480"
                height="560"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DARK STORY BAND (#111418) -->
    <section class="about-story-section">
      <div class="container">
        <div class="about-story-band">
          {pageData.is_custom ? (
            <div class="about-story-prose prose-dark" set:html={bioHtml} />
          ) : (
            <>
              <div class="story-left">
                <h2 class="story-headline">
                  I was tired of electronics tutorials that don't actually work.
                </h2>
              </div>
              <div class="story-right">
                <p class="story-body">
                  Most guides leave out critical pinouts, skip power decoupling, or share untested code that throws errors the moment you clone it.
                </p>
                <p class="story-body">
                  So there is one promise here: <span class="story-highlight">complete transparency and physical proof</span>.
                </p>
              </div>
            </>
          )}
        </div>
      </div>
    </section>

    <!-- PROOF, NOT PROMISES SECTION -->
    <section class="about-proof-section">
      <div class="container">
        <h2 class="about-sec-heading">Proof, not promises</h2>
        <div class="about-proof-grid">
          {proofCards.map((c) => (
            <div class="about-proof-card">
              <span class="proof-card-icon">
                <Icon name={c.icon} size={20} />
              </span>
              <h3 class="proof-card-title">{c.title}</h3>
              <p class="proof-card-text">{c.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FOLLOW THE BUILDS (4 SOCIAL PILLS) -->
    <section class="about-socials-section">
      <div class="container">
        <h2 class="about-sec-heading">Follow the builds</h2>
        <div class="about-socials-grid">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="social-pill-card">
              <span>{s.label}</span>
              <span class="social-arrow">&gt;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- EXPLORE THE PROJECT PACKS CLOSING CARD -->
    <section class="about-closing-section">
      <div class="container">
        <div class="about-closing-card">
          <div class="closing-text-col">
            <h2 class="closing-title">Explore the project packs</h2>
            <p class="closing-desc">
              From flight controllers to autonomous robotics, full documentation ready for your workbench.
            </p>
            <a href="/projects" class="btn-closing-red">Browse all projects</a>
          </div>

          <div class="closing-covers-col">
            {featuredCovers.map((src, i) => (
              <img
                src={src}
                alt={`Project pack ${i + 1}`}
                class="closing-thumb"
                width="160"
                height="100"
                loading="lazy"
                onerror="this.src='/brand/og-image.png'"
              />
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .about-page {
    background: #FFFFFF;
    color: var(--ink);
  }

  /* Hero Section */
  .about-hero {
    padding: 64px 0 48px;
  }
  .about-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  @media (max-width: 900px) {
    .about-hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  .about-eyebrow {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--red);
    display: block;
    margin-bottom: 12px;
  }
  .about-title {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 18px;
  }
  .about-lead {
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 32px;
  }

  .about-stats-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .about-stat-tile {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px 24px;
    display: flex;
    flex-direction: column;
    min-width: 120px;
  }
  .stat-number {
    font-size: 26px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .stat-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }

  .about-photo-wrap {
    border-radius: 24px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
  }
  .about-portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 4.6;
    object-fit: cover;
    display: block;
  }

  /* Dark Story Band */
  .about-story-section {
    padding: 24px 0 64px;
  }
  .about-story-band {
    background: var(--dark);
    border-radius: 24px;
    padding: 56px 48px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  @media (max-width: 820px) {
    .about-story-band {
      grid-template-columns: 1fr;
      padding: 36px 24px;
      gap: 24px;
    }
  }
  .story-headline {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    line-height: 1.25;
    color: #FFFFFF;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .story-body {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 16px;
  }
  .story-body:last-child {
    margin-bottom: 0;
  }
  .about-story-prose {
    grid-column: 1 / -1;
    max-width: 720px;
  }
  .about-story-prose :global(h2) {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    line-height: 1.25;
    color: #FFFFFF;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }
  .about-story-prose :global(h3) {
    font-size: clamp(18px, 2.5vw, 24px);
    font-weight: 600;
    color: #FFFFFF;
    margin: 28px 0 12px;
  }
  .about-story-prose :global(p) {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 16px;
  }
  .about-story-prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .about-story-prose :global(strong) {
    color: #FFFFFF;
  }
  .about-story-prose :global(a) {
    color: var(--brand-red, #E11D48);
    text-decoration: underline;
  }
  .story-highlight {
    color: #FFFFFF;
    font-weight: 600;
    border-bottom: 2px solid var(--red);
    padding-bottom: 2px;
  }

  /* Proof Section */
  .about-proof-section {
    padding: 24px 0 64px;
  }
  .about-sec-heading {
    font-size: 28px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin: 0 0 28px;
  }
  .about-proof-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 820px) {
    .about-proof-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
  .about-proof-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 28px 24px;
  }
  .proof-card-icon {
    color: var(--red);
    display: inline-flex;
    margin-bottom: 16px;
  }
  .proof-card-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .proof-card-text {
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
  }

  /* Socials Section */
  .about-socials-section {
    padding: 0 0 64px;
  }
  .about-socials-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  @media (max-width: 820px) {
    .about-socials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .about-socials-grid {
      grid-template-columns: 1fr;
    }
  }
  .social-pill-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--ink);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: all 150ms ease;
  }
  .social-pill-card:hover {
    border-color: var(--ink);
  }
  .social-arrow {
    color: var(--muted);
    font-weight: 700;
  }

  /* Closing Card */
  .about-closing-section {
    padding: 0 0 80px;
  }
  .about-closing-card {
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 40px 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }
  .closing-text-col {
    max-width: 480px;
  }
  .closing-title {
    font-size: 26px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .closing-desc {
    font-size: 15px;
    color: var(--muted);
    margin: 0 0 24px;
    line-height: 1.5;
  }
  .btn-closing-red {
    background: var(--red);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 15px;
    padding: 12px 26px;
    border-radius: 14px;
    text-decoration: none;
    display: inline-block;
  }

  .closing-covers-col {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .closing-thumb {
    width: 140px;
    height: 84px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
</style>
