---
import Admin from '../../layouts/Admin.astro';
import { listOrders, listProjects } from '../../lib/db';

const env = Astro.locals.runtime.env;
const url = new URL(Astro.request.url);
const status = url.searchParams.get('status') || 'all';
const search = url.searchParams.get('search') || '';
const projectId = url.searchParams.get('projectId') || '';
const dateStart = url.searchParams.get('dateStart') || '';
const dateEnd = url.searchParams.get('dateEnd') || '';
const view = url.searchParams.get('view') || 'orders';

const projects = await listProjects(env.DB);
const orders = await listOrders(env.DB, { 
  status: status === 'all' ? undefined : status, 
  search, 
  projectId, 
  dateStart, 
  dateEnd, 
  limit: 1000 
});

let groupedCustomers = [];
if (view === 'customers') {
  const customerMap = new Map();
  for (const order of orders) {
    if (!order.email) continue;
    if (!customerMap.has(order.email)) {
      customerMap.set(order.email, { email: order.email, amount_inr: 0, count: 0 });
    }
    const c = customerMap.get(order.email);
    c.amount_inr += (order.amount_inr || 0);
    c.count += 1;
  }
  groupedCustomers = Array.from(customerMap.values()).sort((a,b) => b.amount_inr - a.amount_inr);
}

const statuses = ['all', 'paid', 'pending', 'abandoned', 'failed', 'refunded'];
---
<Admin title="Orders">
  <div class="px-4 sm:px-6 lg:px-8 py-8">
    <div class="sm:flex sm:items-center">
      <div class="sm:flex-auto">
        <h1 class="text-2xl font-semibold text-gray-900">Orders</h1>
      </div>
      <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none flex gap-4 items-center">
        <a href={`?${new URLSearchParams({ ...Object.fromEntries(url.searchParams), view: view === 'customers' ? 'orders' : 'customers' })}`} class="inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">
          {view === 'customers' ? 'View as Orders' : 'View as Customers'}
        </a>
        <button id="exportCsvBtn" class="inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700">
          Export CSV
        </button>
      </div>
    </div>

    <!-- Filters -->
    <form class="mt-8 mb-4 grid grid-cols-1 gap-4 sm:grid-cols-5" method="get">
      <input type="hidden" name="view" value={view} />
      
      <div>
        <label for="search" class="block text-sm font-medium text-gray-700">Search</label>
        <input type="text" name="search" id="search" value={search} placeholder="Email, Name..." class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
      </div>

      <div>
        <label for="projectId" class="block text-sm font-medium text-gray-700">Project</label>
        <select name="projectId" id="projectId" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
          <option value="">All Projects</option>
          {projects.map(p => (
            <option value={p.id} selected={p.id.toString() === projectId}>{p.title}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="status" class="block text-sm font-medium text-gray-700">Status</label>
        <select name="status" id="status" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
          {statuses.map(s => (
            <option value={s} selected={s === status}>{s}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="dateStart" class="block text-sm font-medium text-gray-700">Date Start</label>
        <input type="date" name="dateStart" id="dateStart" value={dateStart} class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
      </div>

      <div>
        <label for="dateEnd" class="block text-sm font-medium text-gray-700">Date End</label>
        <div class="flex gap-2 items-center mt-1">
          <input type="date" name="dateEnd" id="dateEnd" value={dateEnd} class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
          <button type="submit" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-md text-sm border border-gray-300 shadow-sm">Filter</button>
        </div>
      </div>
    </form>

    <!-- Table -->
    <div class="mt-4 flex flex-col">
      <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
        <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
          <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
            
            {view === 'customers' ? (
              <table id="dataTable" class="min-w-full divide-y divide-gray-300">
                <thead class="bg-gray-50">
                  <tr>
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Email</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Total Spent (INR)</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Order Count</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                  {groupedCustomers.map(c => (
                    <tr>
                      <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-900 sm:pl-6">{c.email}</td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">₹{(c.amount_inr / 100).toFixed(2)}</td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{c.count}</td>
                    </tr>
                  ))}
                  {groupedCustomers.length === 0 && (
                    <tr>
                      <td colspan="3" class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-center text-gray-500 sm:pl-6">No customers found.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            ) : (
              <table id="dataTable" class="min-w-full divide-y divide-gray-300">
                <thead class="bg-gray-50">
                  <tr>
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">ID / Date</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Customer</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Project</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Amount</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                  {orders.map(order => (
                    <tr class="cursor-pointer hover:bg-gray-50 order-row" data-order={JSON.stringify(order)}>
                      <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-900 sm:pl-6">
                        <div class="font-medium text-indigo-600">{order.id}</div>
                        <div class="text-xs text-gray-500">{new Date(order.created_at).toLocaleString()}</div>
                      </td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                        <div>{order.name}</div>
                        <div class="text-xs">{order.email}</div>
                      </td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{order.project_id}</td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">₹{(order.amount_inr / 100).toFixed(2)}</td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                        <span class={`inline-flex rounded-full px-2 text-xs font-semibold leading-5 ${order.status === 'paid' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}`}>
                          {order.status}
                        </span>
                      </td>
                    </tr>
                  ))}
                  {orders.length === 0 && (
                    <tr>
                      <td colspan="5" class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-center text-gray-500 sm:pl-6">No orders found.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Order Detail Drawer -->
  <dialog id="orderDrawer" class="relative z-10 w-full max-w-md h-full max-h-screen bg-white shadow-xl ml-auto mr-0 p-0 m-0 backdrop:bg-gray-500/75 transition-all" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
    <div class="h-full flex flex-col py-6 shadow-xl">
      <div class="px-4 sm:px-6 flex items-start justify-between">
        <h2 class="text-lg font-medium text-gray-900" id="slide-over-title">Order Details</h2>
        <div class="ml-3 flex h-7 items-center">
          <button type="button" id="closeDrawer" class="rounded-md bg-white text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
            <span class="sr-only">Close panel</span>
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
      <div class="relative mt-6 flex-1 px-4 sm:px-6 overflow-y-auto">
        <div id="drawerContent" class="space-y-6">
          <!-- Content injected via JS -->
        </div>
      </div>
    </div>
  </dialog>

  <script>
    // CSV Export
    document.getElementById('exportCsvBtn').addEventListener('click', () => {
      const table = document.getElementById('dataTable');
      if (!table) return;
      
      let csv = [];
      const rows = table.querySelectorAll('tr');
      for (const row of rows) {
        const cols = row.querySelectorAll('th, td');
        const rowData = [];
        for (const col of cols) {
          // clean text and escape quotes
          let text = col.innerText.replace(/(\r\n|\n|\r)/gm, " ").replace(/"/g, '""');
          rowData.push(`"${text}"`);
        }
        csv.push(rowData.join(','));
      }
      
      const csvString = csv.join('\n');
      const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', 'export.csv');
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    // Drawer Logic
    const drawer = document.getElementById('orderDrawer');
    const closeDrawerBtn = document.getElementById('closeDrawer');
    const drawerContent = document.getElementById('drawerContent');

    closeDrawerBtn?.addEventListener('click', () => {
      drawer.close();
    });

    document.querySelectorAll('.order-row').forEach(row => {
      row.addEventListener('click', (e) => {
        // don't open drawer if clicking on a button or link inside the row
        if (e.target.tagName.toLowerCase() === 'button' || e.target.tagName.toLowerCase() === 'a') return;
        
        const orderData = JSON.parse(row.dataset.order || '{}');
        
        drawerContent.innerHTML = `
          <div>
            <h3 class="text-sm font-medium text-gray-500">Order ID</h3>
            <p class="mt-1 text-sm text-gray-900">${orderData.id}</p>
          </div>
          <div>
            <h3 class="text-sm font-medium text-gray-500">Razorpay Order ID</h3>
            <p class="mt-1 text-sm text-gray-900">${orderData.razorpay_order_id || 'N/A'}</p>
          </div>
          <div>
            <h3 class="text-sm font-medium text-gray-500">Razorpay Payment ID</h3>
            <p class="mt-1 text-sm text-gray-900">${orderData.razorpay_payment_id || 'N/A'}</p>
          </div>
          
          <hr class="border-gray-200" />
          
          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-2">Actions</h3>
            <div class="flex flex-col space-y-3">
              <button onclick="postAction('/api/admin/order/resend', '${orderData.id}')" class="inline-flex justify-center items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none">
                Resend Download Email
              </button>
              <button onclick="postAction('/api/admin/order/grant', '${orderData.id}')" class="inline-flex justify-center items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none">
                Grant Manual Access
              </button>
              <button onclick="if(confirm('Are you sure you want to refund this via Razorpay API?')) postAction('/api/admin/order/refund', '${orderData.id}')" class="inline-flex justify-center items-center rounded-md border border-transparent bg-red-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-red-700 focus:outline-none">
                Refund via Razorpay API
              </button>
            </div>
          </div>

          <hr class="border-gray-200" />

          <div>
            <h3 class="text-sm font-medium text-gray-500">Internal Notes</h3>
            <div class="mt-2">
              <textarea id="orderNotes" rows="4" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">${orderData.notes || ''}</textarea>
              <button onclick="saveNotes('${orderData.id}')" class="mt-2 inline-flex justify-center items-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none">
                Save Notes
              </button>
            </div>
          </div>
        `;
        
        drawer.showModal();
      });
    });

    window.postAction = async function(url, orderId) {
      try {
        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderId })
        });
        if (res.ok) {
          alert('Action successful');
        } else {
          alert('Action failed');
        }
      } catch (err) {
        alert('Error performing action');
        console.error(err);
      }
    };

    window.saveNotes = async function(orderId) {
      const notes = document.getElementById('orderNotes').value;
      try {
        const res = await fetch('/api/admin/order/notes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderId, notes })
        });
        if (res.ok) {
          alert('Notes saved');
          // ideally reload page or update state
        } else {
          alert('Failed to save notes');
        }
      } catch (err) {
        alert('Error saving notes');
      }
    };
  </script>
</Admin>
