---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { listOrders, listProjects } from '../../lib/db';
import { formatDateTime, formatDate, formatINR } from '../../lib/format';

const url = new URL(Astro.request.url);
const status = url.searchParams.get('status') || 'all';
const search = url.searchParams.get('search') || '';
const projectId = url.searchParams.get('projectId') || '';
const dateStart = url.searchParams.get('dateStart') || '';
const dateEnd = url.searchParams.get('dateEnd') || '';
const view = url.searchParams.get('view') || 'orders';

const projects = await listProjects(env.DB);
const projectMap = new Map(projects.map((p) => [p.id, p.title]));
const projectsObj = Object.fromEntries(projectMap);

const orders = await listOrders(env.DB, { 
  status: status === 'all' ? undefined : status, 
  search, 
  projectId: projectId ? Number(projectId) : undefined, 
  dateStart: dateStart ? Math.floor(new Date(dateStart).getTime() / 1000) : undefined, 
  dateEnd: dateEnd ? Math.floor(new Date(dateEnd + 'T23:59:59').getTime() / 1000) : undefined, 
  limit: 1000 
});

let groupedCustomers: { email: string; amount_inr: number; count: number }[] = [];
if (view === 'customers') {
  const customerMap = new Map<string, { email: string; amount_inr: number; count: number }>();
  for (const order of orders) {
    if (!order.email) continue;
    if (!customerMap.has(order.email)) {
      customerMap.set(order.email, { email: order.email, amount_inr: 0, count: 0 });
    }
    const c = customerMap.get(order.email)!;
    c.amount_inr += (order.amount_inr || 0);
    c.count += 1;
  }
  groupedCustomers = Array.from(customerMap.values()).sort((a,b) => b.amount_inr - a.amount_inr);
}

const statuses = ['all', 'paid', 'pending', 'abandoned', 'failed', 'refunded'];
const csrfToken = Astro.locals.csrfToken || '';
---

<Admin title="Orders" active="orders">
  <!-- ==============================================
       DESKTOP / TABLET ORDERS VIEW (Screen width >= 769px)
       ============================================== -->
  <div class="orders-desktop-view">
    <header class="admin-desktop-topbar">
      <h1 class="admin-desktop-topbar__title">Orders</h1>
      <div class="admin-desktop-topbar__actions">
        <a
          href={`?${new URLSearchParams({ ...Object.fromEntries(url.searchParams), view: view === 'customers' ? 'orders' : 'customers' })}`}
          class="admin-btn admin-btn--secondary"
        >
          {view === 'customers' ? 'View as Orders' : 'View as Customers'}
        </a>
        <button id="exportCsvBtn" type="button" class="admin-btn admin-btn--primary">
          <Icon name="download" size={16} />
          <span>Export CSV</span>
        </button>
      </div>
    </header>

    <div class="admin-desktop-content">
      <!-- Filter Toolbar -->
      <form class="orders-filter-toolbar" method="get">
        <input type="hidden" name="view" value={view} />
        
        <div class="filter-col filter-col--search">
          <label for="search" class="admin-label">Search</label>
          <div class="input-with-icon">
            <Icon name="search" size={16} class="search-icon" />
            <input type="text" name="search" id="search" value={search} placeholder="Email, order ID, payment ID..." class="admin-input" />
          </div>
        </div>

        <div class="filter-col">
          <label for="projectId" class="admin-label">Project</label>
          <select name="projectId" id="projectId" class="admin-select">
            <option value="">All Projects</option>
            {projects.map(p => (
              <option value={p.id} selected={p.id.toString() === projectId}>{p.title}</option>
            ))}
          </select>
        </div>

        <div class="filter-col">
          <label for="status" class="admin-label">Status</label>
          <select name="status" id="status" class="admin-select">
            {statuses.map(s => (
              <option value={s} selected={s === status}>{s.charAt(0).toUpperCase() + s.slice(1)}</option>
            ))}
          </select>
        </div>

        <div class="filter-col">
          <label for="dateStart" class="admin-label">Date Start</label>
          <input type="date" name="dateStart" id="dateStart" value={dateStart} class="admin-input" />
        </div>

        <div class="filter-col">
          <label for="dateEnd" class="admin-label">Date End</label>
          <div style="display: flex; gap: 0.5rem;">
            <input type="date" name="dateEnd" id="dateEnd" value={dateEnd} class="admin-input" />
            <button type="submit" class="admin-btn admin-btn--secondary">Filter</button>
          </div>
        </div>
      </form>

      <!-- Desktop Table in Card -->
      <div class="admin-table-card">
        <div class="admin-table-wrap">
          {view === 'customers' ? (
            <table id="dataTable" class="admin-table-standard" data-view={view}>
              <thead>
                <tr>
                  <th>Customer Email</th>
                  <th>Total Spent</th>
                  <th>Orders Count</th>
                </tr>
              </thead>
              <tbody>
                {groupedCustomers.map(c => (
                  <tr data-customer-email={c.email} data-customer-amount={c.amount_inr} data-customer-count={c.count}>
                    <td style="font-weight: 600; min-width: 0; max-width: 21.25rem;">
                      <div class="admin-cell-truncate" title={c.email}>{c.email}</div>
                    </td>
                    <td style="font-weight: 700; color: var(--admin-ink); white-space: nowrap;">{formatINR(c.amount_inr)}</td>
                    <td style="white-space: nowrap;">{c.count} {c.count === 1 ? 'order' : 'orders'}</td>
                  </tr>
                ))}
                {groupedCustomers.length === 0 && (
                  <tr>
                    <td colspan="3" style="text-align: center; padding: 3rem; color: var(--admin-muted);">No customers found.</td>
                  </tr>
                )}
              </tbody>
            </table>
          ) : (
            <table id="dataTable" class="admin-table-standard" data-view={view}>
              <thead>
                <tr>
                  <th style="width: 8.75rem;">ID / Date</th>
                  <th>Customer</th>
                  <th>Project</th>
                  <th style="width: 7.5rem;">Amount</th>
                  <th style="width: 6.875rem;">Status</th>
                </tr>
              </thead>
              <tbody>
                {orders.map(order => {
                  const projName = projectMap.get(order.project_id) || `Project #${order.project_id}`;
                  const isPaid = order.status === 'paid';
                  const isRefunded = order.status === 'refunded';
                  return (
                    <tr class="order-row-clickable" data-order-id={order.id} data-order={JSON.stringify(order)} data-project-name={projName}>
                      <td style="white-space: nowrap;">
                        <div style="font-weight: 700; color: var(--admin-ink);">{order.id}</div>
                        <div style="font-size: max(12px, 0.75rem); color: var(--admin-muted);">{formatDate(order.created_at)}</div>
                      </td>
                      <td style="min-width: 0; max-width: 13.75rem;">
                        <div style="font-weight: 600;" class="admin-cell-truncate" title={order.name || 'Anonymous'}>{order.name || 'Anonymous'}</div>
                        <div style="font-size: max(12px, 0.75rem); color: var(--admin-muted);" class="admin-cell-truncate" title={order.email}>{order.email}</div>
                      </td>
                      <td style="font-weight: 500; min-width: 0; max-width: 18.75rem;">
                        <div class="admin-cell-truncate" title={projName}>{projName}</div>
                      </td>
                      <td style="font-weight: 700; white-space: nowrap;">{formatINR(order.amount_inr)}</td>
                      <td style="white-space: nowrap;">
                        <span class:list={['admin-chip', isPaid ? 'admin-chip--live' : isRefunded ? 'admin-chip--danger' : 'admin-chip--draft']}>
                          {order.status}
                        </span>
                      </td>
                    </tr>
                  );
                })}
                {orders.length === 0 && (
                  <tr>
                    <td colspan="5" style="text-align: center; padding: 3rem; color: var(--admin-muted);">No orders found.</td>
                  </tr>
                )}
              </tbody>
            </table>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- ==============================================
       MOBILE ORDERS VIEW (Screen width <= 768px)
       Dedicated layout with card list and filter chips
       ============================================== -->
  <div class="admin-mobile-shell">
    <header class="admin-mobile-topbar">
      <h1 class="admin-mobile-topbar__title">Orders</h1>
      <a
        href={`?${new URLSearchParams({ ...Object.fromEntries(url.searchParams), view: view === 'customers' ? 'orders' : 'customers' })}`}
        class="admin-btn admin-btn--secondary admin-btn--sm"
      >
        {view === 'customers' ? 'Orders' : 'Customers'}
      </a>
    </header>

    <div class="admin-mobile-content">
      <!-- Search -->
      <form class="mobile-search-form" method="get">
        <input type="hidden" name="status" value={status} />
        <input type="hidden" name="view" value={view} />
        <div class="mobile-search-wrap">
          <Icon name="search" size={18} class="mobile-search-icon" />
          <input
            type="search"
            name="search"
            value={search}
            placeholder="Search email, name..."
            class="admin-input mobile-search-field"
            autocomplete="off"
          />
        </div>
      </form>

      <!-- Horizontal Filter Chips -->
      <div class="mobile-chips-track">
        {statuses.map((s) => (
          <a
            href={`?${new URLSearchParams({ ...Object.fromEntries(url.searchParams), status: s })}`}
            class:list={['admin-chip admin-chip--filter', { 'is-active': status === s }]}
          >
            {s === 'all' ? 'All' : s.charAt(0).toUpperCase() + s.slice(1)}
          </a>
        ))}
      </div>

      <!-- Card List -->
      {view === 'customers' ? (
        <div class="admin-card mobile-orders-list-card">
          {groupedCustomers.map((c) => (
            <div class="mobile-order-card">
              <div class="mobile-order-top">
                <span class="order-card-email">{c.email}</span>
                <span class="order-card-amount">{formatINR(c.amount_inr)}</span>
              </div>
              <div class="mobile-order-sub">
                <span class="order-card-meta">{c.count} {c.count === 1 ? 'order' : 'orders'}</span>
              </div>
            </div>
          ))}
          {groupedCustomers.length === 0 && (
            <div class="mobile-empty-orders">No customers found.</div>
          )}
        </div>
      ) : (
        <div class="admin-card mobile-orders-list-card">
          {orders.map((order) => {
            const projName = projectMap.get(order.project_id) || `Project #${order.project_id}`;
            const isPaid = order.status === 'paid';
            const isRefunded = order.status === 'refunded';
            return (
              <div class="mobile-order-card order-row-clickable" data-order-id={order.id} data-order={JSON.stringify(order)} data-project-name={projName}>
                <div class="mobile-order-top">
                  <span class="order-card-project">{projName}</span>
                  <span class="order-card-amount">{formatINR(order.amount_inr)}</span>
                </div>
                <div class="mobile-order-middle">
                  <span class="order-card-customer">{order.name || 'Anonymous'}</span>
                  <span class="order-card-email">{order.email}</span>
                </div>
                <div class="mobile-order-bottom">
                  <span class="order-card-date">{formatDate(order.created_at)}</span>
                  <span class:list={['admin-chip', isPaid ? 'admin-chip--live' : isRefunded ? 'admin-chip--danger' : 'admin-chip--draft']}>
                    {order.status}
                  </span>
                </div>
              </div>
            );
          })}
          {orders.length === 0 && (
            <div class="mobile-empty-orders">No orders found.</div>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- ==============================================
       ORDER DETAIL SLIDE-OVER DRAWER (Desktop & Mobile)
       ============================================== -->
  <dialog id="orderDrawer" class="admin-drawer-dialog" aria-labelledby="drawer-title">
    <div class="drawer-container">
      <div class="drawer-header">
        <h2 class="drawer-title" id="drawer-title">Order Details</h2>
        <button type="button" id="closeDrawer" class="admin-btn admin-btn--ghost admin-btn--icon" aria-label="Close">
          <Icon name="close" size={20} />
        </button>
      </div>
      <div class="drawer-body" id="drawerContent">
        <!-- Injected via JS -->
      </div>

      <!-- CUSTOM REFUND CONFIRM MODAL (Inside Dialog) -->
      <div id="refundConfirmModal" class="refund-modal" hidden>
        <div class="refund-modal-backdrop" id="refundModalBackdrop"></div>
        <div class="refund-modal-content" role="dialog" aria-modal="true" aria-labelledby="refundModalHeading">
          <h3 id="refundModalHeading" class="refund-modal-title">Confirm Refund</h3>
          <p id="refundModalMessage" class="refund-modal-body"></p>
          <div id="refundModalError" class="admin-alert admin-alert--danger" style="display: none; margin: 0; font-size: max(12px, 0.8125rem);"></div>
          <div class="refund-modal-actions">
            <button type="button" id="cancelRefundBtn" class="admin-btn admin-btn--secondary">Cancel</button>
            <button type="button" id="confirmRefundBtn" class="admin-btn admin-btn--danger">
              <span class="btn-text">Confirm Refund</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </dialog>
</Admin>

<style>
  /* Desktop Layout */
  @media (max-width: 768px) {
    .orders-desktop-view { display: none !important; }
  }

  .orders-filter-toolbar {
    display: grid;
    grid-template-columns: 2fr 1.5fr 1fr 1fr 1.2fr;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1.25rem;
    background: var(--admin-card);
    padding: 1rem 1.25rem;
    border-radius: var(--admin-r-card);
    border: var(--admin-border);
  }
  @media (max-width: 1023px) {
    .orders-filter-toolbar {
      grid-template-columns: 1fr 1fr;
    }
  }

  .filter-col {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .input-with-icon {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: 0.75rem;
    color: var(--admin-muted);
    pointer-events: none;
  }
  .input-with-icon input {
    padding-left: 2.25rem;
  }

  .order-row-clickable {
    cursor: pointer;
    transition: background var(--admin-duration) var(--admin-ease);
  }
  .order-row-clickable:hover {
    background: #FAFBFD;
  }

  /* Chip danger for refunded */
  :global(.admin-chip--danger) {
    background: #FEE2E2 !important;
    color: #991B1B !important;
    border-color: #FCA5A5 !important;
  }

  /* Mobile Layout */
  .mobile-search-wrap {
    position: relative;
    margin-bottom: 0.75rem;
  }
  .mobile-search-icon {
    position: absolute;
    left: 0.875rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--admin-muted);
    pointer-events: none;
  }
  .mobile-search-field {
    padding-left: 2.625rem !important;
  }
  .mobile-chips-track {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.75rem;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-orders-list-card {
    padding: 0.5rem 1rem;
  }
  .mobile-order-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--admin-line-subtle);
  }
  .mobile-order-card:last-child {
    border-bottom: none;
  }
  .mobile-order-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .order-card-project {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--admin-ink);
  }
  .order-card-amount {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--admin-ink);
  }
  .mobile-order-middle {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .order-card-customer {
    font-size: max(12px, 0.8438rem);
    color: var(--admin-ink);
    font-weight: 500;
  }
  .order-card-email {
    font-size: max(12px, 0.75rem);
    color: var(--admin-muted);
    word-break: break-all;
  }
  .mobile-order-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.25rem;
  }
  .order-card-date {
    font-size: max(12px, 0.75rem);
    color: var(--admin-muted);
  }
  .mobile-empty-orders {
    text-align: center;
    padding: 2rem 1rem;
    color: var(--admin-muted);
    font-size: max(12px, 0.875rem);
  }

  /* Drawer Dialog */
  .admin-drawer-dialog {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100dvh;
  }
  .admin-drawer-dialog::backdrop {
    background: rgba(15, 17, 21, 0.45);
    backdrop-filter: blur(0.25rem);
  }
  .drawer-container {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 28.75rem;
    max-width: 100vw;
    background: var(--admin-card);
    display: flex;
    flex-direction: column;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.1);
    animation: drawerSlide 0.22s var(--admin-ease);
  }
  @media (max-width: 768px) {
    .drawer-container {
      width: 100vw;
    }
  }
  @keyframes drawerSlide {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }
  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.125rem 1.5rem;
    border-bottom: var(--admin-border);
  }
  .drawer-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0;
  }
  .drawer-body {
    padding: 1.5rem;
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  /* Drawer Timeline */
  :global(.drawer-timeline-card) {
    background: #F8FAFC;
    border: 1px solid var(--admin-line);
    border-radius: 0.75rem;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  :global(.drawer-timeline-title) {
    font-size: max(12px, 0.75rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--admin-muted);
  }
  :global(.drawer-timeline) {
    position: relative;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  :global(.drawer-timeline::before) {
    content: '';
    position: absolute;
    top: 0.375rem;
    bottom: 0.375rem;
    left: 0.375rem;
    width: 0.125rem;
    background: var(--admin-line);
  }
  :global(.timeline-step) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  :global(.timeline-dot) {
    position: absolute;
    left: -1.25rem;
    top: 0.25rem;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: #fff;
    border: 2px solid #CBD5E1;
    box-sizing: border-box;
  }
  :global(.timeline-step.is-done .timeline-dot) {
    border-color: #10B981;
    background: #10B981;
  }
  :global(.timeline-step.is-refunded .timeline-dot) {
    border-color: #EF4444;
    background: #EF4444;
  }
  :global(.timeline-label) {
    font-size: max(12px, 0.8438rem);
    font-weight: 600;
    color: var(--admin-ink);
  }
  :global(.timeline-time) {
    font-size: max(12px, 0.75rem);
    color: var(--admin-muted);
  }
  :global(.timeline-meta) {
    font-size: max(12px, 0.7188rem);
    font-family: var(--admin-font-mono);
    color: var(--admin-muted);
  }
  :global(.resend-info-label) {
    font-size: max(12px, 0.75rem);
    color: var(--admin-muted);
    text-align: center;
    margin-top: 0.375rem;
  }

  /* Refund Modal */
  .refund-modal {
    position: absolute;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .refund-modal[hidden] {
    display: none;
  }
  .refund-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 17, 21, 0.6);
    backdrop-filter: blur(0.25rem);
  }
  .refund-modal-content {
    position: relative;
    background: var(--admin-card);
    border: var(--admin-border);
    border-radius: 0.875rem;
    max-width: 27.5rem;
    width: 100%;
    padding: 1.5rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    animation: modalScale 0.18s var(--admin-ease);
  }
  @keyframes modalScale {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }
  .refund-modal-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--admin-ink);
    margin: 0;
  }
  .refund-modal-body {
    font-size: max(12px, 0.875rem);
    line-height: 1.5;
    color: var(--admin-muted);
    margin: 0;
  }
  .refund-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }
</style>

<script>
  // CSRF token from meta or fallback
  function getCsrfToken() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
  }

  // Money formatting client helper
  function formatINRClient(rupees) {
    const n = Number(rupees);
    if (!n || n <= 0 || isNaN(n)) return 'Free';
    return '₹' + new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
  }

  // Date parsing client helper: handles legacy seconds (<1e12) and ISO strings
  function parseDateClient(val) {
    if (val === null || val === undefined || val === '') return null;
    if (val instanceof Date) return isNaN(val.getTime()) ? null : val;
    if (typeof val === 'number') {
      if (val <= 0) return null;
      const ms = val < 1e12 ? val * 1000 : val;
      const d = new Date(ms);
      return isNaN(d.getTime()) ? null : d;
    }
    if (typeof val === 'string') {
      const s = val.trim();
      if (!s) return null;
      if (/^\d+$/.test(s)) {
        const num = Number(s);
        if (num <= 0) return null;
        const ms = num < 1e12 ? num * 1000 : num;
        const d = new Date(ms);
        return isNaN(d.getTime()) ? null : d;
      }
      const d = new Date(s);
      return isNaN(d.getTime()) ? null : d;
    }
    return null;
  }

  // Format in Asia/Kolkata timezone as "14 Oct 2026, 11:14 PM"
  function formatDateTimeClient(val) {
    const d = parseDateClient(val);
    if (!d) return '—';
    const raw = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Kolkata',
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      hour12: true
    }).format(d);
    return raw.replace(/am|pm/i, m => m.toUpperCase());
  }

  // In-memory data store for live updates
  const ordersMap = new Map();
  document.querySelectorAll('.order-row-clickable').forEach(el => {
    const raw = el.getAttribute('data-order');
    if (raw) {
      try {
        const order = JSON.parse(raw);
        if (order && order.id && !ordersMap.has(order.id)) {
          order._projectName = el.getAttribute('data-project-name') || '';
          ordersMap.set(order.id, order);
        }
      } catch {}
    }
  });

  // CSV Export
  const exportBtn = document.getElementById('exportCsvBtn');
  if (exportBtn) {
    exportBtn.addEventListener('click', () => {
      const table = document.getElementById('dataTable');
      const isCustomers = table?.getAttribute('data-view') === 'customers';
      let csv = [];
      if (isCustomers) {
        csv.push(['"Customer Email"', '"Total Spent"', '"Orders Count"'].join(','));
        const custRows = document.querySelectorAll('#dataTable tbody tr[data-customer-email]');
        custRows.forEach(tr => {
          const email = tr.getAttribute('data-customer-email') || '';
          const amt = tr.getAttribute('data-customer-amount') || '0';
          const cnt = tr.getAttribute('data-customer-count') || '0';
          csv.push([
            `"${email.replace(/"/g, '""')}"`,
            `"${formatINRClient(amt)}"`,
            `"${cnt}"`
          ].join(','));
        });
      } else {
        csv.push([
          '"Order ID"',
          '"Date"',
          '"Customer Name"',
          '"Customer Email"',
          '"Project"',
          '"Amount"',
          '"Status"',
          '"Razorpay Order ID"',
          '"Razorpay Payment ID"'
        ].join(','));
        for (const order of ordersMap.values()) {
          const projName = order._projectName || `Project #${order.project_id}`;
          csv.push([
            `"${(order.id || '').replace(/"/g, '""')}"`,
            `"${formatDateTimeClient(order.created_at)}"`,
            `"${(order.name || 'Anonymous').replace(/"/g, '""')}"`,
            `"${(order.email || '').replace(/"/g, '""')}"`,
            `"${(projName || '').replace(/"/g, '""')}"`,
            `"${formatINRClient(order.amount_inr)}"`,
            `"${order.status || ''}"`,
            `"${(order.razorpay_order_id || '').replace(/"/g, '""')}"`,
            `"${(order.razorpay_payment_id || '').replace(/"/g, '""')}"`
          ].join(','));
        }
      }
      const blob = new Blob([csv.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.setAttribute('href', url);
      a.setAttribute('download', `orders-export-${new Date().toISOString().slice(0, 10)}.csv`);
      a.click();
      window.URL.revokeObjectURL(url);
    });
  }

  // Drawer Elements
  const drawer = document.getElementById('orderDrawer');
  const drawerContent = document.getElementById('drawerContent');
  const closeBtn = document.getElementById('closeDrawer');

  // Refund Modal Elements
  const refundModal = document.getElementById('refundConfirmModal');
  const refundModalBackdrop = document.getElementById('refundModalBackdrop');
  const refundModalMessage = document.getElementById('refundModalMessage');
  const refundModalError = document.getElementById('refundModalError');
  const cancelRefundBtn = document.getElementById('cancelRefundBtn');
  const confirmRefundBtn = document.getElementById('confirmRefundBtn');

  let activeOrderForRefund = null;

  function closeRefundConfirm() {
    if (!refundModal) return;
    refundModal.hidden = true;
    if (refundModalError) {
      refundModalError.style.display = 'none';
      refundModalError.textContent = '';
    }
    activeOrderForRefund = null;
    if (confirmRefundBtn) {
      confirmRefundBtn.disabled = false;
      confirmRefundBtn.innerHTML = '<span class="btn-text">Confirm Refund</span>';
    }
  }

  cancelRefundBtn?.addEventListener('click', closeRefundConfirm);
  refundModalBackdrop?.addEventListener('click', closeRefundConfirm);

  function openRefundConfirm(order) {
    if (!refundModal || !refundModalMessage || !confirmRefundBtn) return;
    activeOrderForRefund = order;
    const formattedAmt = formatINRClient(order.amount_inr);
    refundModalMessage.textContent = `Refund ${formattedAmt} to ${order.email}? The money returns through Razorpay and download access is revoked. This cannot be undone.`;
    confirmRefundBtn.innerHTML = `<span class="btn-text">Refund ${formattedAmt}</span>`;
    if (refundModalError) {
      refundModalError.style.display = 'none';
      refundModalError.textContent = '';
    }
    refundModal.hidden = false;
  }

  confirmRefundBtn?.addEventListener('click', async () => {
    if (!activeOrderForRefund || !confirmRefundBtn) return;
    const order = activeOrderForRefund;
    confirmRefundBtn.disabled = true;
    confirmRefundBtn.innerHTML = '<span class="btn-text">Processing refund...</span>';
    if (refundModalError) refundModalError.style.display = 'none';

    try {
      const csrf = getCsrfToken();
      const res = await fetch(`/api/admin/orders/${order.id}/refund`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': csrf
        },
        body: JSON.stringify({ csrf })
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Failed to refund order');
      }

      // Update state
      order.status = 'refunded';
      order.refund_id = data.refund_id || 'rfnd_' + Date.now();
      order.refunded_at = data.refunded_at || new Date().toISOString();
      order.download_token = '';
      ordersMap.set(order.id, order);

      // Update UI row/cards in DOM
      document.querySelectorAll(`[data-order-id="${order.id}"]`).forEach(el => {
        el.dataset.order = JSON.stringify(order);
        const chip = el.querySelector('.admin-chip');
        if (chip) {
          chip.className = 'admin-chip admin-chip--danger';
          chip.textContent = 'refunded';
        }
      });

      closeRefundConfirm();
      openOrderDrawer(order);

      if (window.toast) {
        window.toast(`Refund of ${formatINRClient(order.amount_inr)} to ${order.email} completed.`, 'success');
      }
    } catch (e) {
      if (refundModalError) {
        refundModalError.textContent = e.message || 'Refund error occurred.';
        refundModalError.style.display = 'block';
      }
      confirmRefundBtn.disabled = false;
      const formattedAmt = formatINRClient(order.amount_inr);
      confirmRefundBtn.innerHTML = `<span class="btn-text">Refund ${formattedAmt}</span>`;
    }
  });

  function openOrderDrawer(order) {
    if (!drawer || !drawerContent) return;
    const projName = order._projectName || (document.querySelector(`[data-order-id="${order.id}"]`)?.getAttribute('data-project-name')) || `Project #${order.project_id}`;
    const isPaid = order.status === 'paid';
    const isRefunded = order.status === 'refunded';
    const isPaidOrRefunded = isPaid || isRefunded;

    drawerContent.innerHTML = `
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <!-- Top Status Card -->
        <div style="background: #F8FAFC; border: 1px solid var(--admin-line); border-radius: 0.75rem; padding: 1rem;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
            <span style="font-size: max(12px, 0.75rem); color: var(--admin-muted); font-weight: 600;">ORDER ID</span>
            <span class="admin-chip ${isPaid ? 'admin-chip--live' : isRefunded ? 'admin-chip--danger' : 'admin-chip--draft'}">${order.status}</span>
          </div>
          <div style="font-size: 1.125rem; font-weight: 700; color: var(--admin-ink);">${order.id}</div>
          <div style="font-size: max(12px, 0.8125rem); color: var(--admin-muted); margin-top: 0.25rem;">${formatDateTimeClient(order.created_at)}</div>
        </div>

        <!-- Details Grid -->
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <div class="admin-field">
            <span class="admin-label">Customer</span>
            <div style="font-size: max(12px, 0.9063rem); font-weight: 600;">${order.name || 'Anonymous'}</div>
            <div style="font-size: max(12px, 0.8125rem); color: var(--admin-muted);">${order.email}</div>
          </div>

          <div class="admin-field">
            <span class="admin-label">Project</span>
            <div style="font-size: max(12px, 0.9063rem); font-weight: 600; color: var(--admin-ink);">${projName}</div>
          </div>

          <div class="admin-field">
            <span class="admin-label">Amount</span>
            <div style="font-size: 1.25rem; font-weight: 700; color: var(--admin-ink);">${formatINRClient(order.amount_inr)}</div>
          </div>

          <div class="admin-field">
            <span class="admin-label">Razorpay Order ID</span>
            <div style="font-size: max(12px, 0.8125rem); font-family: var(--admin-font-mono); color: var(--admin-muted); word-break: break-all;">${order.razorpay_order_id || '—'}</div>
          </div>

          <div class="admin-field">
            <span class="admin-label">Razorpay Payment ID</span>
            <div style="font-size: max(12px, 0.8125rem); font-family: var(--admin-font-mono); color: var(--admin-muted); word-break: break-all;">${order.razorpay_payment_id || '—'}</div>
          </div>

          ${isRefunded ? `
            <div class="admin-field">
              <span class="admin-label">Refund ID</span>
              <div style="font-size: max(12px, 0.8125rem); font-family: var(--admin-font-mono); color: #991B1B; word-break: break-all;">${order.refund_id || '—'}</div>
            </div>
          ` : ''}
        </div>

        <!-- Order Timeline -->
        <div class="drawer-timeline-card">
          <div class="drawer-timeline-title">Order Timeline</div>
          <div class="drawer-timeline">
            <div class="timeline-step is-done">
              <div class="timeline-dot"></div>
              <div class="timeline-label">Order created</div>
              <div class="timeline-time">${formatDateTimeClient(order.created_at)}</div>
            </div>
            <div class="timeline-step ${isPaidOrRefunded ? 'is-done' : ''}">
              <div class="timeline-dot"></div>
              <div class="timeline-label">Payment captured</div>
              <div class="timeline-time">${isPaidOrRefunded ? formatDateTimeClient(order.paid_at || order.created_at) : 'Awaiting payment'}</div>
              ${order.razorpay_payment_id ? `<div class="timeline-meta">${order.razorpay_payment_id}</div>` : ''}
            </div>
            <div class="timeline-step ${isPaidOrRefunded ? 'is-done' : ''}">
              <div class="timeline-dot"></div>
              <div class="timeline-label">Download email sent</div>
              <div class="timeline-time" id="timelineEmailSentTime">
                ${order.last_resent_at ? ('Resent ' + formatDateTimeClient(order.last_resent_at)) : (isPaidOrRefunded ? formatDateTimeClient(order.paid_at || order.created_at) : 'Pending payment')}
              </div>
            </div>
            ${isRefunded ? `
              <div class="timeline-step is-refunded">
                <div class="timeline-dot"></div>
                <div class="timeline-label" style="color: #991B1B;">Refunded</div>
                <div class="timeline-time">${formatDateTimeClient(order.refunded_at || order.created_at)}</div>
                ${order.refund_id ? `<div class="timeline-meta">ID: ${order.refund_id}</div>` : ''}
              </div>
            ` : ''}
          </div>
        </div>

        <!-- Actions -->
        <div style="display: flex; flex-direction: column; gap: 0.625rem; margin-top: 0.5rem; padding-top: 1rem; border-top: var(--admin-border);">
          ${isPaid ? `
            <div>
              <button type="button" id="drawerResendBtn" class="admin-btn admin-btn--secondary" style="width: 100%;">
                <span class="btn-text">Resend Download Email</span>
              </button>
              <div class="resend-info-label" id="drawerLastResentLabel">
                ${order.last_resent_at ? `Last sent: ${formatDateTimeClient(order.last_resent_at)}` : `Initial email sent on purchase`}
              </div>
            </div>

            <button type="button" id="drawerOpenRefundBtn" class="admin-btn admin-btn--danger" style="width: 100%;">
              Refund via Razorpay API
            </button>
          ` : ''}

          ${isRefunded ? `
            <div class="admin-alert admin-alert--warning" style="margin: 0; font-size: max(12px, 0.8125rem);">
              This order has been refunded. Download access has been revoked.
            </div>
          ` : ''}
        </div>
      </div>
    `;

    // Wire up Resend in Drawer
    const resendBtn = document.getElementById('drawerResendBtn');
    const lastResentLabel = document.getElementById('drawerLastResentLabel');
    const timelineEmailSentTime = document.getElementById('timelineEmailSentTime');

    if (resendBtn) {
      resendBtn.addEventListener('click', async () => {
        resendBtn.disabled = true;
        resendBtn.innerHTML = '<span class="btn-text">Sending download email...</span>';
        try {
          const csrf = getCsrfToken();
          const res = await fetch(`/api/admin/orders/${order.id}/resend`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': csrf
            },
            body: JSON.stringify({ csrf })
          });

          const data = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.error || 'Failed to resend download email');
          }

          const nowIso = data.last_resent_at || new Date().toISOString();
          order.last_resent_at = nowIso;
          order.resend_count = (order.resend_count || 0) + 1;
          ordersMap.set(order.id, order);

          const formattedTime = formatDateTimeClient(nowIso);
          if (lastResentLabel) lastResentLabel.textContent = `Last sent: ${formattedTime}`;
          if (timelineEmailSentTime) timelineEmailSentTime.textContent = `Resent ${formattedTime}`;

          if (window.toast) {
            window.toast(`Download email sent to ${order.email}`, 'success');
          }
        } catch (e) {
          if (window.toast) {
            window.toast(e.message || 'Failed to resend download email', 'error');
          }
        } finally {
          resendBtn.disabled = false;
          resendBtn.innerHTML = '<span class="btn-text">Resend Download Email</span>';
        }
      });
    }

    // Wire up Refund in Drawer
    const openRefundBtn = document.getElementById('drawerOpenRefundBtn');
    if (openRefundBtn) {
      openRefundBtn.addEventListener('click', () => {
        openRefundConfirm(order);
      });
    }

    drawer.showModal();
  }

  // Row / card click event listeners
  document.querySelectorAll('.order-row-clickable').forEach((row) => {
    row.addEventListener('click', () => {
      const orderId = row.dataset.orderId;
      const order = (orderId && ordersMap.get(orderId)) || (row.dataset.order ? JSON.parse(row.dataset.order) : null);
      if (order) {
        openOrderDrawer(order);
      }
    });
  });

  closeBtn?.addEventListener('click', () => drawer?.close());
  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) drawer.close();
  });
</script>
