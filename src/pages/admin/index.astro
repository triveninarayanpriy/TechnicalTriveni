---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { adminStats, listRecentOrders } from '../../lib/db';
import { formatINR, formatDateTime } from '../../lib/format';
import { razorpayConfigured } from '../../lib/razorpay';
import { turnstileEnabled } from '../../lib/turnstile';

const stats = await adminStats(env.DB);
const recent = (await listRecentOrders(env.DB, 6)).filter((o) => o.status === 'paid');

const checklist = [
  { ok: razorpayConfigured(env), label: 'Razorpay payments', hint: 'Set RAZORPAY_* secrets and RAZORPAY_ENABLED=true' },
  { ok: turnstileEnabled(env), label: 'Turnstile bot protection', hint: 'Set TURNSTILE_* secrets and TURNSTILE_ENABLED=true' },
  { ok: !!env.RESEND_API_KEY, label: 'Email receipts (optional)', hint: 'Set RESEND_API_KEY to email download links' },
  { ok: !!env.SESSION_SECRET && env.SESSION_SECRET.length > 20, label: 'Session secret', hint: 'Set a long random SESSION_SECRET' },
];

const cards = [
  { label: 'Projects', value: stats.projects, sub: `${stats.published} published`, icon: 'cpu', href: '/admin/projects' },
  { label: 'Paid orders', value: stats.orders, sub: 'all time', icon: 'cart', href: '/admin/orders' },
  { label: 'Revenue', value: formatINR(stats.revenue), sub: 'gross', icon: 'bolt', href: '/admin/orders' },
  { label: 'Messages', value: stats.unreadMessages, sub: 'unread', icon: 'mail', href: '/admin/messages' },
];
---

<Admin title="Dashboard" active="dashboard">
  <div class="stat-grid">
    {cards.map((c) => (
      <a href={c.href} class="stat-card">
        <div class="stat-card__icon"><Icon name={c.icon} size={20} /></div>
        <div class="stat-card__value">{c.value}</div>
        <div class="stat-card__label">{c.label}</div>
        <div class="stat-card__sub dim">{c.sub}</div>
      </a>
    ))}
  </div>

  <div class="dash-grid">
    <section class="dash-panel">
      <div class="dash-panel__head">
        <h2>Recent orders</h2>
        <a href="/admin/orders" class="link-more">View all <Icon name="arrow-right" size={14} /></a>
      </div>
      {recent.length > 0 ? (
        <div class="table-wrap">
          <table class="admin-table">
            <thead><tr><th>Project</th><th>Email</th><th>Amount</th><th>When</th></tr></thead>
            <tbody>
              {recent.map((o) => (
                <tr>
                  <td>{o.project_title}</td>
                  <td class="mono dim">{o.email}</td>
                  <td>{formatINR(o.amount_inr)}</td>
                  <td class="dim">{formatDateTime(o.paid_at || o.created_at)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="dim">No paid orders yet. They'll appear here as customers buy combos.</p>
      )}
    </section>

    <section class="dash-panel">
      <div class="dash-panel__head"><h2>Setup checklist</h2></div>
      <ul class="checklist">
        {checklist.map((c) => (
          <li class:list={['checklist__item', { 'is-ok': c.ok }]}>
            <Icon name={c.ok ? 'check-circle' : 'lock'} size={18} />
            <div>
              <strong>{c.label}</strong>
              {!c.ok && <span class="dim">{c.hint}</span>}
            </div>
          </li>
        ))}
      </ul>
      <a href="/admin/projects/new" class="btn btn-primary btn-block" style="margin-top:1.25rem">
        <Icon name="spark" size={16} /> Create a project
      </a>
    </section>
  </div>
</Admin>

<style>
  .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
  .stat-card { padding: 1.25rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); transition: border-color 0.2s, transform 0.2s; }
  .stat-card:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .stat-card__icon { width: 40px; height: 40px; display: grid; place-items: center; border-radius: var(--r-sm); background: rgba(231,36,42,0.12); color: var(--brand-red); margin-bottom: 0.85rem; }
  .stat-card__value { font-family: var(--font-display); font-weight: 700; font-size: 1.9rem; line-height: 1; }
  .stat-card__label { margin-top: 0.35rem; font-weight: 550; }
  .stat-card__sub { font-size: var(--fs-xs); }

  .dash-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 1.25rem; }
  .dash-panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 1.5rem; }
  .dash-panel__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.1rem; }
  .dash-panel__head h2 { font-size: var(--fs-md); }
  .link-more { display: inline-flex; align-items: center; gap: 0.3rem; font-size: var(--fs-sm); color: var(--brand-red); }

  .admin-table { width: 100%; border-collapse: collapse; min-width: 460px; }
  .admin-table th { text-align: left; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dim); padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); }
  .admin-table td { padding: 0.7rem 0.75rem; border-bottom: 1px solid var(--hairline); font-size: var(--fs-sm); }

  .checklist { display: flex; flex-direction: column; gap: 0.75rem; }
  .checklist__item { display: flex; gap: 0.7rem; align-items: flex-start; color: var(--warning); }
  .checklist__item.is-ok { color: var(--success); }
  .checklist__item div { display: flex; flex-direction: column; }
  .checklist__item strong { color: var(--text); font-weight: 550; font-size: var(--fs-sm); }
  .checklist__item .dim { font-size: var(--fs-xs); }

  @media (max-width: 1000px) { .stat-grid { grid-template-columns: 1fr 1fr; } .dash-grid { grid-template-columns: 1fr; } }
</style>
