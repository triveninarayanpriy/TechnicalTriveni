---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { getDashboardStats } from '../../lib/db';
import { formatINR } from '../../lib/format';
import { razorpayConfigured } from '../../lib/razorpay';

const days = parseInt(Astro.url.searchParams.get('days') || '30', 10);
const stats = await getDashboardStats(env.DB, days);

const maxRevenue = stats.topProjects.length > 0 
  ? Math.max(...stats.topProjects.map((p) => p.revenue), 1) 
  : 1;

const hasPayments = razorpayConfigured(env);

// Fetch covers for top projects
const projectIds = stats.topProjects.map((p) => p.id).filter(Boolean);
const coverMap = new Map<number, string>();
if (projectIds.length > 0) {
  try {
    const placeholders = projectIds.map(() => '?').join(',');
    const imgRes = await env.DB.prepare(`SELECT project_id, url, kind FROM project_images WHERE project_id IN (${placeholders}) ORDER BY sort ASC`).bind(...projectIds).all<{ project_id: number; url: string; kind: string }>();
    for (const img of imgRes.results ?? []) {
      if (!coverMap.has(img.project_id) || img.kind === 'cover') {
        coverMap.set(img.project_id, img.url);
      }
    }
  } catch {}
}
---

<Admin title="Dashboard" active="dashboard">
  <!-- ==============================================
       DESKTOP / TABLET DASHBOARD (Screen width >= 769px)
       Matches desktop screenshot exactly
       ============================================== -->
  <div class="dash-desktop-view">
    <!-- Topbar: Title on left, Segmented range on right -->
    <header class="admin-desktop-topbar">
      <h1 class="admin-desktop-topbar__title">Dashboard</h1>
      <div class="admin-desktop-topbar__actions">
        <div class="admin-segmented">
          <a href="/admin?days=7" class:list={['admin-segment-item', { 'is-active': days === 7 }]}>7D</a>
          <a href="/admin?days=30" class:list={['admin-segment-item', { 'is-active': days === 30 }]}>30D</a>
          <a href="/admin?days=0" class:list={['admin-segment-item', { 'is-active': days === 0 }]}>All time</a>
        </div>
      </div>
    </header>

    <div class="admin-desktop-content">
      <!-- Row 1: Stat Cards (Net Revenue 2x width, Paid orders, Conversion) -->
      <div class="dash-row-stats">
        <!-- Net Revenue (Double width card) -->
        <div class="admin-card dash-stat-card dash-stat-card--revenue">
          <span class="dash-stat-label">Net revenue</span>
          <div class="dash-stat-value">{formatINR(stats.revenue)}</div>
          <span class="dash-stat-sub">Excludes test orders and refunds</span>
        </div>

        <!-- Paid Orders -->
        <div class="admin-card dash-stat-card">
          <span class="dash-stat-label">Paid orders</span>
          <div class="dash-stat-value">{stats.orders}</div>
          <span class="dash-stat-sub">Completed</span>
        </div>

        <!-- Conversion -->
        <div class="admin-card dash-stat-card">
          <span class="dash-stat-label">Conversion</span>
          <div class="dash-stat-value">{stats.conversion.toFixed(1)}%</div>
          <span class="dash-stat-sub">Pending to paid</span>
        </div>
      </div>

      <!-- Row 2: Top projects beside Needs attention -->
      <div class="dash-row-split">
        <!-- Left: Top projects -->
        <div class="admin-card dash-projects-card">
          <h2 class="dash-card-title">Top projects</h2>
          <div class="dash-projects-list">
            {stats.topProjects.map((p) => {
              const pct = Math.max(8, Math.round((p.revenue / maxRevenue) * 100));
              const cover = coverMap.get(p.id);
              return (
                <div class="dash-project-row">
                  <div class="dash-project-thumb">
                    {cover ? (
                      <img src={cover} alt="" loading="lazy" />
                    ) : (
                      <div class="dash-project-placeholder"><Icon name="cube" size={20} /></div>
                    )}
                  </div>
                  <div class="dash-project-info">
                    <div class="dash-project-header">
                      <span class="dash-project-name" title={p.title}>{p.title}</span>
                      <div class="dash-project-nums">
                        <span class="dash-project-rev">{formatINR(p.revenue)}</span>
                        <span class="dash-project-sales">{p.sales} {p.sales === 1 ? 'sale' : 'sales'}</span>
                      </div>
                    </div>
                    <div class="dash-bar-track">
                      <div class="dash-bar-fill" style={`width: ${pct}%`}></div>
                    </div>
                  </div>
                </div>
              );
            })}
            {stats.topProjects.length === 0 && (
              <p class="dash-empty-text">No project sales recorded in this period.</p>
            )}
          </div>
          <a href="/admin/projects" class="dash-card-footer-link">Open all projects</a>
        </div>

        <!-- Right: Needs attention -->
        <div class="admin-card dash-attention-card">
          <h2 class="dash-card-title">Needs attention</h2>
          <div class="dash-attention-list" id="desktop-attention-list">
            {stats.attention.map((a, idx) => (
              <a
                href={a.link}
                class:list={['dash-attention-row', { 'dash-attention-extra': idx >= 6 }]}
                title={a.title}
              >
                <div class="dash-attention-left">
                  <span class="dash-attention-chip" title={a.type}>{a.type}</span>
                  <span class="dash-attention-text" title={a.title}>{a.title}</span>
                </div>
                <Icon name="chevron-right" size={18} class="dash-attention-arrow" />
              </a>
            ))}
            {stats.attention.length === 0 && (
              <div class="dash-empty-attention">
                <Icon name="check-circle" size={20} />
                <span>All clear! No items require attention.</span>
              </div>
            )}
          </div>
          {stats.attention.length > 6 && (
            <button
              type="button"
              class="dash-card-footer-link dash-attention-toggle"
              id="dash-attention-toggle-desktop"
              data-count={stats.attention.length}
            >
              Show all ({stats.attention.length})
            </button>
          )}
        </div>
      </div>

      <!-- Row 3: System health 3 status tiles in 1 card -->
      <div class="admin-card dash-health-card">
        <h2 class="dash-card-title">System health</h2>
        <div class="dash-health-grid">
          <!-- Tile 1: Payments -->
          <div class="dash-health-tile">
            <div class="dash-health-left">
              <span class:list={['dash-health-dot', hasPayments ? 'is-active' : 'is-warn']}></span>
              <span class="dash-health-name">Payments</span>
            </div>
            <span class="dash-health-status">{hasPayments ? 'Active' : 'Disabled'}</span>
          </div>

          <!-- Tile 2: Payment webhook -->
          <div class="dash-health-tile">
            <div class="dash-health-left">
              <span class:list={['dash-health-dot', stats.health.webhook && stats.health.webhook !== 'Never received' ? 'is-active' : 'is-disabled']}></span>
              <span class="dash-health-name">Payment webhook</span>
            </div>
            <span class="dash-health-status">{stats.health.webhook || 'Never received'}</span>
          </div>

          <!-- Tile 3: Email -->
          <div class="dash-health-tile">
            <div class="dash-health-left">
              <span class:list={['dash-health-dot', stats.health.email && stats.health.email !== 'Never sent' ? 'is-active' : 'is-disabled']}></span>
              <span class="dash-health-name">Email</span>
            </div>
            <span class="dash-health-status">{stats.health.email || 'Never sent'}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ==============================================
       MOBILE DASHBOARD (Screen width <= 768px)
       Dedicated layout matching mobile specification
       ============================================== -->
  <div class="admin-mobile-shell">
    <!-- Top Mobile Title Bar -->
    <header class="admin-mobile-topbar">
      <h1 class="admin-mobile-topbar__title">Dashboard</h1>
      <a href="/" target="_blank" rel="noopener noreferrer" class="admin-btn admin-btn--ghost admin-btn--icon" aria-label="View public site">
        <Icon name="external" size={20} />
      </a>
    </header>

    <div class="admin-mobile-content">
      <!-- 7D / 30D / All time segmented control -->
      <div class="mobile-segmented-wrap">
        <div class="admin-segmented" style="width: 100%; display: flex;">
          <a href="/admin?days=7" class:list={['admin-segment-item', { 'is-active': days === 7 }]} style="flex: 1;">7D</a>
          <a href="/admin?days=30" class:list={['admin-segment-item', { 'is-active': days === 30 }]} style="flex: 1;">30D</a>
          <a href="/admin?days=0" class:list={['admin-segment-item', { 'is-active': days === 0 }]} style="flex: 1;">All time</a>
        </div>
      </div>

      <!-- Needs attention Card (FIRST per mobile spec) -->
      <div class="admin-card mobile-card-section mobile-attention-card">
        <h2 class="dash-card-title">Needs attention</h2>
        <div class="dash-attention-list" id="mobile-attention-list">
          {stats.attention.map((a, idx) => (
            <a
              href={a.link}
              class:list={['dash-attention-row', { 'dash-attention-extra-mobile': idx >= 6 }]}
              title={a.title}
            >
              <div class="dash-attention-left">
                <span class="dash-attention-chip" title={a.type}>{a.type}</span>
                <span class="dash-attention-text" title={a.title}>{a.title}</span>
              </div>
              <Icon name="chevron-right" size={18} class="dash-attention-arrow" />
            </a>
          ))}
          {stats.attention.length === 0 && (
            <p class="dash-empty-text">All good! Nothing needs attention.</p>
          )}
        </div>
        {stats.attention.length > 6 ? (
          <button
            type="button"
            class="dash-card-footer-link dash-attention-toggle-mobile"
            id="dash-attention-toggle-mobile"
            data-count={stats.attention.length}
          >
            Show all ({stats.attention.length})
          </button>
        ) : (
          <a href="/admin/projects" class="dash-card-footer-link">Show all</a>
        )}
      </div>

      <!-- Net revenue Card with two tiles (Paid orders, Conversion) -->
      <div class="admin-card mobile-card-section mobile-revenue-card">
        <span class="dash-stat-label">Net revenue</span>
        <div class="dash-stat-value">{formatINR(stats.revenue)}</div>
        <span class="dash-stat-sub">Excludes test orders and refunds</span>

        <div class="mobile-rev-tiles">
          <div class="mobile-rev-tile">
            <div class="mobile-rev-tile__num">{stats.orders}</div>
            <div class="mobile-rev-tile__label">Paid orders</div>
          </div>
          <div class="mobile-rev-tile">
            <div class="mobile-rev-tile__num">{stats.conversion.toFixed(1)}%</div>
            <div class="mobile-rev-tile__label">Pending to paid</div>
          </div>
        </div>
      </div>

      <!-- Top projects Card (Ranked rows with red revenue bar) -->
      <div class="admin-card mobile-card-section">
        <h2 class="dash-card-title">Top projects</h2>
        <div class="dash-projects-list">
          {stats.topProjects.map((p) => {
            const pct = Math.max(8, Math.round((p.revenue / maxRevenue) * 100));
            const cover = coverMap.get(p.id);
            return (
              <div class="mobile-project-row">
                <div class="dash-project-thumb">
                  {cover ? (
                    <img src={cover} alt="" loading="lazy" />
                  ) : (
                    <div class="dash-project-placeholder"><Icon name="cube" size={20} /></div>
                  )}
                </div>
                <div class="dash-project-info">
                  <div class="dash-project-header">
                    <span class="dash-project-name" title={p.title}>{p.title}</span>
                    <span class="dash-project-rev">{formatINR(p.revenue)}</span>
                  </div>
                  <div class="dash-bar-track">
                    <div class="dash-bar-fill" style={`width: ${pct}%`}></div>
                  </div>
                  <span class="dash-project-sales">{p.sales} {p.sales === 1 ? 'sale' : 'sales'}</span>
                </div>
              </div>
            );
          })}
          {stats.topProjects.length === 0 && (
            <p class="dash-empty-text">No sales data for this period.</p>
          )}
        </div>
        <a href="/admin/projects" class="dash-card-footer-link">Open all projects</a>
      </div>

      <!-- System health rows (Payments, Webhook, Email) -->
      <div class="admin-card mobile-card-section">
        <h2 class="dash-card-title">System health</h2>
        <div class="mobile-health-list">
          <div class="mobile-health-row">
            <div class="dash-health-left">
              <span class:list={['dash-health-dot', hasPayments ? 'is-active' : 'is-warn']}></span>
              <span class="dash-health-name">Payments</span>
            </div>
            <span class="dash-health-status">{hasPayments ? 'Active' : 'Disabled'}</span>
          </div>

          <div class="mobile-health-row">
            <div class="dash-health-left">
              <span class:list={['dash-health-dot', stats.health.webhook && stats.health.webhook !== 'Never received' ? 'is-active' : 'is-disabled']}></span>
              <span class="dash-health-name">Payment webhook</span>
            </div>
            <span class="dash-health-status">{stats.health.webhook || 'Never received'}</span>
          </div>

          <div class="mobile-health-row">
            <div class="dash-health-left">
              <span class:list={['dash-health-dot', stats.health.email && stats.health.email !== 'Never sent' ? 'is-active' : 'is-disabled']}></span>
              <span class="dash-health-name">Email</span>
            </div>
            <span class="dash-health-status">{stats.health.email || 'Never sent'}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Admin>

<style>
  /* ============================================================
     DESKTOP / TABLET DASHBOARD STYLES (>= 769px)
     ============================================================ */
  @media (max-width: 768px) {
    .dash-desktop-view {
      display: none !important;
    }
  }

  .dash-row-stats {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 1023px) {
    .dash-row-stats {
      grid-template-columns: 1fr;
    }
  }

  .dash-stat-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem 1.75rem;
    min-width: 0;
  }
  .dash-stat-label {
    font-size: max(12px, 0.875rem);
    font-weight: 500;
    color: var(--admin-muted);
    margin-bottom: 0.5rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dash-stat-value {
    font-size: var(--admin-fs-hero);
    font-weight: 700;
    color: var(--admin-ink);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 0.375rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dash-stat-sub {
    font-size: max(12px, 0.8125rem);
    color: var(--admin-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dash-row-split {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 1.25rem;
    align-items: start;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 1023px) {
    .dash-row-split {
      grid-template-columns: 1fr;
    }
  }

  .dash-card-title {
    font-size: var(--admin-fs-card-title);
    font-weight: 700;
    color: var(--admin-ink);
    margin: 0 0 1.125rem 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Projects Card */
  .dash-projects-card {
    min-width: 0;
  }
  .dash-projects-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
    min-width: 0;
  }
  .dash-project-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
  }
  .dash-project-thumb {
    width: 3.75rem;
    height: 2.75rem;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #E8ECEF;
    flex: none;
  }
  .dash-project-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dash-project-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--admin-muted);
  }
  .dash-project-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .dash-project-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }
  .dash-project-name {
    font-size: max(12px, 0.875rem);
    font-weight: 600;
    color: var(--admin-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    flex: 1;
  }
  .dash-project-nums {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex: none;
  }
  .dash-project-rev {
    font-size: max(12px, 0.875rem);
    font-weight: 700;
    color: var(--admin-ink);
    flex: none;
    white-space: nowrap;
  }
  .dash-project-sales {
    font-size: max(12px, 0.75rem);
    color: var(--admin-muted);
    flex: none;
    white-space: nowrap;
  }
  .dash-bar-track {
    width: 100%;
    height: 0.25rem;
    background: #E8ECEF;
    border-radius: 999px;
    overflow: hidden;
  }
  .dash-bar-fill {
    height: 100%;
    background: var(--admin-red);
    border-radius: 999px;
  }
  .dash-card-footer-link {
    display: block;
    text-align: center;
    font-size: max(12px, 0.875rem);
    font-weight: 600;
    color: var(--admin-red);
    text-decoration: none;
    padding-top: 0.625rem;
    background: none;
    border: none;
    cursor: pointer;
    width: 100%;
    font-family: inherit;
  }
  .dash-card-footer-link:hover {
    text-decoration: underline;
  }

  /* Needs attention */
  .dash-attention-card {
    background: #FFFDF7 !important;
    border-color: #F8E7C5 !important;
    min-width: 0;
  }
  .dash-attention-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .dash-attention-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.625rem;
    text-decoration: none;
    color: var(--admin-ink);
    min-width: 0;
    transition: background var(--admin-duration) var(--admin-ease);
  }
  .dash-attention-row:hover {
    background: #FFF6E0;
  }
  .dash-attention-left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    flex: 1;
  }
  .dash-attention-chip {
    width: 5.25rem;
    flex: none;
    text-align: center;
    box-sizing: border-box;
    padding: 0.1875rem 0.375rem;
    border-radius: 999px;
    background: #FEE8B8;
    color: #78350F;
    font-size: max(12px, 0.6875rem);
    font-weight: 700;
    text-transform: capitalize;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dash-attention-text {
    font-size: max(12px, 0.875rem);
    font-weight: 600;
    color: var(--admin-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    flex: 1;
  }
  .dash-attention-arrow {
    color: #92400E;
    flex: none;
  }
  .dash-attention-extra {
    display: none !important;
  }
  .dash-attention-extra.is-shown {
    display: flex !important;
  }
  .dash-attention-extra-mobile {
    display: none !important;
  }
  .dash-attention-extra-mobile.is-shown {
    display: flex !important;
  }
  .dash-empty-attention {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--admin-success-text);
    font-size: max(12px, 0.875rem);
    font-weight: 500;
    padding: 0.75rem;
  }
  .dash-empty-text {
    font-size: max(12px, 0.8125rem);
    color: var(--admin-muted);
    padding: 0.5rem 0;
    margin: 0;
  }

  /* Health Card */
  .dash-health-card {
    min-width: 0;
  }
  .dash-health-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (max-width: 1023px) {
    .dash-health-grid {
      grid-template-columns: 1fr;
    }
  }
  .dash-health-tile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.125rem;
    background: #F8FAFC;
    border: 1px solid var(--admin-line);
    border-radius: 0.75rem;
  }
  .dash-health-left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .dash-health-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dash-health-dot.is-active {
    background: #10B981;
  }
  .dash-health-dot.is-warn {
    background: #F59E0B;
  }
  .dash-health-dot.is-disabled {
    background: #94A3B8;
  }
  .dash-health-name {
    font-size: max(12px, 0.875rem);
    font-weight: 600;
    color: var(--admin-ink);
  }
  .dash-health-status {
    font-size: max(12px, 0.8125rem);
    color: var(--admin-muted);
  }

  /* ============================================================
     MOBILE SPECIFIC STYLES (<= 768px)
     ============================================================ */
  .mobile-segmented-wrap {
    margin-bottom: 1rem;
  }
  .mobile-card-section {
    margin-bottom: 1rem;
    padding: 1.25rem;
  }
  .mobile-attention-card {
    background: #FFFDF7 !important;
    border-color: #F8E7C5 !important;
  }
  .mobile-revenue-card {
    display: flex;
    flex-direction: column;
  }
  .mobile-rev-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 1.125rem;
    padding-top: 1.125rem;
    border-top: 1px solid var(--admin-line);
  }
  .mobile-rev-tile {
    background: #F8FAFC;
    border-radius: 0.75rem;
    padding: 0.75rem;
    text-align: center;
  }
  .mobile-rev-tile__num {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--admin-ink);
  }
  .mobile-rev-tile__label {
    font-size: max(12px, 0.75rem);
    color: var(--admin-muted);
    margin-top: 0.125rem;
  }
  .mobile-project-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--admin-line-subtle);
  }
  .mobile-project-row:last-child {
    border-bottom: none;
  }
  .mobile-health-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .mobile-health-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem;
    background: #F8FAFC;
    border-radius: 0.625rem;
    border: 1px solid var(--admin-line);
  }
</style>

<script>
  function setupAttentionToggles() {
    const desktopBtn = document.getElementById('dash-attention-toggle-desktop');
    if (desktopBtn) {
      desktopBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const list = document.getElementById('desktop-attention-list');
        if (!list) return;
        const extras = list.querySelectorAll('.dash-attention-extra');
        const count = desktopBtn.getAttribute('data-count') || '';
        const isShown = extras[0]?.classList.contains('is-shown');
        extras.forEach((el) => el.classList.toggle('is-shown', !isShown));
        desktopBtn.textContent = !isShown ? 'Show less' : `Show all (${count})`;
      });
    }

    const mobileBtn = document.getElementById('dash-attention-toggle-mobile');
    if (mobileBtn) {
      mobileBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const list = document.getElementById('mobile-attention-list');
        if (!list) return;
        const extras = list.querySelectorAll('.dash-attention-extra-mobile');
        const count = mobileBtn.getAttribute('data-count') || '';
        const isShown = extras[0]?.classList.contains('is-shown');
        extras.forEach((el) => el.classList.toggle('is-shown', !isShown));
        mobileBtn.textContent = !isShown ? 'Show less' : `Show all (${count})`;
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAttentionToggles);
  } else {
    setupAttentionToggles();
  }
</script>
