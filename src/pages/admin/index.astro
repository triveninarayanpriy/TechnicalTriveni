---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { getDashboardStats } from '../../lib/db';
import { formatINR, formatDateTime } from '../../lib/format';
import { turnstileEnabled } from '../../lib/turnstile';

const days = parseInt(Astro.url.searchParams.get('days') || '30', 10);
const stats = await getDashboardStats(env.DB, days);

const cards = [
  { label: 'Net Revenue', value: formatINR(stats.revenue), sub: 'excl test/refunds', icon: 'bolt', href: '/admin/orders' },
  { label: 'Paid Orders', value: stats.orders, sub: 'completed', icon: 'cart', href: '/admin/orders?status=paid' },
  { label: 'Conversion', value: stats.conversion.toFixed(1) + '%', sub: 'pending to paid', icon: 'bar-chart-2', href: '/admin/orders' },
];
---

<Admin title="Dashboard" active="dashboard">
  <div class="orders-head" style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
    <h2>Dashboard</h2>
    <div class="filter-tabs">
      {[7, 30, 0].map((d) => (
        <a href={`/admin?days=${d}`} class:list={['filter-tab', { 'is-active': days === d }]}>
          {d === 0 ? 'All-Time' : `${d}D`}
        </a>
      ))}
    </div>
  </div>

  <div class="stat-grid">
    {cards.map((c) => (
      <a href={c.href} class="stat-card">
        <div class="stat-card__icon"><Icon name={c.icon} size={20} /></div>
        <div class="stat-card__value">{c.value}</div>
        <div class="stat-card__label">{c.label}</div>
        <div class="stat-card__sub dim">{c.sub}</div>
      </a>
    ))}
  </div>

  <div class="dash-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1.5rem;">
    
    <!-- Left Column -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <section class="dash-panel card-table">
        <div class="dash-panel__head" style="padding: 1rem; border-bottom: 1px solid var(--border);">
          <h3 style="font-size: 1.1rem;"><Icon name="star" size={16} /> Top Projects</h3>
        </div>
        <table class="admin-table">
          <thead><tr><th>Project</th><th>Sales</th><th>Revenue</th></tr></thead>
          <tbody>
            {stats.topProjects.map((p) => (
              <tr>
                <td style="font-weight: 500;">{p.title}</td>
                <td>{p.sales}</td>
                <td style="color: var(--success);">{formatINR(p.revenue)}</td>
              </tr>
            ))}
            {stats.topProjects.length === 0 && <tr><td colspan="3" class="dim" style="text-align: center;">No data for this period.</td></tr>}
          </tbody>
        </table>
      </section>

      <section class="dash-panel card-table" style="background: var(--surface-2); padding: 1.5rem; border-radius: var(--r-md); border: 1px solid var(--border);">
        <h3 style="font-size: 1.1rem; margin-bottom: 1rem;"><Icon name="activity" size={16} /> System Health</h3>
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.75rem;">
          <li><strong>Turnstile:</strong> {turnstileEnabled(env) ? <span style="color: var(--success);">Active</span> : <span class="dim">Disabled</span>}</li>
          <li><strong>Last Webhook:</strong> {stats.health.webhook}</li>
          <li><strong>Last Email:</strong> {stats.health.email}</li>
        </ul>
      </section>
    </div>

    <!-- Right Column -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <section class="dash-panel card-table">
        <div class="dash-panel__head" style="padding: 1rem; border-bottom: 1px solid var(--border); background: rgba(245, 158, 11, 0.05);">
          <h3 style="font-size: 1.1rem; color: #d97706;"><Icon name="alert-circle" size={16} /> Needs Attention</h3>
        </div>
        <ul style="list-style: none; padding: 0; margin: 0;">
          {stats.attention.map((a) => (
            <li style="border-bottom: 1px solid var(--hairline); padding: 0.75rem 1rem;">
              <a href={a.link} style="display: flex; justify-content: space-between; align-items: center; color: var(--text); text-decoration: none;">
                <div>
                  <span class="status" style="margin-right: 0.5rem; background: var(--surface-3);">{a.type}</span>
                  <span>{a.title}</span>
                </div>
                <Icon name="chevron-right" size={16} class="dim" />
              </a>
            </li>
          ))}
          {stats.attention.length === 0 && <li style="padding: 1rem; text-align: center;" class="dim">All good! Nothing needs attention.</li>}
        </ul>
      </section>
    </div>
  </div>
</Admin>

<style>
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
  .stat-card { display: flex; flex-direction: column; padding: 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); text-decoration: none; color: inherit; transition: border-color 0.15s, transform 0.15s; }
  .stat-card:hover { border-color: var(--brand-red); transform: translateY(-2px); }
  .stat-card__icon { width: 40px; height: 40px; border-radius: 50%; background: var(--surface-2); display: grid; place-items: center; color: var(--text-muted); margin-bottom: 1rem; }
  .stat-card__value { font-family: var(--font-display); font-size: 1.8rem; font-weight: 600; line-height: 1; margin-bottom: 0.25rem; }
  .stat-card__label { font-weight: 500; font-size: var(--fs-sm); }
  .filter-tabs { display: flex; gap: 0.35rem; }
  .filter-tab { padding: 0.4rem 0.85rem; border-radius: var(--r-full); border: 1px solid var(--border); color: var(--text-muted); font-size: var(--fs-sm); text-transform: capitalize; text-decoration: none; }
  .filter-tab.is-active { background: var(--brand-red); border-color: var(--brand-red); color: #fff; }
  .card-table { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; }
  .admin-table { width: 100%; border-collapse: collapse; }
  .admin-table th { text-align: left; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dim); padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); }
  .admin-table td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--hairline); font-size: var(--fs-sm); }
  .status { padding: 0.2rem 0.55rem; border-radius: var(--r-full); font-size: var(--fs-xs); font-family: var(--font-mono); text-transform: uppercase; }
</style>
