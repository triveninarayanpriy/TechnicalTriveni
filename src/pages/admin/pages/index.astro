---
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { getAllPages } from '../../../lib/db';
import { formatDate } from '../../../lib/format';

const pages = await getAllPages(env.DB);
const defaultPages = ['about', 'contact', 'how-it-works'];

const displayPages = [...pages];
for (const slug of defaultPages) {
  if (!displayPages.some(p => p.slug === slug)) {
    displayPages.push({ slug, title: `Set up ${slug}`, content_md: '', image_url: '', updated_at: 0, published: 0, meta_title: '', meta_description: '' });
  }
}
displayPages.sort((a, b) => a.slug.localeCompare(b.slug));
---

<Admin title="Pages" active="pages">
  <!-- Desktop / Tablet Pages View (>= 769px) -->
  <div class="pages-desktop-view">
    <header class="admin-desktop-topbar">
      <h1 class="admin-desktop-topbar__title">Pages</h1>
      <p style="margin: 0; color: var(--admin-muted); font-size: 14px;">Manage custom static pages</p>
    </header>

    <div class="admin-desktop-content">
      <div class="admin-table-card">
        <div class="admin-table-wrap">
          <table class="admin-table-standard">
            <thead>
              <tr>
                <th>Page</th>
                <th>Status</th>
                <th>Published</th>
                <th>Last Updated</th>
                <th style="text-align: right;"></th>
              </tr>
            </thead>
            <tbody>
              {displayPages.map((p) => (
                <tr>
                  <td>
                    <a href={`/admin/pages/${p.slug}`} class="proj-table-title">{p.title}</a>
                    <span class="proj-table-slug">/{p.slug}</span>
                  </td>
                  <td>
                    <span class:list={['admin-chip', p.updated_at === 0 ? 'admin-chip--draft' : 'admin-chip--live']}>
                      {p.updated_at === 0 ? 'Not configured' : 'Active'}
                    </span>
                  </td>
                  <td>
                    <span class:list={['admin-chip', p.published === 1 ? 'admin-chip--live' : 'admin-chip--draft']}>
                      {p.published === 1 ? 'Published' : 'Draft'}
                    </span>
                  </td>
                  <td style="color: var(--admin-muted); font-size: 13px;">
                    {p.updated_at > 0 ? formatDate(p.updated_at) : '—'}
                  </td>
                  <td style="text-align: right;">
                    <a href={`/admin/pages/${p.slug}`} class="admin-btn admin-btn--secondary admin-btn--sm">Edit</a>
                    <a href={`/${p.slug}`} target="_blank" rel="noopener noreferrer" class="admin-btn admin-btn--ghost admin-btn--sm admin-btn--icon" aria-label="Preview">
                      <Icon name="external" size={16} />
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Pages View (<= 768px) -->
  <div class="admin-mobile-shell">
    <header class="admin-mobile-topbar">
      <h1 class="admin-mobile-topbar__title">Pages</h1>
    </header>

    <div class="admin-mobile-content">
      <div class="admin-card mobile-pages-list">
        {displayPages.map((p) => (
          <a href={`/admin/pages/${p.slug}`} class="mobile-page-row">
            <div class="mobile-page-info">
              <strong class="mobile-page-title">{p.title}</strong>
              <span class="mobile-page-slug">/{p.slug}</span>
              <div class="mobile-page-meta">
                <span class:list={['admin-chip', p.published === 1 ? 'admin-chip--live' : 'admin-chip--draft']}>
                  {p.published === 1 ? 'Published' : 'Draft'}
                </span>
                <span style="font-size: 12px; color: var(--admin-muted);">
                  {p.updated_at > 0 ? formatDate(p.updated_at) : 'Not configured'}
                </span>
              </div>
            </div>
            <Icon name="chevron-right" size={18} class="mobile-page-arrow" />
          </a>
        ))}
      </div>
    </div>
  </div>
</Admin>

<style>
  @media (max-width: 768px) {
    .pages-desktop-view { display: none !important; }
  }

  .proj-table-title {
    font-size: 14.5px;
    font-weight: 700;
    color: var(--admin-ink);
    text-decoration: none;
    display: block;
  }
  .proj-table-title:hover {
    color: var(--admin-red);
  }
  .proj-table-slug {
    font-size: 12px;
    color: var(--admin-muted);
    font-family: var(--admin-font-mono);
  }

  /* Mobile */
  .mobile-pages-list {
    padding: 8px 16px;
  }
  .mobile-page-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid var(--admin-line-subtle);
    text-decoration: none;
    color: var(--admin-ink);
  }
  .mobile-page-row:last-child {
    border-bottom: none;
  }
  .mobile-page-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mobile-page-title {
    font-size: 15px;
    font-weight: 700;
  }
  .mobile-page-slug {
    font-size: 12px;
    color: var(--admin-muted);
    font-family: var(--admin-font-mono);
  }
  .mobile-page-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }
  .mobile-page-arrow {
    color: var(--admin-muted);
  }
</style>
