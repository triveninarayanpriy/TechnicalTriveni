---
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { getEffectiveContent } from '../../../lib/pages';
import { listPageRevisions, listProjects } from '../../../lib/db';
import { formatDate, renderMarkdown } from '../../../lib/format';
import { getAboutPageData, getHomePageData } from '../../../lib/site-content';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/admin/pages');

const page = await getEffectiveContent(env.DB, slug);
const revisions = await listPageRevisions(env.DB, slug, 5);
const csrf = Astro.locals.csrfToken;

const isAbout = slug === 'about';
const isHome = slug === 'home';
const aboutData = isAbout ? await getAboutPageData(env.DB) : null;
const homeData = isHome ? await getHomePageData(env.DB) : null;
const allProjects = (isAbout || isHome) ? await listProjects(env.DB, { publishedOnly: true }) : [];

// Word count calculation
const wordCount = page.markdown.trim() ? page.markdown.trim().split(/\s+/).length : 0;
const initialPreviewHtml = renderMarkdown(page.markdown);
---

<Admin title={`Edit ${page.title}`} active="pages">
  <!-- Toast feedback container -->
  <div id="page-toast" class="admin-toast" hidden></div>

  <!-- Main Editor Form -->
  <form id="page-editor-form" method="post" action="/api/admin/page/save" enctype="multipart/form-data" class="editor-shell">
    <input type="hidden" name="csrf" value={csrf} />
    <input type="hidden" name="slug" value={page.slug} />
    <input type="hidden" name="image_url" value={page.image_url || ''} />

    <!-- Top Navigation & Action Bar -->
    <header class="editor-topbar">
      <div class="editor-topbar__left">
        <a href="/admin/pages" class="editor-back-link">
          <Icon name="chevron-left" size={18} />
          <span>Back to pages</span>
        </a>
        <h1 class="editor-topbar__title">Edit {page.title} page</h1>
      </div>

      <div class="editor-topbar__actions">
        <!-- Published Toggle Switch -->
        <label class="switch-label">
          <span class="switch-text">Published</span>
          <div class="switch-wrap">
            <input type="checkbox" name="published" value="1" checked={page.published === 1} class="switch-input" id="published-toggle" />
            <span class="switch-slider"></span>
          </div>
        </label>

        <!-- Preview Button (Toggles preview or scrolls to preview) -->
        <button type="button" class="admin-btn admin-btn--secondary" id="btn-toggle-preview">
          <Icon name="eye" size={16} />
          <span>Preview</span>
        </button>

        <!-- Save Button -->
        <button type="submit" class="admin-btn admin-btn--primary" id="btn-save-desktop">
          <Icon name="check" size={16} />
          <span>Save changes</span>
        </button>
      </div>
    </header>

    <!-- Mobile Segmented Control (Edit vs Preview) -->
    <div class="mobile-segmented-bar">
      <div class="segmented-control">
        <button type="button" class="segmented-btn is-active" id="seg-btn-edit">Edit</button>
        <button type="button" class="segmented-btn" id="seg-btn-preview">Preview</button>
      </div>
    </div>

    <!-- Mobile Content Source Card (top) -->
    <div class="mobile-source-bar">
      <div class="source-card source-card--mobile">
        <div class="source-card__header">
          <span class:list={['source-badge', page.is_custom ? 'source-badge--custom' : 'source-badge--default']}>
            {page.is_custom ? 'Custom content' : 'Built-in site content'}
          </span>
          <span class="source-card__hint">
            {page.is_custom ? 'Custom overrides active.' : 'Visitors see this text now.'}
          </span>
        </div>
        <div class="source-card__actions">
          <button
            type="button"
            class="admin-btn admin-btn--secondary admin-btn--sm"
            id="btn-reset-mobile"
            disabled={!page.is_custom}
          >
            Reset to default
          </button>
        </div>
      </div>
    </div>

    <!-- Two-Column Editor Layout -->
    <div class="editor-grid">
      <!-- LEFT COLUMN: EDIT FORM -->
      <div class="editor-col-left" id="editor-left-pane">
        <!-- Card 1: Page Details -->
        <div class="editor-card">
          <h2 class="editor-card__title">Page</h2>
          <div class="page-meta-grid">
            <div class="admin-form-group">
              <label for="title" class="admin-label">Page title</label>
              <input
                type="text"
                id="title"
                name="title"
                value={page.title}
                class="admin-input"
                required
              />
            </div>

            <div class="admin-form-group">
              <label for="page-url-display" class="admin-label">URL</label>
              <div class="url-input-wrap">
                <input
                  type="text"
                  id="page-url-display"
                  value={page.route}
                  class="admin-input url-input"
                  readonly
                />
                <a
                  href={page.route}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="url-open-btn"
                  title="Open live URL"
                  aria-label="Open live URL in new tab"
                >
                  <Icon name="external" size={16} />
                </a>
              </div>
            </div>
          </div>
        </div>

        {isAbout && aboutData && (
          <>
            <!-- Section 1: Hero -->
            <div class="editor-card">
              <h2 class="editor-card__title">1. Hero Section</h2>
              <p class="admin-field-hint" style="margin-bottom: 1rem;">Controls the top hero on the About page and feeds into the Home page "Meet the maker" block.</p>
              
              <div class="page-meta-grid" style="margin-bottom: 1rem;">
                <div class="admin-form-group">
                  <label for="hero_eyebrow" class="admin-label">Eyebrow</label>
                  <input type="text" id="hero_eyebrow" name="hero_eyebrow" value={aboutData.hero.eyebrow} class="admin-input" />
                </div>
                <div class="admin-form-group">
                  <label for="hero_name" class="admin-label">Maker Name</label>
                  <input type="text" id="hero_name" name="hero_name" value={aboutData.hero.name || 'Triveni Narayan Priy'} class="admin-input" />
                </div>
              </div>

              <div class="admin-form-group" style="margin-bottom: 1rem;">
                <label for="hero_headline" class="admin-label">Headline</label>
                <input type="text" id="hero_headline" name="hero_headline" value={aboutData.hero.headline} class="admin-input" />
              </div>

              <div class="admin-form-group" style="margin-bottom: 1rem;">
                <label for="hero_intro" class="admin-label">Introduction Paragraph</label>
                <textarea id="hero_intro" name="hero_intro" class="admin-input" rows="3">{aboutData.hero.intro}</textarea>
              </div>

              <div class="page-meta-grid" style="margin-bottom: 1rem;">
                <div class="admin-form-group">
                  <label for="hero_badge_text" class="admin-label">Photo Badge Text</label>
                  <input type="text" id="hero_badge_text" name="hero_badge_text" value={aboutData.hero.badge_text} class="admin-input" placeholder="Maker and developer" />
                </div>
                <div class="admin-form-group">
                  <label for="hero_credentials" class="admin-label">Credential Chips (one per line)</label>
                  <textarea id="hero_credentials" name="hero_credentials" class="admin-input" rows="3">{aboutData.hero.credentials.join('\n')}</textarea>
                </div>
              </div>

              <div class="photo-upload-grid" style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border);">
                <div class="photo-preview-wrap">
                  <img
                    src={page.image_url || '/brand/profile.jpg'}
                    alt="Profile preview"
                    id="photo-preview-img"
                    class="photo-preview"
                  />
                </div>
                <div class="photo-input-col">
                  <label for="image" class="admin-label">Replace Maker Photo</label>
                  <input type="file" id="image" name="image" accept="image/*" class="admin-file-input" />
                  <span class="admin-field-hint">Upload a high-resolution portrait photo (JPG, PNG, WebP). Used across About and Home.</span>
                </div>
              </div>
            </div>

            <!-- Section 2: Numbers strip -->
            <div class="editor-card">
              <h2 class="editor-card__title">2. Numbers Strip</h2>
              <div class="admin-alert admin-alert--info" style="margin-bottom: 1rem; font-size: 0.8125rem;">
                <Icon name="info" size={15} />
                <span>Stat 1 (Total published packs) and Stat 2 (Free downloads count) are <strong>automatically computed from live projects</strong>. The remaining two stats are editable below.</span>
              </div>
              <div class="page-meta-grid">
                <div class="admin-form-group">
                  <label for="stat3_val" class="admin-label">Stat 3 Value</label>
                  <input type="text" id="stat3_val" name="stat3_val" value={aboutData.numbers.stat3_val} class="admin-input" placeholder="100%" />
                  <label for="stat3_label" class="admin-label" style="margin-top: 0.5rem;">Stat 3 Label</label>
                  <input type="text" id="stat3_label" name="stat3_label" value={aboutData.numbers.stat3_label} class="admin-input" placeholder="Tested on real hardware" />
                </div>
                <div class="admin-form-group">
                  <label for="stat4_val" class="admin-label">Stat 4 Value</label>
                  <input type="text" id="stat4_val" name="stat4_val" value={aboutData.numbers.stat4_val} class="admin-input" placeholder="1" />
                  <label for="stat4_label" class="admin-label" style="margin-top: 0.5rem;">Stat 4 Label</label>
                  <input type="text" id="stat4_label" name="stat4_label" value={aboutData.numbers.stat4_label} class="admin-input" placeholder="Maker answering your emails" />
                </div>
              </div>
            </div>

            <!-- Section 3: My story -->
            <div class="editor-card">
              <h2 class="editor-card__title">3. My Story Block</h2>
              <p class="admin-field-hint" style="margin-bottom: 1rem;">Do not repeat the hero headline or intro here. This block is dedicated purely to the personal narrative and ethos.</p>
              
              <div class="admin-form-group" style="margin-bottom: 1rem;">
                <label for="story_heading" class="admin-label">Story Heading</label>
                <input type="text" id="story_heading" name="story_heading" value={aboutData.story.heading} class="admin-input" />
              </div>

              <div class="admin-form-group" style="margin-bottom: 1rem;">
                <label for="story_pull_quote" class="admin-label">Pull-Quote (featured callout text)</label>
                <input type="text" id="story_pull_quote" name="story_pull_quote" value={aboutData.story.pull_quote} class="admin-input" />
              </div>

              <div class="admin-form-group">
                <label for="story_md" class="admin-label">Story Narrative (Markdown)</label>
                <textarea id="story_md" name="story_md" class="md-textarea" rows="8">{aboutData.story.body_md}</textarea>
              </div>
            </div>

            <!-- Section 4: How every pack is made -->
            <div class="editor-card">
              <h2 class="editor-card__title">4. How Every Pack is Made (4 Steps)</h2>
              <div class="steps-editor-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
                {aboutData.steps.map((st, idx) => (
                  <div class="step-card-box" style="padding: 1rem; background: #f8fafc; border: 1px solid var(--border); border-radius: 8px;">
                    <div style="font-weight: 700; font-size: 0.8125rem; color: var(--brand-red); margin-bottom: 0.5rem;">Step {idx + 1}</div>
                    <div class="admin-form-group" style="margin-bottom: 0.5rem;">
                      <label class="admin-label">Title</label>
                      <input type="text" name={`step_${idx}_title`} value={st.title} class="admin-input admin-input--sm" />
                    </div>
                    <div class="admin-form-group">
                      <label class="admin-label">Text</label>
                      <textarea name={`step_${idx}_text`} class="admin-input admin-input--sm" rows="3">{st.text}</textarea>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Section 5: On the workbench (4 Pack Covers) -->
            <div class="editor-card">
              <h2 class="editor-card__title">5. On the Workbench (4 Gallery Covers)</h2>
              <p class="admin-field-hint" style="margin-bottom: 1rem;">Choose 4 project slugs (one per line) to feature in the desktop mosaic and mobile gallery carousel.</p>
              <textarea id="workbench_slugs" name="workbench_slugs" class="admin-input mono" rows="4">{aboutData.workbench.project_slugs.join('\n')}</textarea>
              <span class="admin-field-hint" style="margin-top: 0.35rem; display: block;">Available project slugs: {allProjects.map(p => p.slug).join(', ')}</span>
            </div>

            <!-- Section 6: What you can expect from me -->
            <div class="editor-card">
              <h2 class="editor-card__title">6. What You Can Expect From Me (3 Cards)</h2>
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
                {aboutData.expect_cards.map((ec, idx) => (
                  <div style="padding: 1rem; background: #f8fafc; border: 1px solid var(--border); border-radius: 8px;">
                    <div class="admin-form-group" style="margin-bottom: 0.5rem;">
                      <label class="admin-label">Card {idx + 1} Title</label>
                      <input type="text" name={`expect_${idx}_title`} value={ec.title} class="admin-input admin-input--sm" />
                    </div>
                    <div class="admin-form-group">
                      <label class="admin-label">Card {idx + 1} Text</label>
                      <textarea name={`expect_${idx}_text`} class="admin-input admin-input--sm" rows="3">{ec.text}</textarea>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Section 7: Work with me -->
            <div class="editor-card">
              <h2 class="editor-card__title">7. Work With Me Block</h2>
              <div class="admin-form-group" style="margin-bottom: 1rem;">
                <label for="work_heading" class="admin-label">Heading</label>
                <input type="text" id="work_heading" name="work_heading" value={aboutData.work_with_me.heading} class="admin-input" />
              </div>
              <div class="admin-form-group" style="margin-bottom: 1rem;">
                <label for="work_text" class="admin-label">Description Text</label>
                <textarea id="work_text" name="work_text" class="admin-input" rows="3">{aboutData.work_with_me.text}</textarea>
              </div>
              <div class="page-meta-grid">
                <div class="admin-form-group">
                  <label for="work_btn_text" class="admin-label">Button Text</label>
                  <input type="text" id="work_btn_text" name="work_btn_text" value={aboutData.work_with_me.btn_text} class="admin-input" />
                </div>
                <div class="admin-form-group">
                  <label for="work_btn_url" class="admin-label">Button Link URL</label>
                  <input type="text" id="work_btn_url" name="work_btn_url" value={aboutData.work_with_me.btn_url} class="admin-input" />
                </div>
              </div>
            </div>

            <!-- Section 8: Follow the builds -->
            <div class="editor-card">
              <h2 class="editor-card__title">8. Follow the Builds (Social Links)</h2>
              <div class="admin-alert admin-alert--info" style="font-size: 0.8125rem;">
                <Icon name="info" size={15} />
                <span>Social channel links (YouTube, Instagram, GitHub, LinkedIn) are managed centrally under <a href="/admin/settings/images" target="_blank" style="color: var(--brand-red); text-decoration: underline;">Admin &gt; Site Images &amp; Links</a> so they stay synced across all pages. Empty links are automatically hidden.</span>
              </div>
            </div>

            <!-- Section 9: Closing CTA -->
            <div class="editor-card">
              <h2 class="editor-card__title">9. Closing Call to Action</h2>
              <div class="admin-form-group" style="margin-bottom: 1rem;">
                <label for="cta_heading" class="admin-label">Heading</label>
                <input type="text" id="cta_heading" name="cta_heading" value={aboutData.cta.heading} class="admin-input" />
              </div>
              <div class="admin-form-group">
                <label for="cta_subline" class="admin-label">Subline</label>
                <input type="text" id="cta_subline" name="cta_subline" value={aboutData.cta.subline} class="admin-input" />
              </div>
            </div>
          </>
        )}

        {isHome && homeData && (
          <div class="about-block-editor">
            <!-- 1. HERO BLOCK -->
            <div class="block-card">
              <div class="block-card__header">
                <h3><Icon name="spark" size={18} /> Hero: Headline, Subline & Eyebrow</h3>
                <span class="block-tag">Public Hero</span>
              </div>
              <div class="block-card__body">
                <div class="admin-field">
                  <label for="hero_eyebrow" class="admin-label">Eyebrow pill text</label>
                  <input type="text" id="hero_eyebrow" name="hero_eyebrow" value={homeData.hero.eyebrow} class="admin-input" />
                </div>
                <div class="admin-field">
                  <label for="hero_headline" class="admin-label">Headline (HTML supported)</label>
                  <input type="text" id="hero_headline" name="hero_headline" value={homeData.hero.headline} class="admin-input" />
                  <span class="admin-help">Tip: Wrap keywords in &lt;span class="text-red"&gt;...&lt;/span&gt; for brand red styling.</span>
                </div>
                <div class="admin-field">
                  <label for="hero_subline" class="admin-label">Subline text</label>
                  <textarea id="hero_subline" name="hero_subline" class="admin-input" rows="3">{homeData.hero.subline}</textarea>
                </div>
              </div>
            </div>

            <!-- 2. HERO FEATURED PACK CARD -->
            <div class="block-card">
              <div class="block-card__header">
                <h3><Icon name="layers" size={18} /> Hero Featured Pack Card</h3>
                <span class="block-tag">Hero Pack</span>
              </div>
              <div class="block-card__body">
                <div class="admin-field">
                  <label for="featured_pack_slug" class="admin-label">Select Featured Project</label>
                  <select id="featured_pack_slug" name="featured_pack_slug" class="admin-input">
                    <option value="" selected={!homeData.hero.featured_pack_slug}>Auto: Newest paid pack (default)</option>
                    {allProjects.map((p) => (
                      <option value={p.slug} selected={homeData.hero.featured_pack_slug === p.slug}>
                        {p.title} ({p.price_inr > 0 ? `₹${p.price_inr}` : 'Free'})
                      </option>
                    ))}
                  </select>
                  <span class="admin-help">The selected pack is shown prominently on the right of the Hero (or below Hero copy on mobile).</span>
                </div>
              </div>
            </div>

            <!-- 3. FEATURED PROJECTS -->
            <div class="block-card">
              <div class="block-card__header">
                <h3><Icon name="grid" size={18} /> Featured Projects (4 Pack Cards)</h3>
                <span class="block-tag">Cards Grid</span>
              </div>
              <div class="block-card__body">
                <div class="admin-field">
                  <label for="featured_projects_mode" class="admin-label">Projects Selection Mode</label>
                  <select id="featured_projects_mode" name="featured_projects_mode" class="admin-input">
                    <option value="auto" selected={homeData.featured_projects.mode === 'auto'}>Auto by default (newest published packs)</option>
                    <option value="manual" selected={homeData.featured_projects.mode === 'manual'}>Manual selection (pick 4 packs below)</option>
                  </select>
                </div>
                <div class="admin-grid-2">
                  {[0, 1, 2, 3].map((idx) => (
                    <div class="admin-field">
                      <label class="admin-label">Slot {idx + 1}</label>
                      <select name={`featured_project_${idx}`} class="admin-input">
                        {allProjects.map((p) => (
                          <option value={p.slug} selected={homeData.featured_projects.project_slugs[idx] === p.slug}>
                            {p.title} ({p.price_inr > 0 ? `₹${p.price_inr}` : 'Free'})
                          </option>
                        ))}
                      </select>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- 4. 3 FEATURED VIDEOS -->
            <div class="block-card">
              <div class="block-card__header">
                <h3><Icon name="video" size={18} /> Watch Every Build Before You Buy (3 Featured Videos)</h3>
                <span class="block-tag">YouTube URLs</span>
              </div>
              <div class="block-card__body">
                <p class="admin-help" style="margin-bottom: 1rem;">
                  Paste YouTube URLs (full video, shorts, or youtu.be links). Video thumbnails are automatically derived from the YouTube video ID. Clicking the card opens YouTube in a new tab.
                </p>
                {[0, 1, 2].map((idx) => (
                  <div class="block-card" style="margin-bottom: 1rem; border: 1px solid var(--border); background: var(--bg);">
                    <div class="block-card__header" style="background: var(--bg-2); padding: 0.6rem 1rem;">
                      <h4 style="font-size: 0.95rem; margin: 0; font-weight: 600;">Video {idx + 1}</h4>
                    </div>
                    <div class="block-card__body admin-grid-2" style="padding: 1rem;">
                      <div class="admin-field">
                        <label class="admin-label">Video Card Title</label>
                        <input type="text" name={`video_${idx}_title`} value={homeData.featured_videos[idx]?.title || ''} class="admin-input" placeholder="e.g. ESP32 Blynk IoT Smart Relay Switch" />
                      </div>
                      <div class="admin-field">
                        <label class="admin-label">YouTube URL</label>
                        <input type="url" name={`video_${idx}_url`} value={homeData.featured_videos[idx]?.url || ''} class="admin-input" placeholder="https://youtube.com/watch?v=..." />
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {!isAbout && !isHome && (
          <div class="editor-card">
            <div class="editor-card__head">
              <h2 class="editor-card__title">Content (Markdown)</h2>
              {page.sectionHint && (
                <span class="section-hint-badge" title={page.sectionHint}>
                  <Icon name="info" size={13} /> {page.sectionHint}
                </span>
              )}
            </div>

            <!-- Markdown Toolbar -->
            <div class="md-toolbar" role="toolbar" aria-label="Markdown formatting tools">
              <button type="button" class="md-tool-btn" data-tool="bold" title="Bold (Ctrl+B)"><strong>B</strong></button>
              <button type="button" class="md-tool-btn" data-tool="italic" title="Italic (Ctrl+I)"><em>I</em></button>
              <button type="button" class="md-tool-btn" data-tool="h2" title="Heading 2">H2</button>
              <button type="button" class="md-tool-btn" data-tool="link" title="Link">Link</button>
              <button type="button" class="md-tool-btn" data-tool="list" title="Bullet list">List</button>
              <button type="button" class="md-tool-btn" data-tool="quote" title="Quote">Quote</button>
              <button type="button" class="md-tool-btn" data-tool="code" title="Code block">Code</button>
              <button type="button" class="md-tool-btn" data-tool="image" title="Image">Image</button>
            </div>

            <!-- Markdown Textarea -->
            <div class="textarea-wrap">
              <textarea
                id="content_md"
                name="content_md"
                class="md-textarea"
                placeholder="Write page content in Markdown..."
                rows="16"
              >{page.markdown}</textarea>
            </div>

            <!-- Word count & Saved info footer -->
            <div class="md-footer">
              <span id="word-count-display">{wordCount} words.</span>
              <span class="md-footer-sep">Saved {formatDate(page.updated_at)}.</span>
            </div>
          </div>
        )}

        <!-- Card 4: Search and social (SEO) -->
        <div class="editor-card">
          <h2 class="editor-card__title">Search and social</h2>
          <div class="seo-grid">
            <div class="admin-form-group">
              <div class="label-with-counter">
                <label for="meta_title" class="admin-label">Meta title</label>
                <span class="char-counter" id="meta-title-counter">({(page.meta_title || '').length}/60)</span>
              </div>
              <input
                type="text"
                id="meta_title"
                name="meta_title"
                value={page.meta_title || ''}
                maxlength="60"
                class="admin-input"
                placeholder={page.title}
              />
            </div>

            <div class="admin-form-group">
              <div class="label-with-counter">
                <label for="meta_description" class="admin-label">Meta description</label>
                <span class="char-counter" id="meta-desc-counter">({(page.meta_description || '').length}/160)</span>
              </div>
              <input
                type="text"
                id="meta_description"
                name="meta_description"
                value={page.meta_description || ''}
                maxlength="160"
                class="admin-input"
                placeholder="Defaults to the first paragraph"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: STATUS, LIVE PREVIEW, HISTORY -->
      <div class="editor-col-right" id="editor-right-pane">
        <!-- Content Source Card -->
        <div class="editor-card source-card-desktop">
          <h2 class="editor-card__title">Content source</h2>
          <div class="source-content">
            <span class:list={['source-badge', page.is_custom ? 'source-badge--custom' : 'source-badge--default']}>
              {page.is_custom ? 'Custom content' : 'Showing built-in site content'}
            </span>
            <p class="source-desc">
              {page.is_custom
                ? 'This page has custom overrides active and live on the site.'
                : 'This is the text visitors see now. Edit and save to make it custom.'}
            </p>
            <div class="source-actions">
              <button
                type="button"
                class="admin-btn admin-btn--secondary admin-btn--sm"
                id="btn-reset-desktop"
                disabled={!page.is_custom}
              >
                Reset to default
              </button>
              <a
                href={page.route}
                target="_blank"
                rel="noopener noreferrer"
                class="admin-btn admin-btn--secondary admin-btn--sm"
              >
                View on site
              </a>
            </div>
          </div>
        </div>

        <!-- Live Preview Card -->
        <div class="editor-card preview-card">
          <div class="editor-card__head">
            <h2 class="editor-card__title">Live preview</h2>
            <span class="preview-mode-tag">Real site styling</span>
          </div>
          {isAbout || isHome ? (
            <div style="padding: 1.25rem; color: var(--text-muted); font-size: 0.9rem; line-height: 1.5;">
              <p style="margin: 0 0 0.75rem 0;">This is a multi-block page. Each block directly controls its corresponding section on the live site.</p>
              <a href={page.route} target="_blank" rel="noopener noreferrer" class="admin-btn admin-btn--secondary admin-btn--sm" style="display: inline-flex;">
                Open {page.title} in new tab &rarr;
              </a>
            </div>
          ) : (
            <div class="live-preview-box" id="live-preview-box" set:html={initialPreviewHtml}>
            </div>
          )}
        </div>

        <!-- History Card -->
        <div class="editor-card history-card">
          <h2 class="editor-card__title">History</h2>
          <div class="history-list" id="history-list">
            {revisions.length > 0 ? (
              revisions.map((rev) => (
                <div class="history-item" data-rev-id={rev.id}>
                  <div class="history-item__left">
                    <strong class="history-item__note">{rev.note || 'Custom content saved'}</strong>
                    <span class="history-item__date">{formatDate(rev.created_at)}</span>
                  </div>
                  <button
                    type="button"
                    class="btn-restore"
                    data-id={rev.id}
                    title="Restore this revision"
                  >
                    Restore
                  </button>
                </div>
              ))
            ) : (
              <>
                {page.is_custom && (
                  <div class="history-item">
                    <div class="history-item__left">
                      <strong class="history-item__note">Custom content saved</strong>
                      <span class="history-item__date">{formatDate(page.updated_at)}</span>
                    </div>
                  </div>
                )}
                <div class="history-item">
                  <div class="history-item__left">
                    <strong class="history-item__note">Created</strong>
                    <span class="history-item__date">14 Nov 2023</span>
                  </div>
                </div>
              </>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Sticky Mobile Bottom Bar -->
    <div class="mobile-sticky-footer">
      <button type="submit" class="admin-btn admin-btn--primary admin-btn--block" id="btn-save-mobile">
        <Icon name="check" size={18} />
        <span>Save changes</span>
      </button>
    </div>
  </form>
</Admin>

