  <input type="hidden" id="page-csrf" value={csrf} />
  <input type="hidden" id="page-slug" value={slug} />

<script>
  const csrf = (document.getElementById('page-csrf') as HTMLInputElement)?.value || '';
  const slug = (document.getElementById('page-slug') as HTMLInputElement)?.value || '';

  // Simple markdown-to-HTML parser for real-time live preview
  function renderMarkdown(md: string) {
    if (!md) return '<p style="color: #94a3b8; font-style: italic;">No content to preview.</p>';
    let html = md
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    // Headings
    html = html.replace(/^### (.*$)/gim, '<h3>$1</h3>');
    html = html.replace(/^## (.*$)/gim, '<h2>$1</h2>');
    html = html.replace(/^# (.*$)/gim, '<h2>$1</h2>');

    // Bold & Italic
    html = html.replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>');
    html = html.replace(/\*(.*?)\*/gim, '<em>$1</em>');

    // Code blocks & inline code
    html = html.replace(/```([\s\S]*?)```/gim, '<pre><code>$1</code></pre>');
    html = html.replace(/`([^`]+)`/gim, '<code>$1</code>');

    // Blockquotes
    html = html.replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>');

    // Links & Images
    html = html.replace(/!\[([^\]]*)\]\((.*?)\)/gim, '<img alt="$1" src="$2" style="max-width: 100%; border-radius: 0.5rem;" />');
    html = html.replace(/\[([^\]]+)\]\((.*?)\)/gim, '<a href="$2" target="_blank" rel="noopener">$1</a>');

    // Lists
    html = html.replace(/^\- (.*$)/gim, '<li>$1</li>');
    html = html.replace(/(<li>.*<\/li>)/gim, '<ul>$1</ul>');

    // Paragraphs
    html = html.split(/\n{2,}/).map(para => {
      para = para.trim();
      if (!para) return '';
      if (para.startsWith('<h') || para.startsWith('<ul') || para.startsWith('<blockquote') || para.startsWith('<pre')) {
        return para;
      }
      return '<p>' + para.replace(/\n/g, '<br />') + '</p>';
    }).join('');

    return html;
  }

  // Toast
  function showToast(msg, isError = false) {
    const toast = document.getElementById('page-toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.className = 'admin-toast ' + (isError ? 'admin-toast--error' : 'admin-toast--success');
    toast.hidden = false;
    setTimeout(() => { toast.hidden = true; }, 3500);
  }

  const form = document.getElementById('page-editor-form');
  const textarea = document.getElementById('content_md');
  const previewBox = document.getElementById('live-preview-box');
  const wordCountDisplay = document.getElementById('word-count-display');
  const metaTitleInput = document.getElementById('meta_title');
  const metaTitleCounter = document.getElementById('meta-title-counter');
  const metaDescInput = document.getElementById('meta_description');
  const metaDescCounter = document.getElementById('meta-desc-counter');

  let isDirty = false;

  // Real-time Preview & Word count update
  function updatePreview() {
    if (!textarea || !previewBox) return;
    const val = textarea.value;
    previewBox.innerHTML = renderMarkdown(val);

    const words = val.trim() ? val.trim().split(/\s+/).length : 0;
    if (wordCountDisplay) {
      wordCountDisplay.textContent = `${words} words.`;
    }
  }

  if (textarea) {
    textarea.addEventListener('input', () => {
      isDirty = true;
      updatePreview();
    });
    // Initial render
    updatePreview();
  }

  // Char counters
  if (metaTitleInput && metaTitleCounter) {
    metaTitleInput.addEventListener('input', () => {
      isDirty = true;
      metaTitleCounter.textContent = `(${metaTitleInput.value.length}/60)`;
    });
  }
  if (metaDescInput && metaDescCounter) {
    metaDescInput.addEventListener('input', () => {
      isDirty = true;
      metaDescCounter.textContent = `(${metaDescInput.value.length}/160)`;
    });
  }

  // Markdown Toolbar helper
  function insertFormat(prefix, suffix = '', defaultText = '') {
    if (!textarea) return;
    textarea.focus();
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const sel = textarea.value.substring(start, end) || defaultText;
    const replacement = prefix + sel + suffix;

    textarea.setRangeText(replacement, start, end, 'select');
    textarea.selectionStart = start + prefix.length;
    textarea.selectionEnd = start + prefix.length + sel.length;
    isDirty = true;
    updatePreview();
  }

  document.querySelectorAll('.md-tool-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tool = btn.getAttribute('data-tool');
      switch (tool) {
        case 'bold': insertFormat('**', '**', 'bold text'); break;
        case 'italic': insertFormat('*', '*', 'italic text'); break;
        case 'h2': insertFormat('\n## ', '\n', 'Heading'); break;
        case 'link': insertFormat('[', '](https://example.com)', 'link text'); break;
        case 'list': insertFormat('\n- ', '', 'List item'); break;
        case 'quote': insertFormat('\n> ', '', 'Quote text'); break;
        case 'code': insertFormat('\n```\n', '\n```\n', 'code here'); break;
        case 'image': insertFormat('![', '](https://example.com/image.png)', 'alt text'); break;
      }
    });
  });

  // Mobile Segments (Edit vs Preview)
  const segEdit = document.getElementById('seg-btn-edit');
  const segPreview = document.getElementById('seg-btn-preview');
  const leftPane = document.getElementById('editor-left-pane');
  const rightPane = document.getElementById('editor-right-pane');

  if (segEdit && segPreview) {
    segEdit.addEventListener('click', () => {
      segEdit.classList.add('is-active');
      segPreview.classList.remove('is-active');
      if (leftPane) leftPane.style.display = 'block';
      if (rightPane) rightPane.style.display = 'none';
    });

    segPreview.addEventListener('click', () => {
      segPreview.classList.add('is-active');
      segEdit.classList.remove('is-active');
      if (leftPane) leftPane.style.display = 'none';
      if (rightPane) rightPane.style.display = 'block';
    });
  }

  // Desktop Toggle Preview button
  const btnTogglePreview = document.getElementById('btn-toggle-preview');
  if (btnTogglePreview) {
    btnTogglePreview.addEventListener('click', () => {
      if (previewBox) {
        previewBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        previewBox.style.outline = '2px solid #E11D48';
        setTimeout(() => { previewBox.style.outline = 'none'; }, 1000);
      }
    });
  }

  // Save handler (AJAX & Form)
  async function submitForm() {
    if (!form) return;
    const btnSaveDesktop = document.getElementById('btn-save-desktop');
    const btnSaveMobile = document.getElementById('btn-save-mobile');

    const setBusy = (b) => {
      if (btnSaveDesktop) btnSaveDesktop.disabled = b;
      if (btnSaveMobile) btnSaveMobile.disabled = b;
    };

    setBusy(true);

    try {
      const fd = new FormData(form);
      const res = await fetch('/api/admin/page/save', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: fd
      });
      const data = await res.json();
      if (data.ok) {
        isDirty = false;
        showToast(data.msg);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showToast(data.error || 'Failed to save page.', true);
        setBusy(false);
      }
    } catch (e) {
      showToast('Network error while saving.', true);
      setBusy(false);
    }
  }

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitForm();
    });
  }

  // Reset to default handler
  async function handleReset() {
    if (!confirm('Reset this page to its built-in site default? This will delete your custom overrides.')) {
      return;
    }

    try {
      const fd = new FormData();
      fd.append('csrf', csrf);
      fd.append('slug', slug);

      const res = await fetch('/api/admin/page/reset', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: fd
      });
      const data = await res.json();
      if (data.ok) {
        isDirty = false;
        showToast(data.msg);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showToast(data.error || 'Reset failed.', true);
      }
    } catch (e) {
      showToast('Network error while resetting.', true);
    }
  }

  const btnResetDesktop = document.getElementById('btn-reset-desktop');
  if (btnResetDesktop) btnResetDesktop.addEventListener('click', handleReset);
  const btnResetMobile = document.getElementById('btn-reset-mobile');
  if (btnResetMobile) btnResetMobile.addEventListener('click', handleReset);

  // Restore revision handler
  document.querySelectorAll('.btn-restore').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      if (!confirm('Restore this revision? Your current draft will be replaced.')) return;

      try {
        const fd = new FormData();
        fd.append('csrf', csrf);
        fd.append('id', id);

        const res = await fetch('/api/admin/page/restore', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: fd
        });
        const data = await res.json();
        if (data.ok) {
          isDirty = false;
          showToast(data.msg);
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || 'Restore failed.', true);
        }
      } catch {
        showToast('Network error while restoring.', true);
      }
    });
  });

  // Keyboard shortcut: Ctrl+S or Cmd+S to save
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
      e.preventDefault();
      submitForm();
    }
  });

  // Unsaved changes guard
  window.addEventListener('beforeunload', (e) => {
    if (isDirty) {
      e.preventDefault();
      e.returnValue = '';
    }
  });
</script>
