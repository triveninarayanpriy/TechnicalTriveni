---
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { listComponentsWithLinks, checkStaleLinks } from '../../../lib/db';

// Automatically check for links older than 30 days and mark them stale
await checkStaleLinks(env.DB);

const components = await listComponentsWithLinks(env.DB);
const csrf = Astro.locals.csrfToken;

// Also fetch project usages for each component
const usagesRes = await env.DB.prepare(
  'SELECT b.component_id, p.title as project_title, p.slug as project_slug FROM bom_items b JOIN projects p ON b.project_id = p.id WHERE b.component_id > 0'
).all<{ component_id: number; project_title: string; project_slug: string }>();

const usageMap = new Map<number, Array<{ title: string; slug: string }>>();
for (const u of usagesRes.results ?? []) {
  const arr = usageMap.get(u.component_id) || [];
  arr.push({ title: u.project_title, slug: u.project_slug });
  usageMap.set(u.component_id, arr);
}

// Compute counts
const totalCount = components.length;
const needsReviewCount = components.filter(c => !c.link || c.link.status === 'unverified' || c.link.status === 'stale').length;
const verifiedCount = components.filter(c => c.link?.status === 'verified').length;
const searchOnlyCount = components.filter(c => c.link?.status === 'search_only').length;
const brokenCount = components.filter(c => c.link?.status === 'broken').length;

const currentTab = Astro.url.searchParams.get('tab') || 'needs_review';

const filteredComponents = components.filter(c => {
  if (currentTab === 'all') return true;
  if (currentTab === 'needs_review') return !c.link || c.link.status === 'unverified' || c.link.status === 'stale';
  if (currentTab === 'verified') return c.link?.status === 'verified';
  if (currentTab === 'search_only') return c.link?.status === 'search_only';
  if (currentTab === 'broken') return c.link?.status === 'broken';
  return true;
});
---

<Admin title="Component Link Review Queue" active="components" hideTabBar={true}>
  <div class="links-page">
    <!-- Header -->
    <header class="links-header">
      <div class="links-header__left">
        <a href="/admin/components" class="back-btn" title="Back to Components">
          <Icon name="chevron-left" size={20} />
        </a>
        <div>
          <h1 class="page-title">Link Verification Queue</h1>
          <div class="page-sub">Verify and review product links on Amazon India. Only verified links render direct buttons.</div>
        </div>
      </div>

      <div class="links-header__actions">
        <button type="button" id="bulk-find-btn" class="admin-btn admin-btn--secondary">
          <Icon name="spark" size={16} />
          <span>Find links for unlinked ({needsReviewCount})</span>
        </button>
        <a href="/admin/settings/affiliate" class="admin-btn admin-btn--ghost">
          <Icon name="sliders" size={16} />
          <span>Affiliate Settings</span>
        </a>
      </div>
    </header>

    <!-- Keyboard Shortcuts Banner -->
    <div class="shortcuts-bar">
      <div class="shortcuts-title"><Icon name="info" size={14} /> <strong>Keyboard Shortcuts:</strong></div>
      <div class="shortcuts-list">
        <span><kbd>V</kbd> Verify</span>
        <span><kbd>S</kbd> Search Only</span>
        <span><kbd>O</kbd> Open on Amazon</span>
        <span><kbd>B</kbd> Mark Broken</span>
        <span><kbd>J</kbd> Next</span>
        <span><kbd>K</kbd> Prev</span>
      </div>
    </div>

    <!-- Stats Navigation Tabs -->
    <nav class="stats-tabs" role="tablist">
      <a href="?tab=needs_review" class:list={['stat-tab', { 'is-active': currentTab === 'needs_review' }]}>
        <span class="stat-tab__count stat-tab__count--amber">{needsReviewCount}</span>
        <span class="stat-tab__label">Needs Review</span>
      </a>
      <a href="?tab=verified" class:list={['stat-tab', { 'is-active': currentTab === 'verified' }]}>
        <span class="stat-tab__count stat-tab__count--green">{verifiedCount}</span>
        <span class="stat-tab__label">Verified</span>
      </a>
      <a href="?tab=search_only" class:list={['stat-tab', { 'is-active': currentTab === 'search_only' }]}>
        <span class="stat-tab__count">{searchOnlyCount}</span>
        <span class="stat-tab__label">Search Only</span>
      </a>
      <a href="?tab=broken" class:list={['stat-tab', { 'is-active': currentTab === 'broken' }]}>
        <span class="stat-tab__count stat-tab__count--red">{brokenCount}</span>
        <span class="stat-tab__label">Broken / Stale</span>
      </a>
      <a href="?tab=all" class:list={['stat-tab', { 'is-active': currentTab === 'all' }]}>
        <span class="stat-tab__count">{totalCount}</span>
        <span class="stat-tab__label">All Components</span>
      </a>
    </nav>

    <!-- Component Queue List -->
    {filteredComponents.length === 0 ? (
      <div class="empty-state admin-card">
        <Icon name="check-circle" size={32} />
        <h3>All clear!</h3>
        <p class="dim">No components found under this filter.</p>
        <a href="?tab=all" class="admin-btn admin-btn--secondary">View all components</a>
      </div>
    ) : (
      <div class="queue-list" id="queue-container">
        {filteredComponents.map((c, idx) => {
          const link = c.link;
          const status = link?.status || 'unverified';
          const isVerified = status === 'verified';
          const isStale = status === 'stale';
          const isBroken = status === 'broken';
          const isSearchOnly = status === 'search_only';
          const isUnverified = status === 'unverified' && !!link?.asin;
          const hasNoCandidate = !link || (!link.asin && status !== 'search_only');

          let evidence: any = {};
          if (link?.evidence) {
            try { evidence = JSON.parse(link.evidence); } catch {}
          }

          const specMatches = evidence.spec_matches || [];
          const specMismatches = evidence.spec_mismatches || [];
          const projects = usageMap.get(c.id) || [];

          return (
            <article class="queue-card admin-card" data-comp-id={c.id} data-idx={idx} tabindex="0">
              <!-- Left Column: Component Specification -->
              <div class="queue-spec">
                <div class="queue-spec__top">
                  <span class="comp-id-badge">#{c.id}</span>
                  <h2 class="comp-name">{c.name}</h2>
                </div>

                <div class="spec-meta">
                  <div class="spec-meta-row">
                    <span class="spec-label">Store:</span>
                    <span class="spec-val">{c.store || 'Amazon'}</span>
                  </div>
                  <div class="spec-meta-row">
                    <span class="spec-label">Est. Cost:</span>
                    <span class="spec-val font-display">{c.unit_price_inr > 0 ? `₹${c.unit_price_inr}` : 'Not set'}</span>
                  </div>
                  {c.notes && (
                    <div class="spec-meta-row">
                      <span class="spec-label">Notes:</span>
                      <span class="spec-val spec-notes">{c.notes}</span>
                    </div>
                  )}
                </div>

                {projects.length > 0 && (
                  <div class="used-in-box">
                    <span class="used-in-label">Used in {projects.length} project{projects.length === 1 ? '' : 's'}:</span>
                    <div class="used-in-list">
                      {projects.map((p) => (
                        <a href={`/projects/${p.slug}`} target="_blank" class="used-tag">
                          {p.title}
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                <div class="spec-action-row">
                  <button type="button" class="admin-btn admin-btn--sm admin-btn--ghost btn-find-single" data-comp-id={c.id}>
                    <Icon name="spark" size={14} />
                    <span>Re-run Gemini Search</span>
                  </button>
                </div>
              </div>

              <!-- Right Column: Candidate & Verification Controls -->
              <div class="queue-candidate">
                <div class="candidate-header">
                  <div class="status-chips">
                    {isVerified && <span class="chip chip--verified"><Icon name="check-circle" size={13} /> Verified</span>}
                    {isStale && <span class="chip chip--stale"><Icon name="alert-triangle" size={13} /> Stale (&gt;30d)</span>}
                    {isBroken && <span class="chip chip--broken"><Icon name="close" size={13} /> Broken Link</span>}
                    {isSearchOnly && <span class="chip chip--search"><Icon name="search" size={13} /> Search Fallback</span>}
                    {isUnverified && <span class="chip chip--unverified"><Icon name="clock" size={13} /> Needs Review</span>}
                    {hasNoCandidate && <span class="chip chip--empty">No Candidate</span>}

                    {link?.grounded === 1 && (
                      <span class="chip chip--grounded" title="ASIN confirmed via Google Search Grounding on Amazon.in">
                        <Icon name="check" size={12} /> Grounded
                      </span>
                    )}
                    {link && link.grounded === 0 && link.asin && (
                      <span class="chip chip--caution" title="ASIN not confirmed via live search proof">
                        <Icon name="alert-triangle" size={12} /> Search Unconfirmed
                      </span>
                    )}
                  </div>

                  {link?.confidence !== undefined && link.confidence > 0 && (
                    <span class="confidence-badge" title="Confidence Score">
                      {Math.round(link.confidence * 100)}% match
                    </span>
                  )}
                </div>

                {link?.asin ? (
                  <div class="candidate-details">
                    <div class="cand-title-wrap">
                      <h3 class="cand-title">{link.title || c.name}</h3>
                      <div class="asin-badge-box">
                        <span class="asin-label">ASIN:</span>
                        <code class="asin-code">{link.asin}</code>
                      </div>
                    </div>

                    {evidence.why_match && (
                      <p class="cand-why">{evidence.why_match}</p>
                    )}

                    {specMatches.length > 0 && (
                      <div class="spec-pills-row">
                        {specMatches.map((m: string) => (
                          <span class="pill pill--match"><Icon name="check" size={11} /> {m}</span>
                        ))}
                      </div>
                    )}

                    {specMismatches.length > 0 && (
                      <div class="spec-pills-row">
                        {specMismatches.map((m: string) => (
                          <span class="pill pill--mismatch"><Icon name="alert-triangle" size={11} /> {m}</span>
                        ))}
                      </div>
                    )}

                    {evidence.needs_review_reason && (
                      <div class="review-reason-box">
                        <Icon name="alert-circle" size={14} />
                        <span>{evidence.needs_review_reason}</span>
                      </div>
                    )}

                    <!-- Verification Checklist -->
                    <div class="verify-checklist">
                      <label class="check-item">
                        <input type="checkbox" class="cb-check" data-for="title" />
                        <span>Title matches required component</span>
                      </label>
                      <label class="check-item">
                        <input type="checkbox" class="cb-check" data-for="variant" />
                        <span>Variant / chip / pins correct</span>
                      </label>
                      <label class="check-item">
                        <input type="checkbox" class="cb-check" data-for="stock" />
                        <span>In stock on Amazon.in</span>
                      </label>
                    </div>

                    <!-- Action Buttons -->
                    <div class="candidate-actions">
                      <a
                        href={link.canonical_url || `https://www.amazon.in/dp/${link.asin}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="admin-btn admin-btn--secondary btn-open-amazon"
                        title="Open clean product page on Amazon.in without tracking parameters"
                      >
                        <Icon name="external-link" size={15} />
                        <span>Open on Amazon</span>
                      </a>

                      <button
                        type="button"
                        class="admin-btn admin-btn--primary btn-mark-verified"
                        data-comp-id={c.id}
                        disabled={isVerified}
                      >
                        <Icon name="check" size={15} />
                        <span>{isVerified ? 'Verified' : 'Mark Verified (V)'}</span>
                      </button>

                      <button
                        type="button"
                        class="admin-btn admin-btn--ghost btn-mark-search"
                        data-comp-id={c.id}
                        title="Use safe Amazon search query fallback instead of direct product"
                      >
                        <Icon name="search" size={15} />
                        <span>Search Link (S)</span>
                      </button>

                      <button
                        type="button"
                        class="admin-btn admin-btn--ghost btn-mark-broken"
                        data-comp-id={c.id}
                        title="Mark broken or out-of-stock"
                      >
                        <Icon name="close" size={15} />
                        <span>Broken (B)</span>
                      </button>
                    </div>
                  </div>
                ) : (
                  <div class="no-candidate-box">
                    <p class="dim">No product candidate found yet.</p>
                    <button type="button" class="admin-btn admin-btn--primary btn-find-single" data-comp-id={c.id}>
                      <Icon name="spark" size={15} />
                      <span>Find with Gemini Search</span>
                    </button>
                  </div>
                )}

                <!-- Manual ASIN / Link Override Drawer -->
                <details class="manual-override-details">
                  <summary class="manual-summary">
                    <span>Paste custom Amazon link or ASIN</span>
                  </summary>
                  <form class="manual-form" data-comp-id={c.id}>
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="component_id" value={c.id} />
                    <div class="manual-inputs">
                      <input
                        type="text"
                        name="asin_or_url"
                        class="admin-input mono"
                        placeholder="Paste Amazon URL or 10-char ASIN (e.g. B086MGVDC3)"
                        required
                      />
                      <button type="submit" class="admin-btn admin-btn--primary admin-btn--sm">
                        <span>Save &amp; Clean</span>
                      </button>
                    </div>
                  </form>
                </details>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</Admin>

<script is:inline>
  // Link Verification Queue Client Logic
  const container = document.getElementById('queue-container');
  let currentActiveIndex = 0;

  function setActiveCard(idx) {
    const cards = document.querySelectorAll('.queue-card');
    if (cards.length === 0) return;
    const bounded = Math.max(0, Math.min(cards.length - 1, idx));
    currentActiveIndex = bounded;
    cards.forEach((c, i) => {
      c.classList.toggle('is-focused', i === bounded);
      if (i === bounded) c.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }

  // Keyboard navigation & actions
  window.addEventListener('keydown', (e) => {
    // Ignore keystrokes when typing inside inputs
    if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName)) return;

    const cards = document.querySelectorAll('.queue-card');
    if (cards.length === 0) return;
    const currentCard = cards[currentActiveIndex];
    if (!currentCard) return;

    const compId = currentCard.dataset.compId;

    if (e.key === 'j' || e.key === 'J' || e.key === 'ArrowDown') {
      setActiveCard(currentActiveIndex + 1);
    } else if (e.key === 'k' || e.key === 'K' || e.key === 'ArrowUp') {
      setActiveCard(currentActiveIndex - 1);
    } else if (e.key === 'v' || e.key === 'V') {
      const btn = currentCard.querySelector('.btn-mark-verified');
      if (btn && !btn.disabled) btn.click();
    } else if (e.key === 's' || e.key === 'S') {
      const btn = currentCard.querySelector('.btn-mark-search');
      if (btn) btn.click();
    } else if (e.key === 'b' || e.key === 'B') {
      const btn = currentCard.querySelector('.btn-mark-broken');
      if (btn) btn.click();
    } else if (e.key === 'o' || e.key === 'O') {
      const link = currentCard.querySelector('.btn-open-amazon');
      if (link) window.open(link.href, '_blank');
    }
  });

  // Verify Action
  document.querySelectorAll('.btn-mark-verified').forEach(btn => {
    btn.addEventListener('click', async () => {
      const compId = btn.dataset.compId;
      btn.disabled = true;
      btn.textContent = 'Verifying...';

      try {
        const res = await fetch('/api/admin/affiliate/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ component_id: Number(compId) })
        });
        const data = await res.json();
        if (data.ok) {
          const card = btn.closest('.queue-card');
          card.classList.add('is-done');
          btn.textContent = 'Verified ✓';
          btn.style.background = '#16A34A';
          setTimeout(() => location.reload(), 600);
        } else {
          alert(data.error || 'Failed to verify');
          btn.disabled = false;
          btn.textContent = 'Mark Verified';
        }
      } catch (err) {
        alert(err.message);
        btn.disabled = false;
        btn.textContent = 'Mark Verified';
      }
    });
  });

  // Set Search Only
  document.querySelectorAll('.btn-mark-search').forEach(btn => {
    btn.addEventListener('click', async () => {
      const compId = btn.dataset.compId;
      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/affiliate/set-status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ component_id: Number(compId), status: 'search_only' })
        });
        const data = await res.json();
        if (data.ok) location.reload();
      } catch (err) {
        alert(err.message);
        btn.disabled = false;
      }
    });
  });

  // Set Broken
  document.querySelectorAll('.btn-mark-broken').forEach(btn => {
    btn.addEventListener('click', async () => {
      const compId = btn.dataset.compId;
      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/affiliate/set-status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ component_id: Number(compId), status: 'broken' })
        });
        const data = await res.json();
        if (data.ok) location.reload();
      } catch (err) {
        alert(err.message);
        btn.disabled = false;
      }
    });
  });

  // Find with Gemini Single
  document.querySelectorAll('.btn-find-single').forEach(btn => {
    btn.addEventListener('click', async () => {
      const compId = btn.dataset.compId;
      btn.disabled = true;
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span>Searching...</span>';

      try {
        const res = await fetch('/api/admin/affiliate/find-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ component_id: Number(compId), force: true })
        });
        const data = await res.json();
        if (data.ok) {
          location.reload();
        } else {
          alert(data.error || 'Failed to find link');
          btn.disabled = false;
          btn.innerHTML = originalText;
        }
      } catch (err) {
        alert(err.message);
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    });
  });

  // Bulk Find
  const bulkBtn = document.getElementById('bulk-find-btn');
  bulkBtn?.addEventListener('click', async () => {
    if (!confirm('Run Gemini Search for unlinked components (concurrency 3)?')) return;
    bulkBtn.disabled = true;
    bulkBtn.innerHTML = '<span>Searching Amazon India...</span>';

    try {
      const res = await fetch('/api/admin/affiliate/bulk-find', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.ok) {
        alert(`Processed ${data.processed} components! Reloading queue...`);
        location.reload();
      } else {
        alert(data.error || 'Bulk search failed');
        bulkBtn.disabled = false;
      }
    } catch (err) {
      alert(err.message);
      bulkBtn.disabled = false;
    }
  });

  // Manual Form
  document.querySelectorAll('.manual-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const compId = fd.get('component_id');
      const asinOrUrl = fd.get('asin_or_url');

      try {
        const res = await fetch('/api/admin/affiliate/save-manual', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            component_id: Number(compId),
            asin_or_url: asinOrUrl,
            verified: true
          })
        });
        const data = await res.json();
        if (data.ok) {
          location.reload();
        } else {
          alert(data.error || 'Failed to save clean link');
        }
      } catch (err) {
        alert(err.message);
      }
    });
  });
</script>

<style>
  .links-page {
    max-width: 68rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .links-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--admin-line);
  }

  .links-header__left {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .back-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--admin-r-input);
    border: 1px solid var(--admin-line);
    background: #fff;
    color: var(--admin-ink);
    text-decoration: none;
    transition: all 120ms ease;
  }
  .back-btn:hover {
    border-color: var(--admin-red);
    color: var(--admin-red);
  }

  .page-title {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--admin-ink);
    margin: 0;
  }
  .page-sub {
    font-size: max(12px, 0.8125rem);
    color: var(--admin-muted);
    margin-top: 0.125rem;
  }

  .links-header__actions {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  /* Shortcuts Bar */
  .shortcuts-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: var(--admin-r-card);
    padding: 0.5rem 0.875rem;
    font-size: max(12px, 0.75rem);
    color: var(--admin-muted);
    flex-wrap: wrap;
  }
  .shortcuts-title {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--admin-ink);
  }
  .shortcuts-list {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex-wrap: wrap;
  }
  kbd {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    font-family: monospace;
    font-weight: 600;
    color: var(--admin-ink);
    box-shadow: 0 1px 0 rgba(0,0,0,0.1);
  }

  /* Stats Tabs */
  .stats-tabs {
    display: flex;
    gap: 0.5rem;
    border-bottom: 2px solid var(--admin-line);
    padding-bottom: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .stat-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    font-size: max(12px, 0.8438rem);
    font-weight: 600;
    color: var(--admin-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    white-space: nowrap;
    transition: all 120ms ease;
  }
  .stat-tab:hover {
    color: var(--admin-ink);
  }
  .stat-tab.is-active {
    color: var(--admin-red);
    border-bottom-color: var(--admin-red);
  }
  .stat-tab__count {
    background: #E2E8F0;
    color: var(--admin-ink);
    font-size: max(11px, 0.6875rem);
    font-weight: 700;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
  }
  .stat-tab__count--amber {
    background: #FEF3C7;
    color: #92400E;
  }
  .stat-tab__count--green {
    background: #DCFCE7;
    color: #166534;
  }
  .stat-tab__count--red {
    background: #FEE2E2;
    color: #991B1B;
  }

  /* Queue List */
