---
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { listProjects } from '../../../lib/db';
import { formatINR } from '../../../lib/format';

const projects = await listProjects(env.DB, {});
const csrf = Astro.locals.csrfToken;

// Fetch covers and order counts for rich rows
const [imagesRes, ordersRes] = await Promise.all([
  env.DB.prepare('SELECT project_id, url, kind FROM project_images ORDER BY sort ASC').all<{ project_id: number; url: string; kind: string }>(),
  env.DB.prepare("SELECT project_id, COUNT(*) as count FROM orders WHERE status = 'paid' GROUP BY project_id").all<{ project_id: number; count: number }>(),
]);

const coverMap = new Map<number, string>();
const imagesByProject = new Map<number, number>();
for (const img of imagesRes.results ?? []) {
  imagesByProject.set(img.project_id, (imagesByProject.get(img.project_id) || 0) + 1);
  if (!coverMap.has(img.project_id) || img.kind === 'cover') {
    coverMap.set(img.project_id, img.url);
  }
}

const salesMap = new Map<number, number>();
for (const ord of ordersRes.results ?? []) {
  if (ord.project_id) salesMap.set(ord.project_id, ord.count);
}

// Compute metadata and issues for each project
const projectMeta = projects.map((p) => {
  const hasCover = (imagesByProject.get(p.id) || 0) > 0;
  const isPaid = p.combo_enabled === 1 && p.price_inr > 0;
  const sales = salesMap.get(p.id) || 0;

  let isStalePrice = false;
  if (p.cost_checked) {
    const checkDate = new Date(p.cost_checked);
    if (!isNaN(checkDate.getTime())) {
      const daysOld = (Date.now() - checkDate.getTime()) / (1000 * 60 * 60 * 24);
      if (daysOld > 60) isStalePrice = true;
    }
  }

  let issueText = '';
  if (!hasCover && isStalePrice) {
    issueText = 'Missing cover, stale price';
  } else if (!hasCover) {
    issueText = 'Missing cover';
  } else if (isStalePrice) {
    issueText = 'Stale price';
  }

  let priceDisplay = '-';
  if (p.combo_enabled === 1 && p.price_inr > 0) {
    priceDisplay = formatINR(p.price_inr);
  } else if (p.published === 1) {
    priceDisplay = 'Free';
  }

  return {
    ...p,
    coverUrl: coverMap.get(p.id) || '',
    issueText,
    priceDisplay,
    sales,
  };
});
---

<Admin title="Projects" active="projects">
  <!-- ==============================================
       DESKTOP / TABLET PROJECTS VIEW (Screen width >= 769px)
       Matches desktop screenshot exactly
       ============================================== -->
  <div class="projects-desktop-view">
    <!-- Desktop Topbar -->
    <header class="admin-desktop-topbar">
      <h1 class="admin-desktop-topbar__title">Projects</h1>
      <div class="admin-desktop-topbar__actions">
        <a href="/admin/projects/new" class="admin-btn admin-btn--primary">
          <Icon name="plus" size={18} />
          <span>New project</span>
        </a>
      </div>
    </header>

    <div class="admin-desktop-content">
      <!-- Toolbar: Search + Filter Chips -->
      <div class="projects-toolbar">
        <div class="projects-search-box">
          <Icon name="search" size={18} class="projects-search-icon" />
          <input
            type="search"
            id="desktop-proj-search"
            placeholder="Search projects"
            class="projects-search-input"
            autocomplete="off"
          />
        </div>

        <div class="projects-chips-track">
          <button type="button" class="admin-chip admin-chip--filter is-active" data-desktop-filter="all">All</button>
          <button type="button" class="admin-chip admin-chip--filter" data-desktop-filter="live">Live</button>
          <button type="button" class="admin-chip admin-chip--filter" data-desktop-filter="draft">Draft</button>
          <button type="button" class="admin-chip admin-chip--filter" data-desktop-filter="archived">Archived</button>
        </div>
      </div>

      <!-- Card Table matching screenshot -->
      <div class="admin-table-card">
        <div class="admin-table-wrap">
          <table class="admin-table-standard" id="desktop-proj-table">
            <thead>
              <tr>
                <th style="width: 4.5rem;">Cover</th>
                <th>Project</th>
                <th style="width: 7.5rem;">Status</th>
                <th style="width: 6.875rem;">Price</th>
                <th style="width: 13.75rem;">Issues</th>
                <th style="width: 5.625rem; text-align: right;"></th>
              </tr>
            </thead>
            <tbody>
              {projectMeta.map((p) => (
                <tr
                  class="desktop-project-row"
                  data-title={p.title.toLowerCase()}
                  data-slug={p.slug.toLowerCase()}
                  data-status={p.published ? 'live' : 'draft'}
                >
                  <td>
                    <div class="proj-table-thumb">
                      {p.coverUrl ? (
                        <img src={p.coverUrl} alt="" loading="lazy" />
                      ) : (
                        <div class="proj-table-placeholder">
                          <Icon name="image" size={18} />
                        </div>
                      )}
                    </div>
                  </td>
                  <td style="min-width: 0; max-width: 23.75rem;">
                    <a href={`/admin/projects/${p.id}`} class="proj-table-title" title={p.title}>{p.title}</a>
                    <span class="proj-table-slug" title={p.slug}>{p.slug}</span>
                  </td>
                  <td style="width: 7.5rem; white-space: nowrap;">
                    <span class:list={['admin-chip', p.published ? 'admin-chip--live' : 'admin-chip--draft']}>
                      {p.published ? 'Live' : 'Draft'}
                    </span>
                  </td>
                  <td style="width: 6.875rem; white-space: nowrap;">
                    <span class="proj-table-price">{p.priceDisplay}</span>
                  </td>
                  <td style="min-width: 0; max-width: 13.75rem;">
                    {p.issueText ? (
                      <span class="admin-chip admin-chip--warning" title={p.issueText}>{p.issueText}</span>
                    ) : null}
                  </td>
                  <td style="text-align: right; width: 5.625rem; white-space: nowrap;">
                    <a href={`/admin/projects/${p.id}`} class="admin-btn admin-btn--secondary admin-btn--sm">Edit</a>
                  </td>
                </tr>
              ))}
              {projectMeta.length === 0 && (
                <tr>
                  <td colspan="6" style="text-align: center; padding: 3rem; color: var(--admin-muted);">
                    No projects found. Create your first project to get started.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- ==============================================
       MOBILE PROJECTS VIEW (Screen width <= 768px)
       Dedicated layout matching mobile specification
       ============================================== -->
  <div class="admin-mobile-shell">
    <header class="admin-mobile-topbar">
      <h1 class="admin-mobile-topbar__title">Projects</h1>
      <a href="/admin/projects/new" class="admin-btn admin-btn--primary admin-btn--sm" aria-label="New project">
        <Icon name="plus" size={16} />
        <span>New</span>
      </a>
    </header>

    <div class="admin-mobile-content">
      <!-- Search input -->
      <div class="mobile-search-wrap">
        <Icon name="search" size={18} class="mobile-search-icon" />
        <input
          type="search"
          id="mobile-proj-search"
          placeholder="Search projects"
          class="admin-input mobile-search-field"
          autocomplete="off"
        />
      </div>

      <!-- Filter chips (All, Live, Draft, Archived) -->
      <div class="mobile-chips-track">
        <button type="button" class="admin-chip admin-chip--filter is-active" data-mobile-filter="all">All</button>
        <button type="button" class="admin-chip admin-chip--filter" data-mobile-filter="live">Live</button>
        <button type="button" class="admin-chip admin-chip--filter" data-mobile-filter="draft">Draft</button>
        <button type="button" class="admin-chip admin-chip--filter" data-mobile-filter="archived">Archived</button>
      </div>

      <!-- Project Rows in Card Container -->
      <div class="admin-card mobile-projects-card">
        {projectMeta.map((p) => (
          <a
            href={`/admin/projects/${p.id}`}
            class="mobile-project-item"
            data-title={p.title.toLowerCase()}
            data-slug={p.slug.toLowerCase()}
            data-status={p.published ? 'live' : 'draft'}
          >
            <div class="mobile-project-thumb">
              {p.coverUrl ? (
                <img src={p.coverUrl} alt="" loading="lazy" />
              ) : (
                <div class="mobile-project-placeholder">
                  <Icon name="image" size={20} />
                </div>
              )}
            </div>
            <div class="mobile-project-body">
              <span class="mobile-project-title" title={p.title}>{p.title}</span>
              <div class="mobile-project-tags">
                <span class:list={['admin-chip', p.published ? 'admin-chip--live' : 'admin-chip--draft']}>
                  {p.published ? 'Live' : 'Draft'}
                </span>
                {p.issueText ? (
                  <span class="admin-chip admin-chip--warning">{p.issueText}</span>
                ) : (
                  <span class="mobile-project-price">{p.priceDisplay}</span>
                )}
              </div>
            </div>
          </a>
        ))}
        <div id="mobile-no-results" class="mobile-empty-state" style="display: none;">
          No projects match your filter.
        </div>
      </div>
    </div>

    <!-- Floating Action Button (+ New project) -->
    <a href="/admin/projects/new" class="mobile-fab" aria-label="Create new project">
      <Icon name="plus" size={20} />
      <span>New project</span>
    </a>
  </div>
</Admin>

<style>
  /* ============================================================
     DESKTOP STYLES (>= 769px)
     ============================================================ */
  @media (max-width: 768px) {
    .projects-desktop-view {
      display: none !important;
    }
  }

  .projects-toolbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .projects-search-box {
    position: relative;
    width: 20rem;
  }
  .projects-search-icon {
    position: absolute;
    left: 0.875rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--admin-muted);
    pointer-events: none;
  }
  .projects-search-input {
    width: 100%;
    height: 2.625rem;
    padding: 0 0.875rem 0 2.5rem;
    background: var(--admin-card);
    border: var(--admin-border);
    border-radius: var(--admin-r-input);
    font-family: var(--admin-font);
    font-size: max(12px, 0.875rem);
    color: var(--admin-ink);
    outline: none;
  }
  .projects-search-input:focus {
    border-color: var(--admin-ink);
  }
  .projects-chips-track {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .proj-table-thumb {
    width: 3.25rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #E8ECEF;
  }
  .proj-table-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .proj-table-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--admin-muted);
  }
  .proj-table-title {
    font-size: max(12px, 0.875rem);
    font-weight: 700;
    color: var(--admin-ink);
    text-decoration: none;
    display: block;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .proj-table-title:hover {
    color: var(--admin-red);
  }
  .proj-table-slug {
    font-size: max(12px, 0.75rem);
    color: var(--admin-muted);
    display: block;
    margin-top: 0.125rem;
    font-family: var(--admin-font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .proj-table-price {
    font-size: max(12px, 0.875rem);
    font-weight: 600;
    color: var(--admin-ink);
    white-space: nowrap;
  }

  /* ============================================================
     MOBILE STYLES (<= 768px)
     ============================================================ */
  .mobile-search-wrap {
    position: relative;
    margin-bottom: 0.75rem;
  }
  .mobile-search-icon {
    position: absolute;
    left: 0.875rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--admin-muted);
    pointer-events: none;
  }
  .mobile-search-field {
    padding-left: 2.625rem !important;
  }
  .mobile-chips-track {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.75rem;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-projects-card {
    padding: 0.5rem 1rem;
  }
  .mobile-project-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--admin-line-subtle);
    text-decoration: none;
    color: var(--admin-ink);
    transition: background var(--admin-duration) var(--admin-ease);
  }
  .mobile-project-item:last-child {
    border-bottom: none;
  }
  .mobile-project-thumb {
    width: 3.5rem;
    height: 2.75rem;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #E8ECEF;
    flex-shrink: 0;
  }
  .mobile-project-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mobile-project-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--admin-muted);
  }
  .mobile-project-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-project-title {
    font-size: max(12px, 0.875rem);
    font-weight: 700;
    color: var(--admin-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mobile-project-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .mobile-project-price {
    font-size: max(12px, 0.8125rem);
    font-weight: 600;
    color: var(--admin-muted);
  }
  .mobile-empty-state {
    text-align: center;
    padding: 2rem 1rem;
    color: var(--admin-muted);
    font-size: max(12px, 0.875rem);
  }

  .mobile-fab {
    position: fixed;
    right: 1rem;
    bottom: calc(4.5rem + env(safe-area-inset-bottom, 0rem));
    background: var(--admin-red);
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    box-shadow: 0 4px 16px rgba(217, 31, 38, 0.35);
    font-size: max(12px, 0.875rem);
    font-weight: 700;
    text-decoration: none;
    z-index: 85;
    transition: transform var(--admin-duration) var(--admin-ease);
  }
  .mobile-fab:active {
    transform: scale(0.96);
  }
</style>

<script>
  // Desktop Filter & Search
  const desktopSearch = document.getElementById('desktop-proj-search') as HTMLInputElement | null;
  const desktopChips = document.querySelectorAll<HTMLButtonElement>('[data-desktop-filter]');
  const desktopRows = document.querySelectorAll<HTMLTableRowElement>('.desktop-project-row');
  let currentDesktopFilter = 'all';

  function applyDesktopFilter() {
    const q = (desktopSearch?.value || '').trim().toLowerCase();
    desktopRows.forEach((row) => {
      const title = row.dataset.title || '';
      const slug = row.dataset.slug || '';
      const status = row.dataset.status || '';
      const matchesSearch = !q || title.includes(q) || slug.includes(q);
      const matchesStatus = currentDesktopFilter === 'all' || status === currentDesktopFilter;
      row.style.display = matchesSearch && matchesStatus ? '' : 'none';
    });
  }

  desktopSearch?.addEventListener('input', applyDesktopFilter);
  desktopChips.forEach((btn) => {
    btn.addEventListener('click', () => {
      desktopChips.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      currentDesktopFilter = btn.dataset.desktopFilter || 'all';
      applyDesktopFilter();
    });
  });

  // Mobile Filter & Search
  const mobileSearch = document.getElementById('mobile-proj-search') as HTMLInputElement | null;
  const mobileChips = document.querySelectorAll<HTMLButtonElement>('[data-mobile-filter]');
  const mobileItems = document.querySelectorAll<HTMLAnchorElement>('.mobile-project-item');
  const mobileNoResults = document.getElementById('mobile-no-results');
  let currentMobileFilter = 'all';

  function applyMobileFilter() {
    const q = (mobileSearch?.value || '').trim().toLowerCase();
    let visibleCount = 0;
    mobileItems.forEach((item) => {
      const title = item.dataset.title || '';
      const slug = item.dataset.slug || '';
      const status = item.dataset.status || '';
      const matchesSearch = !q || title.includes(q) || slug.includes(q);
      const matchesStatus = currentMobileFilter === 'all' || status === currentMobileFilter;
      const show = matchesSearch && matchesStatus;
      item.style.display = show ? 'flex' : 'none';
      if (show) visibleCount++;
    });
    if (mobileNoResults) {
      mobileNoResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  mobileSearch?.addEventListener('input', applyMobileFilter);
  mobileChips.forEach((btn) => {
    btn.addEventListener('click', () => {
      mobileChips.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      currentMobileFilter = btn.dataset.mobileFilter || 'all';
      applyMobileFilter();
    });
  });
</script>
