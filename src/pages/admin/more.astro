---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';

const admin = Astro.locals.admin;
const csrf = Astro.locals.csrfToken;
const email = admin?.email || 'admin@technicaltriveni.me';
const initial = email.charAt(0).toUpperCase() || 'T';
---

<Admin title="More" active="more">
  <div class="more-container">
    <div class="more-header">
      <h1 class="more-title">More</h1>
    </div>

    <!-- Admin Profile Card -->
    <div class="admin-card profile-card">
      <div class="profile-avatar">{initial}</div>
      <div class="profile-info">
        <h2 class="profile-name">TechnicalTriveni Admin</h2>
        <span class="profile-email mono">{email}</span>
      </div>
    </div>

    <!-- Navigation Hub Card -->
    <div class="admin-card list-card">
      <a href="/admin/pages" class="list-row">
        <div class="list-row__left">
          <Icon name="file" size={20} class="row-icon" />
          <span class="row-label">Pages</span>
        </div>
        <Icon name="chevron-right" size={18} class="row-chevron" />
      </a>

      <a href="/admin/coupons" class="list-row">
        <div class="list-row__left">
          <Icon name="tag" size={20} class="row-icon" />
          <span class="row-label">Coupons</span>
        </div>
        <Icon name="chevron-right" size={18} class="row-chevron" />
      </a>

      <a href="/admin/settings" class="list-row">
        <div class="list-row__left">
          <Icon name="sliders" size={20} class="row-icon" />
          <span class="row-label">Settings</span>
        </div>
        <Icon name="chevron-right" size={18} class="row-chevron" />
      </a>
    </div>

    <!-- Actions Card -->
    <div class="admin-card list-card">
      <a href="/" target="_blank" rel="noopener noreferrer" class="list-row">
        <div class="list-row__left">
          <Icon name="external" size={20} class="row-icon" />
          <span class="row-label">View site</span>
        </div>
        <Icon name="chevron-right" size={18} class="row-chevron" />
      </a>

      <form method="post" action="/api/admin/logout" class="logout-form">
        <input type="hidden" name="csrf" value={csrf} />
        <button type="submit" class="list-row logout-btn">
          <div class="list-row__left">
            <Icon name="logout" size={20} class="row-icon logout-icon" />
            <span class="row-label logout-label">Log out</span>
          </div>
        </button>
      </form>
    </div>
  </div>
</Admin>

<style>
  .more-container {
    max-width: 37.5rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.5rem 0;
  }

  .more-header {
    margin-bottom: 0.25rem;
  }

  .more-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--admin-ink);
    margin: 0;
  }

  /* Profile Card */
  .profile-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
  }

  .profile-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: #E8ECEF;
    color: var(--admin-ink);
    font-size: 1.25rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .profile-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--admin-ink);
    margin: 0;
  }

  .profile-email {
    font-size: max(12px, 0.8125rem);
    color: var(--admin-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* List Card */
  .list-card {
    padding: 0.25rem 1rem;
    display: flex;
    flex-direction: column;
  }

  .list-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0.25rem;
    text-decoration: none;
    color: var(--admin-ink);
    border-bottom: 1px solid var(--admin-line-subtle);
    background: transparent;
    border-top: none;
    border-left: none;
    border-right: none;
    width: 100%;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.9375rem;
    transition: background var(--admin-duration) var(--admin-ease);
  }

  .list-row:last-child {
    border-bottom: none;
  }

  .list-row__left {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .row-icon {
    color: var(--admin-muted);
  }

  .row-label {
    font-weight: 600;
    color: var(--admin-ink);
  }

  .row-chevron {
    color: var(--admin-muted);
  }

  /* Logout button */
  .logout-form {
    margin: 0;
    width: 100%;
  }

  .logout-btn {
    text-align: left;
  }

  .logout-icon,
  .logout-label {
    color: var(--admin-red) !important;
  }
</style>
