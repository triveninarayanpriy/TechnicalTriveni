---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { listContactMessages } from '../../lib/db';
import { formatDateTime } from '../../lib/format';

const status = Astro.url.searchParams.get('status') || 'new';
const search = Astro.url.searchParams.get('q') || '';
const messages = await listContactMessages(env.DB, status, search, 200);
const csrf = Astro.locals.csrfToken;

const tabs = [
  { id: 'new', label: 'New' },
  { id: 'replied', label: 'Replied' },
  { id: 'spam', label: 'Spam' },
  { id: 'archived', label: 'Archived' },
  { id: 'all', label: 'All' }
];

const savedReplies = [
  { label: 'Select a saved reply...', value: '' },
  { label: 'Thank you - Looking into it', value: 'Hi there,\n\nThank you for reaching out. We have received your message and are currently looking into it. We will get back to you shortly.\n\nBest regards,\nTechnical Triveni' },
  { label: 'Check the FAQ', value: 'Hi,\n\nThanks for your message! Please check our FAQ section on the website, as it might already answer your question.\n\nBest,\nTechnical Triveni' },
  { label: 'Not a good fit right now', value: 'Hi,\n\nThanks for reaching out. Unfortunately, this is not something we are able to assist with at this time.\n\nBest regards,\nTechnical Triveni' }
];
---

<Admin title="Messages" active="messages">
  <div class="msg-board">
    <div class="msg-header">
      <div class="tabs">
        {tabs.map((t) => (
          <a
            href={`?status=${t.id}${search ? `&q=${encodeURIComponent(search)}` : ''}`}
            class:list={['tab', { active: status === t.id }]}
          >
            {t.label}
          </a>
        ))}
      </div>
      <form class="search-form" method="get" action="/admin/messages">
        <input type="hidden" name="status" value={status} />
        <div class="search-input-wrapper">
          <Icon name="search" size={16} class="search-icon" />
          <input
            type="search"
            name="q"
            placeholder="Search name, email, subject..."
            value={search}
            class="input search-input"
          />
        </div>
      </form>
    </div>

    {messages.length > 0 ? (
      <div class="msgs">
        {messages.map((m) => (
          <article class:list={['msg', `status-${m.status}`]} data-msg-id={m.id}>
            <div class="msg__head" role="button" tabindex="0">
              <div class="msg__sender">
                <strong>{m.name}</strong>
                <a href={`mailto:${m.email}`} class="mono dim msg__email" aria-label="Email">{m.email}</a>
              </div>
              <div class="msg__meta">
                <span class="dim msg__date">{formatDateTime(m.created_at)}</span>
                <Icon name="chevron-down" size={16} class="expand-icon" />
              </div>
            </div>
            
            <div class="msg__content">
              {m.subject && <h4 class="msg__subject">{m.subject}</h4>}
              <p class="msg__body">{m.message}</p>
              
              {m.reply_body && m.status === 'replied' && (
                <div class="msg__reply-history">
                  <h5>Previous Reply</h5>
                  <p>{m.reply_body}</p>
                </div>
              )}

              <div class="msg__actions">
                <form method="post" action="/api/admin/message/action" class="inline-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="id" value={m.id} />
                  <input type="hidden" name="action" value="archive" />
                  <button class="btn btn-ghost btn-sm" type="submit">Archive</button>
                </form>
                <form method="post" action="/api/admin/message/action" class="inline-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="id" value={m.id} />
                  <input type="hidden" name="action" value="spam" />
                  <button class="btn btn-ghost btn-sm" type="submit">Mark Spam</button>
                </form>
                {m.status !== 'new' && (
                  <form method="post" action="/api/admin/message/action" class="inline-form">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="id" value={m.id} />
                    <input type="hidden" name="action" value="new" />
                    <button class="btn btn-ghost btn-sm" type="submit">Mark New</button>
                  </form>
                )}
                <button class="btn btn-primary btn-sm btn-reply-toggle" type="button">
                  <Icon name="mail" size={14} /> Reply
                </button>
              </div>

              <div class="msg__reply-box" style="display: none;">
                <form method="post" action="/api/admin/message/reply" class="reply-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="id" value={m.id} />
                  <input type="hidden" name="email" value={m.email} />
                  <input type="hidden" name="subject" value={m.subject} />
                  
                  <div class="form-group">
                    <select class="select saved-replies">
                      {savedReplies.map(r => (
                        <option value={r.value}>{r.label}</option>
                      ))}
                    </select>
                  </div>
                  <div class="form-group">
                    <textarea 
                      name="reply_body" 
                      class="input reply-textarea" 
                      rows="5" 
                      required 
                      placeholder="Write your reply here..."
                    >{m.reply_body || ''}</textarea>
                  </div>
                  <div class="reply-actions">
                    <button type="button" class="btn btn-ghost btn-cancel-reply">Cancel</button>
                    <button type="submit" class="btn btn-primary"><Icon name="send" size={14} /> Send Reply</button>
                  </div>
                </form>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-admin">
        <div class="empty-admin__icon"><Icon name="mail" size={28} /></div>
        <h3>No messages found</h3>
        <p class="dim">Try changing the search or tab.</p>
      </div>
    )}
  </div>
</Admin>

<style>
  .msg-board { max-width: 900px; display: flex; flex-direction: column; gap: 1.5rem; }
  .msg-header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; align-items: center; background: var(--surface); padding: 1rem; border-radius: var(--r-lg); border: 1px solid var(--border); }
  .tabs { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tab { padding: 0.4rem 0.8rem; border-radius: var(--r-md); font-size: var(--fs-sm); font-weight: 500; color: var(--text-dim); text-decoration: none; transition: background 0.2s, color 0.2s; }
  .tab:hover { background: var(--surface-2); color: var(--text); }
  .tab.active { background: var(--brand-red); color: white; }
  
  .search-form { flex: 1; min-width: 200px; max-width: 300px; }
  .search-input-wrapper { position: relative; display: flex; align-items: center; }
  .search-icon { position: absolute; left: 0.8rem; color: var(--text-muted); pointer-events: none; }
  .search-input { width: 100%; padding-left: 2.2rem; }
  
  .msgs { display: flex; flex-direction: column; gap: 1rem; }
  .msg { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; transition: box-shadow 0.2s; }
  .msg.status-new { border-left: 3px solid var(--brand-red); }
  .msg.status-replied { border-left: 3px solid var(--success); }
  .msg.status-spam { border-left: 3px solid var(--danger); opacity: 0.7; }
  .msg.status-archived { border-left: 3px solid var(--text-muted); opacity: 0.8; }
  
  .msg__head { display: flex; justify-content: space-between; align-items: flex-start; padding: 1.2rem 1.5rem; cursor: pointer; gap: 1rem; user-select: none; }
  .msg__head:hover { background: var(--surface-2); }
  .msg__sender { display: flex; flex-direction: column; }
  .msg__email { font-size: var(--fs-xs); margin-top: 2px; }
  .msg__meta { display: flex; align-items: center; gap: 1rem; }
  .msg__date { font-size: var(--fs-xs); }
  .expand-icon { transition: transform 0.2s; }
  .msg.expanded .expand-icon { transform: rotate(180deg); }
  
  .msg__content { display: none; padding: 0 1.5rem 1.5rem; border-top: 1px solid var(--border); }
  .msg.expanded .msg__content { display: block; padding-top: 1.2rem; }
  
  .msg__subject { margin-bottom: 0.5rem; font-size: var(--fs-md); font-weight: 600; }
  .msg__body { color: var(--text-muted); font-size: var(--fs-sm); white-space: pre-wrap; line-height: 1.5; }
  
  .msg__reply-history { margin-top: 1.5rem; padding: 1rem; background: var(--surface-2); border-radius: var(--r-md); border-left: 2px solid var(--success); }
  .msg__reply-history h5 { margin-bottom: 0.5rem; font-size: var(--fs-sm); color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em; }
  .msg__reply-history p { font-size: var(--fs-sm); white-space: pre-wrap; color: var(--text); }
  
  .msg__actions { display: flex; gap: 0.5rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed var(--border); flex-wrap: wrap; }
  .inline-form { display: inline; }
  
  .msg__reply-box { margin-top: 1.5rem; padding: 1rem; background: var(--surface-2); border-radius: var(--r-md); border: 1px solid var(--border); }
  .form-group { margin-bottom: 1rem; }
  .reply-textarea { width: 100%; font-family: inherit; }
  .reply-actions { display: flex; justify-content: flex-end; gap: 0.5rem; }
  .saved-replies { width: 100%; max-width: 300px; }
  
  .empty-admin { text-align: center; padding: 4rem 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); }
  .empty-admin__icon { width: 60px; height: 60px; display: grid; place-items: center; margin: 0 auto 1rem; border-radius: 50%; background: var(--surface-2); color: var(--text-dim); }
</style>

<script>
  // Expand/collapse messages
  document.querySelectorAll('.msg__head').forEach(head => {
    head.addEventListener('click', () => {
      const msg = head.closest('.msg');
      msg.classList.toggle('expanded');
    });
    head.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        head.closest('.msg').classList.toggle('expanded');
      }
    });
  });

  // Toggle reply box
  document.querySelectorAll('.btn-reply-toggle').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const box = btn.closest('.msg__content').querySelector('.msg__reply-box');
      box.style.display = box.style.display === 'none' ? 'block' : 'none';
      if (box.style.display === 'block') {
        box.querySelector('textarea').focus();
      }
    });
  });

  // Cancel reply
  document.querySelectorAll('.btn-cancel-reply').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.closest('.msg__reply-box').style.display = 'none';
    });
  });

  // Saved replies
  document.querySelectorAll('.saved-replies').forEach(select => {
    select.addEventListener('change', (e) => {
      const val = e.target.value;
      if (val) {
        const textarea = select.closest('.msg__reply-box').querySelector('textarea');
        textarea.value = val;
      }
    });
  });
</script>
