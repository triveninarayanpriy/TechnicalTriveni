---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { listContactMessages } from '../../lib/db';
import { formatDateTime } from '../../lib/format';

const status = Astro.url.searchParams.get('status') || 'new';
const search = Astro.url.searchParams.get('q') || '';
const messages = await listContactMessages(env.DB, status, search, 200);
const csrf = Astro.locals.csrfToken;

const tabs = [
  { id: 'new', label: 'New' },
  { id: 'replied', label: 'Replied' },
  { id: 'spam', label: 'Spam' },
  { id: 'archived', label: 'Archived' },
  { id: 'all', label: 'All' },
];

const savedReplies = [
  { label: 'Select a saved reply...', value: '' },
  { label: 'Thank you - Looking into it', value: 'Hi there,\n\nThank you for reaching out. We have received your message and are currently looking into it. We will get back to you shortly.\n\nBest regards,\nTechnical Triveni' },
  { label: 'Check the FAQ', value: 'Hi,\n\nThanks for your message! Please check our FAQ section on the website, as it might already answer your question.\n\nBest,\nTechnical Triveni' },
  { label: 'Not a good fit right now', value: 'Hi,\n\nThanks for reaching out. Unfortunately, this is not something we are able to assist with at this time.\n\nBest regards,\nTechnical Triveni' },
];

const activeMessageId = Astro.url.searchParams.get('id') ? Number(Astro.url.searchParams.get('id')) : (messages[0]?.id || 0);
const selectedMessage = messages.find((m) => m.id === activeMessageId) || messages[0] || null;
---

<Admin title="Messages" active="messages">
  <!-- ==============================================
       DESKTOP / TABLET TWO-PANE VIEW (>= 769px)
       ============================================== -->
  <div class="msg-desktop-view">
    <header class="admin-desktop-topbar">
      <h1 class="admin-desktop-topbar__title">Messages</h1>
      <div class="admin-desktop-topbar__actions">
        <!-- Filter Tabs as Segmented Control -->
        <div class="admin-segmented">
          {tabs.map((t) => (
            <a
              href={`?status=${t.id}${search ? `&q=${encodeURIComponent(search)}` : ''}`}
              class:list={['admin-segment-item', { 'is-active': status === t.id }]}
            >
              {t.label}
            </a>
          ))}
        </div>
      </div>
    </header>

    <div class="admin-desktop-content">
      <!-- Search Bar -->
      <form class="msg-search-bar" method="get">
        <input type="hidden" name="status" value={status} />
        <div class="search-wrap">
          <Icon name="search" size={18} class="search-icon" />
          <input
            type="search"
            name="q"
            value={search}
            placeholder="Search name, email, subject..."
            class="admin-input search-input"
            autocomplete="off"
          />
        </div>
      </form>

      <!-- Split 2-Pane Container -->
      <div class="admin-card msg-two-pane">
        <!-- Left Pane: Message List -->
        <div class="msg-pane-list">
          {messages.map((m) => {
            const isSelected = selectedMessage && selectedMessage.id === m.id;
            return (
              <a
                href={`?status=${status}&id=${m.id}${search ? `&q=${encodeURIComponent(search)}` : ''}`}
                class:list={['msg-list-item', { 'is-selected': isSelected }]}
              >
                <div class="msg-item-top">
                  <span class="msg-item-sender" title={m.name}>{m.name}</span>
                  <span class="msg-item-date">{formatDateTime(m.created_at)}</span>
                </div>
                <span class="msg-item-email" title={m.email}>{m.email}</span>
                <span class="msg-item-subject" title={m.subject || 'No subject'}>{m.subject || 'No subject'}</span>
                <p class="msg-item-preview">{m.message.slice(0, 90)}...</p>
                <div class="msg-item-footer">
                  <span class:list={['admin-chip', m.status === 'new' ? 'admin-chip--warning' : m.status === 'replied' ? 'admin-chip--live' : 'admin-chip--draft']}>
                    {m.status}
                  </span>
                </div>
              </a>
            );
          })}
          {messages.length === 0 && (
            <div class="msg-empty-state">
              <Icon name="mail" size={28} />
              <p>No messages found in this folder.</p>
            </div>
          )}
        </div>

        <!-- Right Pane: Detail & Reply -->
        <div class="msg-pane-detail">
          {selectedMessage ? (
            <div class="msg-detail-wrap">
              <div class="msg-detail-header">
                <div>
                  <h2 class="msg-detail-title">{selectedMessage.subject || 'General Inquiry'}</h2>
                  <div class="msg-detail-sender">
                    <strong>{selectedMessage.name}</strong>
                    <span class="dim">&lt;{selectedMessage.email}&gt;</span>
                  </div>
                  <div class="msg-detail-time dim">{formatDateTime(selectedMessage.created_at)}</div>
                </div>

                <div class="msg-detail-actions">
                  <form method="post" action="/api/admin/message/action">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="id" value={selectedMessage.id} />
                    <input type="hidden" name="action" value="archive" />
                    <button type="submit" class="admin-btn admin-btn--secondary admin-btn--sm">Archive</button>
                  </form>
                  <form method="post" action="/api/admin/message/action">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="id" value={selectedMessage.id} />
                    <input type="hidden" name="action" value="spam" />
                    <button type="submit" class="admin-btn admin-btn--secondary admin-btn--sm">Mark Spam</button>
                  </form>
                </div>
              </div>

              <div class="msg-detail-body">
                <p>{selectedMessage.message}</p>
              </div>

              {selectedMessage.reply_body && (
                <div class="msg-previous-reply">
                  <h4>Previous Reply</h4>
                  <p>{selectedMessage.reply_body}</p>
                </div>
              )}

              <!-- Inline Reply Box -->
              <div class="msg-reply-section">
                <h3 class="msg-reply-title">Reply to {selectedMessage.name}</h3>
                <form method="post" action="/api/admin/message/reply" class="msg-reply-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="id" value={selectedMessage.id} />
                  <input type="hidden" name="email" value={selectedMessage.email} />
                  <input type="hidden" name="subject" value={selectedMessage.subject} />

                  <div class="admin-field">
                    <label class="admin-label">Quick Saved Reply</label>
                    <select class="admin-select desktop-saved-replies">
                      {savedReplies.map(r => (
                        <option value={r.value}>{r.label}</option>
                      ))}
                    </select>
                  </div>

                  <div class="admin-field">
                    <label class="admin-label">Message Body</label>
                    <textarea
                      name="reply_body"
                      class="admin-textarea desktop-reply-text"
                      rows="6"
                      required
                      placeholder="Write your reply here..."
                    ></textarea>
                  </div>

                  <div class="reply-button-row">
                    <button type="submit" class="admin-btn admin-btn--primary">
                      <Icon name="mail" size={16} />
                      <span>Send Reply</span>
                    </button>
                  </div>
                </form>
              </div>
            </div>
          ) : (
            <div class="msg-detail-empty">
              <Icon name="mail" size={36} />
              <p>Select a message on the left to read and reply.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- ==============================================
       MOBILE MESSAGES VIEW (<= 768px)
       Dedicated layout with cards & full-screen viewer
       ============================================== -->
  <div class="admin-mobile-shell">
    <header class="admin-mobile-topbar">
      <h1 class="admin-mobile-topbar__title">Messages</h1>
    </header>

    <div class="admin-mobile-content">
      <!-- Search Input -->
      <form class="mobile-search-form" method="get">
        <input type="hidden" name="status" value={status} />
        <div class="mobile-search-wrap">
          <Icon name="search" size={18} class="mobile-search-icon" />
          <input
            type="search"
            name="q"
            value={search}
            placeholder="Search name, email..."
            class="admin-input mobile-search-field"
            autocomplete="off"
          />
        </div>
      </form>

      <!-- Filter Chips -->
      <div class="mobile-chips-track">
        {tabs.map((t) => (
          <a
            href={`?status=${t.id}${search ? `&q=${encodeURIComponent(search)}` : ''}`}
            class:list={['admin-chip admin-chip--filter', { 'is-active': status === t.id }]}
          >
            {t.label}
          </a>
        ))}
      </div>

      <!-- Mobile Message Cards -->
      <div class="admin-card mobile-msg-card-list">
        {messages.map((m) => (
          <article class="mobile-msg-item">
            <details class="mobile-msg-details">
              <summary class="mobile-msg-summary">
                <div class="mobile-msg-head">
                  <span class="mobile-msg-sender">{m.name}</span>
                  <span class="mobile-msg-date">{formatDateTime(m.created_at)}</span>
                </div>
                <span class="mobile-msg-subject">{m.subject || 'No subject'}</span>
                <div class="mobile-msg-status-row">
                  <span class:list={['admin-chip', m.status === 'new' ? 'admin-chip--warning' : m.status === 'replied' ? 'admin-chip--live' : 'admin-chip--draft']}>
                    {m.status}
                  </span>
                  <span class="dim" style="font-size: 12px; margin-left: auto;">Tap to read</span>
                </div>
              </summary>

              <div class="mobile-msg-body">
                <p class="mobile-msg-text">{m.message}</p>

                {m.reply_body && (
                  <div class="msg-previous-reply">
                    <h4>Previous Reply</h4>
                    <p>{m.reply_body}</p>
                  </div>
                )}

                <div class="mobile-msg-actions">
                  <form method="post" action="/api/admin/message/action">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="id" value={m.id} />
                    <input type="hidden" name="action" value="archive" />
                    <button type="submit" class="admin-btn admin-btn--secondary admin-btn--sm">Archive</button>
                  </form>
                  <form method="post" action="/api/admin/message/action">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="id" value={m.id} />
                    <input type="hidden" name="action" value="spam" />
                    <button type="submit" class="admin-btn admin-btn--secondary admin-btn--sm">Mark Spam</button>
                  </form>
                </div>

                <!-- Reply Form -->
                <form method="post" action="/api/admin/message/reply" class="mobile-reply-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="id" value={m.id} />
                  <input type="hidden" name="email" value={m.email} />
                  <input type="hidden" name="subject" value={m.subject} />

                  <div class="admin-field">
                    <label class="admin-label">Quick Saved Reply</label>
                    <select class="admin-select mobile-saved-replies">
                      {savedReplies.map(r => (
                        <option value={r.value}>{r.label}</option>
                      ))}
                    </select>
                  </div>

                  <div class="admin-field">
                    <label class="admin-label">Reply</label>
                    <textarea
                      name="reply_body"
                      class="admin-textarea mobile-reply-text"
                      rows="4"
                      required
                      placeholder="Write your reply..."
                    ></textarea>
                  </div>

                  <button type="submit" class="admin-btn admin-btn--primary" style="width: 100%;">
                    Send Reply
                  </button>
                </form>
              </div>
            </details>
          </article>
        ))}

        {messages.length === 0 && (
          <div class="mobile-empty-orders">No messages found.</div>
        )}
      </div>
    </div>
  </div>
</Admin>

<style>
  /* Desktop Layout */
  @media (max-width: 768px) {
    .msg-desktop-view { display: none !important; }
  }

  .msg-search-bar {
    margin-bottom: 20px;
    max-width: 420px;
  }
  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-icon {
    position: absolute;
    left: 14px;
    color: var(--admin-muted);
    pointer-events: none;
  }
  .search-input {
    padding-left: 40px !important;
  }

  .msg-two-pane {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    padding: 0;
    overflow: hidden;
    min-height: 600px;
    min-width: 0;
  }
  @media (max-width: 1023px) {
    .msg-two-pane {
      grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    }
  }

  .msg-pane-list {
    border-right: var(--admin-border);
    overflow-y: auto;
    max-height: 750px;
    background: #FAFBFD;
    min-width: 0;
  }
  .msg-list-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--admin-line-subtle);
    text-decoration: none;
    color: var(--admin-ink);
    transition: background var(--admin-duration) var(--admin-ease);
    min-width: 0;
  }
  .msg-list-item:hover {
    background: #F0F3F7;
  }
  .msg-list-item.is-selected {
    background: #FFFFFF;
    border-left: 3px solid var(--admin-red);
  }
  .msg-item-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }
  .msg-item-sender {
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .msg-item-date {
    font-size: 11px;
    color: var(--admin-muted);
    flex: none;
    white-space: nowrap;
  }
  .msg-item-email {
    font-size: 12px;
    color: var(--admin-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .msg-item-subject {
    font-size: 13px;
    font-weight: 600;
    color: var(--admin-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
    min-width: 0;
  }
  .msg-item-preview {
    font-size: 12.5px;
    color: var(--admin-muted);
    margin: 2px 0 6px 0;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .msg-empty-state {
    text-align: center;
    padding: 60px 24px;
    color: var(--admin-muted);
  }

  .msg-pane-detail {
    padding: 28px 32px;
    overflow-y: auto;
    background: #FFFFFF;
  }
  .msg-detail-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 20px;
    border-bottom: var(--admin-border);
  }
  .msg-detail-title {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 6px 0;
  }
  .msg-detail-sender {
    font-size: 14px;
    margin-bottom: 4px;
  }
  .msg-detail-time {
    font-size: 12px;
    color: var(--admin-muted);
  }
  .msg-detail-actions {
    display: flex;
    gap: 8px;
  }
  .msg-detail-body {
    padding: 24px 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--admin-ink);
  }
  .msg-previous-reply {
    background: #F8FAFC;
    border-left: 3px solid var(--admin-success-text);
    padding: 14px 18px;
    border-radius: 8px;
    margin-bottom: 24px;
  }
  .msg-previous-reply h4 {
    margin: 0 0 6px 0;
    font-size: 13px;
    color: var(--admin-success-text);
  }
  .msg-previous-reply p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .msg-reply-section {
    padding-top: 20px;
    border-top: var(--admin-border);
  }
  .msg-reply-title {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 16px 0;
  }
  .msg-reply-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .reply-button-row {
    display: flex;
    justify-content: flex-end;
  }
  .msg-detail-empty {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--admin-muted);
  }

  /* Mobile Layout */
  .mobile-search-wrap {
    position: relative;
    margin-bottom: 12px;
  }
  .mobile-search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--admin-muted);
    pointer-events: none;
  }
  .mobile-search-field {
    padding-left: 42px !important;
  }
  .mobile-chips-track {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 12px;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-msg-card-list {
    padding: 8px 16px;
  }
  .mobile-msg-item {
    border-bottom: 1px solid var(--admin-line-subtle);
  }
  .mobile-msg-item:last-child {
    border-bottom: none;
  }
  .mobile-msg-summary {
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mobile-msg-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .mobile-msg-sender {
    font-size: 15px;
    font-weight: 700;
  }
  .mobile-msg-date {
    font-size: 11px;
    color: var(--admin-muted);
  }
  .mobile-msg-subject {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--admin-ink);
  }
  .mobile-msg-status-row {
    display: flex;
    align-items: center;
    margin-top: 4px;
  }
  .mobile-msg-body {
    padding: 12px 0 18px 0;
    border-top: 1px dashed var(--admin-line);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .mobile-msg-text {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }
  .mobile-msg-actions {
    display: flex;
    gap: 8px;
  }
  .mobile-reply-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #F8FAFC;
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--admin-line);
  }
  .mobile-empty-orders {
    text-align: center;
    padding: 32px 16px;
    color: var(--admin-muted);
    font-size: 14px;
  }
</style>

<script>
  // Desktop saved reply auto-fill
  const desktopSavedSelect = document.querySelector('.desktop-saved-replies') as HTMLSelectElement | null;
  const desktopReplyText = document.querySelector('.desktop-reply-text') as HTMLTextAreaElement | null;
  desktopSavedSelect?.addEventListener('change', () => {
    if (desktopSavedSelect.value && desktopReplyText) {
      desktopReplyText.value = desktopSavedSelect.value;
    }
  });

  // Mobile saved reply auto-fill
  document.querySelectorAll('.mobile-reply-form').forEach((form) => {
    const sel = form.querySelector('.mobile-saved-replies') as HTMLSelectElement | null;
    const txt = form.querySelector('.mobile-reply-text') as HTMLTextAreaElement | null;
    sel?.addEventListener('change', () => {
      if (sel.value && txt) {
        txt.value = sel.value;
      }
    });
  });
</script>
