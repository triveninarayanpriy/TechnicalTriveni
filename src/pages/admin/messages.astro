---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { listContactMessages } from '../../lib/db';
import { formatDateTime } from '../../lib/format';

const messages = await listContactMessages(env.DB, 200);
const csrf = Astro.locals.csrfToken;
---

<Admin title="Messages" active="messages">
  {messages.length > 0 ? (
    <div class="msgs">
      {messages.map((m) => (
        <article class:list={['msg', { 'is-handled': m.handled === 1 }]}>
          <div class="msg__head">
            <div>
              <strong>{m.name}</strong>
              <a href={`mailto:${m.email}`} class="mono dim msg__email">{m.email}</a>
            </div>
            <span class="dim msg__date">{formatDateTime(m.created_at)}</span>
          </div>
          {m.subject && <p class="msg__subject">{m.subject}</p>}
          <p class="msg__body">{m.message}</p>
          <div class="msg__actions">
            <a href={`mailto:${m.email}?subject=Re: ${encodeURIComponent(m.subject || 'Your message')}`} class="btn btn-ghost btn-xs"><Icon name="mail" size={14} /> Reply</a>
            <form method="post" action="/api/admin/message/action" class="inline-form">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="id" value={m.id} />
              <input type="hidden" name="action" value={m.handled ? 'unhandle' : 'handle'} />
              <button class="btn btn-ghost btn-xs" type="submit">{m.handled ? 'Mark unread' : 'Mark handled'}</button>
            </form>
            <form method="post" action="/api/admin/message/action" class="inline-form" data-confirm="Delete this message?">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="id" value={m.id} />
              <input type="hidden" name="action" value="delete" />
              <button class="btn btn-ghost btn-xs btn-danger" type="submit"><Icon name="close" size={14} /></button>
            </form>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="empty-admin">
      <div class="empty-admin__icon"><Icon name="mail" size={28} /></div>
      <h3>No messages yet</h3>
      <p class="dim">Contact form submissions will appear here.</p>
    </div>
  )}
</Admin>

<style>
  .msgs { display: flex; flex-direction: column; gap: 1rem; max-width: 800px; }
  .msg { padding: 1.25rem 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); border-left: 3px solid var(--brand-red); }
  .msg.is-handled { border-left-color: var(--surface-3); opacity: 0.7; }
  .msg__head { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .msg__email { display: block; font-size: var(--fs-xs); margin-top: 2px; }
  .msg__date { font-size: var(--fs-xs); }
  .msg__subject { font-weight: 600; margin-bottom: 0.35rem; }
  .msg__body { color: var(--text-muted); font-size: var(--fs-sm); white-space: pre-wrap; }
  .msg__actions { display: flex; gap: 0.4rem; margin-top: 1rem; padding-top: 0.85rem; border-top: 1px solid var(--hairline); }
  .btn-xs { padding: 0.35rem 0.65rem; font-size: var(--fs-xs); }
  .btn-danger { color: var(--danger); }
  .inline-form { display: inline; }
  .empty-admin { text-align: center; padding: 4rem 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); }
  .empty-admin__icon { width: 60px; height: 60px; display: grid; place-items: center; margin: 0 auto 1rem; border-radius: 50%; background: var(--surface-2); color: var(--text-dim); }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) => {
    f.addEventListener('submit', (e) => { if (!confirm(f.dataset.confirm!)) e.preventDefault(); });
  });
</script>
