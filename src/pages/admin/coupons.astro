---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { formatDateTime } from '../../lib/format';

interface Coupon {
  id: number;
  code: string;
  discount_pct: number;
  discount_inr: number;
  max_uses: number;
  used: number;
  expires_at: number;
  created_at: number;
}

const coupons = await env.DB.prepare('SELECT * FROM coupons ORDER BY created_at DESC').all<Coupon>();
const couponList = coupons.results ?? [];
const csrf = Astro.locals.csrfToken;
---

<Admin title="Coupons" active="coupons">
  <!-- ==============================================
       DESKTOP / TABLET COUPONS VIEW (>= 769px)
       ============================================== -->
  <div class="coupons-desktop-view">
    <header class="admin-desktop-topbar">
      <h1 class="admin-desktop-topbar__title">Coupons</h1>
    </header>

    <div class="admin-desktop-content">
      <div class="coupons-grid-layout">
        <!-- Left: List of coupons -->
        <div class="admin-table-card">
          <div style="padding: 20px 24px; border-bottom: var(--admin-border);">
            <h2 style="font-size: 17px; font-weight: 700; margin: 0;">Active Coupons</h2>
          </div>
          <div class="admin-table-wrap">
            <table class="admin-table-standard">
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Discount</th>
                  <th>Uses</th>
                  <th>Expires</th>
                  <th style="text-align: right;"></th>
                </tr>
              </thead>
              <tbody>
                {couponList.map((c) => (
                  <tr>
                    <td>
                      <span class="admin-chip admin-chip--draft" style="font-family: var(--admin-font-mono); font-size: 13px;">
                        {c.code}
                      </span>
                    </td>
                    <td style="font-weight: 700; color: var(--admin-ink);">
                      {c.discount_pct > 0 ? `${c.discount_pct}% OFF` : `₹${c.discount_inr} OFF`}
                    </td>
                    <td>
                      {c.used} {c.max_uses > 0 ? `/ ${c.max_uses}` : '(Unlimited)'}
                    </td>
                    <td style="color: var(--admin-muted); font-size: 13px;">
                      {c.expires_at ? formatDateTime(c.expires_at) : 'Never'}
                    </td>
                    <td style="text-align: right;">
                      <form method="post" action="/api/admin/coupon/delete" onsubmit="return confirm('Delete this coupon?');" style="display: inline;">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="id" value={c.id} />
                        <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm admin-btn--icon" style="color: var(--admin-red);" title="Delete coupon">
                          <Icon name="trash" size={16} />
                        </button>
                      </form>
                    </td>
                  </tr>
                ))}
                {couponList.length === 0 && (
                  <tr>
                    <td colspan="5" style="text-align: center; padding: 48px; color: var(--admin-muted);">
                      No coupons found. Create your first discount coupon on the right.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Right: Create form -->
        <div class="admin-card">
          <h2 style="font-size: 17px; font-weight: 700; margin: 0 0 16px 0;">Create Coupon</h2>
          <form method="post" action="/api/admin/coupon/save" class="coupon-form">
            <input type="hidden" name="csrf" value={csrf} />
            
            <div class="admin-field">
              <label class="admin-label">Coupon Code *</label>
              <input class="admin-input" type="text" name="code" required placeholder="e.g. DIWALI50" style="text-transform: uppercase;" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div class="admin-field">
                <label class="admin-label">Discount (%)</label>
                <input class="admin-input" type="number" name="discount_pct" min="0" max="100" placeholder="0" />
              </div>
              <div class="admin-field">
                <label class="admin-label">Discount (INR)</label>
                <input class="admin-input" type="number" name="discount_inr" min="0" placeholder="0" />
              </div>
            </div>
            <span style="font-size: 12px; color: var(--admin-muted);">Specify EITHER a percentage OR a fixed amount.</span>

            <div class="admin-field">
              <label class="admin-label">Max Uses</label>
              <input class="admin-input" type="number" name="max_uses" min="0" placeholder="0 (Unlimited)" />
            </div>

            <div class="admin-field">
              <label class="admin-label">Expiry Date (Optional)</label>
              <input class="admin-input" type="datetime-local" name="expires_at" />
            </div>

            <button type="submit" class="admin-btn admin-btn--primary" style="margin-top: 8px;">
              Create Coupon
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- ==============================================
       MOBILE COUPONS VIEW (<= 768px)
       ============================================== -->
  <div class="admin-mobile-shell">
    <header class="admin-mobile-topbar">
      <h1 class="admin-mobile-topbar__title">Coupons</h1>
    </header>

    <div class="admin-mobile-content">
      <!-- Active Coupons List -->
      <div class="admin-card mobile-coupons-list">
        <h2 style="font-size: 16px; font-weight: 700; margin: 0 0 12px 0;">Active Coupons</h2>
        {couponList.map((c) => (
          <div class="mobile-coupon-card">
            <div class="mobile-coupon-top">
              <span class="admin-chip admin-chip--draft" style="font-family: var(--admin-font-mono); font-size: 14px; font-weight: 700;">
                {c.code}
              </span>
              <span class="coupon-discount-badge">
                {c.discount_pct > 0 ? `${c.discount_pct}% OFF` : `₹${c.discount_inr} OFF`}
              </span>
            </div>
            <div class="mobile-coupon-bottom">
              <span class="coupon-meta-text">Used: {c.used} {c.max_uses > 0 ? `/ ${c.max_uses}` : ''}</span>
              <form method="post" action="/api/admin/coupon/delete" onsubmit="return confirm('Delete this coupon?');" style="display:inline;">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={c.id} />
                <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm" style="color: var(--admin-red);">Delete</button>
              </form>
            </div>
          </div>
        ))}
        {couponList.length === 0 && (
          <div style="text-align: center; padding: 24px 0; color: var(--admin-muted); font-size: 14px;">
            No coupons found.
          </div>
        )}
      </div>

      <!-- Create Coupon Mobile Card -->
      <div class="admin-card" style="margin-top: 16px;">
        <h2 style="font-size: 16px; font-weight: 700; margin: 0 0 16px 0;">Create New Coupon</h2>
        <form method="post" action="/api/admin/coupon/save" class="coupon-form">
          <input type="hidden" name="csrf" value={csrf} />
          
          <div class="admin-field">
            <label class="admin-label">Coupon Code *</label>
            <input class="admin-input" type="text" name="code" required placeholder="e.g. DIWALI50" style="text-transform: uppercase;" />
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div class="admin-field">
              <label class="admin-label">Discount (%)</label>
              <input class="admin-input" type="number" name="discount_pct" min="0" max="100" placeholder="0" />
            </div>
            <div class="admin-field">
              <label class="admin-label">Discount (INR)</label>
              <input class="admin-input" type="number" name="discount_inr" min="0" placeholder="0" />
            </div>
          </div>

          <div class="admin-field">
            <label class="admin-label">Max Uses</label>
            <input class="admin-input" type="number" name="max_uses" min="0" placeholder="0 (Unlimited)" />
          </div>

          <div class="admin-field">
            <label class="admin-label">Expiry Date</label>
            <input class="admin-input" type="datetime-local" name="expires_at" />
          </div>

          <button type="submit" class="admin-btn admin-btn--primary" style="width: 100%; margin-top: 8px;">
            Create Coupon
          </button>
        </form>
      </div>
    </div>
  </div>
</Admin>

<style>
  @media (max-width: 768px) {
    .coupons-desktop-view { display: none !important; }
  }

  .coupons-grid-layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 1023px) {
    .coupons-grid-layout {
      grid-template-columns: 1fr;
    }
  }

  .coupon-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Mobile */
  .mobile-coupons-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mobile-coupon-card {
    padding: 12px 0;
    border-bottom: 1px solid var(--admin-line-subtle);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .mobile-coupon-card:last-child {
    border-bottom: none;
  }
  .mobile-coupon-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .coupon-discount-badge {
    font-size: 14px;
    font-weight: 700;
    color: var(--admin-ink);
  }
  .mobile-coupon-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .coupon-meta-text {
    font-size: 12.5px;
    color: var(--admin-muted);
  }
</style>
