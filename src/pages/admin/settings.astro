---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { getSettings } from '../../lib/db';
import { razorpayConfigured } from '../../lib/razorpay';
import { turnstileEnabled } from '../../lib/turnstile';

const settings = await getSettings(env.DB);
const csrf = Astro.locals.csrfToken;

const integrations = [
  { name: 'Razorpay payments', on: razorpayConfigured(env), env: 'RAZORPAY_ENABLED / RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET' },
  { name: 'Turnstile (bot protection)', on: turnstileEnabled(env), env: 'TURNSTILE_ENABLED / TURNSTILE_SITE_KEY / TURNSTILE_SECRET_KEY' },
  { name: 'Email receipts', on: !!env.RESEND_API_KEY, env: 'RESEND_API_KEY / FROM_EMAIL' },
];
---

<Admin title="Settings" active="settings">
  <div class="settings">
    <section class="settings-panel panel">
      <h2>Site content</h2>
      <p class="dim">Editable text that appears across the site.</p>
      <form method="post" action="/api/admin/settings/save" class="settings-form">
        <input type="hidden" name="csrf" value={csrf} />
        <div class="field">
          <label class="label" for="site_announcement">Announcement bar</label>
          <input class="input" id="site_announcement" name="site_announcement" maxlength="160"
            placeholder="e.g. New project drop every Friday!" value={settings.site_announcement || ''} />
          <span class="field-hint">Shows a thin banner at the top of every page. Leave blank to hide.</span>
        </div>
        <div class="field">
          <label class="label" for="contact_email">Public contact email</label>
          <input class="input" id="contact_email" name="contact_email" type="email" maxlength="200"
            value={settings.contact_email || ''} />
        </div>
        <button type="submit" class="btn btn-primary"><Icon name="check" size={16} /> Save settings</button>
      </form>
    </section>

    <section class="settings-panel panel">
      <h2>Integrations</h2>
      <p class="dim">Configured via secrets (see DEPLOY.md). Status is read-only here.</p>
      <ul class="integ-list">
        {integrations.map((i) => (
          <li>
            <span class:list={['integ-dot', { on: i.on }]}></span>
            <div>
              <strong>{i.name}</strong>
              <span class="dim mono">{i.env}</span>
            </div>
            <span class:list={['integ-status', { on: i.on }]}>{i.on ? 'Active' : 'Not set'}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="settings-panel panel">
      <h2>Admin password</h2>
      <p class="dim">Your login password is stored as a secure hash in a secret, not in the database.</p>
      <ol class="howto">
        <li>Generate a new hash locally: <code class="inline-code">node scripts/hash-password.mjs "your-new-password"</code></li>
        <li>Update the secret: <code class="inline-code">wrangler pages secret put ADMIN_PASSWORD_HASH</code></li>
        <li>Paste the hash when prompted. Done — the change is live immediately.</li>
      </ol>
    </section>
  </div>
</Admin>

<style>
  .settings { display: flex; flex-direction: column; gap: 1.25rem; max-width: 720px; }
  .settings-panel { padding: 1.5rem; }
  .settings-panel h2 { font-size: var(--fs-md); }
  .settings-panel > .dim { font-size: var(--fs-sm); margin-top: 0.25rem; margin-bottom: 1.25rem; }
  .settings-form { display: flex; flex-direction: column; gap: 1rem; }
  .integ-list { display: flex; flex-direction: column; gap: 0.85rem; }
  .integ-list li { display: flex; align-items: center; gap: 0.85rem; padding: 0.85rem 1rem; background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--r-sm); }
  .integ-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--surface-3); flex-shrink: 0; }
  .integ-dot.on { background: var(--success); box-shadow: 0 0 0 3px rgba(52,211,153,0.2); }
  .integ-list li div { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .integ-list li strong { font-size: var(--fs-sm); font-weight: 550; }
  .integ-list li .mono { font-size: var(--fs-xs); overflow: hidden; text-overflow: ellipsis; }
  .integ-status { font-size: var(--fs-xs); font-family: var(--font-mono); color: var(--text-dim); }
  .integ-status.on { color: var(--success); }
  .howto { display: flex; flex-direction: column; gap: 0.6rem; padding-left: 1.2rem; color: var(--text-muted); font-size: var(--fs-sm); }
  .howto li { list-style: decimal; }
  .inline-code { background: var(--bg-2); padding: 0.1rem 0.4rem; border-radius: 4px; border: 1px solid var(--border); font-size: 0.85em; color: var(--brand-red-300); }
</style>
