---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { getSettings } from '../../lib/db';
import { razorpayConfigured } from '../../lib/razorpay';
import { turnstileEnabled } from '../../lib/turnstile';
import { emailEnabled } from '../../lib/email';
import { getGeminiApiKey } from '../../lib/gemini';

const settings = await getSettings(env.DB);
const csrf = Astro.locals.csrfToken;
const geminiKey = await getGeminiApiKey(env, env.DB);
const hasGemini = !!geminiKey;

const integrations = [
  { key: 'gemini', name: 'Gemini AI Assistant', on: hasGemini, desc: 'Drafts project descriptions, BOM parts, wiring pins, and troubleshooting.', icon: 'spark' },
  { key: 'razorpay', name: 'Razorpay Payments', on: razorpayConfigured(env), desc: 'Accept payments via UPI, cards, and netbanking.', icon: 'cart' },
  { key: 'turnstile', name: 'Turnstile Bot Protection', on: turnstileEnabled(env), desc: 'Protects contact forms and checkouts from spam and bots.', icon: 'shield' },
  { key: 'email', name: 'Brevo Transactional Email', on: emailEnabled(env), desc: 'Sends digital goods and magic links to customers.', icon: 'mail' },
];
const notifyEmail = settings.contact_notification_email || (env as any).NOTIFICATION_EMAIL || (env as any).CONTACT_NOTIFICATION_EMAIL || '';
const notifyEnabled = settings.contact_email_notify_enabled === null || settings.contact_email_notify_enabled === undefined || settings.contact_email_notify_enabled === '' || settings.contact_email_notify_enabled === '1';
const autoAckEnabled = settings.contact_autoack_enabled === '1';
---

<Admin title="Settings" active="settings">
  <!-- Hidden main settings form anchor -->
  <form id="settings-main-form" method="post" action="/api/admin/settings/save" style="display: none;">
    <input type="hidden" name="csrf" value={csrf} />
  </form>

  <!-- ==============================================
       DESKTOP / TABLET SETTINGS VIEW (>= 769px)
       Grouped cards with sticky save bar
       ============================================== -->
  <div class="settings-desktop-view">
    <header class="admin-desktop-topbar">
      <h1 class="admin-desktop-topbar__title">Settings</h1>
      <div class="admin-desktop-topbar__actions">
        <button type="submit" form="settings-main-form" class="admin-btn admin-btn--primary">
          Save Changes
        </button>
      </div>
    </header>

    <div class="admin-desktop-content">
      <div class="settings-cards-stack">
        <!-- Card 0: Site Images & Links Navigation -->
        <div class="admin-card" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; background: #ffffff; border: 1.5px solid #d91f26;">
          <div>
            <h2 class="settings-card-title" style="margin: 0 0 0.25rem 0; color: #d91f26; display: flex; align-items: center; gap: 0.5rem;">
              <Icon name="image" size={18} /> Site Images &amp; Links
            </h2>
            <div style="font-size: max(12px, 0.8125rem); color: var(--admin-muted);">
              Manage maker photo, how it works image, channel showcase (3 covers), link previews, and social icons.
            </div>
          </div>
          <a href="/admin/settings/images" class="admin-btn admin-btn--primary" style="flex-shrink: 0; text-decoration: none;">
            Configure Images &rarr;
          </a>
        </div>

        <!-- Card: Display Size (Desktop Scaling) -->
        <div class="admin-card">
          <h2 class="settings-card-title" style="display: flex; align-items: center; gap: 0.5rem;">
            <Icon name="sliders" size={18} /> Display Size (Desktop Scale)
          </h2>
          <div style="font-size: max(12px, 0.8125rem); color: var(--admin-muted); margin-bottom: 0.75rem;">
            Control the default scaling across the public site and admin panel for desktop screens (&ge; 1024px).
          </div>
          <div class="display-size-group" style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
            <label style="display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: max(12px, 0.875rem);">
              <input type="radio" name="tt_display_size" value="compact" checked />
              <span><strong>Compact (Default)</strong> — Sleek 80% scale</span>
            </label>
            <label style="display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: max(12px, 0.875rem);">
              <input type="radio" name="tt_display_size" value="default" />
              <span><strong>Standard</strong> — 100% 1rem base</span>
            </label>
            <label style="display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: max(12px, 0.875rem);">
              <input type="radio" name="tt_display_size" value="large" />
              <span><strong>Large</strong> — 115% larger typography</span>
            </label>
          </div>
        </div>

        <script is:inline>
          (function() {
            function sync() {
              const saved = localStorage.getItem('tt-display-size') || 'compact';
              const r = document.querySelector(`input[name="tt_display_size"][value="${saved}"]`);
              if (r) r.checked = true;
            }
            sync();
            document.querySelectorAll('input[name="tt_display_size"]').forEach(radio => {
              radio.addEventListener('change', (e) => {
                const val = e.target.value;
                localStorage.setItem('tt-display-size', val);
                if (val === 'compact') {
                  delete document.documentElement.dataset.displaySize;
                } else {
                  document.documentElement.dataset.displaySize = val;
                }
              });
            });
          })();
        </script>

        <!-- Card 1: General & Site Details -->
        <div class="admin-card">
          <h2 class="settings-card-title">General &amp; Site Details</h2>
          <div class="settings-fields-grid">
            <div class="admin-field">
              <label class="admin-label" for="d-site_title">Site Title</label>
              <input class="admin-input" id="d-site_title" name="site_title" form="settings-main-form" value={settings.site_title || 'Technical Triveni'} />
            </div>

            <div class="admin-field">
              <label class="admin-label" for="d-contact_email">Support Email</label>
              <input class="admin-input" id="d-contact_email" name="contact_email" form="settings-main-form" type="email" value={settings.contact_email || ''} placeholder="support@technicaltriveni.me" />
            </div>

            <div class="admin-field">
              <label class="admin-label" for="d-social_youtube">YouTube Channel URL</label>
              <input class="admin-input" id="d-social_youtube" name="social_youtube" form="settings-main-form" value={settings.social_youtube || ''} placeholder="https://youtube.com/@TechnicalTriveni" />
            </div>

            <div class="admin-field">
              <label class="admin-label" for="d-social_instagram">Instagram Profile URL</label>
              <input class="admin-input" id="d-social_instagram" name="social_instagram" form="settings-main-form" value={settings.social_instagram || ''} />
            </div>
          </div>

          <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: var(--admin-border);">
            <div class="admin-switch-wrap" style="margin-bottom: 0.75rem;">
              <div>
                <span class="admin-switch-label">Announcement Banner</span>
                <div style="font-size: max(12px, 0.7813rem); color: var(--admin-muted);">Show a top banner across public pages.</div>
              </div>
              <label class="admin-switch">
                <input type="checkbox" name="announcement_enabled" form="settings-main-form" value="1" checked={settings.announcement_enabled === '1'} />
                <span class="admin-switch__slider"></span>
              </label>
            </div>

            <div class="admin-field">
              <label class="admin-label" for="d-site_announcement">Banner Message Text</label>
              <input class="admin-input" id="d-site_announcement" name="site_announcement" form="settings-main-form" maxlength="160" value={settings.site_announcement || ''} placeholder="e.g. Free shipping on all parts combos this week!" />
            </div>
          </div>
        </div>

        <!-- Card 2: Integrations -->
        <div class="admin-card">
          <h2 class="settings-card-title">Core Integrations</h2>
          <div class="integrations-list">
            {integrations.map((i) => (
              <div class="integration-row">
                <div class="integration-left">
                  <div class="integration-icon"><Icon name={i.icon} size={20} /></div>
                  <div>
                    <strong style="font-size: max(12px, 0.9063rem); color: var(--admin-ink);">{i.name}</strong>
                    <div style="font-size: max(12px, 0.7813rem); color: var(--admin-muted);">{i.desc}</div>
                  </div>
                </div>
                <span class:list={['admin-chip', i.on ? 'admin-chip--live' : 'admin-chip--draft']}>
                  {i.on ? 'Connected' : 'Not configured'}
                </span>
              </div>
            ))}
          </div>

          <div style="margin-top: 1.125rem; padding-top: 1rem; border-top: var(--admin-border); display: flex; flex-direction: column; gap: 0.75rem;">
            <div class="admin-field">
              <label class="admin-label" for="d-gemini_api_key">Gemini API Key</label>
              <input class="admin-input" type="password" id="d-gemini_api_key" name="gemini_api_key" form="settings-main-form" value={geminiKey ? '••••••••••••••••' : ''} placeholder="AIzaSy..." />
            </div>
            <div class="admin-field">
              <label class="admin-label" for="d-gemini_model">Gemini Model</label>
              <select class="admin-select" id="d-gemini_model" name="gemini_model" form="settings-main-form" style="width: 100%; height: 2.375rem; border: 1px solid var(--admin-line); border-radius: var(--admin-r-input); padding: 0 0.75rem; font-size: max(12px, 0.8438rem); background: #fff;">
                <option value="gemini-3.8-flash" selected={settings.gemini_model === 'gemini-3.8-flash' || !settings.gemini_model}>Gemini 3.8 Flash (Recommended)</option>
                <option value="gemini-2.5-flash" selected={settings.gemini_model === 'gemini-2.5-flash'}>Gemini 2.5 Flash</option>
                <option value="gemini-3.5-flash" selected={settings.gemini_model === 'gemini-3.5-flash'}>Gemini 3.5 Flash</option>
                <option value="gemini-2.5-pro" selected={settings.gemini_model === 'gemini-2.5-pro'}>Gemini 2.5 Pro</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Card 3: Notifications -->
        <div class="admin-card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div>
              <h2 class="settings-card-title" style="margin: 0;">Notifications</h2>
              <div style="font-size: max(12px, 0.8125rem); color: var(--admin-muted); margin-top: 0.125rem;">Configure email notifications when visitors submit messages on the site.</div>
            </div>
            <form method="post" action="/api/admin/settings/test-email">
              <input type="hidden" name="csrf" value={csrf} />
              <button type="submit" class="admin-btn admin-btn--secondary admin-btn--sm">
                <Icon name="mail" size={15} /> Send test email
              </button>
            </form>
          </div>

          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div class="admin-switch-wrap">
              <div>
                <span class="admin-switch-label">Message notification email</span>
                <div style="font-size: max(12px, 0.7813rem); color: var(--admin-muted);">Email me when a visitor sends a message from the website contact form.</div>
              </div>
              <label class="admin-switch">
                <input type="checkbox" name="contact_email_notify_enabled" form="settings-main-form" value="1" checked={notifyEnabled} />
                <span class="admin-switch__slider"></span>
              </label>
            </div>

            <div class="admin-field">
              <label class="admin-label" for="d-contact_notification_email">Notification recipient address(es)</label>
              <input
                class="admin-input"
                id="d-contact_notification_email"
                name="contact_notification_email"
                form="settings-main-form"
                value={settings.contact_notification_email || ''}
                placeholder="technicaltriveniyt@gmail.com"
              />
              <div style="font-size: max(12px, 0.75rem); color: var(--admin-muted); margin-top: 0.3125rem;">
                Comma-separated addresses allowed. Default: <code>technicaltriveniyt@gmail.com</code> (or <code>NOTIFICATION_EMAIL</code> env var).
              </div>
            </div>

            <div style="margin-top: 0.5rem; padding-top: 0.875rem; border-top: var(--admin-border);">
              <div class="admin-switch-wrap">
                <div>
                  <span class="admin-switch-label">Send the visitor an automatic acknowledgement</span>
                  <div style="font-size: max(12px, 0.7813rem); color: var(--admin-muted);">Send the visitor a confirmation email right after they submit (off by default).</div>
                </div>
                <label class="admin-switch">
                  <input type="checkbox" name="contact_autoack_enabled" form="settings-main-form" value="1" checked={autoAckEnabled} />
                  <span class="admin-switch__slider"></span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 4: Security & Access -->
        <div class="admin-card">
          <h2 class="settings-card-title">Security &amp; Password</h2>
          <form method="post" action="/api/admin/password/change" class="settings-fields-grid" style="align-items: end;">
            <input type="hidden" name="csrf" value={csrf} />
            <div class="admin-field">
              <label class="admin-label" for="d-current-pass">Current Password</label>
              <input class="admin-input" type="password" id="d-current-pass" name="current_password" required />
            </div>
            <div class="admin-field">
              <label class="admin-label" for="d-new-pass">New Password</label>
              <input class="admin-input" type="password" id="d-new-pass" name="new_password" required minlength="8" />
            </div>
            <div>
              <button type="submit" class="admin-btn admin-btn--secondary" style="width: 100%;">Change Password</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- ==============================================
       MOBILE SETTINGS VIEW (<= 768px)
       Grouped cards with sticky bottom save bar
       ============================================== -->
  <div class="admin-mobile-shell">
    <header class="admin-mobile-topbar">
      <h1 class="admin-mobile-topbar__title">Settings</h1>
    </header>

    <div class="admin-mobile-content" style="padding-bottom: 5rem;">
      <!-- Card 0: Site Images & Links Navigation (Mobile) -->
      <div class="admin-card mobile-settings-card" style="border: 1.5px solid #d91f26;">
        <h2 class="settings-card-title" style="color: #d91f26; display: flex; align-items: center; gap: 0.5rem;">
          <Icon name="image" size={18} /> Site Images &amp; Links
        </h2>
        <div style="font-size: max(12px, 0.8125rem); color: var(--admin-muted); margin-bottom: 0.75rem;">
          Manage maker photo, how it works, channel showcase, and socials.
        </div>
        <a href="/admin/settings/images" class="admin-btn admin-btn--primary" style="width: 100%; justify-content: center; text-decoration: none;">
          Configure Images &rarr;
        </a>
      </div>

      <!-- Card 1: Site Details -->
      <div class="admin-card mobile-settings-card" style="margin-top: 0.875rem;">
        <h2 class="settings-card-title">Site Details</h2>
        <div class="admin-field">
          <label class="admin-label" for="m-site_title">Site Title</label>
          <input class="admin-input" id="m-site_title" name="site_title" form="settings-main-form" value={settings.site_title || 'Technical Triveni'} />
        </div>
        <div class="admin-field">
          <label class="admin-label" for="m-contact_email">Support Email</label>
          <input class="admin-input" id="m-contact_email" name="contact_email" form="settings-main-form" type="email" value={settings.contact_email || ''} placeholder="support@technicaltriveni.me" />
        </div>
        <div class="admin-field">
          <label class="admin-label" for="m-social_youtube">YouTube Channel</label>
          <input class="admin-input" id="m-social_youtube" name="social_youtube" form="settings-main-form" value={settings.social_youtube || ''} />
        </div>

        <div style="margin-top: 1.125rem; padding-top: 1rem; border-top: var(--admin-border);">
          <div class="admin-switch-wrap">
            <span class="admin-switch-label">Announcement Banner</span>
            <label class="admin-switch">
              <input type="checkbox" name="announcement_enabled" form="settings-main-form" value="1" checked={settings.announcement_enabled === '1'} />
              <span class="admin-switch__slider"></span>
            </label>
          </div>
          <div class="admin-field" style="margin-top: 0.625rem;">
            <label class="admin-label" for="m-site_announcement">Banner Text</label>
            <input class="admin-input" id="m-site_announcement" name="site_announcement" form="settings-main-form" value={settings.site_announcement || ''} placeholder="Banner text..." />
          </div>
        </div>
      </div>

      <!-- Card 2: Integrations -->
      <div class="admin-card mobile-settings-card" style="margin-top: 1rem;">
        <h2 class="settings-card-title">Integrations</h2>
        <div class="integrations-list">
          {integrations.map((i) => (
            <div class="integration-row">
              <div>
                <strong style="font-size: max(12px, 0.875rem); color: var(--admin-ink);">{i.name}</strong>
              </div>
              <span class:list={['admin-chip', i.on ? 'admin-chip--live' : 'admin-chip--draft']}>
                {i.on ? 'Active' : 'Off'}
              </span>
            </div>
          ))}
        </div>

        <div style="margin-top: 0.875rem; padding-top: 0.875rem; border-top: var(--admin-border); display: flex; flex-direction: column; gap: 0.625rem;">
          <div class="admin-field">
            <label class="admin-label" for="m-gemini_api_key">Gemini API Key</label>
            <input class="admin-input" type="password" id="m-gemini_api_key" name="gemini_api_key" form="settings-main-form" value={geminiKey ? '••••••••••••••••' : ''} placeholder="AIzaSy..." />
          </div>
          <div class="admin-field">
            <label class="admin-label" for="m-gemini_model">Gemini Model</label>
            <select class="admin-select" id="m-gemini_model" name="gemini_model" form="settings-main-form" style="width: 100%; height: 2.625rem; border: 1px solid var(--admin-line); border-radius: var(--admin-r-input); padding: 0 0.75rem; font-size: max(12px, 0.875rem); background: #fff;">
              <option value="gemini-3.8-flash" selected={settings.gemini_model === 'gemini-3.8-flash' || !settings.gemini_model}>Gemini 3.8 Flash (Default)</option>
              <option value="gemini-2.5-flash" selected={settings.gemini_model === 'gemini-2.5-flash'}>Gemini 2.5 Flash</option>
              <option value="gemini-3.5-flash" selected={settings.gemini_model === 'gemini-3.5-flash'}>Gemini 3.5 Flash</option>
              <option value="gemini-2.5-pro" selected={settings.gemini_model === 'gemini-2.5-pro'}>Gemini 2.5 Pro</option>
            </select>
          </div>
      </div>
    </div>

      <!-- Card: Notifications (Mobile) -->
      <div class="admin-card mobile-settings-card" style="margin-top: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.875rem;">
          <h2 class="settings-card-title" style="margin: 0;">Notifications</h2>
          <form method="post" action="/api/admin/settings/test-email">
            <input type="hidden" name="csrf" value={csrf} />
            <button type="submit" class="admin-btn admin-btn--secondary admin-btn--sm" style="font-size: max(12px, 0.75rem); padding: 0.3125rem 0.625rem;">
              <Icon name="mail" size={14} /> Send test email
            </button>
          </form>
        </div>

        <div class="admin-switch-wrap">
          <div>
            <span class="admin-switch-label">Message notification email</span>
            <div style="font-size: max(12px, 0.75rem); color: var(--admin-muted);">Email me when a visitor sends a message.</div>
          </div>
          <label class="admin-switch">
            <input type="checkbox" name="contact_email_notify_enabled" form="settings-main-form" value="1" checked={notifyEnabled} />
            <span class="admin-switch__slider"></span>
          </label>
        </div>

        <div class="admin-field" style="margin-top: 0.75rem;">
          <label class="admin-label" for="m-contact_notification_email">Notification recipient address(es)</label>
          <input
            class="admin-input"
            id="m-contact_notification_email"
            name="contact_notification_email"
            form="settings-main-form"
            value={settings.contact_notification_email || ''}
            placeholder="technicaltriveniyt@gmail.com"
          />
          <div style="font-size: max(12px, 0.7188rem); color: var(--admin-muted); margin-top: 0.25rem;">
            Comma-separated addresses. Default: <code>technicaltriveniyt@gmail.com</code>
          </div>
        </div>

        <div style="margin-top: 0.875rem; padding-top: 0.75rem; border-top: var(--admin-border);">
          <div class="admin-switch-wrap">
            <div>
              <span class="admin-switch-label">Visitor acknowledgement</span>
              <div style="font-size: max(12px, 0.75rem); color: var(--admin-muted);">Send confirmation email to visitor.</div>
            </div>
            <label class="admin-switch">
              <input type="checkbox" name="contact_autoack_enabled" form="settings-main-form" value="1" checked={autoAckEnabled} />
              <span class="admin-switch__slider"></span>
            </label>
          </div>
        </div>
      </div>

      <!-- Card 3: Change Password -->
      <div class="admin-card mobile-settings-card" style="margin-top: 1rem;">
        <h2 class="settings-card-title">Change Password</h2>
        <form method="post" action="/api/admin/password/change" style="display: flex; flex-direction: column; gap: 0.75rem;">
          <input type="hidden" name="csrf" value={csrf} />
          <div class="admin-field">
            <label class="admin-label">Current Password</label>
            <input class="admin-input" type="password" name="current_password" required />
          </div>
          <div class="admin-field">
            <label class="admin-label">New Password</label>
            <input class="admin-input" type="password" name="new_password" required minlength="8" />
          </div>
          <button type="submit" class="admin-btn admin-btn--secondary" style="width: 100%;">Update Password</button>
        </form>
      </div>
    </div>

    <!-- Sticky Mobile Save Bar -->
    <div class="mobile-sticky-save-bar">
      <button type="submit" form="settings-main-form" class="admin-btn admin-btn--primary" style="width: 100%;">
        Save Changes
      </button>
    </div>
  </div>
</Admin>

<style>
  @media (max-width: 768px) {
    .settings-desktop-view { display: none !important; }
  }

  .settings-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 53.75rem;
  }
  .settings-card-title {
    font-size: var(--admin-fs-card-title);
    font-weight: 700;
    color: var(--admin-ink);
    margin: 0 0 1.25rem 0;
  }
  .settings-fields-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
    min-width: 0;
  }
  @media (max-width: 1023px) {
    .settings-fields-grid {
      grid-template-columns: 1fr;
    }
  }

  .integrations-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-width: 0;
  }
  .integration-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: #F8FAFC;
    border: 1px solid var(--admin-line);
    border-radius: 0.75rem;
    min-width: 0;
  }
  .integration-left {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
  }
  .integration-icon {
    width: 2.375rem;
    height: 2.375rem;
    border-radius: 0.625rem;
    background: #FFFFFF;
    border: 1px solid var(--admin-line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--admin-ink);
  }

  /* Mobile */
  .mobile-settings-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .mobile-sticky-save-bar {
    position: fixed;
