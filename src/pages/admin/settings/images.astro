                    Library
                  </button>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <footer class="si-modal-footer">
        <button type="button" class="admin-btn admin-btn--primary" id="btn-done-showcase">Done</button>
      </footer>
    </div>
  </dialog>
</Admin>

