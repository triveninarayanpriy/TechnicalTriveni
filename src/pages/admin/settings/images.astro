  <!-- LIBRARY PICKER MODAL -->
  <dialog id="library-dialog" class="si-modal">
    <div class="si-modal-content si-modal-content--wide">
      <header class="si-modal-header">
        <h3 class="si-modal-title">Choose from Media Library</h3>
        <button type="button" class="si-modal-close" id="btn-close-library">✕</button>
      </header>

      <div class="si-modal-body">
