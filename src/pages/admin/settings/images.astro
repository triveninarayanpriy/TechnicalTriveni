          <button type="button" class="si-lib-tab is-active" data-lib-tab="all">All</button>
          <button type="button" class="si-lib-tab" data-lib-tab="covers">Pack Covers</button>
          <button type="button" class="si-lib-tab" data-lib-tab="uploads">Uploaded Media</button>
        </div>

        <div id="lib-grid-container" class="si-lib-grid">
          <!-- Dynamically populated -->
          <div class="si-lib-loading">Loading library items...</div>
        </div>
      </div>

      <footer class="si-modal-footer">
        <button type="button" class="admin-btn admin-btn--secondary" id="btn-cancel-library">Cancel</button>
      </footer>
    </div>
  </dialog>

  <!-- SHOWCASE MANAGE MODAL -->
  <dialog id="showcase-dialog" class="si-modal">
    <div class="si-modal-content">
      <header class="si-modal-header">
        <h3 class="si-modal-title">Manage Channel Showcase (3 Images)</h3>
        <button type="button" class="si-modal-close" id="btn-close-showcase">✕</button>
      </header>

      <div class="si-modal-body">
        <p class="si-crop-instructions">Select which showcase position to update or pick a pack cover.</p>
        <div class="si-showcase-slots-grid" id="showcase-modal-slots">
          <!-- 3 slots -->
          {[0, 1, 2].map((idx) => {
            const item = showcaseImages[idx];
            return (
              <div class="si-sc-slot-item" data-showcase-index={idx}>
                <span class="si-sc-slot-badge">Image #{idx + 1}</span>
                <div class="si-sc-slot-preview">
