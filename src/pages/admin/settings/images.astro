---
import Admin from '../../../layouts/Admin.astro';
import Icon from '../../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { getSiteAssets, SITE_IMAGE_SPECS, computeSlotStatus } from '../../../lib/site-assets';
import { getSiteAssetsRevisions } from '../../../lib/db';

const config = await getSiteAssets(env.DB);
const revisions = await getSiteAssetsRevisions(env.DB, 5);
const csrf = Astro.locals.csrfToken;

// Initial slot statuses
const makerStatus = computeSlotStatus(config.maker_photo, SITE_IMAGE_SPECS.maker_photo);
const hiwStatus = computeSlotStatus(config.how_it_works_image, SITE_IMAGE_SPECS.how_it_works_image);
const shareStatus = computeSlotStatus(config.default_share_image, SITE_IMAGE_SPECS.default_share_image);

// Compute showcase summary
const showcaseImages = config.channel_showcase?.images || [];
const showcaseCount = showcaseImages.filter((img) => img.url && img.url.trim()).length;
const showcaseTotalKb = Math.round(
  showcaseImages.reduce((acc, curr) => acc + (curr.size_bytes || 135000), 0) / 1024
);
---

<Admin title="Site images and links" active="settings" hideTabBar={true}>
  <div class="site-images-page">
    <!-- Top Action Bar (Desktop + Mobile) -->
    <header class="si-header">
      <div class="si-header__left">
        <a href="/admin/settings" class="si-back-btn" title="Back to Settings">
          <Icon name="chevron-left" size={20} />
        </a>
        <h1 class="si-title">Site images and links</h1>
      </div>
      <div class="si-header__actions">
        <button type="button" id="btn-save-top" class="admin-btn admin-btn--primary btn-save-action">
          <Icon name="check-circle" size={17} />
          <span>Save changes</span>
        </button>
      </div>
    </header>

    <!-- Notification Toast / Banner -->
    <div id="si-banner" class="si-banner" hidden>
      <span id="si-banner-msg"></span>
      <button type="button" class="si-banner-close" onclick="this.parentElement.hidden=true">✕</button>
    </div>

    <!-- Main Grid Layout -->
    <div class="si-layout-grid">
      <!-- LEFT COLUMN: Image Slot Cards -->
      <main class="si-slots-column">
        <!-- SLOT 1: Maker Photo -->
        <article class="si-card" id="slot-card-maker_photo" data-slot="maker_photo">
          <div class="si-card__preview-col">
            <div class="si-preview-wrap ratio-4-5" data-slot="maker_photo" role="button" tabindex="0" title="Click to upload or replace image">
              {config.maker_photo?.url ? (
                <div class="si-preview-img-box">
                  <img
                    id="preview-img-maker_photo"
                    src={config.maker_photo.url}
                    alt={config.maker_photo.alt || 'Maker photo'}
                    class="si-preview-img"
                    loading="lazy"
                  />
                  <div class="si-preview-overlay">
                    <Icon name="upload" size={22} />
                    <span>Change photo</span>
                  </div>
                </div>
              ) : (
                <div class="si-fallback-box" id="fallback-box-maker_photo">
                  <div class="si-fallback-icon-wrap">
                    <Icon name="upload" size={26} />
                  </div>
                  <span class="si-fallback-action">Click to upload photo</span>
                  <span class="si-fallback-text">1200 × 1500 px (4:5)</span>
                  <span class="si-fallback-drag">or drag & drop file</span>
                </div>
              )}
            </div>
          </div>

          <div class="si-card__body-col">
            <div class="si-card__head">
              <div class="si-card__title-row">
                <h2 class="si-card__title">Maker photo</h2>
                <span class="si-chip si-chip--used">Home, About</span>
              </div>
              <p class="si-card__specs">Recommended 1200 × 1500 px (4:5). JPG, PNG or WebP, up to 5 MB.</p>
            </div>

            <div class="si-status-row">
              <span class:list={['si-chip', `si-chip--${makerStatus.status}`]} id="status-chip-maker_photo">
                {makerStatus.label}
              </span>
              <span class="si-file-meta" id="file-meta-maker_photo">
                {config.maker_photo?.url
                  ? `${config.maker_photo.filename || 'maker.webp'}, ${config.maker_photo.width || 1200} × ${config.maker_photo.height || 1500}, ${Math.round((config.maker_photo.size_bytes || 148000) / 1024)} KB`
                  : 'No image yet. The page shows a designed fallback.'}
              </span>
            </div>

            <div class="si-field-group">
              <label class="si-label" for="alt-maker_photo">Alt text</label>
              <input
                type="text"
                id="alt-maker_photo"
                class="si-input"
                value={config.maker_photo?.alt || ''}
                placeholder="Triveni on a hillside viewpoint"
                required
              />
            </div>

            <div class="si-btn-row">
              <button type="button" class="btn-slot-upload admin-btn admin-btn--primary" data-slot="maker_photo" title="Upload an image from your computer">
                <Icon name="upload" size={16} />
                <span>Upload image</span>
              </button>
              <button type="button" class="btn-slot-library admin-btn admin-btn--secondary" data-slot="maker_photo" title="Choose from existing media library">
                <Icon name="image" size={16} />
                <span>Library</span>
              </button>
              {config.maker_photo?.url && (
                <button type="button" class="btn-slot-remove admin-btn admin-btn--danger-outline" data-slot="maker_photo" title="Remove image">
                  <span>Remove</span>
                </button>
              )}
            </div>
          </div>
        </article>

        <!-- SLOT 2: How It Works Image -->
        <article class="si-card" id="slot-card-how_it_works_image" data-slot="how_it_works_image">
          <div class="si-card__preview-col">
            <div class="si-preview-wrap ratio-7-5" data-slot="how_it_works_image" role="button" tabindex="0" title="Click to upload or replace image">
              {config.how_it_works_image?.url ? (
                <div class="si-preview-img-box">
                  <img
                    id="preview-img-how_it_works_image"
                    src={config.how_it_works_image.url}
                    alt={config.how_it_works_image.alt || 'How it works'}
                    class="si-preview-img"
                    loading="lazy"
                  />
                  <div class="si-preview-overlay">
                    <Icon name="upload" size={22} />
                    <span>Change image</span>
                  </div>
                </div>
              ) : (
                <div class="si-fallback-box" id="fallback-box-how_it_works_image">
                  <div class="si-fallback-icon-wrap">
                    <Icon name="upload" size={26} />
                  </div>
                  <span class="si-fallback-action">Click to upload image</span>
                  <span class="si-fallback-text">1400 × 1000 px (7:5)</span>
                  <span class="si-fallback-drag">or drag & drop file</span>
                </div>
              )}
            </div>
          </div>

          <div class="si-card__body-col">
            <div class="si-card__head">
              <div class="si-card__title-row">
                <h2 class="si-card__title">How it works image</h2>
                <span class="si-chip si-chip--used">How it works</span>
              </div>
              <p class="si-card__specs">
                Recommended 1400 × 1000 px (7:5). Shown beside "Everything you need to finish the build".
              </p>
            </div>

            <div class="si-status-row">
              <span class:list={['si-chip', `si-chip--${hiwStatus.status}`]} id="status-chip-how_it_works_image">
                {hiwStatus.label}
              </span>
              <span class="si-file-meta" id="file-meta-how_it_works_image">
                {config.how_it_works_image?.url
                  ? `${config.how_it_works_image.filename || 'how-it-works.webp'}, ${config.how_it_works_image.width || 1400} × ${config.how_it_works_image.height || 1000}, ${Math.round((config.how_it_works_image.size_bytes || 185000) / 1024)} KB`
                  : 'No image yet. The page shows a designed fallback instead of a broken image.'}
              </span>
            </div>

            <div class="si-field-group">
              <label class="si-label" for="alt-how_it_works_image">Alt text</label>
              <input
                type="text"
                id="alt-how_it_works_image"
                class="si-input"
                value={config.how_it_works_image?.alt || ''}
                placeholder="Electronics project pack contents"
                required
              />
            </div>

            <div class="si-btn-row">
              <button type="button" class="btn-slot-upload admin-btn admin-btn--primary" data-slot="how_it_works_image" title="Upload an image from your computer">
                <Icon name="upload" size={16} />
                <span>Upload image</span>
              </button>
              <button type="button" class="btn-slot-library admin-btn admin-btn--secondary" data-slot="how_it_works_image" title="Choose from existing media library">
                <Icon name="image" size={16} />
                <span>Library</span>
              </button>
              {config.how_it_works_image?.url && (
                <button type="button" class="btn-slot-remove admin-btn admin-btn--danger-outline" data-slot="how_it_works_image" title="Remove image">
                  <span>Remove</span>
                </button>
              )}
            </div>
          </div>
        </article>

        <!-- SLOT 3: Channel Showcase -->
        <article class="si-card" id="slot-card-channel_showcase" data-slot="channel_showcase">
          <div class="si-card__preview-col">
            <div class="si-preview-wrap si-preview-mosaic" data-slot="channel_showcase" role="button" tabindex="0" title="Click to manage showcase images">
              {showcaseImages.slice(0, 3).map((img, i) => (
                <div class="si-mosaic-thumb">
                  {img.url ? (
                    <img src={img.url} alt={img.alt || `Showcase ${i + 1}`} class="si-thumb-img" loading="lazy" />
                  ) : (
                    <div class="si-thumb-fallback">
                      <Icon name="image" size={20} />
                    </div>
                  )}
                </div>
              ))}
              <div class="si-preview-overlay">
                <Icon name="upload" size={22} />
                <span>Manage showcase</span>
              </div>
            </div>
          </div>

          <div class="si-card__body-col">
            <div class="si-card__head">
              <div class="si-card__title-row">
                <h2 class="si-card__title">Channel showcase</h2>
                <span class="si-chip si-chip--used">Home</span>
              </div>
              <p class="si-card__specs">
                Three 16:9 images, recommended 1600 × 900 px each. Pick pack covers or upload your own.
              </p>
            </div>

            <div class="si-status-row">
              <span class="si-chip si-chip--good_size" id="status-chip-channel_showcase">
                {showcaseCount === 3 ? 'Good size' : 'Partially set'}
              </span>
              <span class="si-file-meta" id="file-meta-channel_showcase">
                {`${showcaseCount} images, 1600 × 900, ${showcaseTotalKb || 412} KB total`}
              </span>
            </div>

            <div class="si-field-group">
              <label class="si-label" for="alt-channel_showcase">Alt text</label>
              <input
                type="text"
                id="alt-channel_showcase"
                class="si-input"
                value={config.channel_showcase?.alt || ''}
                placeholder="Drone, ESP32 and components pack covers"
                required
              />
            </div>

            <div class="si-btn-row">
              <button type="button" class="btn-showcase-manage admin-btn admin-btn--primary" id="btn-manage-showcase" title="Upload or change showcase images">
                <Icon name="upload" size={16} />
                <span>Upload showcase</span>
              </button>
              <button type="button" class="btn-showcase-library admin-btn admin-btn--secondary" id="btn-library-showcase" title="Choose from existing pack covers">
                <Icon name="image" size={16} />
                <span>Library</span>
              </button>
              <button type="button" class="btn-showcase-reset admin-btn admin-btn--danger-outline" id="btn-reset-showcase" title="Reset showcase back to default pack covers">
                <span>Reset covers</span>
              </button>
            </div>
          </div>
        </article>

        <!-- SLOT 4: Default Share Image -->
        <article class="si-card" id="slot-card-default_share_image" data-slot="default_share_image">
          <div class="si-card__preview-col">
            <div class="si-preview-wrap ratio-og" data-slot="default_share_image" role="button" tabindex="0" title="Click to upload or replace image">
              {config.default_share_image?.url ? (
                <div class="si-preview-img-box">
                  <img
                    id="preview-img-default_share_image"
                    src={config.default_share_image.url}
                    alt={config.default_share_image.alt || 'Default share image'}
                    class="si-preview-img"
                    loading="lazy"
                  />
                  <div class="si-preview-overlay">
                    <Icon name="upload" size={22} />
                    <span>Change share image</span>
                  </div>
                </div>
              ) : (
                <div class="si-fallback-box" id="fallback-box-default_share_image">
                  <div class="si-fallback-icon-wrap">
                    <Icon name="upload" size={26} />
                  </div>
                  <span class="si-fallback-action">Click to upload image</span>
                  <span class="si-fallback-text">1200 × 630 px (1.91:1)</span>
                  <span class="si-fallback-drag">or drag & drop file</span>
                </div>
              )}
            </div>
          </div>

          <div class="si-card__body-col">
            <div class="si-card__head">
              <div class="si-card__title-row">
                <h2 class="si-card__title">Default share image</h2>
                <span class="si-chip si-chip--used">Link previews</span>
              </div>
              <p class="si-card__specs">Recommended 1200 × 630 px. Used when a page has no cover.</p>
            </div>

            <div class="si-status-row">
              <span class:list={['si-chip', `si-chip--${shareStatus.status}`]} id="status-chip-default_share_image">
                {shareStatus.label}
              </span>
              <span class="si-file-meta" id="file-meta-default_share_image">
                {config.default_share_image?.url
                  ? `${config.default_share_image.filename || 'share-default.webp'}, ${config.default_share_image.width || 1200} × ${config.default_share_image.height || 630}, ${Math.round((config.default_share_image.size_bytes || 96000) / 1024)} KB`
                  : 'No image yet. Link previews use default brand card.'}
              </span>
            </div>

            <div class="si-field-group">
              <label class="si-label" for="alt-default_share_image">Alt text</label>
              <input
                type="text"
                id="alt-default_share_image"
                class="si-input"
                value={config.default_share_image?.alt || ''}
                placeholder="Technical Triveni project packs"
                required
              />
            </div>

            <div class="si-btn-row">
              <button type="button" class="btn-slot-upload admin-btn admin-btn--primary" data-slot="default_share_image" title="Upload an image from your computer">
                <Icon name="upload" size={16} />
                <span>Upload image</span>
              </button>
              <button type="button" class="btn-slot-library admin-btn admin-btn--secondary" data-slot="default_share_image" title="Choose from existing media library">
                <Icon name="image" size={16} />
                <span>Library</span>
              </button>
              {config.default_share_image?.url && (
                <button type="button" class="btn-slot-remove admin-btn admin-btn--danger-outline" data-slot="default_share_image" title="Remove image">
                  <span>Remove</span>
                </button>
              )}
            </div>
          </div>
        </article>
      </main>

      <!-- RIGHT COLUMN: Social Links & Informational Panels -->
      <aside class="si-sidebar-column">
        <!-- Social links card -->
        <section class="si-panel-card">
          <h2 class="si-panel-title">Social links</h2>

          <div class="si-social-list">
            <!-- YouTube -->
            <div class="si-social-row">
              <div class="si-social-box">
                <Icon name="youtube" size={19} />
              </div>
              <div class="si-social-field">
                <span class="si-social-label">YouTube</span>
                <div class="si-social-input-wrap">
                  <input
                    type="url"
                    id="social-youtube"
                    class="si-input si-social-input"
                    value={config.social_links?.youtube || ''}
                    placeholder="https://youtube.com/@channel"
                  />
                  <a
                    href={config.social_links?.youtube || '#'}
                    target="_blank"
                    rel="noopener noreferrer"
                    id="test-social-youtube"
                    class="si-test-link"
                  >
                    Test
                  </a>
                </div>
              </div>
            </div>

            <!-- Instagram -->
            <div class="si-social-row">
              <div class="si-social-box">
                <Icon name="instagram" size={19} />
              </div>
              <div class="si-social-field">
                <span class="si-social-label">Instagram</span>
                <div class="si-social-input-wrap">
                  <input
                    type="url"
                    id="social-instagram"
                    class="si-input si-social-input"
                    value={config.social_links?.instagram || ''}
                    placeholder="https://instagram.com/handle"
                  />
                  <a
                    href={config.social_links?.instagram || '#'}
                    target="_blank"
                    rel="noopener noreferrer"
                    id="test-social-instagram"
                    class="si-test-link"
                  >
                    Test
                  </a>
                </div>
              </div>
            </div>

            <!-- GitHub -->
            <div class="si-social-row">
              <div class="si-social-box">
                <Icon name="github" size={19} />
              </div>
              <div class="si-social-field">
                <span class="si-social-label">GitHub</span>
                <div class="si-social-input-wrap">
                  <input
                    type="url"
                    id="social-github"
                    class="si-input si-social-input"
                    value={config.social_links?.github || ''}
                    placeholder="https://github.com/handle"
                  />
                  <a
                    href={config.social_links?.github || '#'}
                    target="_blank"
                    rel="noopener noreferrer"
                    id="test-social-github"
                    class="si-test-link"
                  >
                    Test
                  </a>
                </div>
              </div>
            </div>

            <!-- LinkedIn -->
            <div class="si-social-row">
              <div class="si-social-box">
                <Icon name="linkedin" size={19} />
              </div>
              <div class="si-social-field">
                <span class="si-social-label">LinkedIn</span>
                <div class="si-social-input-wrap">
                  <input
                    type="url"
                    id="social-linkedin"
                    class="si-input si-social-input"
                    value={config.social_links?.linkedin || ''}
                    placeholder="https://linkedin.com/in/handle"
                  />
                  <a
                    href={config.social_links?.linkedin || '#'}
                    target="_blank"
                    rel="noopener noreferrer"
                    id="test-social-linkedin"
                    class="si-test-link"
                  >
                    Test
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div class="si-switch-wrap">
            <span class="si-switch-desc">Show icons in the footer, About and Meet the maker</span>
            <label class="admin-switch">
              <input type="checkbox" id="social-show-icons" checked={config.social_links?.show_icons !== false} />
              <span class="admin-switch__slider"></span>
            </label>
          </div>
        </section>

        <!-- What happens on upload card -->
        <section class="si-panel-card">
          <h2 class="si-panel-title">What happens on upload</h2>
          <ul class="si-bullet-list">
            <li>
              <span class="si-check-icon"><Icon name="check-circle" size={16} /></span>
              <span>Resized to 320, 640, 960 and 1600 px wide</span>
            </li>
            <li>
              <span class="si-check-icon"><Icon name="check-circle" size={16} /></span>
              <span>Converted to WebP and compressed</span>
            </li>
            <li>
              <span class="si-check-icon"><Icon name="check-circle" size={16} /></span>
              <span>Alt text required before saving</span>
            </li>
            <li>
              <span class="si-check-icon"><Icon name="check-circle" size={16} /></span>
              <span>Files under the recommended size show a warning</span>
            </li>
          </ul>
        </section>

        <!-- Where images appear card -->
        <section class="si-panel-card">
          <h2 class="si-panel-title">Where images appear</h2>
          <table class="si-locations-table">
            <tbody>
              <tr>
                <td class="si-loc-label">Maker photo</td>
                <td class="si-loc-val">Home, About</td>
              </tr>
              <tr>
                <td class="si-loc-label">How it works image</td>
                <td class="si-loc-val">How it works</td>
              </tr>
              <tr>
                <td class="si-loc-label">Channel showcase</td>
                <td class="si-loc-val">Home</td>
              </tr>
              <tr>
                <td class="si-loc-label">Default share image</td>
                <td class="si-loc-val">Link previews</td>
              </tr>
            </tbody>
          </table>
        </section>

        <!-- Version History card -->
        <section class="si-panel-card">
          <div class="si-panel-head-row">
            <h2 class="si-panel-title" style="margin: 0;">Version history</h2>
            <span class="si-chip si-chip--neutral">Last 5</span>
          </div>
          {revisions && revisions.length > 0 ? (
            <div class="si-revisions-list">
              {revisions.map((rev) => {
                const dateStr = new Date(rev.created_at * 1000).toLocaleString('en-IN', {
                  month: 'short',
                  day: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit',
                  hour12: true,
                });
                return (
                  <div class="si-revision-item">
                    <div class="si-revision-info">
                      <strong class="si-revision-note">{rev.note || 'Site images update'}</strong>
                      <span class="si-revision-date">{dateStr}</span>
                    </div>
                    <button
                      type="button"
                      class="admin-btn admin-btn--secondary admin-btn--sm btn-restore-revision"
                      data-id={rev.id}
                    >
                      Restore
                    </button>
                  </div>
                );
              })}
            </div>
          ) : (
            <p class="si-empty-revisions">No revisions saved yet. Changes are recorded automatically.</p>
          )}
        </section>
      </aside>
    </div>

    <!-- STICKY MOBILE SAVE BAR -->
    <div class="si-mobile-save-bar">
      <button type="button" id="btn-save-mobile" class="admin-btn admin-btn--primary btn-save-action si-mobile-btn">
        <Icon name="check-circle" size={18} />
        <span>Save changes</span>
      </button>
    </div>
  </div>

  <!-- SITE ASSETS DATA & CSRF FOR CLIENT SCRIPT -->
  <script type="application/json" id="site-assets-data" set:html={JSON.stringify(config)} />
  <input type="hidden" id="si-csrf-token" value={csrf} />

  <!-- HIDDEN FILE INPUT (Positioned off-screen, NOT display:none) -->
  <input
    type="file"
    id="slot-file-input"
    accept="image/jpeg,image/png,image/webp,image/avif"
    aria-hidden="true"
    tabindex="-1"
    style="position: fixed; top: -9999px; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none;"
  />

  <!-- CROP & FOCAL POINT MODAL -->
  <dialog id="crop-dialog" class="si-modal">
    <div class="si-modal-content">
      <header class="si-modal-header">
        <h3 class="si-modal-title" id="crop-modal-title">Adjust crop & focal point</h3>
        <button type="button" class="si-modal-close" id="btn-close-crop">✕</button>
      </header>

      <div class="si-modal-body">
        <div id="crop-warning-box" class="si-crop-warning" hidden>
          <Icon name="alert-triangle" size={18} />
          <span id="crop-warning-text">Image is smaller than recommended.</span>
        </div>

        <p class="si-crop-instructions">
          Drag or click inside the image to reposition the focal center for different screens.
        </p>

        <div class="si-crop-viewport" id="crop-viewport">
          <canvas id="crop-canvas" class="si-crop-canvas"></canvas>
          <div id="focal-marker" class="si-focal-marker" title="Focal point"></div>
        </div>

        <div class="si-focal-quick-row">
          <span class="si-focal-label">Quick focus:</span>
          <button type="button" class="si-chip btn-focal" data-x="0.5" data-y="0.2">Top</button>
          <button type="button" class="si-chip btn-focal" data-x="0.5" data-y="0.5">Center</button>
          <button type="button" class="si-chip btn-focal" data-x="0.5" data-y="0.8">Bottom</button>
        </div>
      </div>

      <footer class="si-modal-footer">
