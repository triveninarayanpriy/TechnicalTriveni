---
import '../../styles/global.css';
import Icon from '../../components/Icon.astro';

// If already logged in, go straight to the dashboard.
if (Astro.locals.admin) return Astro.redirect('/admin');

const csrf = Astro.locals.csrfToken;
const nextParam = Astro.url.searchParams.get('next') || '/admin';
const error = Astro.url.searchParams.get('err');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin login · Technical Triveni</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap" />
  </head>
  <body class="login-body">
    <main class="login">
      <div class="login-card panel">
        <div class="login-brand">
          <svg viewBox="-4 -4 120 100" aria-hidden="true">
            <defs><path id="lb" d="M12 0 L62 0 L62 18 L41 18 L41 74 L31 92 L21 74 L21 18 L0 18 L0 7 L12 7 Z"/></defs>
            <use href="#lb" x="0" fill="var(--brand-red)"/>
            <use href="#lb" x="50" fill="#fff"/>
          </svg>
        </div>
        <h1>Admin sign in</h1>
        <p class="login-sub">Manage projects, orders and settings.</p>

        {error && (
          <div class="login-error" role="alert"><Icon name="lock" size={16} /> Invalid email or password.</div>
        )}

        <form method="post" action="/api/admin/login" class="login-form">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="next" value={nextParam} />
          <div class="field">
            <label class="label" for="email">Email</label>
            <input class="input" id="email" name="email" type="email" required autocomplete="username" autofocus />
          </div>
          <div class="field">
            <label class="label" for="password">Password</label>
            <input class="input" id="password" name="password" type="password" required autocomplete="current-password" />
          </div>
          <button type="submit" class="btn btn-primary btn-block btn-lg"><Icon name="lock" size={16} /> Sign in</button>
        </form>
      </div>
      <a href="/" class="login-back">← Back to site</a>
    </main>

    <style>
      .login-body { min-height: 100dvh; display: grid; place-items: center; padding: 2rem 1rem;
        background:
          radial-gradient(700px 500px at 50% -10%, rgba(231,36,42,0.15), transparent 60%),
          var(--bg); }
      .login { width: 100%; max-width: 400px; }
      .login-card { padding: 2.25rem; text-align: center; }
      .login-brand svg { width: 56px; margin: 0 auto 1.5rem; }
      .login-card h1 { font-size: var(--fs-lg); }
      .login-sub { color: var(--text-muted); font-size: var(--fs-sm); margin-top: 0.35rem; margin-bottom: 1.75rem; }
      .login-form { display: flex; flex-direction: column; gap: 1rem; text-align: left; }
      .login-error { display: flex; align-items: center; gap: 0.5rem; justify-content: center; background: rgba(248,113,113,0.1); border: 1px solid color-mix(in srgb, var(--danger) 40%, transparent); color: var(--danger); padding: 0.7rem; border-radius: var(--r-sm); font-size: var(--fs-sm); margin-bottom: 1.25rem; }
      .login-back { display: block; text-align: center; margin-top: 1.5rem; color: var(--text-dim); font-size: var(--fs-sm); }
      .login-back:hover { color: var(--text); }
    </style>
  </body>
</html>
