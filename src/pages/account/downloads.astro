---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { getOrdersByEmail } from '../../lib/db';
import { verifyPayload } from '../../lib/crypto';
import { emailEnabled } from '../../lib/email';
import { formatINR } from '../../lib/format';

const token = Astro.url.searchParams.get('token') || '';

let email = '';
let valid = false;
let orders: Awaited<ReturnType<typeof getOrdersByEmail>> = [];

if (token) {
  const payload = await verifyPayload<{ email: string; exp: number }>(env.SESSION_SECRET, token);
  if (payload && payload.exp > Math.floor(Date.now() / 1000)) {
    valid = true;
    email = payload.email;
    orders = await getOrdersByEmail(env.DB, email);
  }
}

const fmtDate = (s: number) => new Date(s * 1000).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const dlLink = (o: (typeof orders)[number]) =>
  `/account/download?order=${encodeURIComponent(o.id)}&token=${encodeURIComponent(o.download_token)}`;
const mailOn = emailEnabled(env);
---

<Base title="My downloads" noindex>
  <section class="section">
    <div class="container container-narrow">
      {valid ? (
        <div class="mydl">
          <h1>Your purchases</h1>
          <p class="muted mydl__sub">Signed in as <strong>{email}</strong>. Open any project to re-download its files.</p>
          {orders.length > 0 ? (
            <div class="mydl__list">
              {orders.map((o) => (
                <a href={dlLink(o)} class="order-row">
                  <span class="order-row__main">
                    <span class="order-row__title">{o.project_title}</span>
                    <span class="order-row__meta mono">{fmtDate(o.created_at)} · {formatINR(o.amount_inr)} · #{o.id.slice(0, 8).toUpperCase()}</span>
                  </span>
                  <span class="btn btn-primary btn-sm"><Icon name="download" size={15} /> Open</span>
                </a>
              ))}
            </div>
          ) : (
            <p class="muted center" style="margin-top:2rem">No purchases found for this email yet.</p>
          )}
        </div>
      ) : (
        <div class="mydl mydl--form">
          <div class="mydl__icon"><Icon name="download" size={34} /></div>
          <h1 class="center">My downloads</h1>
          <p class="muted center mydl__sub">
            Enter the email you used at checkout and we'll send you a secure link to all your purchased files.
            No password needed.
          </p>
          {mailOn ? (
            <form class="mydl__request" data-magic-form>
              <input class="input" type="email" name="email" placeholder="you@email.com" autocomplete="email" required data-magic-email />
              <button class="btn btn-primary" type="submit" data-magic-btn><Icon name="mail" size={16} /> Email me the link</button>
            </form>
          ) : (
            <p class="mydl__note center">
              Email delivery isn't switched on yet. Use the download link from your purchase confirmation, or
              <a href="/contact"> contact us</a> and we'll send your files.
            </p>
          )}
          <p class="mydl__hint center dim" data-magic-msg hidden></p>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .mydl h1 { font-size: var(--fs-xl); }
  .mydl__sub { max-width: 52ch; margin: 0.85rem 0 2rem; }
  .mydl--form { max-width: 460px; margin: 0 auto; }
  .mydl--form .mydl__sub { margin-inline: auto; }
  .mydl__icon { width: 72px; height: 72px; margin: 0 auto 1.25rem; display: grid; place-items: center; border-radius: 50%; background: rgba(231,36,42,0.1); color: var(--brand-red); }
  .mydl__request { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .mydl__request .input { flex: 1; min-width: 200px; }
  .mydl__note { max-width: 46ch; margin: 0 auto; color: var(--text-muted); font-size: var(--fs-sm); }
  .mydl__note a { color: var(--brand-red); text-decoration: underline; }
  .mydl__hint { margin-top: 1.1rem; font-size: var(--fs-sm); }
  .mydl__hint[hidden] { display: none; }
  .mydl__list { display: flex; flex-direction: column; gap: 0.7rem; margin-top: 1rem; }
  .order-row { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.15rem; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--surface); transition: border-color 0.2s; }
  .order-row:hover { border-color: var(--brand-red); }
  .order-row__main { flex: 1; display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .order-row__title { font-weight: 600; }
  .order-row__meta { font-size: var(--fs-xs); color: var(--text-dim); }
  .btn-sm { padding: 0.5rem 0.9rem; font-size: var(--fs-sm); white-space: nowrap; }
  @media (max-width: 480px) { .order-row { flex-direction: column; align-items: stretch; } .btn-sm { justify-content: center; } }
</style>

<script>
  const form = document.querySelector('[data-magic-form]') as HTMLFormElement | null;
  if (form) {
    const email = form.querySelector('[data-magic-email]') as HTMLInputElement | null;
    const btn = form.querySelector('[data-magic-btn]') as HTMLButtonElement | null;
    const msg = document.querySelector('[data-magic-msg]') as HTMLElement | null;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const value = (email?.value || '').trim();
      if (!value) return;
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      try {
        const res = await fetch('/api/account/magic-link', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: value }),
        });
        const data = (await res.json()) as { message?: string };
        if (msg) { msg.textContent = data.message || 'Check your inbox for the link.'; msg.hidden = false; }
        form.reset();
      } catch {
        if (msg) { msg.textContent = 'Something went wrong. Please try again.'; msg.hidden = false; }
      } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = 'Email me the link'; }
      }
    });
  }
</script>
