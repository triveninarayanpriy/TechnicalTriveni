    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  @media (hover: hover) {
    .order-card:hover {
      transform: translateY(-0.125rem);
      box-shadow: 0 0.75rem 1.75rem rgba(0, 0, 0, 0.06);
      border-color: rgba(233, 36, 36, 0.3);
