    margin: 0 0 0.5rem;
  }

  .mydl-sub {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.55;
    margin: 0;
  }

  /* Orders List */
  .mydl-orders-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .order-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
