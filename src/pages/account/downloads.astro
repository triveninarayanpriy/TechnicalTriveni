</style>

<script>
  const formWrap = document.querySelector('[data-magic-form-wrap]') as HTMLElement | null;
  const form = document.querySelector('[data-magic-form]') as HTMLFormElement | null;
  const sentCard = document.querySelector('[data-magic-sent]') as HTMLElement | null;
  const sentEmailTarget = document.querySelector('[data-sent-email]') as HTMLElement | null;
  const errorMsg = document.querySelector('[data-magic-error]') as HTMLElement | null;
  const resetBtn = document.querySelector('[data-magic-reset]') as HTMLButtonElement | null;
  const resendBtn = document.querySelector('[data-magic-resend]') as HTMLButtonElement | null;
  const resendWait = document.querySelector('[data-resend-wait]') as HTMLElement | null;
  const resendSec = document.querySelector('[data-resend-sec]') as HTMLElement | null;
  const gmailBtn = document.querySelector('[data-gmail-btn]') as HTMLAnchorElement | null;

  let lastSentEmail = '';
  let countdownTimer: number | null = null;

  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function startCooldown(seconds = 30) {
    if (countdownTimer) clearInterval(countdownTimer);
    if (!resendBtn || !resendWait || !resendSec) return;

    resendBtn.disabled = true;
    resendBtn.style.opacity = '0.5';
    resendBtn.style.pointerEvents = 'none';
    resendWait.hidden = false;
    resendSec.textContent = String(seconds);

    let remaining = seconds;
    countdownTimer = window.setInterval(() => {
      remaining -= 1;
      if (resendSec) resendSec.textContent = String(remaining);
      if (remaining <= 0) {
        clearInterval(countdownTimer!);
        resendBtn.disabled = false;
        resendBtn.style.opacity = '1';
        resendBtn.style.pointerEvents = 'auto';
        resendWait.hidden = true;
      }
    }, 1000);
  }

  async function submitMagicEmail(val: string) {
    const email = val.trim().toLowerCase();
    if (!EMAIL_REGEX.test(email)) {
      if (errorMsg) {
        errorMsg.textContent = 'Please enter a valid email address.';
        errorMsg.hidden = false;
      }
      return false;
    }

    if (errorMsg) errorMsg.hidden = true;
    const btn = form?.querySelector('[data-magic-btn]') as HTMLButtonElement | null;
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span>Sending link…</span>';
    }

    try {
      const res = await fetch('/api/account/magic-link', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = (await res.json()) as { ok?: boolean; message?: string; error?: string };

      if (!res.ok && data.error) {
        if (errorMsg) {
          errorMsg.textContent = data.error;
          errorMsg.hidden = false;
        }
        return false;
      }

      // Success transition
      lastSentEmail = email;
      if (sentEmailTarget) sentEmailTarget.textContent = email;

      // Smart mail provider button
      if (gmailBtn) {
        if (email.endsWith('@gmail.com') || email.endsWith('@googlemail.com')) {
          gmailBtn.hidden = false;
          gmailBtn.href = 'https://mail.google.com';
        } else if (email.endsWith('@outlook.com') || email.endsWith('@hotmail.com')) {
          gmailBtn.hidden = false;
          gmailBtn.href = 'https://outlook.live.com';
          gmailBtn.querySelector('span')!.textContent = 'Open Outlook';
        } else {
          gmailBtn.hidden = true;
        }
      }

      if (formWrap) formWrap.hidden = true;
      if (sentCard) sentCard.hidden = false;
      startCooldown(30);
      form?.reset();
      return true;
    } catch {
      if (errorMsg) {
        errorMsg.textContent = 'Network error. Please try again.';
        errorMsg.hidden = false;
      }
      return false;
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<span class="btn-text">Email me the link</span><svg class="icon btn-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" style="width:1rem;height:1rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
      }
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = form.querySelector('[data-magic-email]') as HTMLInputElement | null;
    const value = input?.value || '';
    await submitMagicEmail(value);
  });

  resetBtn?.addEventListener('click', () => {
    if (sentCard) sentCard.hidden = true;
    if (formWrap) formWrap.hidden = false;
    if (errorMsg) errorMsg.hidden = true;
    const input = form?.querySelector('[data-magic-email]') as HTMLInputElement | null;
    if (input) {
      input.value = lastSentEmail || '';
      input.focus();
    }
  });

  resendBtn?.addEventListener('click', async () => {
    if (!lastSentEmail) return;
    await submitMagicEmail(lastSentEmail);
  });
</script>
