---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { env } from 'cloudflare:workers';
import { getOrdersByEmail } from '../../lib/db';
import { verifyPayload } from '../../lib/crypto';
import { emailEnabled } from '../../lib/email';
import { formatINR } from '../../lib/format';

const token = Astro.url.searchParams.get('token') || '';

let email = '';
let valid = false;
let orders: Awaited<ReturnType<typeof getOrdersByEmail>> = [];

if (token) {
  const payload = await verifyPayload<{ email: string; exp: number }>(env.SESSION_SECRET, token);
  if (payload && payload.exp > Math.floor(Date.now() / 1000)) {
    valid = true;
    email = payload.email;
    orders = await getOrdersByEmail(env.DB, email);
  }
}

const fmtDate = (s: number) => new Date(s * 1000).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const dlLink = (o: (typeof orders)[number]) =>
  `/account/download?order=${encodeURIComponent(o.id)}&token=${encodeURIComponent(o.download_token)}`;
const mailOn = emailEnabled(env);
---

<Base title="My downloads" noindex>
  <section class="mydl-section">
    <div class="container container-narrow">
      {valid ? (
        <div class="mydl">
          <span class="mydl-eyebrow">YOUR ACCOUNT</span>
          <h1 class="mydl-title">Your downloads</h1>
          <p class="mydl-sub">Signed in as <strong>{email}</strong>. Open any project pack below to download your source files, schematics, and 3D models.</p>
          {orders.length > 0 ? (
            <div class="mydl__list">
              {orders.map((o) => (
                <div class="order-card">
                  <div class="order-card__main">
                    <span class="order-card__title">{o.project_title}</span>
                    <span class="order-card__meta">{fmtDate(o.created_at)} · {formatINR(o.amount_inr)} · Order #{o.id.slice(0, 8).toUpperCase()}</span>
                  </div>
                  <a href={dlLink(o)} class="btn btn-primary order-card__btn">
                    <Icon name="download" size={16} /> Download files
                  </a>
                </div>
              ))}
            </div>
          ) : (
            <div class="mydl-empty center">
              <p class="mydl-empty__text">No project packs found for this email address yet.</p>
              <a href="/projects" class="btn btn-secondary">Browse project packs →</a>
            </div>
          )}
        </div>
      ) : (
        <div class="mydl mydl--form">
          <div class="mydl__icon">
            <Icon name="download" size={28} />
          </div>
          <span class="mydl-eyebrow center">INSTANT ACCESS</span>
          <h1 class="mydl-title center">My downloads</h1>
          <p class="mydl-sub center">
            Enter the email address you used at checkout and we will send you a secure direct link to all your project files. No password required.
          </p>
          <form class="mydl__request" data-magic-form>
            <input class="input mydl__input" type="email" name="email" placeholder="name@example.com" autocomplete="email" required data-magic-email />
            <button class="btn btn-primary mydl__btn" type="submit" data-magic-btn>
              <Icon name="mail" size={16} /> Email me the link
            </button>
          </form>
          {!mailOn && (
            <p class="mydl__note center" style="margin-top: 14px;">
              Email delivery is currently paused. Please check your original purchase confirmation email, or
              <a href="/contact"> contact support</a> to get your files.
            </p>
          )}
          <p class="mydl__hint center" data-magic-msg hidden></p>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .mydl-section {
    padding: clamp(48px, 6vw, 96px) 0;
  }
  .center {
    text-align: center;
  }
  .mydl-eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--red);
    margin-bottom: 8px;
  }
  .mydl-title {
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 12px;
  }
  .mydl-sub {
    font-size: 1rem;
    color: var(--ink-2);
    line-height: 1.6;
    max-width: 50ch;
    margin: 0 0 32px;
  }
  .mydl--form {
    max-width: 480px;
    margin: 0 auto;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: clamp(24px, 5vw, 40px);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }
  .mydl--form .mydl-sub {
    margin-inline: auto;
  }
  .mydl__icon {
    width: 60px;
    height: 60px;
    margin: 0 auto 16px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgba(233, 36, 36, 0.08);
    color: var(--red);
  }
  .mydl__request {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mydl__input {
    height: 48px;
    border-radius: 10px;
    border: 1px solid var(--line);
    padding: 0 16px;
    font-size: 1rem;
    color: var(--ink);
    width: 100%;
  }
  .mydl__input:focus {
    outline: none;
    border-color: var(--red);
    box-shadow: 0 0 0 2px rgba(233, 36, 36, 0.15);
  }
  .mydl__btn {
    height: 48px;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    cursor: pointer;
  }
  .mydl__note {
    max-width: 46ch;
    margin: 0 auto;
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .mydl__note a {
    color: var(--red);
    text-decoration: underline;
  }
  .mydl__hint {
    margin-top: 16px;
    font-size: 0.875rem;
    color: var(--ink-2);
    background: var(--bg-soft);
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid var(--line);
  }
  .mydl__hint[hidden] {
    display: none;
  }

  /* Orders List */
  .mydl__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .order-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--bg);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  @media (min-width: 1024px) {
    .order-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    }
  }
  .order-card__main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .order-card__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
  }
  .order-card__meta {
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .order-card__btn {
    height: 44px;
    padding: 0 20px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  @media (max-width: 600px) {
    .mydl-section {
      padding: 36px 0 60px;
    }
    .mydl--form {
      padding: 24px 16px;
      border-radius: 16px;
    }
    .mydl__icon {
      width: 56px;
      height: 56px;
      border-radius: 14px;
    }
    .mydl-title {
      font-size: 1.875rem;
    }
    .mydl-sub {
      font-size: 0.9375rem;
      margin-bottom: 24px;
    }
    .order-card {
      flex-direction: column;
      align-items: stretch;
      padding: 16px;
      gap: 12px;
      border-radius: 14px;
    }
    .order-card__btn {
      height: 48px;
      justify-content: center;
      width: 100%;
    }
  }
  .mydl-empty {
    padding: 48px 24px;
    background: var(--bg-soft);
    border: 1px dashed var(--line);
    border-radius: 16px;
  }
  .mydl-empty__text {
    font-size: 1rem;
    color: var(--ink-2);
    margin: 0 0 16px;
  }
</style>

<script>
  const form = document.querySelector('[data-magic-form]') as HTMLFormElement | null;
  if (form) {
    const email = form.querySelector('[data-magic-email]') as HTMLInputElement | null;
    const btn = form.querySelector('[data-magic-btn]') as HTMLButtonElement | null;
    const msg = document.querySelector('[data-magic-msg]') as HTMLElement | null;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const value = (email?.value || '').trim();
      if (!value) return;
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      try {
        const res = await fetch('/api/account/magic-link', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: value }),
        });
        const data = (await res.json()) as { message?: string };
        if (msg) { msg.textContent = data.message || 'Check your inbox for the link.'; msg.hidden = false; }
        form.reset();
      } catch {
        if (msg) { msg.textContent = 'Something went wrong. Please try again.'; msg.hidden = false; }
      } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = 'Email me the link'; }
      }
    });
  }
</script>
