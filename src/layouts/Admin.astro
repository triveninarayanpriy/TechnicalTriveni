---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  active?: string;
}
const { title, active = '' } = Astro.props;
const admin = Astro.locals.admin;

const nav = [
  { key: 'dashboard', label: 'Dashboard', href: '/admin', icon: 'layers' },
  { key: 'projects', label: 'Projects', href: '/admin/projects', icon: 'cpu' },
  { key: 'orders', label: 'Orders', href: '/admin/orders', icon: 'cart' },
  { key: 'messages', label: 'Messages', href: '/admin/messages', icon: 'mail' },
  { key: 'settings', label: 'Settings', href: '/admin/settings', icon: 'spark' },
];
const csrf = Astro.locals.csrfToken;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin · Technical Triveni</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="admin-body">
    <div class="admin">
      <aside class="admin-sidebar" data-sidebar>
        <a href="/admin" class="admin-brand">
          <svg viewBox="-4 -4 120 100" aria-hidden="true">
            <defs><path id="ab" d="M12 0 L62 0 L62 18 L41 18 L41 74 L31 92 L21 74 L21 18 L0 18 L0 7 L12 7 Z"/></defs>
            <use href="#ab" x="0" fill="var(--brand-red)"/>
            <use href="#ab" x="50" fill="#fff"/>
          </svg>
          <span>Triveni <em>Admin</em></span>
        </a>
        <nav class="admin-nav">
          {nav.map((n) => (
            <a href={n.href} class:list={['admin-nav__link', { 'is-active': active === n.key }]}>
              <Icon name={n.icon} size={18} /> {n.label}
            </a>
          ))}
        </nav>
        <div class="admin-sidebar__foot">
          <a href="/" target="_blank" class="admin-nav__link"><Icon name="external" size={18} /> View site</a>
          <form method="post" action="/api/admin/logout">
            <input type="hidden" name="csrf" value={csrf} />
            <button type="submit" class="admin-nav__link admin-logout"><Icon name="logout" size={18} /> Log out</button>
          </form>
        </div>
      </aside>

      <div class="admin-main">
        <header class="admin-topbar">
          <button class="admin-burger" data-sidebar-toggle aria-label="Toggle menu"><Icon name="menu" size={22} /></button>
          <h1 class="admin-topbar__title">{title}</h1>
          <span class="admin-user mono">{admin?.email}</span>
        </header>
        <div class="admin-content">
          <slot />
        </div>
      </div>
    </div>

    <div class="toast-wrap" id="toast-wrap" aria-live="polite"></div>

    <style>
      .admin-body { background: var(--bg); }
      .admin { display: grid; grid-template-columns: 250px 1fr; min-height: 100dvh; }
      .admin-sidebar { position: sticky; top: 0; height: 100dvh; display: flex; flex-direction: column; gap: 0.5rem; padding: 1.25rem 1rem; border-right: 1px solid var(--border); background: var(--bg-2); }
      .admin-brand { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem; font-family: var(--font-display); font-weight: 700; }
      .admin-brand svg { width: 30px; }
      .admin-brand em { color: var(--brand-red); font-style: normal; }
      .admin-nav { display: flex; flex-direction: column; gap: 0.2rem; margin-top: 1rem; }
      .admin-nav__link { display: flex; align-items: center; gap: 0.7rem; padding: 0.7rem 0.85rem; border-radius: var(--r-sm); color: var(--text-muted); font-size: var(--fs-sm); font-weight: 550; width: 100%; background: none; border: none; cursor: pointer; text-align: left; }
      .admin-nav__link:hover { background: var(--surface); color: var(--text); }
      .admin-nav__link.is-active { background: var(--surface-2); color: var(--text); box-shadow: inset 2px 0 0 var(--brand-red); }
      .admin-nav__link :global(svg) { flex-shrink: 0; }
      .admin-sidebar__foot { margin-top: auto; display: flex; flex-direction: column; gap: 0.2rem; padding-top: 1rem; border-top: 1px solid var(--hairline); }
      .admin-logout { color: var(--danger); }

      .admin-main { min-width: 0; display: flex; flex-direction: column; }
      .admin-topbar { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 1rem; padding: 1rem clamp(1rem, 3vw, 2rem); border-bottom: 1px solid var(--border); background: rgba(10,10,12,0.8); backdrop-filter: blur(10px); }
      .admin-topbar__title { font-size: var(--fs-md); flex: 1; }
      .admin-user { font-size: var(--fs-xs); color: var(--text-dim); }
      .admin-burger { display: none; background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: var(--r-sm); padding: 0.35rem; cursor: pointer; }
      .admin-content { padding: clamp(1.25rem, 3vw, 2rem); flex: 1; }

      @media (max-width: 820px) {
        .admin { grid-template-columns: 1fr; }
        .admin-sidebar { position: fixed; z-index: 50; width: 250px; transform: translateX(-100%); transition: transform 0.25s var(--ease); }
        .admin-sidebar.is-open { transform: none; }
        .admin-burger { display: inline-flex; }
      }
    </style>

    <script>
      const sb = document.querySelector('[data-sidebar]');
      document.querySelector('[data-sidebar-toggle]')?.addEventListener('click', () => sb?.classList.toggle('is-open'));
      (window as any).toast = (message: string, type = 'info') => {
        const wrap = document.getElementById('toast-wrap'); if (!wrap) return;
        const el = document.createElement('div'); el.className = `toast is-${type}`; el.textContent = message;
        wrap.appendChild(el); setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity .4s'; setTimeout(() => el.remove(), 400); }, 4000);
      };
      // Surface ?ok= / ?err= flash messages as toasts.
      const p = new URLSearchParams(location.search);
      if (p.get('ok')) (window as any).toast(decodeURIComponent(p.get('ok')!), 'success');
      if (p.get('err')) (window as any).toast(decodeURIComponent(p.get('err')!), 'error');
    </script>
  </body>
</html>
