---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import CookieBanner from '../components/CookieBanner.astro';
import { SITE } from '../lib/site';
import { env } from 'cloudflare:workers';
import { getSetting } from '../lib/db';

let announcement = '';
let annLink = '';
let annExpiry = '';
try {
  const isEnabled = (await getSetting(env.DB, 'announcement_enabled')) === '1';
  if (isEnabled) {
    announcement = (await getSetting(env.DB, 'site_announcement')) || 'Need help with an order? Email technicaltriveniyt@gmail.com';
    annLink = (await getSetting(env.DB, 'announcement_link')) || '';
    annExpiry = (await getSetting(env.DB, 'announcement_expiry')) || '';
    
    if (annExpiry) {
      const expiryDate = new Date(annExpiry);
      if (expiryDate < new Date()) {
        announcement = ''; // expired
      }
    }
  }
} catch {
  /* DB not ready */
}

// Check if dismissed for 7 days
const dismissedAnn = Astro.cookies.get('tt_ann_dismiss')?.value;
if (dismissedAnn) {
  try {
    if (dismissedAnn === '1' || decodeURIComponent(dismissedAnn) === announcement || dismissedAnn === announcement) {
      announcement = '';
    }
  } catch {
    if (dismissedAnn === '1' || dismissedAnn === announcement) {
      announcement = '';
    }
  }
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  wide?: boolean;
  /** JSON-LD structured data object(s). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}


let defaultOgImage = '/og-default.png';
try {
  const customShare = await getSetting(env.DB, 'default_share_image_url');
  if (customShare && customShare.trim()) {
    defaultOgImage = customShare;
  }
} catch {}

const {
  title,
  description = SITE.description,
  ogImage = defaultOgImage,
  noindex = false,
  wide = false,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const ogImageAbs = new URL(ogImage, Astro.site ?? Astro.url.origin).toString();
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    {/* Analytics (Add your GA4 or Plausible tag here) */}
    {import.meta.env.PROD && (
      <script defer data-domain="technicaltriveni.me" src="https://plausible.io/js/script.js"></script>
    )}
    
    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Icons / theme -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {jsonLdArray.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {announcement && (
      <div class="announce-bar" id="announce-bar" role="region" aria-label="Announcement">
        <div class="announce-bar__content">
          {annLink ? (
            <a href={annLink} class="announce-bar__link">
              <span>{announcement}</span>
            </a>
          ) : announcement.includes('technicaltriveniyt@gmail.com') ? (
            <span>
              {announcement.replace('technicaltriveniyt@gmail.com', '').trim()}{' '}
              <a href="mailto:technicaltriveniyt@gmail.com" class="announce-bar__link">technicaltriveniyt@gmail.com</a>
            </span>
          ) : (
            <span>{announcement}</span>
          )}
        </div>
        <button
          type="button"
          class="announce-bar__close"
          aria-label="Dismiss announcement"
          onclick="document.cookie='tt_ann_dismiss=1;path=/;max-age=604800;SameSite=Lax';document.getElementById('announce-bar').remove();"
        >
          &times;
        </button>
      </div>
    )}
    <Header />
    
    <main id="main" class:list={[{ 'is-wide': wide }]}>
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <div class="toast-wrap" id="toast-wrap" aria-live="polite" aria-atomic="true"></div>

    <style>
      body { display: flex; flex-direction: column; min-height: 100dvh; overflow-x: clip; }
      main { flex: 1 0 auto; min-width: 0; }
      
      .announce-bar {
        position: relative;
        text-align: center;
        padding: 6px 36px 6px 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 13px;
        font-weight: 550;
        color: #fff;
        background: var(--red);
        min-height: 36px;
        z-index: 100;
      }
      .announce-bar__content {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
      }
      .announce-bar a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .announce-bar a:hover {
        opacity: 0.9;
      }
      .announce-bar__close {
        position: absolute;
        right: 6px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: white;
        font-size: 1.25rem;
        cursor: pointer;
        padding: 4px 8px;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--r-xs);
        min-height: 28px;
        min-width: 28px;
      }
      .announce-bar__close:hover {
        background: rgba(0, 0, 0, 0.15);
      }
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 300;
        background: var(--brand-red);
        color: #fff;
        padding: 0.6rem 1rem;
        border-radius: var(--r-sm);
        transition: top 0.2s;
      }
      .skip-link:focus { top: 1rem; }
    </style>

    <script>
      // --- Scroll reveal (progressive enhancement) ---
      const reveal = () => {
        const items = document.querySelectorAll('[data-reveal]:not(.is-visible)');
        if (!('IntersectionObserver' in window) || !items.length) {
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).style.transitionDelay =
                  (e.target as HTMLElement).dataset.revealDelay || '0ms';
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      };
      reveal();
      document.addEventListener('astro:page-load', reveal);

      // --- Global toast helper: window.toast(message, type) ---
      (window as any).toast = (message: string, type: 'info' | 'success' | 'error' = 'info') => {
        const wrap = document.getElementById('toast-wrap');
        if (!wrap) return;
        const el = document.createElement('div');
        el.className = `toast is-${type}`;
        el.textContent = message;
        wrap.appendChild(el);
        setTimeout(() => {
          el.style.opacity = '0';
          el.style.transition = 'opacity .4s';
          setTimeout(() => el.remove(), 400);
        }, 4200);
      };
    </script>
  </body>
</html>
