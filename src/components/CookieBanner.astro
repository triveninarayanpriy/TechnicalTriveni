---
// Privacy-first cookie notice. The site uses essential cookies only.
// Bottom-left on desktop (max 360px), slim bar on phones (above sticky buy bar).
---
<div class="cookie" id="cookie-banner" hidden role="region" aria-label="Cookie notice">
  <p class="cookie__text">
    We use essential cookies to keep the site secure. <a href="/legal/cookies">Learn more</a>
  </p>
  <button class="btn btn-primary btn-sm" id="cookie-ok" type="button">Got it</button>
</div>

<style>
  .cookie {
    position: fixed;
    z-index: 150;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .cookie[hidden] {
    display: none;
  }
  .cookie__text {
    flex: 1;
    font-size: var(--fs-xs);
    color: var(--ink-2);
    line-height: 1.4;
    margin: 0;
  }
  .cookie__text a {
    color: var(--red);
    text-decoration: underline;
    font-weight: 550;
    white-space: nowrap;
  }
  .cookie .btn-sm {
    min-height: 2.25rem;
    padding: 0 0.85rem;
    font-size: var(--fs-xs);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Desktop: bottom-left, max-width 28rem */
  @media (min-width: 641px) {
    .cookie {
      bottom: 1.5rem;
      left: 1.5rem;
      right: auto;
      max-width: min(calc(100vw - 3rem), 28rem);
      padding: 0.85rem 1.15rem;
      border-radius: var(--r-card);
    }
  }

  /* Phones: slim bar at bottom (above sticky buy bar) */
  @media (max-width: 640px) {
    .cookie {
      bottom: var(--sticky-buy-h, 0rem);
      left: 0;
      right: 0;
      border-radius: 0;
      border-left: none;
      border-right: none;
      border-bottom: none;
      padding: 0.625rem 1rem;
    }
    .cookie .btn-sm {
      min-height: 2.75rem;
      padding: 0 1.125rem;
    }
  }
</style>

<script>
  const KEY = 'tt-cookie-ack';
  const banner = document.getElementById('cookie-banner');
  const ok = document.getElementById('cookie-ok');

  function updateFooterClearance() {
    if (!banner || banner.hidden || banner.style.display === 'none') {
      document.body.style.paddingBottom = '';
      return;
    }
    const bannerH = banner.offsetHeight || 0;
    if (bannerH > 0) {
      document.body.style.paddingBottom = `${bannerH + 24}px`;
    }
  }

  try {
    if (banner && localStorage.getItem(KEY) !== '1') {
      banner.hidden = false;
      updateFooterClearance();

      if ('ResizeObserver' in window) {
        const ro = new ResizeObserver(() => updateFooterClearance());
        ro.observe(banner);
        window.addEventListener('resize', updateFooterClearance, { passive: true });
      }
    }
  } catch {
    /* storage blocked -> keep hidden */
  }

  ok?.addEventListener('click', () => {
    if (banner) {
      banner.hidden = true;
      document.body.style.paddingBottom = '';
    }
    try { localStorage.setItem(KEY, '1'); } catch { /* ignore */ }
  });
</script>
