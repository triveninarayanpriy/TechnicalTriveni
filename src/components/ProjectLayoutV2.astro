---
import Icon from './Icon.astro';
import BomTable from './BomTable.astro';
import TroubleTable from './TroubleTable.astro';
import ProjectCard from './ProjectCard.astro';
import type { ProjectFull, Project } from '../lib/db';
import { formatINR, formatDate, formatBytes, cleanFileName, difficultyClass } from '../lib/format';
import { FILE_KINDS } from '../lib/site';

interface Props {
  project: ProjectFull;
  estCost: number;
  paid: boolean;
  descHtml: string;
  safetyHtml: string;
  yt?: string | null;
  ratingAvg?: number;
  ratingCount?: number;
  relatedPacks?: Project[];
}

const {
  project,
  estCost,
  paid,
  descHtml,
  safetyHtml,
  yt,
  ratingAvg = 0,
  ratingCount = 0,
  relatedPacks = [],
} = Astro.props;

// Safe array parser
const safeArr = (str: any) => {
  if (!str) return [];
  if (Array.isArray(str)) return str;
  try {
    const arr = JSON.parse(str);
    return Array.isArray(arr) ? arr : [];
  } catch {
    return [];
  }
};

const prereqs = safeArr(project.prereqs_json);
const outcomes = safeArr(project.outcomes_json);
const notIncluded = safeArr(project.not_included_json);
const faqs = safeArr(project.faq_json);

// Real Badges calculation
const fileKindsStr = (project.file_kinds || '').toLowerCase();
const filesList = project.files || [];
const hasCode = filesList.some((f) => f.kind === 'code' || f.kind === 'hex' || f.kind === 'sketch') || fileKindsStr.includes('code');
const hasSchematic = filesList.some((f) => f.kind === 'schematic') || (project.pins && project.pins.length > 0) || fileKindsStr.includes('schematic');
const has3D = filesList.some((f) => f.kind === 'model' || f.kind === '3d') || !!project.model_url;
const hasPdf = filesList.some((f) => f.kind === 'pdf') || (!hasCode && !hasSchematic && !has3D);
const hasBom = project.bom && project.bom.length > 0;

const badges: { label: string; icon: string }[] = [];
if (hasCode) badges.push({ label: 'Code', icon: 'code' });
if (hasSchematic && badges.length < 2) badges.push({ label: 'Schematic', icon: 'schematic' });
if (has3D && badges.length < 2) badges.push({ label: '3D Files', icon: 'cube' });
if (hasPdf && badges.length < 2) badges.push({ label: 'PDF Guide', icon: 'doc' });
if (hasBom && badges.length < 2) badges.push({ label: 'Parts List', icon: 'cart' });

// Media Gallery assembly
const rawImages = (project.images || []).map((img, i) => ({
  id: `img-${img.id || i}`,
  type: img.kind === 'model' ? 'model' : 'image',
  url: img.url,
  caption: img.caption || project.title,
}));

if (rawImages.length === 0 && project.cover_image) {
  rawImages.push({
    id: 'cover',
    type: 'image',
    url: project.cover_image,
    caption: project.title,
  });
}

const mediaList = [...rawImages];
const hasModel = mediaList.some((m) => m.type === 'model');
const firstMedia = mediaList[0] || { type: 'image', url: project.cover_image || '/og-default.png', caption: project.title };

// Deduplicate files by cleaned label and url
const uniqueFiles = filesList.reduce((acc, f) => {
  const clean = cleanFileName(f.label, f.kind);
  const key = `${clean}_${f.url || f.id}`;
  if (!acc.map.has(key)) {
    acc.map.set(key, true);
    acc.list.push({ ...f, cleanLabel: clean });
  }
  return acc;
}, { map: new Map<string, boolean>(), list: [] as any[] }).list;

// File counts for buy box
const codeCount = uniqueFiles.filter((f) => f.kind === 'code' || f.kind === 'hex' || f.kind === 'sketch').length;
const schematicCount = uniqueFiles.filter((f) => f.kind === 'schematic').length;
const modelCount = uniqueFiles.filter((f) => f.kind === 'model' || f.kind === '3d').length;
const pdfCount = uniqueFiles.filter((f) => f.kind === 'pdf' || f.kind === 'doc').length;

// Group Pins by Module
const groupedPins = (project.pins || []).reduce((acc, pin) => {
  const m = pin.module || 'General';
  if (!acc[m]) acc[m] = [];
  acc[m].push(pin);
  return acc;
}, {} as Record<string, typeof project.pins>);

// Meta Row construction
const metaParts: string[] = [];
if (project.difficulty) metaParts.push(project.difficulty);
if (project.build_time) metaParts.push(project.build_time);
else metaParts.push('2 h');
if (estCost > 0) metaParts.push(`Core cost ≈ ${formatINR(estCost)}`);
if (project.updated_at) metaParts.push(`Updated ${formatDate(project.updated_at)}`);
const metaRow = metaParts.join(' · ');

const lastUpdated = formatDate(project.updated_at);
---

<div class="project-layout">
  <!-- BREADCRUMBS -->
  <nav class="p-crumbs container" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="p-crumbs__sep">/</span>
    <a href="/projects">Projects</a>
    <span class="p-crumbs__sep">/</span>
    <a href={`/projects?cat=${encodeURIComponent(project.category || 'All')}`}>{project.category || 'Projects'}</a>
    <span class="p-crumbs__sep">/</span>
    <span class="p-crumbs__current">{project.title}</span>
  </nav>

  <!-- TITLE BLOCK -->
  <header class="p-header container">
    <span class="p-eyebrow">{project.category || 'PROJECT PACK'}</span>
    <h1 class="p-title">{project.title}</h1>
    {project.summary && <p class="p-summary">{project.summary}</p>}

    <div class="p-meta-bar">
      <span class="p-meta-text">{metaRow}</span>
      {badges.length > 0 && (
        <div class="p-badges">
          {badges.map((b) => (
            <span class="p-badge">
              <Icon name={b.icon} size={13} /> {b.label}
            </span>
          ))}
        </div>
      )}
    </div>
  </header>

  <!-- HERO 7/5 GRID -->
  <section class="p-hero-grid container">
    <!-- LEFT COLUMN: Media Viewer (7 cols) -->
    <div class="p-viewer">
      <div class="p-stage" id="media-stage">
        {firstMedia.type === 'model' ? (
          <model-viewer
            src={firstMedia.url}
            camera-controls
            auto-rotate
            shadow-intensity="1"
            exposure="1.2"
            class="p-stage__model"
            alt={`3D Model of ${project.title}`}
          ></model-viewer>
        ) : (
          <img
            src={firstMedia.url}
            alt={firstMedia.caption || project.title}
            class="p-stage__img"
            id="stage-img"
            width="800"
            height="500"
            loading="eager"
          />
        )}
      </div>

      <!-- Media Thumbnails Strip -->
      {(mediaList.length > 1 || yt) && (
        <div class="p-thumbs" role="tablist" aria-label="Media gallery thumbnails">
          {mediaList.map((m, i) => (
            <button
              type="button"
              class:list={['p-thumb-btn', { 'is-active': i === 0 }]}
              data-media-url={m.url}
              data-media-type={m.type}
              aria-label={`View image ${i + 1}`}
            >
              {m.type === 'model' ? (
                <div class="p-thumb-icon"><Icon name="cube" size={18} /></div>
              ) : (
                <img src={m.url} alt="" width="72" height="48" loading="lazy" />
              )}
            </button>
          ))}
          {yt && (
            <button
              type="button"
              class="p-thumb-btn p-thumb-btn--yt"
              data-yt-id={yt}
              aria-label="View Video"
            >
              <div class="p-thumb-icon p-thumb-icon--yt">
                <Icon name="play" size={18} />
              </div>
            </button>
          )}
        </div>
      )}
    </div>

    <!-- RIGHT COLUMN: Sticky Buy Box (5 cols) -->
    <aside class="p-sidebar">
      <div
        class="buy-box"
        id="main-buy-box"
        data-project-id={project.id}
        data-slug={project.slug}
        data-paid={paid ? '1' : '0'}
        data-price={project.price_inr || 0}
      >
        {paid ? (
          <div class="buy-box__paid">
            <div class="buy-box__top">
              <span class="buy-box__tag">DIGITAL PROJECT PACK</span>
              <div class="buy-box__price-wrap">
                <span class="buy-box__price">{formatINR(project.price_inr)}</span>
                <span class="buy-box__price-sub">one-time purchase &middot; instant access</span>
              </div>
            </div>

            <!-- What's inside list -->
            <div class="buy-box__contents">
              <span class="buy-box__contents-title">What's included in this pack:</span>
              <ul class="buy-box__checklist">
                {codeCount > 0 && (
                  <li><Icon name="code" size={15} /> {codeCount} tested source code {codeCount === 1 ? 'file' : 'files'}</li>
                )}
                {schematicCount > 0 && (
                  <li><Icon name="schematic" size={15} /> {schematicCount} verified circuit {schematicCount === 1 ? 'schematic' : 'schematics'}</li>
                )}
                {modelCount > 0 && (
                  <li><Icon name="cube" size={15} /> {modelCount} ready-to-print 3D STL {modelCount === 1 ? 'model' : 'models'}</li>
                )}
                {pdfCount > 0 && (
                  <li><Icon name="doc" size={15} /> Complete documentation & wiring guide</li>
                )}
                {hasBom && (
                  <li><Icon name="cart" size={15} /> Verified parts list with direct buy links</li>
                )}
              </ul>
            </div>

            <!-- Form -->
            <form class="buy-box__form" id="checkout-form" onsubmit="return false;">
              <div class="buy-box__field">
                <label for="buy-email" class="buy-box__label">Your email address</label>
                <input
                  type="email"
                  id="buy-email"
                  class="buy-box__input"
                  placeholder="name@example.com"
                  required
                  autocomplete="email"
                />
              </div>

              <div class="buy-box__coupon">
                <input
                  type="text"
                  id="coupon_code"
                  class="buy-box__input buy-box__input--sm"
                  placeholder="Discount code (optional)"
                  autocomplete="off"
                />
              </div>

              <button type="button" class="btn-buy-action" id="btn-buy-submit">
                <Icon name="lock" size={16} /> Buy pack &mdash; {formatINR(project.price_inr)}
              </button>
            </form>

            <div class="buy-box__trust">
              <div class="trust-item">
                <Icon name="shield" size={14} /> Secure checkout via Razorpay (UPI, Cards, NetBanking)
              </div>
              <div class="trust-item">
                <Icon name="check-circle" size={14} /> 7-day build guarantee &middot; direct email support
              </div>
              <div class="trust-item">
                <Icon name="download" size={14} /> Download link sent immediately to your email
              </div>
            </div>
          </div>
        ) : (
          <div class="buy-box__free">
            <span class="buy-box__tag buy-box__tag--free">FREE DIGITAL RESOURCE</span>
            <h3 class="buy-box__free-title">Get free project files</h3>
            <p class="buy-box__free-desc">
              Enter your email and we'll instantly send you the full resource download link. No spam, ever.
            </p>

            <form class="buy-box__form" id="free-claim-form" onsubmit="return false;">
              <div class="buy-box__field">
                <label for="buy-email" class="buy-box__label">Your email address</label>
                <input
                  type="email"
                  id="buy-email"
                  class="buy-box__input"
                  placeholder="name@example.com"
                  required
                  autocomplete="email"
                />
              </div>

              <button type="button" class="btn-buy-action btn-buy-action--free" id="btn-free-submit">
                <Icon name="download" size={16} /> Get free files &rarr;
              </button>
            </form>

            <div class="buy-box__trust">
              <div class="trust-item">
                <Icon name="check-circle" size={14} /> Instant download link sent to your inbox
              </div>
              <div class="trust-item">
                <Icon name="shield" size={14} /> 100% free open resource &middot; no payment needed
              </div>
            </div>
          </div>
        )}
      </div>
    </aside>
  </section>

  <!-- STICKY SECTION NAV PILLS -->
  <nav class="p-secnav" id="sticky-secnav" aria-label="Page sections">
    <div class="container p-secnav__inner">
      <a href="#overview" class="p-secnav__link is-active">Overview</a>
      {hasBom && <a href="#parts" class="p-secnav__link">Parts list</a>}
      {(project.pins?.length > 0 || project.wiring_diagrams?.length > 0) && (
        <a href="#wiring" class="p-secnav__link">Wiring</a>
      )}
      {project.steps?.length > 0 && <a href="#steps" class="p-secnav__link">Build steps</a>}
      {project.troubleshooting?.length > 0 && (
        <a href="#troubleshooting" class="p-secnav__link">Troubleshooting</a>
      )}
      {uniqueFiles.length > 0 && <a href="#files" class="p-secnav__link">Files included</a>}
      {faqs.length > 0 && <a href="#faq" class="p-secnav__link">FAQ</a>}
    </div>
  </nav>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="p-content container">
    <!-- 1. OVERVIEW -->
    <section class="p-sec" id="overview">
      <h2 class="p-sec__title">Overview</h2>

      <!-- Safety Alert Box (if present) -->
      {safetyHtml && (
        <aside class="p-safety-box" role="alert">
          <div class="p-safety-box__header">
            <Icon name="shield" size={20} />
            <h3 class="p-safety-box__title">Safety first &mdash; read before building</h3>
          </div>
          <div class="p-safety-box__body prose" set:html={safetyHtml}></div>
        </aside>
      )}

      <!-- Description Markdown -->
      <div class="prose p-overview-body" set:html={descHtml}></div>

      <!-- Outcomes list (if present) -->
      {outcomes.length > 0 && (
        <div class="p-outcomes">
          <h3 class="p-subhead">What you'll build & learn</h3>
          <ul class="p-check-list">
            {outcomes.map((o: string) => (
              <li>
                <Icon name="check-circle" size={16} /> <span>{o}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Prerequisites & Not Included (if present) -->
      {(prereqs.length > 0 || notIncluded.length > 0) && (
        <div class="p-prereqs-grid">
          {prereqs.length > 0 && (
            <div class="p-panel">
              <h4 class="p-panel__title"><Icon name="doc" size={16} /> Prerequisites</h4>
              <ul class="p-bullet-list">
                {prereqs.map((p: string) => <li>{p}</li>)}
              </ul>
            </div>
          )}
          {notIncluded.length > 0 && (
            <div class="p-panel">
              <h4 class="p-panel__title"><Icon name="info" size={16} /> Not included in this pack</h4>
              <ul class="p-bullet-list">
                {notIncluded.map((n: string) => <li>{n}</li>)}
              </ul>
            </div>
          )}
        </div>
      )}
    </section>

    <!-- 2. PARTS LIST (BOM) -->
    {hasBom && (
      <section class="p-sec" id="parts">
        <h2 class="p-sec__title">Parts list & components</h2>
        <BomTable items={project.bom} costChecked={project.cost_checked} />
      </section>
    )}

    <!-- 3. WIRING & CONNECTIONS -->
    {(project.pins?.length > 0 || project.wiring_diagrams?.length > 0) && (
      <section class="p-sec" id="wiring">
        <h2 class="p-sec__title">Wiring & connections</h2>

        <!-- Wiring Diagram Images (if present) -->
        {project.wiring_diagrams && project.wiring_diagrams.length > 0 && (
          <div class="p-wiring-diagrams">
            {project.wiring_diagrams.map((d) => (
              <figure class="p-wiring-diagram">
                <img src={d.url} alt={d.label || 'Wiring diagram'} loading="lazy" />
                {d.label && <figcaption class="p-wiring-diagram__cap">{d.label}</figcaption>}
              </figure>
            ))}
          </div>
        )}

        <!-- Pin Tables by Module -->
        {Object.entries(groupedPins).map(([moduleName, pins]) => (
          <div class="p-pin-module">
            <h3 class="p-pin-module__title">{moduleName} Connections</h3>
            <div class="p-table-wrap">
              <table class="p-table">
                <thead>
                  <tr>
                    <th>From Pin / Component</th>
                    <th>To Pin / Board</th>
                    <th>Connection Note</th>
                  </tr>
                </thead>
                <tbody>
                  {pins.map((p) => (
                    <tr>
                      <td class="font-mono font-bold">{p.from_pin}</td>
                      <td class="font-mono">{p.to_pin}</td>
                      <td class="text-ink-2">{p.note || '&mdash;'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </section>
    )}

    <!-- 4. BUILD STEPS -->
    {project.steps?.length > 0 && (
      <section class="p-sec" id="steps">
        <h2 class="p-sec__title">Build steps</h2>
        <div class="p-steps-list">
          {project.steps.map((s, i) => (
            <article class="p-step-card" data-step-index={i}>
              <div class="p-step-card__header">
                <span class="p-step-badge">{i + 1}</span>
                <div class="p-step-card__title-wrap">
                  <h3 class="p-step-card__title">{s.title}</h3>
                  {s.goal && <p class="p-step-card__goal">Goal: {s.goal}</p>}
                </div>
                {s.time_est && (
                  <span class="p-step-time"><Icon name="clock" size={13} /> {s.time_est}</span>
                )}
              </div>

              <div class="p-step-card__body">
                {s.image_url && (
                  <div class="p-step-card__media">
                    <img src={s.image_url} alt={s.title} loading="lazy" />
                  </div>
                )}
                <div class="prose" set:html={s.body}></div>

                {s.expected_res && (
                  <div class="p-step-res p-step-res--ok">
                    <Icon name="check-circle" size={16} />
                    <div>
                      <strong>Expected result:</strong> {s.expected_res}
                    </div>
                  </div>
                )}

                {s.if_fails && (
                  <div class="p-step-res p-step-res--warn">
                    <Icon name="help-circle" size={16} />
                    <div>
                      <strong>If it fails:</strong> {s.if_fails}
                    </div>
                  </div>
                )}

                <div class="p-step-check">
                  <label class="p-step-check__label">
                    <input type="checkbox" class="step-progress-check" data-step-id={s.id || i} />
                    <span>Step completed</span>
                  </label>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- 5. TROUBLESHOOTING -->
    {project.troubleshooting?.length > 0 && (
      <section class="p-sec" id="troubleshooting">
        <h2 class="p-sec__title">Troubleshooting</h2>
        <TroubleTable items={project.troubleshooting} />
      </section>
    )}

    <!-- 6. FILES INCLUDED -->
    {uniqueFiles.length > 0 && (
      <section class="p-sec" id="files">
        <h2 class="p-sec__title">Files included</h2>
        <p class="p-sec__subtext">
          {paid
            ? 'Complete digital asset bundle delivered to your email immediately upon checkout.'
            : 'Available for immediate free download.'}
        </p>

        <div class="p-files-grid">
          {uniqueFiles.map((f: any) => {
            const sz = formatBytes(f.size_bytes);
            return (
              <div class="p-file-item">
                <div class="p-file-item__icon">
                  <Icon
                    name={
                      f.kind === 'code' || f.kind === 'hex' || f.kind === 'sketch'
                        ? 'code'
                        : f.kind === 'schematic'
                        ? 'schematic'
                        : f.kind === 'model' || f.kind === '3d'
                        ? 'cube'
                        : 'doc'
                    }
                    size={22}
                  />
                </div>
                <div class="p-file-item__info">
                  <span class="p-file-item__name">{f.cleanLabel}</span>
                  <div class="p-file-item__meta">
                    <span class="p-file-item__kind">
                      {FILE_KINDS.find((x) => x.key === f.kind)?.label ?? (f.kind || 'File')}
                    </span>
                    {sz && <span class="p-file-item__size">&middot; {sz}</span>}
                  </div>
                </div>

                <div class="p-file-item__action">
                  {f.is_free === 1 ? (
                    <a href={`/api/download/free/${f.id}`} class="btn-file-dl" download>
                      Download <Icon name="download" size={13} />
                    </a>
                  ) : (
                    <span class="file-pack-badge">Pack file</span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- 7. CODE & LICENSE -->
    {(project.code_repo_url || project.license) && (
      <section class="p-sec" id="license">
        <h2 class="p-sec__title">Code & license</h2>
        <div class="p-license-row">
          {project.code_repo_url && (
            <a
              href={project.code_repo_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-license-link"
            >
              <Icon name="github" size={18} /> Open Source GitHub Repository
            </a>
          )}
          {project.license && (
            <div class="p-license-badge">
              <Icon name="doc" size={16} /> License: <strong>{project.license}</strong>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- 8. FAQ -->
    {faqs.length > 0 && (
      <section class="p-sec" id="faq">
        <h2 class="p-sec__title">Frequently asked questions</h2>
        <div class="p-faq-list">
          {faqs.map((f: { q: string; a: string }) => (
            <details class="p-faq-item">
              <summary class="p-faq-q">
                <span>{f.q}</span>
                <Icon name="chevron-down" size={16} />
              </summary>
              <div class="p-faq-a prose">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- AUTHOR & SUPPORT BLOCK -->
    <section class="p-author-block">
      <div class="p-author-img-wrap">
        <img
          src="/brand/profile.jpg"
          alt="Triveni"
          width="120"
          height="120"
          class="p-author-img"
          loading="lazy"
        />
      </div>
      <div class="p-author-content">
        <span class="p-author-label">CREATOR & ENGINEER</span>
        <h3 class="p-author-title">Built and tested by Triveni</h3>
        <p class="p-author-text">
          Every schematic, line of code, and 3D model in this pack was built, tested, and verified on real bench hardware in the Technical Triveni workshop. Need assistance or running into a tricky bring-up issue? Drop me an email anytime.
        </p>
        <a href="mailto:technicaltriveniyt@gmail.com" class="p-author-email">
          <Icon name="mail" size={15} /> technicaltriveniyt@gmail.com
        </a>
      </div>
    </section>

    <!-- RELATED PACKS -->
    {relatedPacks.length > 0 && (
      <section class="p-related-section">
        <h2 class="p-sec__title">Other project packs you might like</h2>
        <div class="p-related-grid">
          {relatedPacks.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </section>
    )}
  </main>

  <!-- MOBILE STICKY BUY BAR (Height 60px) -->
  <div class="mobile-sticky-bar" id="mobile-sticky-bar">
    <div class="mobile-sticky-bar__info">
      <span class="mobile-sticky-bar__title">{project.title}</span>
      <span class="mobile-sticky-bar__price">
        {paid ? formatINR(project.price_inr) : <strong class="text-success">Free</strong>}
      </span>
    </div>
    <button type="button" class="btn-mobile-buy" id="btn-mobile-scroll">
      {paid ? `Buy pack — ${formatINR(project.price_inr)}` : 'Get free files'}
    </button>
  </div>
</div>

<script>
  // Media Viewer thumbnail switcher
  const stage = document.getElementById('media-stage');
  const stageImg = document.getElementById('stage-img') as HTMLImageElement;
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.p-thumb-btn');

  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      thumbBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const ytId = btn.dataset.ytId;
      const mediaUrl = btn.dataset.mediaUrl;
      const mediaType = btn.dataset.mediaType;

      if (!stage) return;

      if (ytId) {
        stage.innerHTML = `<div class="p-stage__yt"><lite-youtube videoid="${ytId}"></lite-youtube></div>`;
      } else if (mediaType === 'model' && mediaUrl) {
        stage.innerHTML = `<model-viewer src="${mediaUrl}" camera-controls auto-rotate shadow-intensity="1" exposure="1.2" class="p-stage__model"></model-viewer>`;
      } else if (mediaUrl) {
        stage.innerHTML = `<img src="${mediaUrl}" alt="Project image" class="p-stage__img" width="800" height="500" />`;
      }
    });
  });

  // Mobile Sticky Buy Bar trigger & scroll
  const buyBox = document.getElementById('main-buy-box');
  const stickyBar = document.getElementById('mobile-sticky-bar');
  const mobileScrollBtn = document.getElementById('btn-mobile-scroll');

  if (buyBox && stickyBar) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting && window.innerWidth <= 900) {
            stickyBar.classList.add('is-visible');
          } else {
            stickyBar.classList.remove('is-visible');
          }
        });
      },
      { threshold: 0.1 }
    );
    observer.observe(buyBox);

    mobileScrollBtn?.addEventListener('click', () => {
      buyBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      const emailInput = document.getElementById('buy-email') as HTMLInputElement;
      if (emailInput) setTimeout(() => emailInput.focus(), 400);
    });
  }

  // Section Nav active pill highlighting on scroll
  const secLinks = document.querySelectorAll<HTMLAnchorElement>('.p-secnav__link');
  const sections = document.querySelectorAll<HTMLElement>('.p-sec');

  window.addEventListener(
    'scroll',
    () => {
      let currentId = '';
      sections.forEach((sec) => {
        const top = sec.offsetTop - 140;
        if (window.scrollY >= top) {
          currentId = sec.getAttribute('id') || '';
        }
      });
      if (currentId) {
        secLinks.forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('href') === `#${currentId}`);
        });
      }
    },
    { passive: true }
  );

  // Step Completion Progress (persisted in localStorage)
  const projBox = document.getElementById('main-buy-box');
  if (projBox && projBox.dataset.projectId) {
    const storageKey = `tt-step-prog-${projBox.dataset.projectId}`;
    let savedSteps: string[] = [];
    try {
      savedSteps = JSON.parse(localStorage.getItem(storageKey) || '[]');
    } catch {}

    const stepChecks = document.querySelectorAll<HTMLInputElement>('.step-progress-check');
    stepChecks.forEach((cb) => {
      const stepId = cb.dataset.stepId || '';
      if (savedSteps.includes(stepId)) {
        cb.checked = true;
        cb.closest('.p-step-card')?.classList.add('is-completed');
      }

      cb.addEventListener('change', () => {
        const card = cb.closest('.p-step-card');
        if (cb.checked) {
          card?.classList.add('is-completed');
          if (!savedSteps.includes(stepId)) savedSteps.push(stepId);
        } else {
          card?.classList.remove('is-completed');
          savedSteps = savedSteps.filter((id) => id !== stepId);
        }
        try {
          localStorage.setItem(storageKey, JSON.stringify(savedSteps));
        } catch {}
      });
    });
  }

  // Checkout and Free Claim logic
  const buyBtn = document.getElementById('btn-buy-submit') as HTMLButtonElement;
  const freeBtn = document.getElementById('btn-free-submit') as HTMLButtonElement;
  const buyBoxContainer = document.getElementById('main-buy-box');

  // Handle Free Claim
  if (freeBtn && buyBoxContainer) {
    freeBtn.addEventListener('click', async () => {
      const emailInput = document.getElementById('buy-email') as HTMLInputElement;
      if (!emailInput || !emailInput.value || !emailInput.checkValidity()) {
        emailInput?.reportValidity();
        return;
      }

      freeBtn.disabled = true;
      freeBtn.innerHTML = `Preparing free files...`;

      try {
        const res = await fetch('/api/download/free-claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            projectId: parseInt(buyBoxContainer.dataset.projectId || '0', 10),
            email: emailInput.value.trim(),
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to claim download');

        buyBoxContainer.innerHTML = `
          <div class="buy-success">
            <div class="buy-success__icon"><svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
            <h3 class="buy-success__title">Free files ready!</h3>
            <p class="buy-success__text">We just emailed the download link to <strong>${emailInput.value}</strong>.</p>
            <a href="${data.redirect || '/account/downloads'}" class="btn-buy-action btn-buy-action--free">Download files now</a>
          </div>
        `;
      } catch (err: any) {
        alert(err.message || 'Error claiming files');
        freeBtn.disabled = false;
        freeBtn.innerHTML = `Get free files &rarr;`;
      }
    });
  }

  // Handle Paid Razorpay Checkout
  if (buyBtn && buyBoxContainer) {
    buyBtn.addEventListener('click', async () => {
      const emailInput = document.getElementById('buy-email') as HTMLInputElement;
      const couponInput = document.getElementById('coupon_code') as HTMLInputElement;

      if (!emailInput || !emailInput.value || !emailInput.checkValidity()) {
        emailInput?.reportValidity();
        return;
      }

      buyBtn.disabled = true;
      buyBtn.innerHTML = `Connecting to checkout...`;

      try {
        const res = await fetch('/api/razorpay/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            projectId: parseInt(buyBoxContainer.dataset.projectId || '0', 10),
            email: emailInput.value.trim(),
            couponCode: couponInput ? couponInput.value.trim() : '',
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to start checkout');

        if (data.alreadyPaid) {
          buyBoxContainer.innerHTML = `
            <div class="buy-success">
              <div class="buy-success__icon"><svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
              <h3 class="buy-success__title">You already own this pack!</h3>
              <p class="buy-success__text">We emailed the fresh download link to <strong>${emailInput.value}</strong>.</p>
              <a href="/account/downloads" class="btn-buy-action">View my downloads</a>
            </div>
          `;
          return;
        }

        const rzp = new (window as any).Razorpay({
          key: data.keyId,
          amount: data.amount,
          currency: 'INR',
          name: 'Technical Triveni',
          description: buyBoxContainer.dataset.slug || 'Project Pack',
          order_id: data.razorpayOrderId,
          handler: async function (response: any) {
            buyBtn.innerHTML = `Verifying payment...`;
            try {
              const vres = await fetch('/api/razorpay/verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  orderId: data.orderId,
                  razorpay_order_id: response.razorpay_order_id,
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_signature: response.razorpay_signature,
                }),
              });
              const vdata = await vres.json();
              if (!vres.ok) throw new Error(vdata.error || 'Verification failed');
              window.location.href = vdata.redirect || '/account/downloads';
            } catch (err: any) {
              alert('Payment confirmed, but session verification failed: ' + err.message);
              window.location.href = '/account/downloads';
            }
          },
          prefill: { email: emailInput.value.trim() },
          theme: { color: '#E92424' },
        });

        rzp.on('payment.failed', function () {
          buyBtn.disabled = false;
          buyBtn.innerHTML = `Buy pack &mdash; ₹${buyBoxContainer.dataset.price}`;
          alert('Payment was cancelled or failed. Please try again.');
        });

        rzp.open();
      } catch (err: any) {
        alert(err.message || 'Error starting payment');
        buyBtn.disabled = false;
        buyBtn.innerHTML = `Buy pack &mdash; ₹${buyBoxContainer.dataset.price}`;
      }
    });
  }
</script>

