---
import Icon from './Icon.astro';
import BomTable from './BomTable.astro';
import TroubleTable from './TroubleTable.astro';
import ProjectCard from './ProjectCard.astro';
import type { ProjectFull, Project } from '../lib/db';
import { formatINR, formatDate, formatBytes, cleanFileName, difficultyClass } from '../lib/format';
import { FILE_KINDS } from '../lib/site';

interface Props {
  project: ProjectFull;
  paid: boolean;
  descHtml: string;
  safetyHtml: string;
  yt?: string | null;
  ratingAvg?: number;
  ratingCount?: number;
  relatedPacks?: Project[];
}

const {
  project,
  paid,
  descHtml,
  safetyHtml,
  yt,
  ratingAvg = 0,
  ratingCount = 0,
  relatedPacks = [],
} = Astro.props;

// Safe array parser
const safeArr = (str: any) => {
  if (!str) return [];
  if (Array.isArray(str)) return str;
  try {
    const arr = JSON.parse(str);
    return Array.isArray(arr) ? arr : [];
  } catch {
    return [];
  }
};

let prereqs = safeArr(project.prereqs_json);
if (prereqs.length === 0) {
  prereqs = ['Soldering basic wires', 'Arduino IDE installed on computer'];
}

let outcomes = safeArr(project.outcomes_json);
if (outcomes.length === 0) {
  outcomes = [
    'Build a custom 6-channel remote and receiver',
    'Wire a flight controller from scratch without guessing pinouts',
    'Learn nRF24 radio pairing and SPI diagnostics',
    'Calibrate sensors and check motor directions safely on the bench',
  ];
}

const notIncluded = safeArr(project.not_included_json);
const faqs = safeArr(project.faq_json);

// Files count & classification
const filesList = project.files || [];
const uniqueFiles = filesList.reduce((acc, f) => {
  const clean = cleanFileName(f.label, f.kind);
  const key = `${clean}_${f.url || f.id}`;
  if (!acc.map.has(key)) {
    acc.map.set(key, true);
    acc.list.push({ ...f, cleanLabel: clean });
  }
  return acc;
}, { map: new Map<string, boolean>(), list: [] as any[] }).list;

const codeCount = uniqueFiles.filter((f) => f.kind === 'code' || f.kind === 'hex' || f.kind === 'sketch').length;
const schematicCount = uniqueFiles.filter((f) => f.kind === 'schematic').length;
const modelCount = uniqueFiles.filter((f) => f.kind === 'model' || f.kind === '3d').length;
const pdfCount = uniqueFiles.filter((f) => f.kind === 'pdf' || f.kind === 'doc').length;
const hasBom = (project.bom && project.bom.length > 0);

// Media gallery assembly
const rawImages = (project.images || []).map((img, i) => ({
  id: `img-${img.id || i}`,
  type: img.kind === 'model' ? 'model' : 'image',
  url: img.url,
  caption: img.caption || project.title,
}));

if (rawImages.length === 0 && project.cover_image) {
  rawImages.push({
    id: 'cover',
    type: 'image',
    url: project.cover_image,
    caption: project.title,
  });
}

const mediaList = [...rawImages];
const firstMedia = mediaList[0] || { type: 'image', url: project.cover_image || '/og-default.png', caption: project.title };

const mobileSlides = [
  ...mediaList.map((m) => ({
    type: m.type,
    url: m.url,
    caption: m.caption,
    ytId: '',
  })),
  ...(yt ? [{ type: 'yt', ytId: yt, caption: 'Video Tutorial', url: '' }] : []),
];
if (mobileSlides.length === 0 && project.cover_image) {
  mobileSlides.push({
    type: 'image',
    url: project.cover_image,
    caption: project.title,
    ytId: '',
  });
}

// Group Pins by Module
const groupedPins = (project.pins || []).reduce((acc, pin) => {
  const m = pin.module || 'General';
  if (!acc[m]) acc[m] = [];
  acc[m].push(pin);
  return acc;
}, {} as Record<string, typeof project.pins>);

// Distinct modules/boards across diagrams and pin connections
const wiringModules = Array.from(new Set([
  ...(project.wiring_diagrams || []).map((d: any) => d.module?.trim()).filter(Boolean),
  ...(project.pins || []).map((p: any) => p.module?.trim()).filter(Boolean)
] as string[])).filter(m => m.toLowerCase() !== 'general');

const lastUpdated = formatDate(project.updated_at);
---

<div class="project-layout" data-project-id={project.id} data-slug={project.slug} data-paid={paid ? '1' : '0'}>
  <!-- ==================== DESKTOP SHELL (>= 1024px, media_1791937885596_788dad57.png) ==================== -->
  <div class="desktop-pack-wrap desktop-pack-only">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="p-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="p-crumbs__sep">/</span>
        <a href="/projects">Projects</a>
        <span class="p-crumbs__sep">/</span>
        <a href={`/projects?cat=${encodeURIComponent(project.category || 'All')}`} class="p-crumbs__cat">{project.category || 'Electronics'}</a>
        <span class="p-crumbs__sep">/</span>
        <span class="p-crumbs__current">{project.title}</span>
      </nav>

      <!-- Two-Column Main Layout: Left Column (Content) + Right Column (Sticky Buy Box) -->
      <div class="p-desktop-grid">
        <!-- LEFT COLUMN -->
        <div class="p-col-main">
          <!-- Eyebrow, Title & Summary -->
          <div class="p-header-block">
            <span class="p-eyebrow">{project.category || 'ELECTRONICS'}</span>
            <h1 class="p-title">{project.title}</h1>
            {project.summary && <p class="p-summary">{project.summary}</p>}

            <!-- Meta Chips Row -->
            <div class="p-meta-chips">
              {project.difficulty && (
                <span class="p-meta-chip">{project.difficulty}</span>
              )}
              <span class="p-meta-chip">{project.build_time || '2 hrs'}</span>
              <span class="p-meta-chip">Updated {lastUpdated}</span>
            </div>
          </div>

          <!-- Main Gallery Stage (16:9 Cover / 3D / Video) -->
          <div class="p-gallery-stage-wrap">
            <div class="p-stage" id="media-stage">
              {firstMedia.type === 'model' ? (
                <model-viewer
                  src={firstMedia.url}
                  camera-controls
                  auto-rotate
                  shadow-intensity="1"
                  exposure="1.2"
                  class="p-stage__model"
                  alt={`3D Model of ${project.title}`}
                ></model-viewer>
              ) : firstMedia.type === 'yt' ? (
                <div class="p-stage__yt">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${firstMedia.ytId}?rel=0&modestbranding=1`}
                    title="Project Video Demonstration"
                    class="p-stage__iframe"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                </div>
              ) : (
                <img
                  src={firstMedia.url}
                  alt={firstMedia.caption || project.title}
                  class="p-stage__img"
                  id="stage-img"
                  width="800"
                  height="450"
                  loading="eager"
                />
              )}
            </div>

            <!-- Thumbnail Strip Below Main Image -->
            {(mediaList.length > 1 || yt) && (
              <div class="p-thumbs" role="tablist" aria-label="Media thumbnails">
                {mediaList.map((m, i) => (
                  <button
                    type="button"
                    class:list={['p-thumb-btn', { 'is-active': i === 0 }]}
                    data-media-url={m.url}
                    data-media-type={m.type}
                    aria-label={`View image ${i + 1}`}
                  >
                    {m.type === 'model' ? (
                      <div class="p-thumb-icon"><Icon name="cube" size={16} /></div>
                    ) : (
                      <img src={m.url} alt="" width="68" height="42" loading="lazy" />
                    )}
                  </button>
                ))}
                {yt && (
                  <button
                    type="button"
                    class="p-thumb-btn p-thumb-btn--yt"
                    data-yt-id={yt}
                    aria-label="View video demonstration"
                  >
                    <img
                      src={`https://img.youtube.com/vi/${yt}/mqdefault.jpg`}
                      alt="Video demonstration"
                      width="68"
                      height="42"
                      loading="lazy"
                    />
                    <div class="p-thumb-icon p-thumb-icon--yt">
                      <Icon name="play" size={16} />
                    </div>
                  </button>
                )}
              </div>
            )}
          </div>

          <!-- Underline Tabs Nav (Overview, Parts list, Wiring, Build steps) -->
          <nav class="p-underline-tabs" role="tablist" aria-label="Project details sections">
            <button type="button" class="p-tab-btn is-active" data-tab-target="overview" role="tab" aria-selected="true">
              Overview
            </button>
            {hasBom && (
              <button type="button" class="p-tab-btn" data-tab-target="parts" role="tab" aria-selected="false">
                Parts list
              </button>
            )}
            {(project.pins?.length > 0 || project.wiring_diagrams?.length > 0) && (
              <button type="button" class="p-tab-btn" data-tab-target="wiring" role="tab" aria-selected="false">
                Wiring
              </button>
            )}
            {project.steps?.length > 0 && (
              <button type="button" class="p-tab-btn" data-tab-target="steps" role="tab" aria-selected="false">
                Build steps
              </button>
            )}
          </nav>

          <!-- Tab Panels Container -->
          <div class="p-tab-panels">
            <!-- 1. OVERVIEW PANEL -->
            <div class="p-panel-content is-active" id="panel-overview" data-tab-panel="overview">
              <!-- Safety Note Card (Warm #FFF6E0, border #FDE68A, text #5E3B00) -->
              {safetyHtml && (
                <div class="p-safety-card">
                  <div class="p-safety-card__head">
                    <Icon name="shield" size={18} />
                    <span class="p-safety-card__lead">Safety first, read before building.</span>
                  </div>
                  <div class="p-safety-card__body prose" set:html={safetyHtml}></div>
                </div>
              )}

              <!-- What You Will Build and Learn (2x2 Grid with Red Check Icons) -->
              {outcomes.length > 0 && (
                <div class="p-outcomes-section">
                  <h3 class="p-panel-h3">What you will build and learn</h3>
                  <div class="p-outcomes-grid">
                    {outcomes.map((item: string) => (
                      <div class="p-outcome-card">
                        <span class="p-outcome-icon">
                          <Icon name="check-circle" size={16} />
                        </span>
                        <span class="p-outcome-text">{item}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <!-- Prerequisites Card -->
              {prereqs.length > 0 && (
                <div class="p-prereqs-card">
                  <h4 class="p-prereqs-title">Prerequisites</h4>
                  <p class="p-prereqs-text">{prereqs.join(', ')}</p>
                </div>
              )}

              <!-- Description Body -->
              {descHtml && (
                <div class="p-desc-section">
                  <div class="prose p-desc-prose" set:html={descHtml}></div>
                </div>
              )}

              <!-- Files Included List -->
              {uniqueFiles.length > 0 && (
                <div class="p-files-summary">
                  <h4 class="p-panel-h3">Files included in this pack</h4>
                  <div class="p-files-grid">
                    {uniqueFiles.map((f: any) => {
                      const sz = formatBytes(f.size_bytes);
                      return (
                        <div class="p-file-row">
                          <span class="p-file-icon"><Icon name={f.kind === 'code' ? 'code' : f.kind === 'model' ? 'cube' : 'doc'} size={16} /></span>
                          <span class="p-file-name">{f.cleanLabel}</span>
                          {sz && <span class="p-file-size">{sz}</span>}
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}

              <!-- Code Repo / License (if present) -->
              {(project.code_repo_url || project.license) && (
                <div class="p-license-box">
                  {project.code_repo_url && (
                    <a href={project.code_repo_url} target="_blank" rel="noopener noreferrer" class="p-license-link">
                      <Icon name="github" size={16} /> Open source repository
                    </a>
                  )}
                  {project.license && (
                    <span class="p-license-text">License: <strong>{project.license}</strong></span>
                  )}
                </div>
              )}
            </div>

            <!-- 2. PARTS LIST PANEL -->
            {hasBom && (
              <div class="p-panel-content" id="panel-parts" data-tab-panel="parts" hidden>
                <BomTable items={project.bom} projectId={project.id} projectTitle={project.title} />
              </div>
            )}

            <!-- 3. WIRING & CONNECTIONS PANEL -->
            {(project.pins?.length > 0 || project.wiring_diagrams?.length > 0) && (
              <div class="p-panel-content" id="panel-wiring" data-tab-panel="wiring" hidden>
                <div class="p-wiring-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem;">
                  <div>
                    <h3 class="p-panel-h3" style="margin: 0;">Wiring & circuit connections</h3>
                    <p style="font-size: max(12px, 0.8438rem); color: var(--ink-2); margin: 0.25rem 0 0 0;">Follow the exact circuit connections and pinouts for your board.</p>
                  </div>
                  {wiringModules.length > 1 && (
                    <div class="p-module-filter-bar">
                      <span class="p-module-filter-label">Select Board:</span>
                      <div class="p-module-filter-pills" role="tablist">
                        <button type="button" class="p-module-pill is-active" data-module-filter="all">All Boards</button>
                        {wiringModules.map((mod) => (
                          <button type="button" class="p-module-pill" data-module-filter={mod.toLowerCase()}>{mod}</button>
                        ))}
                      </div>
                    </div>
                  )}
                </div>

                {wiringModules.length > 1 && (
                  <div class="p-module-info-alert">
                    <Icon name="spark" size={16} />
                    <span>Multiple boards supported for this project. Select your board above (e.g. <strong>{wiringModules.join(' vs ')}</strong>) to view the matching pinout & circuit schematic so you don't wire pins incorrectly.</span>
                  </div>
                )}

                {project.wiring_diagrams && project.wiring_diagrams.length > 0 && (
                  <div class="p-wiring-diagrams">
                    {project.wiring_diagrams.map((d) => (
                      <figure class="p-wiring-fig" data-wiring-module={(d.module || '').toLowerCase().trim()}>
                        <div class="p-wiring-fig-head">
                          {d.module && <span class="p-wiring-module-badge">{d.module}</span>}
                          {d.label && <span class="p-wiring-title">{d.label}</span>}
                        </div>
                        <img src={d.url} alt={d.label || 'Wiring diagram'} loading="lazy" />
                      </figure>
                    ))}
                  </div>
                )}

                {Object.entries(groupedPins).map(([moduleName, pins]) => (
                  <div class="p-pin-module-block" data-pin-module={moduleName.toLowerCase().trim()}>
                    <div class="p-pin-module-header">
                      <h4 class="p-pin-module-title">{moduleName} Connections</h4>
                      {moduleName.toLowerCase() !== 'general' && <span class="p-wiring-module-badge">{moduleName}</span>}
                    </div>
                    <div class="p-wiring-desktop">
                      <table class="p-wiring-table">
                        <thead>
                          <tr>
                            <th>From Pin / Component</th>
                            <th>To Pin / Board</th>
                            <th>Connection Note</th>
                          </tr>
                        </thead>
                        <tbody>
                          {pins.map((p) => (
                            <tr>
                              <td class="font-mono font-bold">{p.from_pin}</td>
                              <td class="font-mono">{p.to_pin}</td>
                              <td class="text-ink-2">{p.note || '—'}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                ))}
              </div>
            )}

            <!-- 4. BUILD STEPS PANEL -->
            {project.steps?.length > 0 && (
              <div class="p-panel-content" id="panel-steps" data-tab-panel="steps" hidden>
                <div class="p-steps-progress-top">
                  <div class="p-steps-prog-labels">
                    <span class="p-steps-prog-title" id="desktop-prog-title">0 of {project.steps.length} steps completed</span>
                    <span class="p-steps-prog-pct" id="desktop-prog-pct">0%</span>
                  </div>
                  <div class="p-steps-prog-bar">
                    <div class="p-steps-prog-fill" id="desktop-prog-fill" style="width: 0%;"></div>
                  </div>
                </div>

                <div class="p-steps-stack">
                  {project.steps.map((s, i) => (
                    <article class:list={['p-step-accordion', { 'is-open': i === 0 }]} data-step-id={s.id || i}>
                      <div class="p-step-accordion__header">
                        <span class="p-step-num-badge">{i + 1}</span>
                        <div class="p-step-header-text">
                          <h4 class="p-step-heading">{s.title}</h4>
                          {s.goal && <p class="p-step-goal">Goal: {s.goal}</p>}
                        </div>
                        {s.time_est && (
                          <span class="p-step-est"><Icon name="clock" size={13} /> {s.time_est}</span>
                        )}
                        <span class="p-step-chevron">
                          <Icon name="chevron-down" size={16} />
                        </span>
                      </div>

                      <div class="p-step-accordion__body">
                        {s.image_url && (
                          <div class="p-step-media">
                            <img src={s.image_url} alt={s.title} loading="lazy" />
                          </div>
                        )}
                        <div class="prose" set:html={s.body}></div>

                        {s.expected_res && (
                          <div class="p-step-feedback p-step-feedback--ok">
                            <Icon name="check-circle" size={15} />
                            <div><strong>Expected result:</strong> {s.expected_res}</div>
                          </div>
                        )}

                        {s.if_fails && (
                          <div class="p-step-feedback p-step-feedback--warn">
                            <Icon name="help-circle" size={15} />
                            <div><strong>If it fails:</strong> {s.if_fails}</div>
                          </div>
                        )}

                        <div class="p-step-footer-check">
                          <label class="p-step-check-label">
                            <input type="checkbox" class="step-progress-check" data-step-id={s.id || i} />
                            <span>Step completed</span>
                          </label>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- RIGHT COLUMN: Sticky 400px Buy Card -->
        <aside class="p-col-sidebar">
          <div class="p-sticky-card" id="main-buy-box">
            {paid ? (
              <div class="buy-card-inner">
                <span class="buy-card-eyebrow">DIGITAL PROJECT PACK</span>
                <div class="buy-card-price-row">
                  <span class="buy-card-price">{formatINR(project.price_inr)}</span>
                  <span class="buy-card-price-sub">one-time purchase, instant access</span>
                </div>

                <div class="buy-card-bullets">
                  <div class="buy-card-bullet">
                    <span class="buy-card-icon"><Icon name="code" size={15} /></span>
                    <span>{codeCount > 0 ? codeCount : 2} tested source code files</span>
                  </div>
                  <div class="buy-card-bullet">
                    <span class="buy-card-icon"><Icon name="cart" size={15} /></span>
                    <span>Verified parts list with direct buy links</span>
                  </div>
                </div>

                <form class="buy-card-form" id="desktop-checkout-form" onsubmit="return false;">
                  <div class="buy-card-field">
                    <label for="desktop-buy-email" class="buy-card-label">Your email address</label>
                    <input
                      type="email"
                      id="desktop-buy-email"
                      class="buy-card-input"
                      placeholder="name@example.com"
                      required
                      autocomplete="email"
                    />
                  </div>

                  <div class="buy-card-coupon-row">
                    <button type="button" class="buy-coupon-toggle" id="btn-desktop-coupon-toggle">
                      Have a discount code?
                    </button>
                    <div class="buy-coupon-input-wrap" id="desktop-coupon-box" hidden>
                      <input
                        type="text"
                        id="desktop-coupon-input"
                        class="buy-card-input buy-card-input--sm"
                        placeholder="Discount code"
                        autocomplete="off"
                      />
                    </div>
                  </div>

                  <button type="button" class="btn-buy-primary" id="btn-desktop-buy-submit">
                    <Icon name="lock" size={16} /> Buy pack, {formatINR(project.price_inr)}
                  </button>
                </form>

                <div class="buy-card-trust">
                  <div class="trust-line">Secure checkout via Razorpay: UPI, cards, net banking</div>
                  <div class="trust-line">7-day build guarantee, direct email support</div>
                  <div class="trust-line">Download link sent to your email right away</div>
                </div>
              </div>
            ) : (
              <div class="buy-card-inner">
                <span class="buy-card-eyebrow buy-card-eyebrow--free">FREE DIGITAL RESOURCE</span>
                <div class="buy-card-price-row">
                  <span class="buy-card-price">Free</span>
                  <span class="buy-card-price-sub">All resources for this project are free</span>
                </div>

                <p class="buy-free-text">
                  Enter your email address to receive immediate direct download links for the full project assets.
                </p>

                <form class="buy-card-form" id="desktop-free-form" onsubmit="return false;">
                  <div class="buy-card-field">
                    <label for="desktop-free-email" class="buy-card-label">Your email address</label>
                    <input
                      type="email"
                      id="desktop-free-email"
                      class="buy-card-input"
                      placeholder="name@example.com"
                      required
                      autocomplete="email"
                    />
                  </div>

                  <button type="button" class="btn-buy-primary" id="btn-desktop-free-submit">
                    <Icon name="download" size={16} /> Download pack files
                  </button>
                </form>

                <div class="buy-card-trust">
                  <div class="trust-line">Instant direct download link sent to your inbox</div>
                  <div class="trust-line">100% free open hardware resource</div>
                </div>
              </div>
            )}
          </div>
        </aside>
      </div>
    </div>
  </div>

  <!-- ==================== MOBILE SHELL (<= 768px, media_1791876192118_f7595c00.png) ==================== -->
  <div class="mobile-pack-wrap m-pack-only">
    <!-- Top Bar: Back to Category + Share Icon -->
    <div class="m-topbar">
      <a href={`/projects?cat=${encodeURIComponent(project.category || 'All')}`} class="m-topbar-back">
        <Icon name="chevron-left" size={20} />
        <span>{project.category || 'Electronics'}</span>
      </a>
      <button type="button" class="m-topbar-share" id="btn-m-share" aria-label="Share project">
        <Icon name="share" size={20} />
      </button>
    </div>

    <!-- Full-Bleed Swipe Gallery with 1 / N Pill Counter -->
    <div class="m-gallery-container">
      <div class="m-gallery-scroll" id="m-gallery-scroll">
        {mobileSlides.map((s, idx) => (
          <div class="m-gallery-slide">
            {s.type === 'yt' ? (
              <div class="m-slide-yt">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${s.ytId}?rel=0&modestbranding=1`}
                  title="Project Video Demonstration"
                  class="m-slide-iframe"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              </div>
            ) : s.type === 'model' ? (
              <model-viewer
                src={s.url}
                camera-controls
                auto-rotate
                shadow-intensity="1"
                exposure="1.2"
                class="m-slide-model"
                alt={`3D Model of ${project.title}`}
              ></model-viewer>
            ) : (
              <img
                src={s.url}
                alt={s.caption || project.title}
                width="800"
                height="450"
                loading={idx === 0 ? 'eager' : 'lazy'}
                class="m-slide-img"
              />
            )}
          </div>
        ))}
      </div>
      {mobileSlides.length > 1 && (
        <div class="m-gallery-pill" id="m-gallery-pill">
          1 / {mobileSlides.length}
        </div>
      )}
    </div>

    <!-- Title, Chips & Summary -->
    <div class="m-info-block">
      <h1 class="m-title">{project.title}</h1>

      <div class="m-chips-row">
        {project.difficulty && (
          <span class="m-chip">{project.difficulty}</span>
        )}
        <span class="m-chip">{project.build_time || '2 hrs'}</span>
      </div>

      {project.summary && (
        <p class="m-summary">{project.summary}</p>
      )}
    </div>

    <!-- Sticky Tab Chips Track (Overview, Parts list, Wiring, Build steps) -->
    <nav class="m-sticky-chips-nav" id="m-sticky-chips" aria-label="Sections">
      <div class="m-chips-track">
        <button type="button" class="m-chip-btn is-active" data-mobile-tab="overview">
          Overview
        </button>
        {hasBom && (
          <button type="button" class="m-chip-btn" data-mobile-tab="parts">
            Parts list
          </button>
        )}
        {(project.pins?.length > 0 || project.wiring_diagrams?.length > 0) && (
          <button type="button" class="m-chip-btn" data-mobile-tab="wiring">
            Wiring
          </button>
        )}
        {project.steps?.length > 0 && (
          <button type="button" class="m-chip-btn" data-mobile-tab="steps">
            Build steps
          </button>
        )}
      </div>
    </nav>

    <!-- Mobile Panel Contents -->
    <div class="m-content-panels">
      <!-- 1. OVERVIEW (Mobile) -->
      <div class="m-panel is-active" id="m-panel-overview" data-m-panel="overview">
        {safetyHtml && (
          <div class="m-safety-card">
            <span class="m-safety-bold">Safety first, read before building.</span>
            <div class="m-safety-text prose" set:html={safetyHtml}></div>
          </div>
        )}

        {outcomes.length > 0 && (
          <div class="m-outcomes-block">
            <h3 class="m-section-heading">What you will build and learn</h3>
            <div class="m-outcomes-list">
              {outcomes.map((item: string) => (
                <div class="m-outcome-item">
                  <span class="m-outcome-check"><Icon name="check-circle" size={16} /></span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {prereqs.length > 0 && (
          <div class="m-prereqs-card">
            <h4 class="m-prereqs-title">Prerequisites</h4>
            <p class="m-prereqs-body">{prereqs.join(', ')}</p>
          </div>
        )}

        {descHtml && (
          <div class="m-desc-prose prose" set:html={descHtml}></div>
        )}
      </div>

      <!-- 2. PARTS LIST (Mobile, media_1791876192124_8bdf7be7.png) -->
      {hasBom && (
        <div class="m-panel" id="m-panel-parts" data-m-panel="parts" hidden>
          <BomTable items={project.bom} projectId={project.id} projectTitle={project.title} />
        </div>
      )}

      <!-- 3. WIRING (Mobile) -->
      {(project.pins?.length > 0 || project.wiring_diagrams?.length > 0) && (
        <div class="m-panel" id="m-panel-wiring" data-m-panel="wiring" hidden>
          <div class="m-wiring-top">
            <h3 class="m-section-heading">Wiring connections</h3>
            {wiringModules.length > 1 && (
              <div class="p-module-filter-bar" style="margin-top: 0.625rem; margin-bottom: 0.75rem; width: 100%; overflow-x: auto;">
                <span class="p-module-filter-label">Board:</span>
                <div class="p-module-filter-pills" role="tablist">
                  <button type="button" class="p-module-pill is-active" data-module-filter="all">All</button>
                  {wiringModules.map((mod) => (
                    <button type="button" class="p-module-pill" data-module-filter={mod.toLowerCase()}>{mod}</button>
                  ))}
                </div>
              </div>
            )}
          </div>
          {wiringModules.length > 1 && (
            <div class="p-module-info-alert" style="margin-bottom: 0.875rem; font-size: max(12px, 0.7813rem);">
              <Icon name="spark" size={14} />
              <span>Select your board above to view the matching wiring for your code.</span>
            </div>
          )}

          {project.wiring_diagrams && project.wiring_diagrams.length > 0 && (
            <div class="m-wiring-imgs">
              {project.wiring_diagrams.map((d) => (
                <figure class="m-wiring-fig" data-wiring-module={(d.module || '').toLowerCase().trim()}>
                  <div class="p-wiring-fig-head">
                    {d.module && <span class="p-wiring-module-badge">{d.module}</span>}
                    {d.label && <span class="p-wiring-title">{d.label}</span>}
                  </div>
                  <img src={d.url} alt={d.label || 'Wiring diagram'} loading="lazy" />
                </figure>
              ))}
            </div>
          )}

          {Object.entries(groupedPins).map(([moduleName, pins]) => (
            <div class="m-pin-module-section" data-pin-module={moduleName.toLowerCase().trim()}>
              <div class="p-pin-module-header">
                <h4 class="m-pin-module-h4">{moduleName}</h4>
                {moduleName.toLowerCase() !== 'general' && <span class="p-wiring-module-badge">{moduleName}</span>}
              </div>
              <div class="m-pin-cards">
                {pins.map((p) => (
                  <div class="m-pin-card">
                    <div class="m-pin-row">
                      <span class="m-pin-name font-mono">{p.from_pin}</span>
                      <span class="m-pin-arrow">&rarr;</span>
                      <span class="m-pin-dest font-mono">{p.to_pin}</span>
                    </div>
                    {p.note && p.note !== '—' && (
                      <div class="m-pin-note">{p.note}</div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}

      <!-- 4. BUILD STEPS (Mobile) -->
      {project.steps?.length > 0 && (
        <div class="m-panel" id="m-panel-steps" data-m-panel="steps" hidden>
          <div class="m-steps-progress-box">
            <div class="m-steps-prog-top">
              <span class="m-steps-prog-title" id="m-prog-title">0 of {project.steps.length} steps completed</span>
              <span class="m-steps-prog-pct" id="m-prog-pct">0%</span>
            </div>
            <div class="m-steps-prog-track">
              <div class="m-steps-prog-fill" id="m-prog-fill" style="width: 0%;"></div>
            </div>
          </div>

          <div class="m-steps-stack">
            {project.steps.map((s, i) => (
              <article class:list={['m-step-card', { 'is-open': i === 0 }]} data-m-step-id={s.id || i}>
                <div class="m-step-card__head">
                  <span class="m-step-pill">{i + 1}</span>
                  <div class="m-step-title-col">
                    <h4 class="m-step-name">{s.title}</h4>
                    {s.goal && <p class="m-step-goal">Goal: {s.goal}</p>}
                  </div>
                  <span class="m-step-chevron"><Icon name="chevron-down" size={16} /></span>
                </div>

                <div class="m-step-card__body">
                  {s.image_url && (
                    <div class="m-step-img"><img src={s.image_url} alt={s.title} loading="lazy" /></div>
                  )}
                  <div class="prose" set:html={s.body}></div>

                  {s.expected_res && (
                    <div class="m-step-alert m-step-alert--ok">
                      <Icon name="check-circle" size={15} />
                      <div><strong>Expected:</strong> {s.expected_res}</div>
                    </div>
                  )}

                  {s.if_fails && (
                    <div class="m-step-alert m-step-alert--warn">
                      <Icon name="help-circle" size={15} />
                      <div><strong>If fails:</strong> {s.if_fails}</div>
                    </div>
                  )}

                  <div class="m-step-check-row">
                    <label class="m-step-check-label">
                      <input type="checkbox" class="step-progress-check m-step-check-box" data-step-id={s.id || i} />
                      <span>Step completed</span>
                    </label>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Sticky Bottom Bar (media_1791876192118_f7595c00.png) -->
    <div class="m-sticky-bottom-bar">
      <div class="m-sticky-price-col">
        <span class="m-sticky-price">{paid ? formatINR(project.price_inr) : 'Free'}</span>
        <span class="m-sticky-sub">One-time, instant access</span>
      </div>
      <button type="button" class="btn-m-buy" id="btn-open-m-sheet">
        {paid ? 'Buy pack' : 'Get free files'}
      </button>
    </div>

    <!-- Bottom Sheet Modal (media_1791876192114_cad8732e.png) -->
    <div class="m-sheet-overlay" id="m-sheet-overlay" aria-hidden="true">
      <div class="m-sheet-panel" id="m-sheet-panel" role="dialog" aria-modal="true">
        <div class="m-sheet-handle-wrap">
          <div class="m-sheet-handle"></div>
        </div>

        <div class="m-sheet-header-row">
          <div class="m-sheet-title-col">
            <span class="m-sheet-eyebrow">{paid ? 'Digital project pack' : 'Free digital resource'}</span>
            <div class="m-sheet-price-lead">
              <span class="m-sheet-price">{paid ? formatINR(project.price_inr) : 'Free'}</span>
              <span class="m-sheet-price-sub">one-time, instant access</span>
            </div>
          </div>
          <button type="button" class="m-sheet-close-btn" id="btn-close-m-sheet" aria-label="Close modal">
            <Icon name="close" size={18} />
          </button>
        </div>

        <div class="m-sheet-bullets">
          <div class="m-sheet-bullet">
            <span class="m-sheet-b-icon"><Icon name="code" size={15} /></span>
            <span>{codeCount > 0 ? codeCount : 2} tested source code files</span>
          </div>
          <div class="m-sheet-bullet">
            <span class="m-sheet-b-icon"><Icon name="cart" size={15} /></span>
            <span>Verified parts list with direct buy links</span>
          </div>
        </div>

        <form class="m-sheet-form" id="m-sheet-checkout-form" onsubmit="return false;">
          <div class="m-sheet-field">
            <label for="m-sheet-email" class="m-sheet-label">Your email address</label>
            <input
              type="email"
              id="m-sheet-email"
              class="m-sheet-input"
              placeholder="name@example.com"
              required
              autocomplete="email"
            />
          </div>

          {paid && (
            <div class="m-sheet-coupon-wrap">
              <button type="button" class="m-sheet-coupon-toggle" id="btn-m-coupon-toggle">
                Have a discount code?
              </button>
              <div class="m-sheet-coupon-input-wrap" id="m-coupon-box" hidden>
                <input
                  type="text"
                  id="m-sheet-coupon-input"
                  class="m-sheet-input m-sheet-input--sm"
                  placeholder="Discount code"
                  autocomplete="off"
                />
              </div>
            </div>
          )}

          <button type="button" class="btn-m-sheet-pay" id="btn-m-sheet-submit">
            {paid ? (
              <><Icon name="lock" size={16} /> Pay {formatINR(project.price_inr)}</>
            ) : (
              <><Icon name="download" size={16} /> Get free files &rarr;</>
            )}
          </button>
        </form>

        <div class="m-sheet-trust-lines">
          <div class="m-trust-item">Secure checkout via Razorpay: UPI, cards, net banking</div>
          <div class="m-trust-item">7-day build guarantee, direct email support</div>
          <div class="m-trust-item">Download link sent to your email right away</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== RELATED PACKS SECTION (Full Width) ==================== -->
  {relatedPacks.length > 0 && (
    <section class="p-related-section">
      <div class="container">
        <h2 class="p-related-h2">Other project packs you might like</h2>
        <div class="p-related-grid">
          {relatedPacks.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </div>
    </section>
  )}
</div>

<script>
  // ==================== TAB SWITCHING (Desktop & Mobile) ====================
  const desktopTabBtns = document.querySelectorAll<HTMLButtonElement>('.p-tab-btn');
  const desktopPanels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');
  const mobileTabBtns = document.querySelectorAll<HTMLButtonElement>('.m-chip-btn');
  const mobilePanels = document.querySelectorAll<HTMLElement>('[data-m-panel]');

  function activateTab(tabKey: string) {
    // Desktop tabs & panels
    desktopTabBtns.forEach((btn) => {
      const active = btn.dataset.tabTarget === tabKey;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    desktopPanels.forEach((panel) => {
      const match = panel.dataset.tabPanel === tabKey;
      panel.hidden = !match;
      panel.classList.toggle('is-active', match);
    });

    // Mobile tabs & panels
    mobileTabBtns.forEach((btn) => {
      const active = btn.dataset.mobileTab === tabKey;
      btn.classList.toggle('is-active', active);
    });
    mobilePanels.forEach((panel) => {
      const match = panel.dataset.mPanel === tabKey;
      panel.hidden = !match;
      panel.classList.toggle('is-active', match);
    });
  }

  desktopTabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (btn.dataset.tabTarget) activateTab(btn.dataset.tabTarget);
    });
  });

  mobileTabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (btn.dataset.mobileTab) activateTab(btn.dataset.mobileTab);
    });
  });

  // ==================== WIRING MODULE FILTER ====================
  const moduleFilterPills = document.querySelectorAll<HTMLButtonElement>('.p-module-pill');
  moduleFilterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const selected = (pill.dataset.moduleFilter || 'all').toLowerCase();
      // Update active state across all pills with matching filter
      moduleFilterPills.forEach((p) => {
        p.classList.toggle('is-active', (p.dataset.moduleFilter || 'all').toLowerCase() === selected);
      });

      // Filter wiring diagrams
      const diagrams = document.querySelectorAll<HTMLElement>('.p-wiring-fig, .m-wiring-fig');
      diagrams.forEach((fig) => {
        const mod = (fig.dataset.wiringModule || '').toLowerCase();
        if (selected === 'all' || !mod || mod === selected) {
          fig.style.display = '';
        } else {
          fig.style.display = 'none';
        }
      });

      // Filter pin module blocks
      const pinBlocks = document.querySelectorAll<HTMLElement>('.p-pin-module-block, .m-pin-module-section');
      pinBlocks.forEach((block) => {
        const mod = (block.dataset.pinModule || '').toLowerCase();
        if (selected === 'all' || mod === 'general' || mod === selected) {
          block.style.display = '';
        } else {
          block.style.display = 'none';
        }
      });
    });
  });

  // ==================== DESKTOP GALLERY THUMBNAILS ====================
  const mediaStage = document.getElementById('media-stage');
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.p-thumb-btn');

  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      thumbBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const ytId = btn.dataset.ytId;
      const mediaUrl = btn.dataset.mediaUrl;
      const mediaType = btn.dataset.mediaType;

      if (!mediaStage) return;
      if (ytId) {
        mediaStage.innerHTML = `<div class="p-stage__yt" style="width:100%;height:100%;"><iframe src="https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0&modestbranding=1" title="Project Video Demonstration" class="p-stage__iframe" style="width:100%;height:100%;border:0;display:block;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>`;
      } else if (mediaType === 'model' && mediaUrl) {
        mediaStage.innerHTML = `<model-viewer src="${mediaUrl}" camera-controls auto-rotate shadow-intensity="1" exposure="1.2" class="p-stage__model"></model-viewer>`;
      } else if (mediaUrl) {
        mediaStage.innerHTML = `<img src="${mediaUrl}" alt="Project image" class="p-stage__img" width="800" height="450" />`;
      }
    });
  });

  // ==================== MOBILE GALLERY COUNTER ====================
  const mGalleryScroll = document.getElementById('m-gallery-scroll');
  const mGalleryPill = document.getElementById('m-gallery-pill');
  if (mGalleryScroll && mGalleryPill) {
    const slides = mGalleryScroll.querySelectorAll('.m-gallery-slide');
    const total = slides.length;
    mGalleryScroll.addEventListener(
      'scroll',
      () => {
        const slideW = mGalleryScroll.clientWidth || 1;
        const idx = Math.min(total, Math.max(1, Math.round(mGalleryScroll.scrollLeft / slideW) + 1));
        mGalleryPill.textContent = `${idx} / ${total}`;
      },
      { passive: true }
    );
  }

  // ==================== SHARE BUTTON ====================
  const shareBtn = document.getElementById('btn-m-share');
  shareBtn?.addEventListener('click', async () => {
    if (navigator.share) {
      try {
        await navigator.share({ title: document.title, url: window.location.href });
      } catch {}
    } else {
      try {
        await navigator.clipboard.writeText(window.location.href);
        alert('Link copied to clipboard!');
      } catch {
        prompt('Copy project link:', window.location.href);
      }
    }
  });

  // ==================== MOBILE BOTTOM SHEET MODAL ====================
  const sheetOverlay = document.getElementById('m-sheet-overlay');
  const openSheetBtn = document.getElementById('btn-open-m-sheet');
  const closeSheetBtn = document.getElementById('btn-close-m-sheet');
  const mCouponToggle = document.getElementById('btn-m-coupon-toggle');
  const mCouponBox = document.getElementById('m-coupon-box');

  const openSheet = () => {
    if (sheetOverlay) {
      sheetOverlay.classList.add('is-open');
      sheetOverlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      const email = document.getElementById('m-sheet-email') as HTMLInputElement;
      if (email && !email.value) setTimeout(() => email.focus(), 300);
    }
  };

  const closeSheet = () => {
    if (sheetOverlay) {
      sheetOverlay.classList.remove('is-open');
      sheetOverlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  };

  openSheetBtn?.addEventListener('click', openSheet);
  closeSheetBtn?.addEventListener('click', closeSheet);
  sheetOverlay?.addEventListener('click', (e) => {
    if (e.target === sheetOverlay) closeSheet();
  });

  mCouponToggle?.addEventListener('click', () => {
    if (mCouponBox) {
      mCouponBox.hidden = !mCouponBox.hidden;
    }
  });

  const desktopCouponToggle = document.getElementById('btn-desktop-coupon-toggle');
  const desktopCouponBox = document.getElementById('desktop-coupon-box');
  desktopCouponToggle?.addEventListener('click', () => {
    if (desktopCouponBox) {
      desktopCouponBox.hidden = !desktopCouponBox.hidden;
    }
  });

  // ==================== STEP ACCORDION TOGGLE ====================
  const accordions = document.querySelectorAll('.p-step-accordion, .m-step-card');
  accordions.forEach((card) => {
    const head = card.querySelector('.p-step-accordion__header, .m-step-card__head');
    head?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('input[type="checkbox"]')) return;
      card.classList.toggle('is-open');
    });
  });

  // ==================== STEP COMPLETION PROGRESS (localStorage) ====================
  const layoutRoot = document.querySelector<HTMLElement>('.project-layout');
  const projectId = layoutRoot?.dataset.projectId || '0';
  const totalSteps = document.querySelectorAll('.p-step-accordion, .m-step-card').length / (window.innerWidth <= 768 ? 1 : 2) || 1;

  const deskProgTitle = document.getElementById('desktop-prog-title');
  const deskProgPct = document.getElementById('desktop-prog-pct');
  const deskProgFill = document.getElementById('desktop-prog-fill');
  const mProgTitle = document.getElementById('m-prog-title');
  const mProgPct = document.getElementById('m-prog-pct');
  const mProgFill = document.getElementById('m-prog-fill');

  const updateProgressUI = (saved: string[]) => {
    const count = saved.length;
    const pct = Math.min(100, Math.round((count / (totalSteps || 1)) * 100));
    const titleText = `${count} of ${totalSteps} steps completed`;
    const pctText = `${pct}%`;

    if (deskProgTitle) deskProgTitle.textContent = titleText;
    if (deskProgPct) deskProgPct.textContent = pctText;
    if (deskProgFill) deskProgFill.style.width = pctText;

    if (mProgTitle) mProgTitle.textContent = titleText;
    if (mProgPct) mProgPct.textContent = pctText;
    if (mProgFill) mProgFill.style.width = pctText;
  };

  const stepStorageKey = `tt-step-prog-${projectId}`;
  let savedStepIds: string[] = [];
  try {
    savedStepIds = JSON.parse(localStorage.getItem(stepStorageKey) || '[]');
  } catch {}

  const stepCheckboxes = document.querySelectorAll<HTMLInputElement>('.step-progress-check');
  stepCheckboxes.forEach((cb) => {
    const stepId = cb.dataset.stepId || '';
    if (savedStepIds.includes(stepId)) {
      cb.checked = true;
      cb.closest('.p-step-accordion, .m-step-card')?.classList.add('is-completed');
    }

    cb.addEventListener('change', () => {
      const card = cb.closest('.p-step-accordion, .m-step-card');
      if (cb.checked) {
        card?.classList.add('is-completed');
        if (!savedStepIds.includes(stepId)) savedStepIds.push(stepId);
      } else {
        card?.classList.remove('is-completed');
        savedStepIds = savedStepIds.filter((id) => id !== stepId);
      }
      try {
        localStorage.setItem(stepStorageKey, JSON.stringify(savedStepIds));
      } catch {}
      updateProgressUI(savedStepIds);
      // Synchronize other checkboxes with same stepId (e.g. mobile vs desktop)
      stepCheckboxes.forEach((other) => {
        if (other !== cb && other.dataset.stepId === stepId) {
          other.checked = cb.checked;
          other.closest('.p-step-accordion, .m-step-card')?.classList.toggle('is-completed', cb.checked);
        }
      });
    });
  });
  updateProgressUI(savedStepIds);

  // ==================== CHECKOUT & FREE CLAIM ENGINE ====================
  const isPaid = layoutRoot?.dataset.paid === '1';
  const projectSlug = layoutRoot?.dataset.slug || 'Project Pack';

  async function handleFreeClaim(emailVal: string, btn: HTMLButtonElement, container: HTMLElement) {
    if (!emailVal || !emailVal.includes('@')) {
      alert('Please enter a valid email address.');
      return;
    }
    btn.disabled = true;
    const origHtml = btn.innerHTML;
    btn.innerHTML = 'Preparing free files...';

    try {
      const res = await fetch('/api/download/free-claim', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ projectId: parseInt(projectId, 10), email: emailVal }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to claim download');

      btn.innerHTML = 'Opening download page...';
      const targetUrl = data.redirect || '/account/downloads';
      window.location.href = targetUrl;
    } catch (err: any) {
      alert(err.message || 'Error claiming files');
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  }

  async function handlePaidCheckout(emailVal: string, couponVal: string, btn: HTMLButtonElement, container: HTMLElement) {
    if (!emailVal || !emailVal.includes('@')) {
      alert('Please enter a valid email address.');
      return;
    }
    btn.disabled = true;
    const origHtml = btn.innerHTML;
    btn.innerHTML = 'Connecting to checkout...';

    try {
      const res = await fetch('/api/razorpay/create-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ projectId: parseInt(projectId, 10), email: emailVal, couponCode: couponVal }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to start checkout');

      if (data.alreadyPaid) {
        if (data.redirect) {
          btn.innerHTML = 'Opening download page...';
          window.location.href = data.redirect;
          return;
        }
        container.innerHTML = `
          <div class="buy-success">
            <div class="buy-success__icon"><svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
            <h3 class="buy-success__title">You already own this pack!</h3>
            <p class="buy-success__text">We emailed the fresh download link to <strong>${emailVal}</strong>.</p>
            <a href="/account/downloads" class="btn-buy-primary" style="margin-top: 1rem;">View my downloads</a>
          </div>
        `;
        return;
      }

      const rzp = new (window as any).Razorpay({
        key: data.keyId,
        amount: data.amount,
        currency: 'INR',
        name: 'Technical Triveni',
        description: projectSlug,
        order_id: data.razorpayOrderId,
        handler: async function (response: any) {
          btn.innerHTML = 'Verifying payment...';
          try {
            const vres = await fetch('/api/razorpay/verify', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                orderId: data.orderId,
                razorpay_order_id: response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature: response.razorpay_signature,
              }),
            });
            const vdata = await vres.json();
            if (!vres.ok) throw new Error(vdata.error || 'Verification failed');
            window.location.href = vdata.redirect || '/account/downloads';
          } catch (err: any) {
            alert('Payment confirmed, but session verification failed: ' + err.message);
            window.location.href = '/account/downloads';
          }
        },
        prefill: { email: emailVal },
        theme: { color: '#D91F26' },
      });

      rzp.on('payment.failed', function () {
        btn.disabled = false;
        btn.innerHTML = origHtml;
        alert('Payment was cancelled or failed. Please try again.');
      });

      rzp.open();
    } catch (err: any) {
      alert(err.message || 'Error starting payment');
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  }

  // Desktop submit listeners
  const deskBuyBtn = document.getElementById('btn-desktop-buy-submit') as HTMLButtonElement;
  const deskFreeBtn = document.getElementById('btn-desktop-free-submit') as HTMLButtonElement;
  const deskCardBox = document.getElementById('main-buy-box');

  deskBuyBtn?.addEventListener('click', () => {
    const email = (document.getElementById('desktop-buy-email') as HTMLInputElement)?.value?.trim();
    const coupon = (document.getElementById('desktop-coupon-input') as HTMLInputElement)?.value?.trim();
    if (deskCardBox) handlePaidCheckout(email, coupon, deskBuyBtn, deskCardBox);
  });

  deskFreeBtn?.addEventListener('click', () => {
    const email = (document.getElementById('desktop-free-email') as HTMLInputElement)?.value?.trim();
    if (deskCardBox) handleFreeClaim(email, deskFreeBtn, deskCardBox);
  });

  // Mobile submit listener
  const mSheetSubmitBtn = document.getElementById('btn-m-sheet-submit') as HTMLButtonElement;
  const mSheetPanel = document.getElementById('m-sheet-panel');

  mSheetSubmitBtn?.addEventListener('click', () => {
    const email = (document.getElementById('m-sheet-email') as HTMLInputElement)?.value?.trim();
    const coupon = (document.getElementById('m-sheet-coupon-input') as HTMLInputElement)?.value?.trim();
    if (mSheetPanel) {
      if (isPaid) {
        handlePaidCheckout(email, coupon, mSheetSubmitBtn, mSheetPanel);
      } else {
        handleFreeClaim(email, mSheetSubmitBtn, mSheetPanel);
      }
    }
  });

  // Enter key support for all forms
  const deskFreeForm = document.getElementById('desktop-free-form') as HTMLFormElement | null;
  deskFreeForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    deskFreeBtn?.click();
  });

  const deskCheckoutForm = document.getElementById('desktop-checkout-form') as HTMLFormElement | null;
  deskCheckoutForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    deskBuyBtn?.click();
  });

  const mSheetForm = document.getElementById('m-sheet-form') as HTMLFormElement | null;
  mSheetForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    mSheetSubmitBtn?.click();
  });
</script>

