---
import Icon from './Icon.astro';
import BomTable from './BomTable.astro';
import TroubleTable from './TroubleTable.astro';
import ProjectCard from './ProjectCard.astro';
import type { ProjectFull, Project } from '../lib/db';
import { formatINR, formatDate, formatBytes, cleanFileName, difficultyClass } from '../lib/format';
import { FILE_KINDS } from '../lib/site';

interface Props {
  project: ProjectFull;
  estCost: number;
  paid: boolean;
  descHtml: string;
  safetyHtml: string;
  yt?: string | null;
  ratingAvg?: number;
  ratingCount?: number;
  relatedPacks?: Project[];
}

const {
  project,
  estCost,
  paid,
  descHtml,
  safetyHtml,
  yt,
  ratingAvg = 0,
  ratingCount = 0,
  relatedPacks = [],
} = Astro.props;

// Safe array parser
const safeArr = (str: any) => {
  if (!str) return [];
  if (Array.isArray(str)) return str;
  try {
    const arr = JSON.parse(str);
    return Array.isArray(arr) ? arr : [];
  } catch {
    return [];
  }
};

const prereqs = safeArr(project.prereqs_json);
const outcomes = safeArr(project.outcomes_json);
const notIncluded = safeArr(project.not_included_json);
const faqs = safeArr(project.faq_json);

// Real Badges calculation
const fileKindsStr = (project.file_kinds || '').toLowerCase();
const filesList = project.files || [];
const hasCode = filesList.some((f) => f.kind === 'code' || f.kind === 'hex' || f.kind === 'sketch') || fileKindsStr.includes('code');
const hasSchematic = filesList.some((f) => f.kind === 'schematic') || (project.pins && project.pins.length > 0) || fileKindsStr.includes('schematic');
const has3D = filesList.some((f) => f.kind === 'model' || f.kind === '3d') || !!project.model_url;
const hasPdf = filesList.some((f) => f.kind === 'pdf') || (!hasCode && !hasSchematic && !has3D);
const hasBom = project.bom && project.bom.length > 0;

const badges: { label: string; icon: string }[] = [];
if (hasCode) badges.push({ label: 'Code', icon: 'code' });
if (hasSchematic && badges.length < 2) badges.push({ label: 'Schematic', icon: 'schematic' });
if (has3D && badges.length < 2) badges.push({ label: '3D Files', icon: 'cube' });
if (hasPdf && badges.length < 2) badges.push({ label: 'PDF Guide', icon: 'doc' });
if (hasBom && badges.length < 2) badges.push({ label: 'Parts List', icon: 'cart' });

// Media Gallery assembly
const rawImages = (project.images || []).map((img, i) => ({
  id: `img-${img.id || i}`,
  type: img.kind === 'model' ? 'model' : 'image',
  url: img.url,
  caption: img.caption || project.title,
}));

if (rawImages.length === 0 && project.cover_image) {
  rawImages.push({
    id: 'cover',
    type: 'image',
    url: project.cover_image,
    caption: project.title,
  });
}

const mediaList = [...rawImages];
const hasModel = mediaList.some((m) => m.type === 'model');
const firstMedia = mediaList[0] || { type: 'image', url: project.cover_image || '/og-default.png', caption: project.title };

const mobileSlides = [
  ...mediaList.map((m) => ({
    type: m.type,
    url: m.url,
    caption: m.caption,
    ytId: '',
  })),
  ...(yt ? [{ type: 'yt', ytId: yt, caption: 'Video Tutorial', url: '' }] : []),
];
if (mobileSlides.length === 0 && project.cover_image) {
  mobileSlides.push({
    type: 'image',
    url: project.cover_image,
    caption: project.title,
    ytId: '',
  });
}

// Deduplicate files by cleaned label and url
const uniqueFiles = filesList.reduce((acc, f) => {
  const clean = cleanFileName(f.label, f.kind);
  const key = `${clean}_${f.url || f.id}`;
  if (!acc.map.has(key)) {
    acc.map.set(key, true);
    acc.list.push({ ...f, cleanLabel: clean });
  }
  return acc;
}, { map: new Map<string, boolean>(), list: [] as any[] }).list;

// File counts for buy box
const codeCount = uniqueFiles.filter((f) => f.kind === 'code' || f.kind === 'hex' || f.kind === 'sketch').length;
const schematicCount = uniqueFiles.filter((f) => f.kind === 'schematic').length;
const modelCount = uniqueFiles.filter((f) => f.kind === 'model' || f.kind === '3d').length;
const pdfCount = uniqueFiles.filter((f) => f.kind === 'pdf' || f.kind === 'doc').length;

// Group Pins by Module
const groupedPins = (project.pins || []).reduce((acc, pin) => {
  const m = pin.module || 'General';
  if (!acc[m]) acc[m] = [];
  acc[m].push(pin);
  return acc;
}, {} as Record<string, typeof project.pins>);

// Meta Row construction
const metaParts: string[] = [];
if (project.difficulty) metaParts.push(project.difficulty);
if (project.build_time) metaParts.push(project.build_time);
else metaParts.push('2 h');
if (estCost > 0) metaParts.push(`Core cost ≈ ${formatINR(estCost)}`);
if (project.updated_at) metaParts.push(`Updated ${formatDate(project.updated_at)}`);
const metaRow = metaParts.join(' · ');

const lastUpdated = formatDate(project.updated_at);
---

<div class="project-layout">
  <!-- BREADCRUMBS -->
  <nav class="p-crumbs container desktop-pack-only" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="p-crumbs__sep">/</span>
    <a href="/projects">Projects</a>
    <span class="p-crumbs__sep">/</span>
    <a href={`/projects?cat=${encodeURIComponent(project.category || 'All')}`} class="p-crumbs__cat">{project.category || 'Projects'}</a>
    <span class="p-crumbs__sep p-crumbs__sep--tail">/</span>
    <span class="p-crumbs__current" title={project.title}>{project.title}</span>
  </nav>

  <!-- TITLE BLOCK -->
  <header class="p-header container desktop-pack-only">
    <span class="p-eyebrow">{project.category || 'PROJECT PACK'}</span>
    <h1 class="p-title">{project.title}</h1>
    {project.summary && <p class="p-summary">{project.summary}</p>}

    <div class="p-meta-bar">
      <span class="p-meta-text">{metaRow}</span>
      {badges.length > 0 && (
        <div class="p-badges">
          {badges.map((b) => (
            <span class="p-badge">
              <Icon name={b.icon} size={13} /> {b.label}
            </span>
          ))}
        </div>
      )}
    </div>
  </header>

  <!-- HERO 7/5 GRID -->
  <section class="p-hero-grid container desktop-pack-only">
    <!-- LEFT COLUMN: Media Viewer (7 cols) -->
    <div class="p-viewer">
      <div class="p-stage" id="media-stage">
        {firstMedia.type === 'model' ? (
          <model-viewer
            src={firstMedia.url}
            camera-controls
            auto-rotate
            shadow-intensity="1"
            exposure="1.2"
            class="p-stage__model"
            alt={`3D Model of ${project.title}`}
          ></model-viewer>
        ) : (
          <img
            src={firstMedia.url}
            alt={firstMedia.caption || project.title}
            class="p-stage__img"
            id="stage-img"
            width="800"
            height="500"
            loading="eager"
          />
        )}
      </div>

      <!-- Media Thumbnails Strip -->
      {(mediaList.length > 1 || yt) && (
        <div class="p-thumbs" role="tablist" aria-label="Media gallery thumbnails">
          {mediaList.map((m, i) => (
            <button
              type="button"
              class:list={['p-thumb-btn', { 'is-active': i === 0 }]}
              data-media-url={m.url}
              data-media-type={m.type}
              aria-label={`View image ${i + 1}`}
            >
              {m.type === 'model' ? (
                <div class="p-thumb-icon"><Icon name="cube" size={18} /></div>
              ) : (
                <img src={m.url} alt="" width="72" height="48" loading="lazy" />
              )}
            </button>
          ))}
          {yt && (
            <button
              type="button"
              class="p-thumb-btn p-thumb-btn--yt"
              data-yt-id={yt}
              aria-label="View Video"
            >
              <div class="p-thumb-icon p-thumb-icon--yt">
                <Icon name="play" size={18} />
              </div>
            </button>
          )}
        </div>
      )}
    </div>

    <!-- RIGHT COLUMN: Sticky Buy Box (5 cols) -->
    <aside class="p-sidebar">
      <div
        class="buy-box"
        id="main-buy-box"
        data-project-id={project.id}
        data-slug={project.slug}
        data-paid={paid ? '1' : '0'}
        data-price={project.price_inr || 0}
      >
        {paid ? (
          <div class="buy-box__paid">
            <div class="buy-box__top">
              <span class="buy-box__tag">DIGITAL PROJECT PACK</span>
              <div class="buy-box__price-wrap">
                <span class="buy-box__price">{formatINR(project.price_inr)}</span>
                <span class="buy-box__price-sub">one-time purchase &middot; instant access</span>
              </div>
            </div>

            <!-- What's inside list -->
            <div class="buy-box__contents">
              <span class="buy-box__contents-title">What's included in this pack:</span>
              <ul class="buy-box__checklist">
                {codeCount > 0 && (
                  <li><Icon name="code" size={15} /> {codeCount} tested source code {codeCount === 1 ? 'file' : 'files'}</li>
                )}
                {schematicCount > 0 && (
                  <li><Icon name="schematic" size={15} /> {schematicCount} verified circuit {schematicCount === 1 ? 'schematic' : 'schematics'}</li>
                )}
                {modelCount > 0 && (
                  <li><Icon name="cube" size={15} /> {modelCount} ready-to-print 3D STL {modelCount === 1 ? 'model' : 'models'}</li>
                )}
                {pdfCount > 0 && (
                  <li><Icon name="doc" size={15} /> Complete documentation & wiring guide</li>
                )}
                {hasBom && (
                  <li><Icon name="cart" size={15} /> Verified parts list with direct buy links</li>
                )}
              </ul>
            </div>

            <!-- Form -->
            <form class="buy-box__form" id="checkout-form" onsubmit="return false;">
              <div class="buy-box__field">
                <label for="buy-email" class="buy-box__label">Your email address</label>
                <input
                  type="email"
                  id="buy-email"
                  class="buy-box__input"
                  placeholder="name@example.com"
                  required
                  autocomplete="email"
                />
              </div>

              <div class="buy-box__coupon">
                <input
                  type="text"
                  id="coupon_code"
                  class="buy-box__input buy-box__input--sm"
                  placeholder="Discount code (optional)"
                  autocomplete="off"
                />
              </div>

              <button type="button" class="btn-buy-action" id="btn-buy-submit">
                <Icon name="lock" size={16} /> Buy pack &mdash; {formatINR(project.price_inr)}
              </button>
            </form>

            <div class="buy-box__trust">
              <div class="trust-item">
                <Icon name="shield" size={14} /> Secure checkout via Razorpay (UPI, Cards, NetBanking)
              </div>
              <div class="trust-item">
                <Icon name="check-circle" size={14} /> 7-day build guarantee &middot; direct email support
              </div>
              <div class="trust-item">
                <Icon name="download" size={14} /> Download link sent immediately to your email
              </div>
            </div>
          </div>
        ) : (
          <div class="buy-box__free">
            <span class="buy-box__tag buy-box__tag--free">FREE DIGITAL RESOURCE</span>
            <h3 class="buy-box__free-title">Get free project files</h3>
            <p class="buy-box__free-desc">
              Enter your email and we'll instantly send you the full resource download link. No spam, ever.
            </p>

            <form class="buy-box__form" id="free-claim-form" onsubmit="return false;">
              <div class="buy-box__field">
                <label for="buy-email" class="buy-box__label">Your email address</label>
                <input
                  type="email"
                  id="buy-email"
                  class="buy-box__input"
                  placeholder="name@example.com"
                  required
                  autocomplete="email"
                />
              </div>

              <button type="button" class="btn-buy-action btn-buy-action--free" id="btn-free-submit">
                <Icon name="download" size={16} /> Get free files &rarr;
              </button>
            </form>

            <div class="buy-box__trust">
              <div class="trust-item">
                <Icon name="check-circle" size={14} /> Instant download link sent to your inbox
              </div>
              <div class="trust-item">
                <Icon name="shield" size={14} /> 100% free open resource &middot; no payment needed
              </div>
            </div>
          </div>
        )}
      </div>
    </aside>
  </section>

  <!-- STICKY SECTION NAV PILLS (Desktop Only) -->
  <nav class="p-secnav desktop-pack-only" id="sticky-secnav" aria-label="Page sections">
    <div class="container p-secnav__inner">
      <a href="#overview" class="p-secnav__link is-active">Overview</a>
      {hasBom && <a href="#parts" class="p-secnav__link">Parts list</a>}
      {(project.pins?.length > 0 || project.wiring_diagrams?.length > 0) && (
        <a href="#wiring" class="p-secnav__link">Wiring</a>
      )}
      {project.steps?.length > 0 && <a href="#steps" class="p-secnav__link">Build steps</a>}
      {project.troubleshooting?.length > 0 && (
        <a href="#troubleshooting" class="p-secnav__link">Troubleshooting</a>
      )}
      {uniqueFiles.length > 0 && <a href="#files" class="p-secnav__link">Files included</a>}
      {faqs.length > 0 && <a href="#faq" class="p-secnav__link">FAQ</a>}
    </div>
  </nav>

  <!-- MOBILE PACK CHROME (<= 768px, media_1791876192118_f7595c00.png) -->
  <div class="m-pack-header m-pack-only">
    <!-- Top Bar: Back to Category + Share Button -->
    <div class="m-pack-topbar">
      <a href={`/projects?cat=${encodeURIComponent(project.category || 'All')}`} class="m-pack-back">
        <Icon name="chevron-left" size={20} />
        <span>{project.category || 'Projects'}</span>
      </a>
      <button type="button" class="m-pack-share-btn" id="btn-pack-share" aria-label="Share project">
        <Icon name="share" size={20} />
      </button>
    </div>

    <!-- Full-bleed Swipe Gallery with 1 / N Counter -->
    <div class="m-pack-gallery-wrap">
      <div class="m-pack-gallery" id="m-pack-gallery">
        {mobileSlides.map((slide, idx) => (
          <div class="m-pack-slide">
            {slide.type === 'yt' ? (
              <div class="m-pack-yt-wrap">
                <lite-youtube videoid={slide.ytId}></lite-youtube>
              </div>
            ) : slide.type === 'model' ? (
              <model-viewer
                src={slide.url}
                camera-controls
                auto-rotate
                shadow-intensity="1"
                exposure="1.2"
                class="m-pack-model"
                alt={`3D model of ${project.title}`}
              ></model-viewer>
            ) : (
              <img
                src={slide.url}
                alt={slide.caption || project.title}
                width="800"
                height="500"
                loading={idx === 0 ? 'eager' : 'lazy'}
                class="m-pack-img"
              />
            )}
          </div>
        ))}
      </div>
      {mobileSlides.length > 1 && (
        <div class="m-pack-gallery-counter" id="m-pack-gallery-counter">
          1 / {mobileSlides.length}
        </div>
      )}
    </div>

    <!-- Title, Chips & Summary -->
    <div class="m-pack-meta-block">
      <h1 class="m-pack-title">{project.title}</h1>

      <div class="m-pack-chips-row">
        {project.difficulty && (
          <span class="m-pack-chip">{project.difficulty}</span>
        )}
        <span class="m-pack-chip">{project.build_time || '2 hrs'}</span>
        {estCost > 0 && (
          <span class="m-pack-chip m-pack-chip--cost">Core cost &asymp; {formatINR(estCost)}</span>
        )}
      </div>

      {project.summary && (
        <p class="m-pack-summary">{project.summary}</p>
      )}
    </div>

    <!-- Sticky Tab Chips: Overview, Parts list, Wiring, Build steps -->
    <nav class="m-pack-tabs-nav" id="m-sticky-tabs" aria-label="Page sections">
      <div class="m-pack-tabs-track">
        <a href="#overview" class="m-pack-tab-chip is-active" data-sec="overview">Overview</a>
        {hasBom && <a href="#parts" class="m-pack-tab-chip" data-sec="parts">Parts list</a>}
        {(project.pins?.length > 0 || project.wiring_diagrams?.length > 0) && (
          <a href="#wiring" class="m-pack-tab-chip" data-sec="wiring">Wiring</a>
        )}
        {project.steps?.length > 0 && (
          <a href="#steps" class="m-pack-tab-chip" data-sec="steps">Build steps</a>
        )}
      </div>
    </nav>
  </div>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="p-content container">
    <!-- 1. OVERVIEW -->
    <section class="p-sec" id="overview">
      <h2 class="p-sec__title">Overview</h2>

      <!-- Safety Alert Box (if present) -->
      {safetyHtml && (
        <aside class="p-safety-box" role="alert">
          <div class="p-safety-box__header">
            <Icon name="shield" size={20} />
            <h3 class="p-safety-box__title">Safety first &mdash; read before building</h3>
          </div>
          <div class="p-safety-box__body prose" set:html={safetyHtml}></div>
        </aside>
      )}

      <!-- Description Markdown -->
      <div class="prose p-overview-body" set:html={descHtml}></div>

      <!-- Outcomes list (if present) -->
      {outcomes.length > 0 && (
        <div class="p-outcomes">
          <h3 class="p-subhead">What you'll build & learn</h3>
          <ul class="p-check-list">
            {outcomes.map((o: string) => (
              <li>
                <Icon name="check-circle" size={16} /> <span>{o}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Prerequisites & Not Included (if present) -->
      {(prereqs.length > 0 || notIncluded.length > 0) && (
        <div class="p-prereqs-grid">
          {prereqs.length > 0 && (
            <div class="p-panel">
              <h4 class="p-panel__title"><Icon name="doc" size={16} /> Prerequisites</h4>
              <ul class="p-bullet-list">
                {prereqs.map((p: string) => <li>{p}</li>)}
              </ul>
            </div>
          )}
          {notIncluded.length > 0 && (
            <div class="p-panel">
              <h4 class="p-panel__title"><Icon name="info" size={16} /> Not included in this pack</h4>
              <ul class="p-bullet-list">
                {notIncluded.map((n: string) => <li>{n}</li>)}
              </ul>
            </div>
          )}
        </div>
      )}
    </section>

    <!-- 2. PARTS LIST (BOM) -->
    {hasBom && (
      <section class="p-sec" id="parts">
        <h2 class="p-sec__title">Parts list & components</h2>
        <BomTable items={project.bom} costChecked={project.cost_checked} />
      </section>
    )}

    <!-- 3. WIRING & CONNECTIONS -->
    {(project.pins?.length > 0 || project.wiring_diagrams?.length > 0) && (
      <section class="p-sec" id="wiring">
        <h2 class="p-sec__title">Wiring & connections</h2>

        <!-- Wiring Diagram Images (if present) -->
        {project.wiring_diagrams && project.wiring_diagrams.length > 0 && (
          <div class="p-wiring-diagrams">
            {project.wiring_diagrams.map((d) => (
              <figure class="p-wiring-diagram">
                <img src={d.url} alt={d.label || 'Wiring diagram'} loading="lazy" />
                {d.label && <figcaption class="p-wiring-diagram__cap">{d.label}</figcaption>}
              </figure>
            ))}
          </div>
        )}

        <!-- Pin Tables by Module -->
        {Object.entries(groupedPins).map(([moduleName, pins]) => (
          <div class="p-pin-module">
            <h3 class="p-pin-module__title">{moduleName} Connections</h3>
            
            <!-- Desktop Table -->
            <div class="p-table-wrap p-wiring-desktop">
              <table class="p-table">
                <thead>
                  <tr>
                    <th>From Pin / Component</th>
                    <th>To Pin / Board</th>
                    <th>Connection Note</th>
                  </tr>
                </thead>
                <tbody>
                  {pins.map((p) => (
                    <tr>
                      <td class="font-mono font-bold">{p.from_pin}</td>
                      <td class="font-mono">{p.to_pin}</td>
                      <td class="text-ink-2">{p.note || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <!-- Mobile Wiring Cards (Item 8) -->
            <div class="p-wiring-mobile">
              {pins.map((p) => (
                <div class="p-pin-card">
                  <div class="p-pin-card__connection">
                    <span class="p-pin-from font-mono">{p.from_pin}</span>
                    <span class="p-pin-arrow">&rarr;</span>
                    <span class="p-pin-to font-mono">{p.to_pin}</span>
                  </div>
                  {p.note && p.note !== '—' && (
                    <div class="p-pin-card__note">{p.note}</div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </section>
    )}

    <!-- 4. BUILD STEPS -->
    {project.steps?.length > 0 && (
      <section class="p-sec" id="steps">
        <h2 class="p-sec__title">Build steps</h2>

        <!-- Mobile Steps Progress Card (<= 768px) -->
        <div class="m-steps-progress-card m-pack-only">
          <div class="m-steps-progress-header">
            <span class="m-steps-progress-title" id="m-steps-prog-title">0 of {project.steps.length} steps completed</span>
            <span class="m-steps-progress-pct" id="m-steps-prog-pct">0%</span>
          </div>
          <div class="m-steps-progress-track">
            <div class="m-steps-progress-fill" id="m-steps-prog-fill" style="width: 0%;"></div>
          </div>
        </div>

        <div class="p-steps-list">
          {project.steps.map((s, i) => (
            <article class:list={['p-step-card', { 'is-open': i === 0 }]} data-step-index={i}>
              <div class="p-step-card__header" data-step-toggle={i}>
                <span class="p-step-badge">{i + 1}</span>
                <div class="p-step-card__title-wrap">
                  <h3 class="p-step-card__title">{s.title}</h3>
                  {s.goal && <p class="p-step-card__goal">Goal: {s.goal}</p>}
                </div>
                {s.time_est && (
                  <span class="p-step-time"><Icon name="clock" size={13} /> {s.time_est}</span>
                )}
                <span class="m-step-chevron m-pack-only">
                  <Icon name="chevron-down" size={18} />
                </span>
              </div>

              <div class="p-step-card__body">
                {s.image_url && (
                  <div class="p-step-card__media">
                    <img src={s.image_url} alt={s.title} loading="lazy" />
                  </div>
                )}
                <div class="prose" set:html={s.body}></div>

                {s.expected_res && (
                  <div class="p-step-res p-step-res--ok">
                    <Icon name="check-circle" size={16} />
                    <div>
                      <strong>Expected result:</strong> {s.expected_res}
                    </div>
                  </div>
                )}

                {s.if_fails && (
                  <div class="p-step-res p-step-res--warn">
                    <Icon name="help-circle" size={16} />
                    <div>
                      <strong>If it fails:</strong> {s.if_fails}
                    </div>
                  </div>
                )}

                <div class="p-step-check">
                  <label class="p-step-check__label">
                    <input type="checkbox" class="step-progress-check" data-step-id={s.id || i} />
                    <span>Step completed</span>
                  </label>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- 5. TROUBLESHOOTING -->
    {project.troubleshooting?.length > 0 && (
      <section class="p-sec" id="troubleshooting">
        <h2 class="p-sec__title">Troubleshooting</h2>
        <TroubleTable items={project.troubleshooting} />
      </section>
    )}

    <!-- 6. FILES INCLUDED -->
    {uniqueFiles.length > 0 && (
      <section class="p-sec" id="files">
        <h2 class="p-sec__title">Files included</h2>
        <p class="p-sec__subtext">
          {paid
            ? 'Complete digital asset bundle delivered to your email immediately upon checkout.'
            : 'Available for immediate free download.'}
        </p>

        <div class="p-files-grid">
          {uniqueFiles.map((f: any) => {
            const sz = formatBytes(f.size_bytes);
            return (
              <div class="p-file-item">
                <div class="p-file-item__icon">
                  <Icon
                    name={
                      f.kind === 'code' || f.kind === 'hex' || f.kind === 'sketch'
                        ? 'code'
                        : f.kind === 'schematic'
                        ? 'schematic'
                        : f.kind === 'model' || f.kind === '3d'
                        ? 'cube'
                        : 'doc'
                    }
                    size={22}
                  />
                </div>
                <div class="p-file-item__info">
                  <span class="p-file-item__name">{f.cleanLabel}</span>
                  <div class="p-file-item__meta">
                    <span class="p-file-item__kind">
                      {FILE_KINDS.find((x) => x.key === f.kind)?.label ?? (f.kind || 'File')}
                    </span>
                    {sz && <span class="p-file-item__size">&middot; {sz}</span>}
                  </div>
                </div>

                <div class="p-file-item__action">
                  {f.is_free === 1 ? (
                    <a href={`/api/download/free/${f.id}`} class="btn-file-dl" download>
                      Download <Icon name="download" size={13} />
                    </a>
                  ) : (
                    <span class="file-pack-badge">Pack file</span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- 7. CODE & LICENSE -->
    {(project.code_repo_url || project.license) && (
      <section class="p-sec" id="license">
        <h2 class="p-sec__title">Code & license</h2>
        <div class="p-license-row">
          {project.code_repo_url && (
            <a
              href={project.code_repo_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-license-link"
            >
              <Icon name="github" size={18} /> Open Source GitHub Repository
            </a>
          )}
          {project.license && (
            <div class="p-license-badge">
              <Icon name="doc" size={16} /> License: <strong>{project.license}</strong>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- 8. FAQ -->
    {faqs.length > 0 && (
      <section class="p-sec" id="faq">
        <h2 class="p-sec__title">Frequently asked questions</h2>
        <div class="p-faq-list">
          {faqs.map((f: { q: string; a: string }) => (
            <details class="p-faq-item">
              <summary class="p-faq-q">
                <span>{f.q}</span>
                <Icon name="chevron-down" size={16} />
              </summary>
              <div class="p-faq-a prose">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- AUTHOR & SUPPORT BLOCK -->
    <section class="p-author-block">
      <div class="p-author-img-wrap">
        <img
          src="/brand/profile.jpg"
          alt="Triveni"
          width="120"
          height="120"
          class="p-author-img"
          loading="lazy"
        />
      </div>
      <div class="p-author-content">
        <span class="p-author-label">CREATOR & ENGINEER</span>
        <h3 class="p-author-title">Built and tested by Triveni</h3>
        <p class="p-author-text">
          Every schematic, line of code, and 3D model in this pack was built, tested, and verified on real bench hardware in the Technical Triveni workshop. Need assistance or running into a tricky bring-up issue? Drop me an email anytime.
        </p>
        <a href="mailto:technicaltriveniyt@gmail.com" class="p-author-email">
          <Icon name="mail" size={15} /> technicaltriveniyt@gmail.com
        </a>
      </div>
    </section>

    <!-- RELATED PACKS -->
    {relatedPacks.length > 0 && (
      <section class="p-related-section">
        <h2 class="p-sec__title">Other project packs you might like</h2>
        <div class="p-related-grid">
          {relatedPacks.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </section>
    )}
  </main>

  <!-- MOBILE STICKY BOTTOM BAR (media_1791876192118_f7595c00.png) -->
  <div class="m-sticky-bar m-pack-only" id="m-sticky-bar">
    <div class="m-sticky-bar__info">
      <span class="m-sticky-bar__price">
        {paid ? formatINR(project.price_inr) : 'Free'}
      </span>
      <span class="m-sticky-bar__sub">One-time, instant access</span>
    </div>
    <button type="button" class="btn-m-sheet-open" id="btn-open-buy-sheet">
      {paid ? 'Buy pack' : 'Get free files'}
    </button>
  </div>

  <!-- MOBILE BUY PACK BOTTOM SHEET MODAL (media_1791876192114_cad8732e.png) -->
  <div class="m-sheet-backdrop m-pack-only" id="m-sheet-backdrop" aria-hidden="true">
    <div class="m-sheet-modal" id="m-sheet-modal" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
      <div class="m-sheet-handle-bar">
        <div class="m-sheet-handle"></div>
      </div>

      <div class="m-sheet-header">
        <div class="m-sheet-header__info">
          <span class="m-sheet-tag">{paid ? 'Digital project pack' : 'Free digital resource'}</span>
          <div class="m-sheet-price-row">
            <span class="m-sheet-price" id="sheet-title">{paid ? formatINR(project.price_inr) : 'Free'}</span>
            <span class="m-sheet-price-sub">one-time, instant access</span>
          </div>
        </div>
        <button type="button" class="m-sheet-close" id="btn-close-buy-sheet" aria-label="Close modal">
          <Icon name="close" size={18} />
        </button>
      </div>

      <!-- Feature highlights with red icons -->
      <div class="m-sheet-highlights">
        <div class="m-sheet-highlight">
          <span class="m-sheet-hl-icon"><Icon name="code" size={16} /></span>
          <span class="m-sheet-hl-text">{codeCount > 0 ? codeCount : (uniqueFiles.length || 2)} tested source code {codeCount === 1 ? 'file' : 'files'}</span>
        </div>
        <div class="m-sheet-highlight">
          <span class="m-sheet-hl-icon"><Icon name="cart" size={16} /></span>
          <span class="m-sheet-hl-text">Verified parts list with direct buy links</span>
        </div>
      </div>

      <!-- Checkout Form -->
      <form class="m-sheet-form" id="m-sheet-form" onsubmit="return false;">
        <div class="m-sheet-field">
          <label for="m-sheet-email" class="m-sheet-label">Your email address</label>
          <input
            type="email"
            id="m-sheet-email"
            class="m-sheet-input"
            placeholder="name@example.com"
            required
            autocomplete="email"
          />
        </div>

        {paid && (
          <div class="m-sheet-coupon-section">
            <button type="button" class="m-sheet-coupon-toggle" id="btn-toggle-coupon">
              Have a discount code?
            </button>
            <div class="m-sheet-coupon-box" id="m-sheet-coupon-box" hidden>
              <input
                type="text"
                id="m-sheet-coupon-input"
                class="m-sheet-input m-sheet-input--sm"
                placeholder="Discount code"
                autocomplete="off"
              />
            </div>
          </div>
        )}

        <button type="button" class="btn-m-sheet-submit" id="btn-m-sheet-submit">
          {paid ? (
            <><Icon name="lock" size={16} /> Pay {formatINR(project.price_inr)}</>
          ) : (
            <><Icon name="download" size={16} /> Get free files &rarr;</>
          )}
        </button>
      </form>

      <!-- Trust lines -->
      <div class="m-sheet-trust">
        <div class="m-sheet-trust-line">
          Secure checkout via Razorpay: UPI, cards, net banking
        </div>
        <div class="m-sheet-trust-line">
          7-day build guarantee, direct email support
        </div>
        <div class="m-sheet-trust-line">
          Download link sent to your email right away
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Desktop Media Viewer thumbnail switcher
  const stage = document.getElementById('media-stage');
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.p-thumb-btn');

  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      thumbBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const ytId = btn.dataset.ytId;
      const mediaUrl = btn.dataset.mediaUrl;
      const mediaType = btn.dataset.mediaType;

      if (!stage) return;

      if (ytId) {
        stage.innerHTML = `<div class="p-stage__yt"><lite-youtube videoid="${ytId}"></lite-youtube></div>`;
      } else if (mediaType === 'model' && mediaUrl) {
        stage.innerHTML = `<model-viewer src="${mediaUrl}" camera-controls auto-rotate shadow-intensity="1" exposure="1.2" class="p-stage__model"></model-viewer>`;
      } else if (mediaUrl) {
        stage.innerHTML = `<img src="${mediaUrl}" alt="Project image" class="p-stage__img" width="800" height="500" />`;
      }
    });
  });

  // Mobile Gallery Counter
  const mGallery = document.getElementById('m-pack-gallery');
  const mCounter = document.getElementById('m-pack-gallery-counter');
  if (mGallery && mCounter) {
    const slides = mGallery.querySelectorAll('.m-pack-slide');
    const total = slides.length;
    mGallery.addEventListener(
      'scroll',
      () => {
        const slideW = mGallery.clientWidth || 1;
        const idx = Math.min(total, Math.max(1, Math.round(mGallery.scrollLeft / slideW) + 1));
        mCounter.textContent = `${idx} / ${total}`;
      },
      { passive: true }
    );
  }

  // Mobile Topbar Share
  const shareBtn = document.getElementById('btn-pack-share');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: document.title,
            url: window.location.href,
          });
        } catch {}
      } else {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const toast = document.createElement('div');
          toast.className = 'm-share-toast';
          toast.textContent = 'Link copied to clipboard!';
          document.body.appendChild(toast);
          setTimeout(() => toast.remove(), 2500);
        } catch {
          prompt('Copy link to share:', window.location.href);
        }
      }
    });
  }

  // Section Nav active pill highlighting on scroll (both desktop and mobile)
  const desktopSecLinks = document.querySelectorAll<HTMLAnchorElement>('.p-secnav__link');
  const mobileTabChips = document.querySelectorAll<HTMLAnchorElement>('.m-pack-tab-chip');
  const sections = document.querySelectorAll<HTMLElement>('.p-sec');

  const highlightTabs = () => {
    let currentId = '';
    sections.forEach((sec) => {
      const top = sec.offsetTop - 140;
      if (window.scrollY >= top) {
        currentId = sec.getAttribute('id') || '';
      }
    });
    if (currentId) {
      desktopSecLinks.forEach((link) => {
        link.classList.toggle('is-active', link.getAttribute('href') === `#${currentId}`);
      });
      mobileTabChips.forEach((chip) => {
        const isActive = chip.getAttribute('href') === `#${currentId}`;
        chip.classList.toggle('is-active', isActive);
        if (isActive && window.innerWidth <= 768) {
          const track = chip.parentElement;
          if (track) {
            const scrollLeft = chip.offsetLeft - (track.clientWidth - chip.clientWidth) / 2;
            track.scrollTo({ left: scrollLeft, behavior: 'smooth' });
          }
        }
      });
    }
  };
  window.addEventListener('scroll', highlightTabs, { passive: true });

  // Mobile Tab Chips Click -> Smooth Scroll
  mobileTabChips.forEach((chip) => {
    chip.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = chip.getAttribute('href')?.replace('#', '');
      const targetEl = targetId ? document.getElementById(targetId) : null;
      if (targetEl) {
        const yOffset = -110;
        const y = targetEl.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    });
  });

  // Mobile Bottom Sheet Modal
  const sheetBackdrop = document.getElementById('m-sheet-backdrop');
  const openSheetBtn = document.getElementById('btn-open-buy-sheet');
  const closeSheetBtn = document.getElementById('btn-close-buy-sheet');
  const couponToggleBtn = document.getElementById('btn-toggle-coupon');
  const couponBox = document.getElementById('m-sheet-coupon-box');

  const openSheet = () => {
    if (sheetBackdrop) {
      sheetBackdrop.classList.add('is-open');
      sheetBackdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      const email = document.getElementById('m-sheet-email') as HTMLInputElement;
      if (email && !email.value) setTimeout(() => email.focus(), 300);
    }
  };

  const closeSheet = () => {
    if (sheetBackdrop) {
      sheetBackdrop.classList.remove('is-open');
      sheetBackdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  };

  openSheetBtn?.addEventListener('click', openSheet);
  closeSheetBtn?.addEventListener('click', closeSheet);
  sheetBackdrop?.addEventListener('click', (e) => {
    if (e.target === sheetBackdrop) closeSheet();
  });

  couponToggleBtn?.addEventListener('click', () => {
    if (couponBox) {
      const isHidden = couponBox.hasAttribute('hidden');
      if (isHidden) couponBox.removeAttribute('hidden');
      else couponBox.setAttribute('hidden', '');
    }
  });

  // Step Completion Progress (persisted in localStorage)
  const projBox = document.getElementById('main-buy-box');
  const totalSteps = document.querySelectorAll('.p-step-card').length;
  const mProgTitle = document.getElementById('m-steps-prog-title');
  const mProgPct = document.getElementById('m-steps-prog-pct');
  const mProgFill = document.getElementById('m-steps-prog-fill');

  const updateProgressUI = (saved: string[]) => {
    if (totalSteps > 0) {
      const count = saved.length;
      const pct = Math.round((count / totalSteps) * 100);
      if (mProgTitle) mProgTitle.textContent = `${count} of ${totalSteps} steps completed`;
      if (mProgPct) mProgPct.textContent = `${pct}%`;
      if (mProgFill) mProgFill.style.width = `${pct}%`;
    }
  };

  if (projBox && projBox.dataset.projectId) {
    const storageKey = `tt-step-prog-${projBox.dataset.projectId}`;
    let savedSteps: string[] = [];
    try {
      savedSteps = JSON.parse(localStorage.getItem(storageKey) || '[]');
    } catch {}

    const stepChecks = document.querySelectorAll<HTMLInputElement>('.step-progress-check');
    stepChecks.forEach((cb) => {
      const stepId = cb.dataset.stepId || '';
      if (savedSteps.includes(stepId)) {
        cb.checked = true;
        cb.closest('.p-step-card')?.classList.add('is-completed');
      }

      cb.addEventListener('change', () => {
        const card = cb.closest('.p-step-card');
        if (cb.checked) {
          card?.classList.add('is-completed');
          if (!savedSteps.includes(stepId)) savedSteps.push(stepId);
        } else {
          card?.classList.remove('is-completed');
          savedSteps = savedSteps.filter((id) => id !== stepId);
        }
        try {
          localStorage.setItem(storageKey, JSON.stringify(savedSteps));
        } catch {}
        updateProgressUI(savedSteps);
      });
    });

    updateProgressUI(savedSteps);
  }

  // Mobile Step Header Collapsible Accordion
  const stepHeaders = document.querySelectorAll<HTMLElement>('[data-step-toggle]');
  stepHeaders.forEach((hdr) => {
    hdr.addEventListener('click', (e) => {
      if (window.innerWidth <= 768) {
        // Prevent toggle if clicking checkbox directly
        if ((e.target as HTMLElement).closest('.p-step-check')) return;
        const card = hdr.closest('.p-step-card');
        card?.classList.toggle('is-open');
      }
    });
  });

  // Unified Checkout & Free Claim Engine
  const buyBoxContainer = document.getElementById('main-buy-box');
  const isPaid = buyBoxContainer?.dataset.paid === '1';
  const projectId = parseInt(buyBoxContainer?.dataset.projectId || '0', 10);
  const projectSlug = buyBoxContainer?.dataset.slug || 'Project Pack';

  async function handleFreeClaim(emailVal: string, btn: HTMLButtonElement, container: HTMLElement) {
    if (!emailVal || !emailVal.includes('@')) {
      alert('Please enter a valid email address.');
      return;
    }
    btn.disabled = true;
    const origHtml = btn.innerHTML;
    btn.innerHTML = 'Preparing free files...';

    try {
      const res = await fetch('/api/download/free-claim', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ projectId, email: emailVal }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to claim download');

      container.innerHTML = `
        <div class="buy-success">
          <div class="buy-success__icon"><svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
          <h3 class="buy-success__title">Free files ready!</h3>
          <p class="buy-success__text">We just emailed the download link to <strong>${emailVal}</strong>.</p>
          <a href="${data.redirect || '/account/downloads'}" class="btn-buy-action btn-buy-action--free">Download files now</a>
        </div>
      `;
    } catch (err: any) {
      alert(err.message || 'Error claiming files');
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  }

  async function handlePaidCheckout(emailVal: string, couponVal: string, btn: HTMLButtonElement, container: HTMLElement) {
    if (!emailVal || !emailVal.includes('@')) {
      alert('Please enter a valid email address.');
      return;
    }
    btn.disabled = true;
    const origHtml = btn.innerHTML;
    btn.innerHTML = 'Connecting to checkout...';

    try {
      const res = await fetch('/api/razorpay/create-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ projectId, email: emailVal, couponCode: couponVal }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to start checkout');

      if (data.alreadyPaid) {
        container.innerHTML = `
          <div class="buy-success">
            <div class="buy-success__icon"><svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
            <h3 class="buy-success__title">You already own this pack!</h3>
            <p class="buy-success__text">We emailed the fresh download link to <strong>${emailVal}</strong>.</p>
            <a href="/account/downloads" class="btn-buy-action">View my downloads</a>
          </div>
        `;
        return;
      }

      const rzp = new (window as any).Razorpay({
        key: data.keyId,
        amount: data.amount,
        currency: 'INR',
        name: 'Technical Triveni',
        description: projectSlug,
        order_id: data.razorpayOrderId,
        handler: async function (response: any) {
          btn.innerHTML = 'Verifying payment...';
          try {
            const vres = await fetch('/api/razorpay/verify', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                orderId: data.orderId,
                razorpay_order_id: response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature: response.razorpay_signature,
              }),
            });
            const vdata = await vres.json();
            if (!vres.ok) throw new Error(vdata.error || 'Verification failed');
            window.location.href = vdata.redirect || '/account/downloads';
          } catch (err: any) {
            alert('Payment confirmed, but session verification failed: ' + err.message);
            window.location.href = '/account/downloads';
          }
        },
        prefill: { email: emailVal },
        theme: { color: '#E92424' },
      });

      rzp.on('payment.failed', function () {
        btn.disabled = false;
        btn.innerHTML = origHtml;
        alert('Payment was cancelled or failed. Please try again.');
      });

      rzp.open();
    } catch (err: any) {
      alert(err.message || 'Error starting payment');
      btn.disabled = false;
      btn.innerHTML = origHtml;
    }
  }

  // Desktop Form Listeners
  const desktopBuyBtn = document.getElementById('btn-buy-submit') as HTMLButtonElement;
  const desktopFreeBtn = document.getElementById('btn-free-submit') as HTMLButtonElement;
  if (desktopBuyBtn && buyBoxContainer) {
    desktopBuyBtn.addEventListener('click', () => {
      const emailInput = document.getElementById('buy-email') as HTMLInputElement;
      const couponInput = document.getElementById('coupon_code') as HTMLInputElement;
      handlePaidCheckout(emailInput?.value?.trim() || '', couponInput?.value?.trim() || '', desktopBuyBtn, buyBoxContainer);
    });
  }
  if (desktopFreeBtn && buyBoxContainer) {
    desktopFreeBtn.addEventListener('click', () => {
      const emailInput = document.getElementById('buy-email') as HTMLInputElement;
      handleFreeClaim(emailInput?.value?.trim() || '', desktopFreeBtn, buyBoxContainer);
    });
  }

  // Mobile Bottom Sheet Listeners
  const sheetSubmitBtn = document.getElementById('btn-m-sheet-submit') as HTMLButtonElement;
  const sheetModal = document.getElementById('m-sheet-modal');
  if (sheetSubmitBtn && sheetModal) {
    sheetSubmitBtn.addEventListener('click', () => {
      const emailInput = document.getElementById('m-sheet-email') as HTMLInputElement;
      const couponInput = document.getElementById('m-sheet-coupon-input') as HTMLInputElement;
      if (isPaid) {
        handlePaidCheckout(emailInput?.value?.trim() || '', couponInput?.value?.trim() || '', sheetSubmitBtn, sheetModal);
      } else {
        handleFreeClaim(emailInput?.value?.trim() || '', sheetSubmitBtn, sheetModal);
      }
    });
  }
</script>

<style>
  /* Base Project Layout */
  .project-layout {
    background: var(--bg);
    padding-bottom: 80px;
  }

  /* Breadcrumbs */
  .p-crumbs {
    padding-top: 20px;
    padding-bottom: 8px;
    font-size: 13px;
    color: var(--ink-3);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .p-crumbs a {
    color: var(--ink-2);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .p-crumbs a:hover {
    color: var(--red);
  }
  .p-crumbs__sep {
    color: var(--line);
  }
  .p-crumbs__current {
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .p-crumbs {
      padding-top: 14px;
      padding-bottom: 6px;
      font-size: 12px;
      gap: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex-wrap: nowrap;
    }
    .p-crumbs__cat {
      max-width: 100px;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .p-crumbs__sep--tail {
      display: inline;
    }
    .p-crumbs__current {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 150px;
    }
  }

  /* Header Block */
  .p-header {
    padding-top: 10px;
    padding-bottom: 20px;
  }
  @media (max-width: 640px) {
    .p-header {
      padding-top: 6px;
      padding-bottom: 14px;
    }
  }
  .p-eyebrow {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--red);
    display: block;
    margin-bottom: 8px;
  }
  .p-title {
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3.75rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 12px;
  }
  @media (max-width: 640px) {
    .p-title {
      font-size: 26px !important;
      line-height: 1.2 !important;
      margin: 0 0 8px !important;
      letter-spacing: -0.01em !important;
    }
    .p-eyebrow {
      font-size: 11px;
      margin-bottom: 4px;
    }
  }
  .p-summary {
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 820px;
    margin: 0 0 16px;
  }
  @media (max-width: 640px) {
    .p-summary {
      font-size: 15px;
      line-height: 1.45;
      margin: 0 0 12px;
    }
    .p-meta-bar {
      padding-top: 10px;
      gap: 10px;
    }
    .p-hero-grid {
      padding-top: 10px;
      padding-bottom: 24px;
      gap: 16px;
    }
  }
  .p-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .p-meta-text {
    font-size: 14px;
    color: var(--ink-3);
    font-weight: 500;
  }
  .p-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .p-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-chip);
    color: var(--ink-2);
  }

  /* 7/5 Grid */
  .p-hero-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 32px;
    align-items: start;
    padding-top: 16px;
    padding-bottom: 40px;
  }
  @media (max-width: 900px) {
    .p-hero-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  /* Media Viewer */
  .p-viewer {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    max-width: 100%;
    width: 100%;
  }
  .p-stage {
    position: relative;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .p-stage__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .p-stage__model {
    width: 100%;
    height: 100%;
    display: block;
  }
  .p-stage__yt {
    width: 100%;
    height: 100%;
  }
  .p-stage__yt lite-youtube {
    width: 100%;
    height: 100%;
    max-width: 100%;
  }

  .p-thumbs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    max-width: 100%;
    width: 100%;
    box-sizing: border-box;
    padding: 6px 2px;
    margin-top: 4px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .p-thumbs::-webkit-scrollbar {
    display: none;
  }
  .p-thumb-btn {
    width: 68px;
    height: 44px;
    padding: 0;
    border-radius: 8px;
    border: 2px solid var(--line);
    background: var(--bg-soft);
    overflow: hidden;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 150ms ease;
  }
  .p-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .p-thumb-btn.is-active {
    border-color: var(--red);
    box-shadow: 0 0 0 2px rgba(233, 36, 36, 0.2);
  }
  .p-thumb-icon {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: #ffffff;
  }
  .p-thumb-icon--yt {
    background: var(--red);
    color: #ffffff;
  }
  .p-thumb-label {
    display: none;
  }

  /* Sticky Buy Box */
  .p-sidebar {
    position: sticky;
    top: 84px;
  }
  .buy-box {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }
  .buy-box__tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--red);
    display: block;
    margin-bottom: 6px;
  }
  .buy-box__tag--free {
    color: var(--success);
  }
  .buy-box__price-wrap {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 16px;
  }
  .buy-box__price {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1;
  }
  .buy-box__price-sub {
    font-size: 13px;
    color: var(--ink-3);
  }
  .buy-box__free-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .buy-box__free-desc {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0 0 16px;
  }

  .buy-box__contents {
    padding: 14px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 18px;
  }
  .buy-box__contents-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    display: block;
    margin-bottom: 8px;
  }
  .buy-box__checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .buy-box__checklist li {
    font-size: 13px;
    color: var(--ink-2);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .buy-box__checklist :global(svg) {
    color: var(--red);
    flex-shrink: 0;
  }

  .buy-box__form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .buy-box__label {
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-2);
    display: block;
    margin-bottom: 4px;
  }
  .buy-box__input {
    width: 100%;
    height: 44px;
    padding: 0 14px;
    border-radius: var(--r-btn);
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    font-size: 14px;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .buy-box__input:focus {
    outline: none;
    border-color: var(--red);
    box-shadow: 0 0 0 3px rgba(233, 36, 36, 0.12);
  }
  .buy-box__input--sm {
    height: 38px;
    font-size: 13px;
  }

  .btn-buy-action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 48px;
    background: var(--red);
    color: #ffffff;
    border: none;
    border-radius: var(--r-btn);
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 150ms ease, transform 100ms ease;
  }
  .btn-buy-action:hover {
    background: var(--red-dark);
  }
  .btn-buy-action:active {
    transform: scale(0.99);
  }
  .btn-buy-action--free {
    background: var(--ink);
  }
  .btn-buy-action--free:hover {
    background: #000000;
  }

  .buy-box__trust {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .trust-item {
    font-size: 12px;
    color: var(--ink-3);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .trust-item :global(svg) {
    color: var(--success);
    flex-shrink: 0;
  }

  .buy-success {
    text-align: center;
    padding: 24px 12px;
  }
  .buy-success__icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 12px;
    display: grid;
    place-items: center;
  }
  .buy-success__title {
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .buy-success__text {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0 0 16px;
  }

  /* Sticky Section Nav Bar */
  .p-secnav {
    position: sticky;
    top: 64px;
    z-index: 20;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-block: 1px solid var(--line);
    margin-bottom: 32px;
  }
  .p-secnav__inner {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-block: 8px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .p-secnav__inner::-webkit-scrollbar {
    display: none;
  }
  .p-secnav__link {
    height: 36px;
    padding: 0 14px;
    border-radius: var(--r-chip);
    border: 1px solid transparent;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    transition: all 150ms ease;
  }
  .p-secnav__link:hover {
    color: var(--ink);
    background: var(--bg-soft);
  }
  .p-secnav__link.is-active {
    background: var(--ink);
    color: #ffffff;
    font-weight: 600;
  }

  /* Content Sections */
  .p-content {
    display: flex;
    flex-direction: column;
    gap: 48px;
    max-width: 900px;
  }
  .p-sec {
    scroll-margin-top: 130px;
  }
  .p-sec__title {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }
  .p-sec__subtext {
    font-size: 15px;
    color: var(--ink-2);
    margin: -8px 0 20px;
  }

  /* Safety Box */
  .p-safety-box {
    background: #FFFBEB;
    border: 1px solid #FDE68A;
    border-left: 4px solid var(--warn);
    border-radius: var(--r-card);
    padding: 16px 20px;
    margin-bottom: 24px;
  }
  .p-safety-box__header {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--warn);
    margin-bottom: 8px;
  }
  .p-safety-box__title {
    font-size: 15px;
    font-weight: 700;
    margin: 0;
  }
  .p-safety-box__body {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* Outcomes & Prereqs */
  .p-subhead {
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    margin: 24px 0 12px;
  }
  .p-check-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .p-check-list li {
    font-size: 15px;
    color: var(--ink-2);
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .p-check-list :global(svg) {
    color: var(--success);
    flex-shrink: 0;
    position: relative;
    top: 2px;
  }

  .p-prereqs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 24px;
  }
  @media (max-width: 640px) {
    .p-prereqs-grid {
      grid-template-columns: 1fr;
    }
  }
  .p-panel {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 18px 20px;
  }
  .p-panel__title {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 10px;
  }
  .p-bullet-list {
    padding-left: 20px;
    margin: 0;
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.6;
  }

  /* Wiring Tables */
  .p-wiring-diagrams {
    display: grid;
    gap: 16px;
    margin-bottom: 24px;
  }
  .p-wiring-diagram {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--bg-soft);
  }
  .p-wiring-diagram img {
    width: 100%;
    height: auto;
    display: block;
  }
  .p-wiring-diagram__cap {
    padding: 10px 16px;
    font-size: 13px;
    color: var(--ink-3);
    font-weight: 500;
    background: var(--bg);
    border-top: 1px solid var(--line);
  }
  .p-pin-module {
    margin-bottom: 24px;
  }
  .p-pin-module__title {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .p-table-wrap {
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--bg);
  }
  .p-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 480px;
  }
  .p-table th {
    background: var(--bg-soft);
    padding: 10px 14px;
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .p-table td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    color: var(--ink);
  }
  .p-table tr:last-child td {
    border-bottom: none;
  }

  .p-wiring-desktop {
    display: block;
  }
  .p-wiring-mobile {
    display: none;
  }

  @media (max-width: 640px) {
    .p-wiring-desktop {
      display: none !important;
    }
    .p-wiring-mobile {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .p-pin-module {
      margin-bottom: 20px;
    }
    .p-pin-module__title {
      position: sticky;
      top: 64px;
      z-index: 10;
      background: var(--bg-soft);
      padding: 8px 12px;
      margin: 0 0 8px 0;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border: 1px solid var(--line);
      border-radius: var(--r-xs);
    }
    .p-pin-card {
      border: 1px solid var(--line);
      border-radius: var(--r-xs);
      background: var(--bg);
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }
    .p-pin-card__connection {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
    }
    .p-pin-from {
      font-weight: 700;
      color: var(--ink);
    }
    .p-pin-arrow {
      color: var(--red);
      font-weight: 600;
    }
    .p-pin-to {
      font-weight: 600;
      color: var(--ink-2);
      background: var(--bg-soft);
      padding: 1px 6px;
      border-radius: 4px;
      border: 1px solid var(--line);
    }
    .p-pin-card__note {
      font-size: 12px;
      color: var(--ink-3);
      line-height: 1.4;
      padding-top: 2px;
    }
  }

  /* Steps Cards */
  .p-steps-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .p-step-card {
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--bg);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: border-color 150ms ease;
  }
  .p-step-card.is-completed {
    border-color: var(--success);
    opacity: 0.85;
  }
  .p-step-card__header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
  }
  .p-step-badge {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--red);
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .p-step-card__title-wrap {
    flex: 1;
  }
  .p-step-card__title {
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }
  .p-step-card__goal {
    font-size: 13px;
    color: var(--ink-3);
    margin: 2px 0 0;
  }
  .p-step-time {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: var(--ink-3);
    font-weight: 500;
  }
  .p-step-card__body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .p-step-card__media {
    border-radius: 8px;
    overflow: hidden;
    max-height: 340px;
    background: var(--bg-soft);
  }
  .p-step-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .p-step-res {
    padding: 12px 16px;
    border-radius: var(--r-btn);
    font-size: 14px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .p-step-res--ok {
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
    color: var(--success);
  }
  .p-step-res--warn {
    background: #FFFBEB;
    border: 1px solid #FDE68A;
    color: var(--warn);
  }
  .p-step-check {
    padding-top: 10px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: flex-end;
  }
  .p-step-check__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
  }
  .p-step-check__label input {
    width: 18px;
    height: 18px;
    accent-color: var(--success);
  }

  /* Files Grid */
  .p-files-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .p-file-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--bg);
    transition: border-color 150ms ease;
  }
  .p-file-item__icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: var(--bg-soft);
    display: grid;
    place-items: center;
    color: var(--red);
    flex-shrink: 0;
  }
  .p-file-item__info {
    flex: 1;
    min-width: 0;
  }
  .p-file-item__name {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    display: block;
    word-break: break-word;
  }
  .p-file-item__meta {
    font-size: 13px;
    color: var(--ink-3);
    margin-top: 2px;
  }
  .p-file-item__action {
    flex-shrink: 0;
  }
  .btn-file-dl {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border-radius: var(--r-btn);
    background: var(--ink);
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease;
  }
  .btn-file-dl:hover {
    background: #000000;
  }
  .file-pack-badge {
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-3);
    background: var(--bg-soft);
    padding: 6px 12px;
    border-radius: var(--r-chip);
    border: 1px solid var(--line);
  }

  /* Code & License */
  .p-license-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn-license-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    border: 1.5px solid var(--ink);
    border-radius: var(--r-btn);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 150ms ease;
  }
  .btn-license-link:hover {
    background: var(--ink);
    color: #ffffff;
  }
  .p-license-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--ink-2);
    padding: 10px 16px;
    border-radius: var(--r-btn);
    background: var(--bg-soft);
    border: 1px solid var(--line);
  }

  /* FAQ Accordion */
  .p-faq-list {
    display: flex;
