---
import type { BomItem } from '../lib/db';
import { getAffiliateSettings, listComponents } from '../lib/db';
import { buildComponentAffiliateUrl, validateAsin, AFFILIATE_LINK_ATTRIBUTES } from '../lib/affiliate';
import { slugify } from '../lib/format';
import { env } from 'cloudflare:workers';

interface Props {
  items: BomItem[];
  projectId?: number;
  projectTitle?: string;
  costChecked?: string;
}

const { items, projectId = 0 } = Astro.props;

const affiliateSettings = await getAffiliateSettings(env.DB);
const allComponents = await listComponents(env.DB);
const validSlugSet = new Set(allComponents.map((c) => slugify(c.name)));

function getLinkInfo(b: BomItem) {
  return buildComponentAffiliateUrl(
    { name: b.name, store: b.store, buy_url: b.affiliate_url },
    b.link,
    affiliateSettings
  );
}

// Prepare cart items with valid ASINs
const asinItems = items
  .filter((b) => b.link?.asin && validateAsin(b.link.asin))
  .map((b) => ({
    asin: b.link!.asin!,
    qty: Math.max(1, parseInt(b.qty, 10) || 1),
  }));

let amazonCartUrl = '';
if (asinItems.length > 0) {
  const cartParams = new URLSearchParams();
  cartParams.set('AssociateTag', affiliateSettings.amazon_tag || 'technicaltr03-21');
  asinItems.forEach((it, idx) => {
    cartParams.set(`ASIN.${idx + 1}`, it.asin);
    cartParams.set(`Quantity.${idx + 1}`, String(it.qty));
  });
  amazonCartUrl = `https://www.amazon.in/gp/aws/cart/add.html?${cartParams.toString()}`;
}
---

<div class="bom-root" data-project-id={projectId}>
  <!-- ==============================================
       DESKTOP PARTS LIST (Matching PartsD.dc.html)
       ============================================== -->
  <div class="bom-desktop">
    <div class="bom-grid">
      <!-- Main Parts List Card -->
      <div class="bom-cd">
        <div class="bom-header-row">
          <h2 class="bom-h2">Parts list</h2>
          <div class="bom-header-right">
            <span class="bom-m">{items.length} parts. Tick them off as you buy.</span>
            <button type="button" class="btn-report-broken-bom" title="Report an incorrect or broken link">
              Report broken link
            </button>
          </div>
        </div>

        <div class="bom-disclosure">
          As an Amazon Associate I earn from qualifying purchases. Buy links are affiliate links.
        </div>

        <div class="bom-rows">
          {items.map((b) => {
            const aff = getLinkInfo(b);
            const slug = slugify(b.name);
            const hasCompPage = b.component_id > 0 || validSlugSet.has(slug);
            const isNonAmazonStore = b.store && !/amazon/i.test(b.store);
            const altStoreUrl = b.affiliate_url && !/amazon/i.test(b.affiliate_url) ? b.affiliate_url : '';

            return (
              <div class="bom-row" data-bom-id={b.id}>
                <label class="bom-check-target" aria-label={`Got ${b.name}`}>
                  <input
                    type="checkbox"
                    class="bom-check"
                    data-item-id={b.id}
                    aria-label={`Got ${b.name}`}
                  />
                </label>

                <div class="bom-info">
                  <div class="bom-item-name">{b.name}</div>
                  {b.notes && <div class="bom-m">{b.notes}</div>}
                  {isNonAmazonStore && (
                    <div class="bom-alt-store">
                      Also at{' '}
                      {altStoreUrl ? (
                        <a href={altStoreUrl} target="_blank" rel="noopener noreferrer" class="bom-alt-link">
                          {b.store}
                        </a>
                      ) : (
                        <span>{b.store}</span>
                      )}
                    </div>
                  )}
                </div>

                <span class="bom-st">Qty {b.qty}</span>

                <a
                  href={aff.url}
                  target={AFFILIATE_LINK_ATTRIBUTES.target}
                  rel={aff.isAffiliate ? AFFILIATE_LINK_ATTRIBUTES.rel : "noopener noreferrer"}
                  class="bom-b"
                  data-affiliate-click={aff.isAffiliate ? '1' : undefined}
                  data-asin={b.link?.asin || undefined}
                  data-comp-id={b.component_id || undefined}
                  title={aff.label}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="bom-icon"><path d="M3 4h2l2 11h11l2-8H6"></path></svg>
                  <span>{aff.isDirectProduct ? 'Buy on Amazon' : 'Search on Amazon'}</span>
                </a>

                {hasCompPage && (
                  <a href={`/components/${slug}`} class="bom-a">
                    <span>Component page</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true" class="bom-icon-sm"><path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6"></path></svg>
                  </a>
                )}
              </div>
            );
          })}
        </div>
      </div>

      <!-- Desktop Sidebar -->
      <aside class="bom-aside">
        {amazonCartUrl && (
          <div class="bom-cd bom-cart-box">
            <h3 class="bom-cart-h3">Buy everything at once</h3>
            <p class="bom-m">Adds all {items.length} parts to your Amazon.in cart. Check the items before you pay.</p>
            <a
              href={amazonCartUrl}
              target="_blank"
              rel="sponsored nofollow noopener noreferrer"
              class="bom-b bom-b-full"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" class="bom-icon"><path d="M3 4h2l2 11h11l2-8H6"></path></svg>
              <span>Add all to Amazon cart</span>
            </a>
          </div>
        )}

        <div class="bom-k">
          <h3 class="bom-k-h3">Before you buy</h3>
          <div class="bom-k-row">
            <span class="bom-k-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="bom-icon-sm"><path d="M12 3a9 9 0 100 18 9 9 0 000-18zM8 12l3 3 5-6"></path></svg>
            </span>
            <span>Match the variant and connector in the note.</span>
          </div>
          <div class="bom-k-row">
            <span class="bom-k-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="bom-icon-sm"><path d="M12 3a9 9 0 100 18 9 9 0 000-18zM8 12l3 3 5-6"></path></svg>
            </span>
            <span>Use the component page for the pinout and datasheet.</span>
          </div>
          <div class="bom-k-row">
            <span class="bom-k-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="bom-icon-sm"><path d="M12 3a9 9 0 100 18 9 9 0 000-18zM8 12l3 3 5-6"></path></svg>
            </span>
            <span>Prices change daily, so check the final total on Amazon.</span>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- ==============================================
       MOBILE PARTS LIST (Matching PartsM.dc.html)
       ============================================== -->
  <div class="bom-mobile">
    <div class="m-bom-lead">
      {items.length} parts. Tick them off as you buy. As an Amazon Associate I earn from qualifying purchases; buy links are affiliate links.
    </div>

    <div class="m-bom-list">
      {items.map((b) => {
        const aff = getLinkInfo(b);
        const slug = slugify(b.name);
        const hasCompPage = b.component_id > 0 || validSlugSet.has(slug);
        const isNonAmazonStore = b.store && !/amazon/i.test(b.store);
        const altStoreUrl = b.affiliate_url && !/amazon/i.test(b.affiliate_url) ? b.affiliate_url : '';

        return (
          <div class="m-bom-card" data-bom-id={b.id}>
            <div class="m-bom-card-top">
              <label class="m-bom-check-wrap" aria-label={`Got ${b.name}`}>
                <input
                  type="checkbox"
                  class="bom-check m-bom-check"
                  data-item-id={b.id}
                  aria-label={`Got ${b.name}`}
                />
              </label>

              <div class="m-bom-info">
                <b class="m-bom-name">{b.name}</b>
                {b.notes && <div class="bom-m">{b.notes}</div>}
                {isNonAmazonStore && (
                  <div class="bom-alt-store">
                    Also at{' '}
                    {altStoreUrl ? (
                      <a href={altStoreUrl} target="_blank" rel="noopener noreferrer" class="bom-alt-link">
                        {b.store}
                      </a>
                    ) : (
                      <span>{b.store}</span>
                    )}
                  </div>
                )}
              </div>

              <span class="bom-st">Qty {b.qty}</span>
            </div>

            <div class="m-bom-actions">
              <a
                href={aff.url}
                target={AFFILIATE_LINK_ATTRIBUTES.target}
                rel={aff.isAffiliate ? AFFILIATE_LINK_ATTRIBUTES.rel : "noopener noreferrer"}
                class="bom-b m-bom-b-primary"
                data-affiliate-click={aff.isAffiliate ? '1' : undefined}
                data-asin={b.link?.asin || undefined}
                data-comp-id={b.component_id || undefined}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" class="bom-icon"><path d="M3 4h2l2 11h11l2-8H6"></path></svg>
                <span>{aff.isDirectProduct ? 'Buy on Amazon' : 'Search on Amazon'}</span>
              </a>

              {hasCompPage && (
                <a href={`/components/${slug}`} class="bom-b bom-g m-bom-b-comp">
                  Component page
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>

    {amazonCartUrl && (
      <div class="m-bom-ab">
        <a
          href={amazonCartUrl}
          target="_blank"
          rel="sponsored nofollow noopener noreferrer"
          class="bom-b m-bom-ab-btn"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="bom-icon"><path d="M3 4h2l2 11h11l2-8H6"></path></svg>
          <span>Add all to Amazon cart</span>
        </a>
      </div>
    )}
  </div>
</div>

<script>
  // Checkbox localStorage progress tracking
  const root = document.querySelector('.bom-root') as HTMLElement | null;
  const projectId = root?.dataset.projectId || 'proj';
  const checkBoxes = document.querySelectorAll<HTMLInputElement>('.bom-check');

  checkBoxes.forEach((cb) => {
    const itemId = cb.getAttribute('data-item-id') || '';
    const storageKey = `tt-bom-${projectId}-${itemId}`;

    // Restore state
    try {
      if (localStorage.getItem(storageKey) === '1') {
        cb.checked = true;
        const row = cb.closest('.bom-row, .m-bom-card');
        if (row) row.classList.add('is-ticked');
      }
    } catch {}

    // Save on toggle
    cb.addEventListener('change', () => {
      try {
        if (cb.checked) {
          localStorage.setItem(storageKey, '1');
        } else {
          localStorage.removeItem(storageKey);
        }
      } catch {}

      // Keep both desktop and mobile inputs in sync if both present
      const peerInputs = document.querySelectorAll<HTMLInputElement>(`.bom-check[data-item-id="${itemId}"]`);
      peerInputs.forEach((p) => {
        p.checked = cb.checked;
        const parentRow = p.closest('.bom-row, .m-bom-card');
        if (parentRow) parentRow.classList.toggle('is-ticked', cb.checked);
      });
    });
  });

  // Passive click tracking via beacon (no redirect / no cloaking)
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('[data-affiliate-click]');
    if (target) {
      const asin = target.getAttribute('data-asin') || '';
      const compId = target.getAttribute('data-comp-id') || '';
      if (navigator.sendBeacon) {
        navigator.sendBeacon(
          '/api/analytics/affiliate-click',
          JSON.stringify({
            asin,
            compId,
            url: location.href,
            time: Date.now(),
          })
        );
      }
    }
  });

  // Report broken link
  document.querySelectorAll('.btn-report-broken-bom').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const partName = prompt('Which component link is incorrect or broken? Enter part name:');
      if (!partName || !partName.trim()) return;

      try {
        await fetch('/api/affiliate/report-broken', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ part_name: partName.trim() }),
        });
        alert('Thank you! This component link has been queued for verification.');
      } catch {
        alert('Thank you! Your feedback has been noted.');
      }
    });
  });
</script>

<style>
  .bom-root {
    width: 100%;
    font-family: inherit;
    color: #0F1115;
  }

  /* Shared Design System (PartsD / PartsM) */
  .bom-m {
    font-size: 14px;
    line-height: 1.5;
    color: #5A6270;
  }
  .bom-a {
    color: #D91F26;
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    flex: none;
    width: 150px;
    transition: color 150ms ease;
  }
  .bom-a:hover {
    color: #B3151B;
  }

  .bom-b {
    border: 0;
    border-radius: 14px;
    height: 48px;
    padding: 0 24px;
    font-weight: 700;
    font-size: 16px;
    background: #D91F26;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: background 150ms ease;
  }
  .bom-b:hover {
    background: #B3151B;
  }

  .bom-g {
    background: #fff;
    color: #0F1115;
    border: 1.5px solid #0F1115;
  }
  .bom-g:hover {
    background: #F4F5F7;
  }

  .bom-st {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 99px;
    background: #E6E9EE;
    color: #3B4350;
    white-space: nowrap;
    flex: none;
  }

  .bom-cd {
    border: 1px solid #E4E7EB;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    display: flex;
    flex-direction: column;
  }

  .bom-k {
    background: #F4F5F7;
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bom-k-h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    color: #0F1115;
  }
  .bom-k-row {
    display: flex;
    gap: 10px;
    font-size: 14px;
    line-height: 1.45;
    color: #0F1115;
  }
  .bom-k-icon {
    color: #D91F26;
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .bom-icon {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }
  .bom-icon-sm {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }

  .bom-alt-store {
    font-size: 13px;
    color: #5A6270;
    margin-top: 2px;
  }
  .bom-alt-link {
    color: #D91F26;
    text-decoration: underline;
  }
  .bom-alt-link:hover {
    color: #B3151B;
  }

  /* Desktop specific */
  .bom-desktop {
    display: block;
    width: 100%;
  }
  .bom-mobile {
    display: none;
  }

  .bom-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 40px;
    align-items: start;
    padding-top: 16px;
    padding-bottom: 48px;
  }
  @media (max-width: 1200px) {
    .bom-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .bom-cd {
    padding: 8px 24px;
    border-radius: 24px;
  }
  .bom-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0 8px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .bom-h2 {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    color: #0F1115;
    letter-spacing: -0.015em;
  }
  .bom-header-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .btn-report-broken-bom {
    background: none;
    border: none;
    padding: 0;
    font-size: 12px;
    color: #5A6270;
    text-decoration: underline;
    cursor: pointer;
  }
  .btn-report-broken-bom:hover {
    color: #D91F26;
  }

  .bom-disclosure {
    font-size: 13px;
    color: #5A6270;
    padding-bottom: 10px;
    border-bottom: 1px solid #E4E7EB;
  }

  .bom-rows {
    display: flex;
    flex-direction: column;
  }

  .bom-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid #E6E9EE;
    transition: opacity 150ms ease;
  }
  .bom-row:first-of-type {
    border-top: 0;
  }
  .bom-row.is-ticked {
    opacity: 0.55;
  }

  .bom-check-target {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    flex: none;
    cursor: pointer;
  }
  .bom-check {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: #D91F26;
    cursor: pointer;
  }

  .bom-info {
    flex: 1;
    min-width: 0;
  }
  .bom-item-name {
    font-weight: 600;
    font-size: 16px;
    color: #0F1115;
    line-height: 1.35;
  }

  .bom-aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 24px;
  }
  .bom-cart-box {
    padding: 24px;
    gap: 12px;
  }
  .bom-cart-h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 700;
  }
  .bom-b-full {
    height: 50px;
    width: 100%;
  }

  /* Mobile Layout */
  @media (max-width: 860px) {
    .bom-desktop {
      display: none !important;
    }
    .bom-mobile {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 8px 0;
    }

    .m-bom-lead {
      font-size: 13px;
      line-height: 1.45;
      color: #5A6270;
      margin-bottom: 6px;
    }

    .m-bom-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .m-bom-card {
      border: 1px solid #E4E7EB;
      border-radius: 16px;
      background: #fff;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      transition: opacity 150ms ease;
    }
    .m-bom-card.is-ticked {
      opacity: 0.55;
    }

    .m-bom-card-top {
      display: flex;
      gap: 6px;
      align-items: flex-start;
    }

    .m-bom-check-wrap {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      flex: none;
      margin: -6px 0 0 -8px;
      cursor: pointer;
    }
    .m-bom-check {
      width: 22px;
      height: 22px;
      margin: 0;
      accent-color: #D91F26;
      cursor: pointer;
    }

    .m-bom-info {
      flex: 1;
      min-width: 0;
    }
    .m-bom-name {
      font-size: 15px;
      color: #0F1115;
      line-height: 1.35;
      display: block;
      margin-bottom: 2px;
    }

    .m-bom-actions {
      display: flex;
      gap: 8px;
      margin-top: 12px;
    }

    .m-bom-b-primary {
      flex: 1;
      min-height: 44px;
      font-size: 14px;
      padding: 0 12px;
    }

    .m-bom-b-comp {
      min-height: 44px;
      font-size: 14px;
      padding: 0 14px;
    }

    .m-bom-ab {
      display: flex;
      gap: 10px;
      padding: 12px 0 16px;
      border-top: 1px solid #E4E7EB;
      background: #fff;
      position: sticky;
      bottom: 0;
      z-index: 10;
    }
    .m-bom-ab-btn {
      flex: 1;
      min-height: 48px;
    }
  }
</style>
