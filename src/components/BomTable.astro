---
import type { BomItem } from '../lib/db';
import { formatINR } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
  items: BomItem[];
  costChecked?: string;
}

const { items, costChecked } = Astro.props;

// Group items into Core vs Tools/Optional
const coreItems = items.filter(
  (b) =>
    !(b.group_name || '').toLowerCase().includes('tool') &&
    !(b.group_name || '').toLowerCase().includes('optional')
);
const toolItems = items.filter(
  (b) =>
    (b.group_name || '').toLowerCase().includes('tool') ||
    (b.group_name || '').toLowerCase().includes('optional')
);

const hasAffiliate = items.some((b) => b.is_affiliate === 1 && b.affiliate_url);
const pricedItems = items.filter((b) => (b.unit_price_inr ?? 0) > 0);
const hasPriced = pricedItems.length > 0;

const totalCoreCost = coreItems
  .filter((b) => (b.unit_price_inr ?? 0) > 0)
  .reduce((sum, b) => {
    const q = parseInt(b.qty, 10);
    const qty = Number.isFinite(q) && q > 0 ? q : 1;
    return sum + b.unit_price_inr * qty;
  }, 0);
---

<div class="bom-meta">
  <div class="bom-meta__affiliate">
    {hasAffiliate && (
      <span>
        Some links are affiliate links. <a href="/legal/affiliate" class="bom-meta__link" target="_blank" rel="noopener noreferrer">Affiliate disclosure</a>.
      </span>
    )}
  </div>
  <div class="bom-meta__date">
    <span>Prices checked {costChecked || 'October 2026'}</span>
  </div>
</div>

<div class="bom-table-wrapper bom-desktop-only">
  <table class="bom-table" id="bom-interactive">
    <thead>
      <tr>
        <th class="col-check">Got</th>
        <th>Part</th>
        <th>Qty</th>
        <th>Price</th>
        <th class="col-buy"></th>
      </tr>
    </thead>
    {coreItems.length > 0 && (
      <tbody class="bom-group">
        <tr>
          <td colspan="5" class="bom-group-title">Core build components</td>
        </tr>
        {coreItems.map((b) => {
          const qty = parseInt(b.qty, 10) || 1;
          const priced = (b.unit_price_inr ?? 0) > 0;
          return (
            <tr class="bom-item-row" data-bom-id={b.id}>
              <td class="col-check">
                <input
                  type="checkbox"
                  class="bom-check"
                  data-price={priced ? b.unit_price_inr * qty : 0}
                  title="I already have this part"
                />
              </td>
              <td>
                <div class="bom-name-wrap">
                  <span class="bom-name">{b.name}</span>
                  {b.notes && <span class="bom-note">{b.notes}</span>}
                </div>
              </td>
              <td class="bom-qty">{b.qty}</td>
              <td class="bom-price">
                {priced ? (
                  formatINR(b.unit_price_inr)
                ) : (
                  <span class="bom-price--unset">Price not set</span>
                )}
              </td>
              <td class="bom-buy-col">
                {b.affiliate_url ? (
                  <a
                    href={b.affiliate_url}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="btn-buy-part"
                  >
                    Buy <Icon name="external-link" size={12} />
                  </a>
                ) : (
                  <span class="bom-empty-dash">—</span>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    )}

    {toolItems.length > 0 && (
      <tbody class="bom-group">
        <tr>
          <td colspan="5" class="bom-group-title">Tools & Optional equipment</td>
        </tr>
        {toolItems.map((b) => {
          const qty = parseInt(b.qty, 10) || 1;
          const priced = (b.unit_price_inr ?? 0) > 0;
          return (
            <tr class="bom-item-row" data-bom-id={b.id}>
              <td class="col-check">
                <input
                  type="checkbox"
                  class="bom-check"
                  data-price={priced ? b.unit_price_inr * qty : 0}
                  checked
                  title="I already have this tool"
                />
              </td>
              <td>
                <div class="bom-name-wrap">
                  <span class="bom-name">{b.name}</span>
                  {b.notes && <span class="bom-note">{b.notes}</span>}
                </div>
              </td>
              <td class="bom-qty">{b.qty}</td>
              <td class="bom-price">
                {priced ? (
                  formatINR(b.unit_price_inr)
                ) : (
                  <span class="bom-price--unset">Price not set</span>
                )}
              </td>
              <td class="bom-buy-col">
                {b.affiliate_url ? (
                  <a
                    href={b.affiliate_url}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="btn-buy-part"
                  >
                    Buy <Icon name="external-link" size={12} />
                  </a>
                ) : (
                  <span class="bom-empty-dash">—</span>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    )}
  </table>

  {hasPriced && totalCoreCost > 0 && (
    <div class="bom-total-row">
      <span class="bom-total-label">Core build estimate (priced parts):</span>
      <span class="bom-total-price" id="bom-calc-total" data-base-total={totalCoreCost}>
        {formatINR(totalCoreCost)}
      </span>
    </div>
  )}
</div>

<!-- Mobile Parts List (Native row layout matching mockup) -->
<div class="bom-mobile-only">
  {coreItems.length > 0 && (
    <div class="m-bom-container">
      <div class="m-bom-header">
        <h3 class="m-bom-title">
          Core cost &asymp; <span id="bom-calc-total-mobile" data-base-total={totalCoreCost}>{formatINR(totalCoreCost)}</span>
        </h3>
        <p class="m-bom-subtitle">Tick off parts as you get them. Every part has a direct buy link.</p>
      </div>

      <div class="m-bom-list">
        {coreItems.map((b) => {
          const qty = parseInt(b.qty, 10) || 1;
          const priced = (b.unit_price_inr ?? 0) > 0;
          return (
            <div class="m-bom-row" data-bom-id={b.id}>
              <label class="m-bom-check-target" aria-label={`Check ${b.name}`}>
                <input
                  type="checkbox"
                  class="bom-check m-bom-check"
                  data-price={priced ? b.unit_price_inr * qty : 0}
                  title="I already have this part"
                />
              </label>

              <div class="m-bom-info">
                <span class="m-bom-name">{b.name}</span>
                {b.notes && <span class="m-bom-note">{b.notes}</span>}
                <span class="m-bom-qty">Qty {b.qty}</span>
              </div>

              <div class="m-bom-action">
                <span class="m-bom-price">
                  {priced ? formatINR(b.unit_price_inr) : '—'}
                </span>
                {b.affiliate_url ? (
                  <a
                    href={b.affiliate_url}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="btn-m-bom-buy"
                  >
                    Buy
                  </a>
                ) : (
                  <span class="btn-m-bom-buy btn-m-bom-buy--dim">Buy</span>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )}

  {toolItems.length > 0 && (
    <div class="m-bom-container" style="margin-top: 24px;">
      <div class="m-bom-header">
        <h4 class="m-bom-title" style="font-size: 16px;">Tools & Optional equipment</h4>
        <p class="m-bom-subtitle">Equipment you may already have on your bench.</p>
      </div>

      <div class="m-bom-list">
        {toolItems.map((b) => {
          const qty = parseInt(b.qty, 10) || 1;
          const priced = (b.unit_price_inr ?? 0) > 0;
          return (
            <div class="m-bom-row" data-bom-id={b.id}>
              <label class="m-bom-check-target" aria-label={`Check ${b.name}`}>
                <input
                  type="checkbox"
                  class="bom-check m-bom-check"
                  data-price={priced ? b.unit_price_inr * qty : 0}
                  checked
                  title="I already have this tool"
                />
              </label>

              <div class="m-bom-info">
                <span class="m-bom-name">{b.name}</span>
                {b.notes && <span class="m-bom-note">{b.notes}</span>}
                <span class="m-bom-qty">Qty {b.qty}</span>
              </div>

              <div class="m-bom-action">
                <span class="m-bom-price">
                  {priced ? formatINR(b.unit_price_inr) : '—'}
                </span>
                {b.affiliate_url ? (
                  <a
                    href={b.affiliate_url}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="btn-m-bom-buy"
                  >
                    Buy
                  </a>
                ) : (
                  <span class="btn-m-bom-buy btn-m-bom-buy--dim">Buy</span>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )}
</div>

<script>
  // Interactive BOM cost calculator
  const checkBoxes = document.querySelectorAll<HTMLInputElement>('.bom-check');
  const totalDisplay = document.getElementById('bom-calc-total');
  const totalDisplayMobile = document.getElementById('bom-calc-total-mobile');

  if (totalDisplay || totalDisplayMobile) {
    const baseTotal = parseFloat(totalDisplay?.dataset.baseTotal || totalDisplayMobile?.dataset.baseTotal || '0');
    let currentDeduction = 0;

    const updateDisplays = (remaining: number) => {
      const formatted = '₹' + remaining.toLocaleString('en-IN');
      if (totalDisplay) totalDisplay.textContent = formatted;
      if (totalDisplayMobile) totalDisplayMobile.textContent = formatted;
    };

    checkBoxes.forEach((cb) => {
      cb.addEventListener('change', () => {
        const itemPrice = parseFloat(cb.dataset.price || '0');
        const row = cb.closest('.m-bom-row');
        if (row) row.classList.toggle('is-ticked', cb.checked);

        const isTool = cb.closest('tbody')?.textContent?.includes('Tools') ||
                       cb.closest('.m-bom-container')?.textContent?.includes('Tools');
        if (!isTool && itemPrice > 0) {
          if (cb.checked) {
            currentDeduction += itemPrice;
          } else {
            currentDeduction -= itemPrice;
          }
          const remaining = Math.max(0, baseTotal - currentDeduction);
          updateDisplays(remaining);
        }
      });
    });
  }
</script>

<style>
  .bom-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--ink-3);
    margin-bottom: 10px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .bom-meta__link {
    color: var(--red);
    text-decoration: underline;
  }
  .bom-meta__link:hover {
    color: var(--red-dark);
  }

  .bom-table-wrapper {
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--bg);
    box-shadow: var(--shadow);
  }

  .bom-table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    text-align: left;
  }
  .bom-table th {
    padding: 10px 14px;
    background: var(--bg-soft);
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--line);
  }
  .bom-table td {
    padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
    font-size: 14px;
    color: var(--ink);
  }
  .bom-table tr:last-child td {
    border-bottom: none;
  }

  .bom-group-title {
    font-weight: 600;
    color: var(--ink-2);
    background: var(--bg-soft);
    padding: 8px 14px !important;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .bom-name-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .bom-name {
    font-weight: 550;
    color: var(--ink);
    line-height: 1.35;
  }
  .bom-note {
    font-size: 12px;
    color: var(--ink-3);
    line-height: 1.35;
  }

  .col-check {
    width: 44px;
    text-align: center;
  }
  .bom-check {
    width: 17px;
    height: 17px;
    accent-color: var(--red);
    cursor: pointer;
  }

  .bom-qty {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    color: var(--ink-2);
    width: 64px;
    white-space: nowrap;
  }

  .bom-price {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    width: 110px;
    text-align: right;
    padding-right: 20px !important;
  }
  .bom-table th:nth-child(4) {
    text-align: right;
    padding-right: 20px !important;
  }
  .bom-price--unset {
    font-family: inherit;
    font-weight: normal;
    font-size: 12px;
    color: var(--ink-3);
    font-style: italic;
  }

  .bom-buy-col {
    text-align: right;
    width: 88px;
    white-space: nowrap;
  }
  .btn-buy-part {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid var(--line);
    border-radius: var(--r-btn);
    color: var(--ink);
    text-decoration: none;
    transition: all 150ms ease;
  }
  .btn-buy-part:hover {
    border-color: var(--red);
    color: var(--red);
    background: var(--bg-soft);
  }
  .bom-empty-dash {
    color: var(--ink-3);
  }

  .bom-total-row {
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
    font-weight: 600;
  }
  .bom-total-label {
    font-size: 14px;
    color: var(--ink-2);
  }
  .bom-total-price {
    font-size: 20px;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--red);
  }

  /* Responsive Display Rules */
  .bom-desktop-only {
    display: block;
  }
  .bom-mobile-only {
    display: none;
  }

  @media (max-width: 768px) {
    .bom-desktop-only {
      display: none !important;
    }
    .bom-mobile-only {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .m-bom-container {
      display: flex;
      flex-direction: column;
    }

    .m-bom-header {
      margin-bottom: 12px;
    }

    .m-bom-title {
      font-size: 20px;
      font-weight: 700;
      color: #0F1115;
      margin: 0 0 4px;
      letter-spacing: -0.01em;
    }

    .m-bom-subtitle {
      font-size: 13px;
      line-height: 1.45;
      color: #5A6270;
      margin: 0;
    }

    .m-bom-list {
      display: flex;
      flex-direction: column;
      border-top: 1px solid #ECEFF2;
    }

    .m-bom-row {
      display: grid;
      grid-template-columns: 44px 1fr auto;
      align-items: start;
      gap: 8px;
      padding: 14px 0;
      border-bottom: 1px solid #ECEFF2;
      transition: opacity 150ms ease;
    }

    .m-bom-row.is-ticked {
      opacity: 0.5;
    }

    .m-bom-check-target {
      min-width: 44px;
      min-height: 44px;
      display: flex;
      align-items: flex-start;
      justify-content: flex-start;
      padding-top: 2px;
      cursor: pointer;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    .m-bom-check {
      width: 22px;
      height: 22px;
      margin: 0;
      border-radius: 4px;
      border: 1.5px solid #CBD5E1;
      accent-color: #0F1115;
      cursor: pointer;
    }

    .m-bom-info {
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 0;
      padding-right: 8px;
    }

    .m-bom-name {
      font-size: 15px;
      font-weight: 700;
      line-height: 1.3;
      color: #0F1115;
      word-break: break-word;
    }

    .m-bom-note {
      font-size: 13px;
      line-height: 1.4;
      color: #5A6270;
      word-break: break-word;
    }

    .m-bom-qty {
      font-size: 13px;
      color: #5A6270;
      font-weight: 500;
      margin-top: 2px;
    }

    .m-bom-action {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
      flex-shrink: 0;
    }

    .m-bom-price {
      font-size: 15px;
      font-weight: 700;
      color: #0F1115;
      white-space: nowrap;
      text-align: right;
    }

    .btn-m-bom-buy {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 62px;
      height: 34px;
      padding: 0 14px;
      border: 1.5px solid #0F1115;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      color: #0F1115;
      background: #ffffff;
      text-decoration: none;
      white-space: nowrap;
      transition: all 150ms ease;
    }

    .btn-m-bom-buy:active {
      transform: scale(0.97);
    }

    .btn-m-bom-buy--dim {
      border-color: #E2E8F0;
      color: #94A3B8;
      cursor: default;
    }
  }
</style>
