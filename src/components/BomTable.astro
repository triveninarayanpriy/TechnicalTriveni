---
import type { BomItem } from '../lib/db';
import { formatINR } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
  items: BomItem[];
  costChecked?: string;
}

const { items, costChecked } = Astro.props;

// Group items
const coreItems = items.filter(b => !(b.group_name || '').toLowerCase().includes('tool') && !(b.group_name || '').toLowerCase().includes('optional'));
const toolItems = items.filter(b => (b.group_name || '').toLowerCase().includes('tool') || (b.group_name || '').toLowerCase().includes('optional'));

const hasAffiliate = items.some(b => b.is_affiliate === 1);
---

<div class="bom-meta" style="display: flex; justify-content: space-between; align-items: flex-end; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.75rem;">
  <div>
    {hasAffiliate && <span>Some links are affiliate links. You pay nothing extra.</span>}
  </div>
  <div>
    {costChecked && <span>Prices checked {costChecked}</span>}
  </div>
</div>

<div class="bom-table-wrapper">
  <table class="bom-table" id="bom-interactive">
    <thead>
      <tr>
        <th class="col-check">Got</th>
        <th>Part</th>
        <th>Qty</th>
        <th>Price</th>
        <th></th>
      </tr>
    </thead>
    {coreItems.length > 0 && (
      <tbody class="bom-group">
        <tr><td colspan="5" class="bom-group-title">Core build</td></tr>
        {coreItems.map((b) => (
          <tr class="bom-item-row" data-bom-id={b.id}>
            <td class="col-check">
              <input type="checkbox" class="bom-check" data-price={b.unit_price_inr * (parseInt(b.qty, 10) || 1)} title="I have this part" />
            </td>
            <td>
              <div class="bom-name-wrap">
                <span class="bom-name">{b.name}</span>
                {b.notes && <span class="bom-note">{b.notes}</span>}
              </div>
            </td>
            <td class="mono">{b.qty}</td>
            <td class="mono bom-price-col">
              {b.unit_price_inr > 0 ? formatINR(b.unit_price_inr) : '-'}
            </td>
            <td class="bom-buy-col">
              {b.affiliate_url ? (
                <a href={b.affiliate_url} target="_blank" rel="nofollow sponsored noopener" class="btn btn-ghost btn-sm btn-buy">
                  Buy <Icon name="arrow-up-right" size={13} />
                </a>
              ) : (
                <span class="dim mono" style="font-size:var(--fs-xs)">-</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    )}
    
    {toolItems.length > 0 && (
      <tbody class="bom-group">
        <tr><td colspan="5" class="bom-group-title">Tools & Optional</td></tr>
        {toolItems.map((b) => (
          <tr class="bom-item-row" data-bom-id={b.id}>
            <td class="col-check">
              <input type="checkbox" class="bom-check" data-price={b.unit_price_inr * (parseInt(b.qty, 10) || 1)} checked title="I have this part" />
            </td>
            <td>
              <div class="bom-name-wrap">
                <span class="bom-name">{b.name}</span>
                {b.notes && <span class="bom-note">{b.notes}</span>}
              </div>
            </td>
            <td class="mono">{b.qty}</td>
            <td class="mono bom-price-col">
              {b.unit_price_inr > 0 ? formatINR(b.unit_price_inr) : '-'}
            </td>
            <td class="bom-buy-col">
              {b.affiliate_url ? (
                <a href={b.affiliate_url} target="_blank" rel="nofollow sponsored noopener" class="btn btn-ghost btn-sm btn-buy">
                  Buy <Icon name="arrow-up-right" size={13} />
                </a>
              ) : (
                <span class="dim mono" style="font-size:var(--fs-xs)">-</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    )}
  </table>
  
  <div class="bom-total-row">
    <span>Your selection:</span>
    <span class="bom-total-price mono" id="bom-calc-total"></span>
  </div>
</div>

<style>
  .bom-table-wrapper { border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden; background: var(--surface); box-shadow: var(--shadow-sm); }
  .bom-table { width: 100%; border-collapse: collapse; text-align: left; }
  .bom-table th { padding: 0.75rem 1rem; background: var(--surface-2); font-size: var(--fs-xs); font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border); }
  .bom-table td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--hairline); vertical-align: middle; }
  .bom-table tr:last-child td { border-bottom: none; }
  .bom-group-title { font-weight: 600; color: var(--text); background: rgba(0,0,0,0.02); padding-top: 1rem !important; padding-bottom: 0.5rem !important; font-size: 0.85rem; }
  .bom-name-wrap { display: flex; flex-direction: column; gap: 0.15rem; }
  .bom-name { font-weight: 500; font-size: var(--fs-sm); }
  .bom-note { font-size: 0.75rem; color: var(--text-muted); }
  .col-check { width: 40px; text-align: center; }
  .bom-buy-col { text-align: right; }
  .btn-buy { padding: 0.35rem 0.6rem; font-size: 0.75rem; border: 1px solid var(--border); }
  .btn-buy:hover { border-color: var(--brand-red); color: var(--brand-red); background: transparent; }
  .bom-total-row { padding: 1.25rem 1rem; display: flex; justify-content: space-between; align-items: center; background: var(--surface-2); border-top: 1px solid var(--border); font-weight: 600; }
  .bom-total-price { font-size: 1.25rem; font-family: var(--font-display); color: var(--brand-red); }
</style>
