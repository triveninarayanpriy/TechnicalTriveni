---
import type { BomItem } from '../lib/db';
import { formatINR } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
  items: BomItem[];
  costChecked?: string;
}

const { items, costChecked } = Astro.props;

// Group items into Core vs Tools/Optional
const coreItems = items.filter(
  (b) =>
    !(b.group_name || '').toLowerCase().includes('tool') &&
    !(b.group_name || '').toLowerCase().includes('optional')
);
const toolItems = items.filter(
  (b) =>
    (b.group_name || '').toLowerCase().includes('tool') ||
    (b.group_name || '').toLowerCase().includes('optional')
);

const hasAffiliate = items.some((b) => b.is_affiliate === 1 && b.affiliate_url);
const pricedItems = items.filter((b) => (b.unit_price_inr ?? 0) > 0);
const hasPriced = pricedItems.length > 0;

const totalCoreCost = coreItems
  .filter((b) => (b.unit_price_inr ?? 0) > 0)
  .reduce((sum, b) => {
    const q = parseInt(b.qty, 10);
    const qty = Number.isFinite(q) && q > 0 ? q : 1;
    return sum + b.unit_price_inr * qty;
  }, 0);
---

<div class="bom-meta">
  <div class="bom-meta__affiliate">
    {hasAffiliate && (
      <span>
        Some links are affiliate links. <a href="/legal/affiliate" class="bom-meta__link" target="_blank" rel="noopener noreferrer">Affiliate disclosure</a>.
      </span>
    )}
  </div>
  <div class="bom-meta__date">
    <span>Prices checked {costChecked || 'October 2026'}</span>
  </div>
</div>

<div class="bom-table-wrapper bom-desktop-only">
  <table class="bom-table" id="bom-interactive">
    <thead>
      <tr>
        <th class="col-check">Got</th>
        <th>Part</th>
        <th>Qty</th>
        <th>Price</th>
        <th class="col-buy"></th>
      </tr>
    </thead>
    {coreItems.length > 0 && (
      <tbody class="bom-group">
        <tr>
          <td colspan="5" class="bom-group-title">Core build components</td>
        </tr>
        {coreItems.map((b) => {
          const qty = parseInt(b.qty, 10) || 1;
          const priced = (b.unit_price_inr ?? 0) > 0;
          return (
            <tr class="bom-item-row" data-bom-id={b.id}>
              <td class="col-check">
                <input
                  type="checkbox"
                  class="bom-check"
                  data-price={priced ? b.unit_price_inr * qty : 0}
                  title="I already have this part"
                />
              </td>
              <td>
                <div class="bom-name-wrap">
                  <span class="bom-name">{b.name}</span>
                  {b.notes && <span class="bom-note">{b.notes}</span>}
                </div>
              </td>
              <td class="bom-qty">{b.qty}</td>
              <td class="bom-price">
                {priced ? (
                  formatINR(b.unit_price_inr)
                ) : (
                  <span class="bom-price--unset">Price not set</span>
                )}
              </td>
              <td class="bom-buy-col">
                {b.affiliate_url ? (
                  <a
                    href={b.affiliate_url}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="btn-buy-part"
                  >
                    Buy <Icon name="external-link" size={12} />
                  </a>
                ) : (
                  <span class="bom-empty-dash">—</span>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    )}

    {toolItems.length > 0 && (
      <tbody class="bom-group">
        <tr>
          <td colspan="5" class="bom-group-title">Tools & Optional equipment</td>
        </tr>
        {toolItems.map((b) => {
          const qty = parseInt(b.qty, 10) || 1;
          const priced = (b.unit_price_inr ?? 0) > 0;
          return (
            <tr class="bom-item-row" data-bom-id={b.id}>
              <td class="col-check">
                <input
                  type="checkbox"
                  class="bom-check"
                  data-price={priced ? b.unit_price_inr * qty : 0}
                  checked
                  title="I already have this tool"
                />
              </td>
              <td>
                <div class="bom-name-wrap">
                  <span class="bom-name">{b.name}</span>
                  {b.notes && <span class="bom-note">{b.notes}</span>}
                </div>
              </td>
              <td class="bom-qty">{b.qty}</td>
              <td class="bom-price">
                {priced ? (
                  formatINR(b.unit_price_inr)
                ) : (
                  <span class="bom-price--unset">Price not set</span>
                )}
              </td>
              <td class="bom-buy-col">
                {b.affiliate_url ? (
                  <a
                    href={b.affiliate_url}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="btn-buy-part"
                  >
                    Buy <Icon name="external-link" size={12} />
                  </a>
                ) : (
                  <span class="bom-empty-dash">—</span>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    )}
  </table>

  {hasPriced && totalCoreCost > 0 && (
    <div class="bom-total-row">
      <span class="bom-total-label">Core build estimate (priced parts):</span>
      <span class="bom-total-price" id="bom-calc-total" data-base-total={totalCoreCost}>
        {formatINR(totalCoreCost)}
      </span>
    </div>
  )}
</div>

<!-- Mobile Parts List (Card-based layout to fit 360px without truncation) -->
<div class="bom-mobile-only">
  {coreItems.length > 0 && (
    <div class="bom-mobile-group">
      <div class="bom-mobile-group__title">Core build components</div>
      <div class="bom-mobile-list">
        {coreItems.map((b) => {
          const qty = parseInt(b.qty, 10) || 1;
          const priced = (b.unit_price_inr ?? 0) > 0;
          return (
            <div class="bom-mobile-card" data-bom-id={b.id}>
              <div class="bom-mobile-card__top">
                <label class="bom-mobile-check-label">
                  <input
                    type="checkbox"
                    class="bom-check"
                    data-price={priced ? b.unit_price_inr * qty : 0}
                    title="I already have this part"
                  />
                  <span class="bom-mobile-name">{b.name}</span>
                </label>
              </div>
              {b.notes && <div class="bom-mobile-note">{b.notes}</div>}
              <div class="bom-mobile-card__bottom">
                <div class="bom-mobile-meta">
                  <span class="bom-mobile-qty">Qty: {b.qty}</span>
                  <span class="bom-mobile-price">
                    {priced ? formatINR(b.unit_price_inr) : <span class="bom-price--unset">Price not set</span>}
                  </span>
                </div>
                {b.affiliate_url ? (
                  <a
                    href={b.affiliate_url}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="btn-buy-part btn-buy-part--mobile"
                  >
                    Buy <Icon name="external-link" size={11} />
                  </a>
                ) : (
                  <span class="bom-empty-dash">—</span>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )}

  {toolItems.length > 0 && (
    <div class="bom-mobile-group">
      <div class="bom-mobile-group__title">Tools & Optional equipment</div>
      <div class="bom-mobile-list">
        {toolItems.map((b) => {
          const qty = parseInt(b.qty, 10) || 1;
          const priced = (b.unit_price_inr ?? 0) > 0;
          return (
            <div class="bom-mobile-card" data-bom-id={b.id}>
              <div class="bom-mobile-card__top">
                <label class="bom-mobile-check-label">
                  <input
                    type="checkbox"
                    class="bom-check"
                    data-price={priced ? b.unit_price_inr * qty : 0}
                    checked
                    title="I already have this tool"
                  />
                  <span class="bom-mobile-name">{b.name}</span>
                </label>
              </div>
              {b.notes && <div class="bom-mobile-note">{b.notes}</div>}
              <div class="bom-mobile-card__bottom">
                <div class="bom-mobile-meta">
                  <span class="bom-mobile-qty">Qty: {b.qty}</span>
                  <span class="bom-mobile-price">
                    {priced ? formatINR(b.unit_price_inr) : <span class="bom-price--unset">Price not set</span>}
                  </span>
                </div>
                {b.affiliate_url ? (
                  <a
                    href={b.affiliate_url}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="btn-buy-part btn-buy-part--mobile"
                  >
                    Buy <Icon name="external-link" size={11} />
                  </a>
                ) : (
                  <span class="bom-empty-dash">—</span>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )}

  {hasPriced && totalCoreCost > 0 && (
    <div class="bom-total-row bom-total-row--mobile">
      <span class="bom-total-label">Core build estimate:</span>
      <span class="bom-total-price" id="bom-calc-total-mobile" data-base-total={totalCoreCost}>
        {formatINR(totalCoreCost)}
      </span>
    </div>
  )}
</div>

<script>
  // Interactive BOM cost calculator
  const checkBoxes = document.querySelectorAll<HTMLInputElement>('.bom-check');
  const totalDisplay = document.getElementById('bom-calc-total');
  const totalDisplayMobile = document.getElementById('bom-calc-total-mobile');

  if (totalDisplay || totalDisplayMobile) {
    const baseTotal = parseFloat(totalDisplay?.dataset.baseTotal || totalDisplayMobile?.dataset.baseTotal || '0');
    let currentDeduction = 0;

    const updateDisplays = (remaining: number) => {
      const formatted = '₹' + remaining.toLocaleString('en-IN');
      if (totalDisplay) totalDisplay.textContent = formatted;
      if (totalDisplayMobile) totalDisplayMobile.textContent = formatted;
    };

    checkBoxes.forEach((cb) => {
      cb.addEventListener('change', () => {
        const itemPrice = parseFloat(cb.dataset.price || '0');
        const isTool = cb.closest('tbody')?.textContent?.includes('Tools') ||
                       cb.closest('.bom-mobile-group')?.textContent?.includes('Tools');
        if (!isTool && itemPrice > 0) {
          if (cb.checked) {
            currentDeduction += itemPrice;
          } else {
            currentDeduction -= itemPrice;
          }
          const remaining = Math.max(0, baseTotal - currentDeduction);
          updateDisplays(remaining);
        }
      });
    });
  }
</script>

<style>
  .bom-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--ink-3);
    margin-bottom: 10px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .bom-meta__link {
    color: var(--red);
    text-decoration: underline;
  }
  .bom-meta__link:hover {
    color: var(--red-dark);
  }

  .bom-table-wrapper {
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--bg);
    box-shadow: var(--shadow);
  }

  .bom-table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    text-align: left;
  }
  .bom-table th {
    padding: 12px 16px;
    background: var(--bg-soft);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--line);
  }
  .bom-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
    font-size: 14px;
    color: var(--ink);
  }
  .bom-table tr:last-child td {
    border-bottom: none;
  }

  .bom-group-title {
    font-weight: 600;
    color: var(--ink-2);
    background: var(--bg-soft);
    padding: 10px 16px !important;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .bom-name-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .bom-name {
    font-weight: 500;
    color: var(--ink);
  }
  .bom-note {
    font-size: 12px;
    color: var(--ink-3);
  }

  .col-check {
    width: 44px;
    text-align: center;
  }
  .bom-check {
    width: 18px;
    height: 18px;
    accent-color: var(--red);
    cursor: pointer;
  }

  .bom-qty {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    color: var(--ink-2);
    width: 60px;
  }

  .bom-price {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    width: 110px;
  }
  .bom-price--unset {
    font-family: inherit;
    font-weight: normal;
    font-size: 13px;
    color: var(--ink-3);
    font-style: italic;
  }

  .bom-buy-col {
    text-align: right;
    width: 90px;
  }
  .btn-buy-part {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid var(--line);
    border-radius: var(--r-btn);
    color: var(--ink);
    text-decoration: none;
    transition: all 150ms ease;
  }
  .btn-buy-part:hover {
    border-color: var(--red);
    color: var(--red);
    background: var(--bg-soft);
  }
  .bom-empty-dash {
    color: var(--ink-3);
  }

  .bom-total-row {
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-soft);
    border-top: 1px solid var(--line);
    font-weight: 600;
  }
  .bom-total-label {
    font-size: 14px;
    color: var(--ink-2);
  }
  .bom-total-price {
    font-size: 20px;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--red);
  }

  /* Responsive Display Rules */
  .bom-desktop-only {
    display: block;
  }
  .bom-mobile-only {
    display: none;
  }

  @media (max-width: 640px) {
    .bom-desktop-only {
      display: none !important;
    }
    .bom-mobile-only {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .bom-mobile-group {
      border: 1px solid var(--line);
      border-radius: var(--r-card);
      overflow: hidden;
      background: var(--bg);
      box-shadow: var(--shadow);
    }
    .bom-mobile-group__title {
      font-weight: 600;
      color: var(--ink-2);
      background: var(--bg-soft);
      padding: 10px 14px;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--line);
    }
    .bom-mobile-list {
      display: flex;
      flex-direction: column;
    }
    .bom-mobile-card {
      padding: 12px 14px;
      border-bottom: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .bom-mobile-card:last-child {
      border-bottom: none;
    }
    .bom-mobile-card__top {
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }
    .bom-mobile-check-label {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      cursor: pointer;
      width: 100%;
    }
    .bom-mobile-check-label input {
      margin-top: 2px;
      flex-shrink: 0;
    }
    .bom-mobile-name {
      font-weight: 600;
      font-size: 14px;
      color: var(--ink);
      line-height: 1.35;
      word-break: break-word;
    }
    .bom-mobile-note {
      font-size: 12px;
      color: var(--ink-3);
      padding-left: 28px;
      line-height: 1.4;
    }
    .bom-mobile-card__bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding-left: 28px;
      margin-top: 2px;
    }
    .bom-mobile-meta {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }
    .bom-mobile-qty {
      font-size: 12px;
      font-family: var(--font-mono, monospace);
      color: var(--ink-2);
      background: var(--bg-soft);
      padding: 2px 6px;
      border-radius: var(--r-xs);
      border: 1px solid var(--line);
    }
    .bom-mobile-price {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 14px;
      color: var(--ink);
      white-space: nowrap;
    }
    .btn-buy-part--mobile {
      padding: 5px 10px;
      font-size: 11px;
      font-weight: 600;
      min-height: 30px;
      flex-shrink: 0;
    }
    .bom-total-row--mobile {
      border: 1px solid var(--line);
      border-radius: var(--r-card);
      padding: 14px 16px;
    }
  }
</style>
