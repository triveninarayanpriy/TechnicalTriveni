---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, FOOTER_LINKS } from '../lib/site';

const year = new Date().getFullYear();
const socials = [
  { key: 'youtube', label: 'YouTube', href: SITE.socials.youtube, icon: 'youtube' },
  { key: 'instagram', label: 'Instagram', href: SITE.socials.instagram, icon: 'instagram' },
  { key: 'github', label: 'GitHub', href: SITE.socials.github, icon: 'github' },
  { key: 'linkedin', label: 'LinkedIn', href: SITE.socials.linkedin, icon: 'linkedin' },
].filter((s) => s.href);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo variant="full" size={30} ink="#ffffff" class="footer-logo" />
        <p class="footer-tagline">{SITE.tagline}</p>
        <div class="footer-socials">
          {socials.map((s) => (
            <a href={s.href} class="social-btn" target="_blank" rel="noopener noreferrer" aria-label={s.label}>
              <span class="social-btn-txt">{s.key === 'youtube' ? 'YT' : s.key === 'instagram' ? 'IG' : s.key === 'github' ? 'GH' : 'in'}</span>
            </a>
          ))}
        </div>
        <p class="footer-streams mono">Electronics · Software · AI</p>
      </div>

      {FOOTER_LINKS.map((group, idx) => (
        <nav class="footer-col" aria-label={group.title} data-footer-group>
          <button
            type="button"
            class="footer-col__header"
            aria-expanded="false"
            aria-controls={`footer-group-${idx}`}
          >
            <span>{group.title}</span>
            <span class="footer-chevron" aria-hidden="true">
              <Icon name="chevron-down" size={16} />
            </span>
          </button>
          <ul id={`footer-group-${idx}`} class="footer-col__list">
            {group.links.map((l) => (
              <li><a href={l.href} class="footer-link">{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}

      <div class="footer-col footer-cta">
        <h3 class="footer-cta__title">Stay in the loop</h3>
        <p class="footer-cta__desc">Get updates on new robotics and IoT project packs.</p>
        <form method="post" action="/api/subscribe" class="footer-form">
          <div class="footer-form__row">
            <input
              type="email"
              name="email"
              required
              placeholder="Enter your email"
              class="footer-input"
              aria-label="Email address"
            />
            <button type="submit" class="btn btn-primary footer-submit">Subscribe</button>
          </div>
          <label class="footer-consent">
            <input type="checkbox" name="consent" class="footer-checkbox" />
            <span>I agree to receive project updates and occasional emails. Unsubscribe anytime.</span>
          </label>
        </form>
      </div>

    </div>

    <div class="footer-bottom">
      <p class="muted">© {year} {SITE.name}. All rights reserved.</p>
      <p class="muted footer-made">
        Built for makers
      </p>
    </div>
  </div>
</footer>

<script>
  function setupFooterAccordions() {
    const groups = document.querySelectorAll<HTMLElement>('[data-footer-group]');
    groups.forEach((group) => {
      const btn = group.querySelector<HTMLButtonElement>('.footer-col__header');
      if (!btn) return;
      btn.addEventListener('click', () => {
        if (window.innerWidth > 768) return;
        const isOpen = group.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(isOpen));
      });
    });
  }
  setupFooterAccordions();
  document.addEventListener('astro:page-load', setupFooterAccordions);
</script>

<style>
  .site-footer {
    --text: #ffffff;
    --text-muted: #a3aab8;
    --text-dim: #7f8798;
    --surface: #1e1e24;
    --surface-2: #282830;
    --border: rgba(255, 255, 255, 0.12);
    --hairline: rgba(255, 255, 255, 0.08);
    margin-top: auto;
    color: #ffffff;
    background: #111418;
    padding-block: 48px 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  @media (min-width: 1024px) {
    .site-footer {
      padding-block: 64px 32px;
    }
  }

  /* Ensure "TECHNICAL" wordmark is always bright white on dark */
  .site-footer :global(.logo__t1) {
    color: #ffffff !important;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    gap: 2.5rem;
  }
  .footer-brand { max-width: 320px; }
  .footer-tagline { color: var(--text-muted); margin-top: 1rem; font-size: 14px; line-height: 1.5; }
  .footer-socials { display: flex; gap: 0.6rem; margin-top: 1.25rem; }
  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px; height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #1B1E24;
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: color 180ms, border-color 180ms, transform 180ms, background 180ms;
  }
  .social-btn:hover {
    color: #ffffff;
    border-color: var(--red);
    transform: translateY(-2px);
    background: #252A33;
  }
  .footer-streams { display: none; }

  /* Desktop Header for link columns: static, no chevron */
  .footer-col__header {
    pointer-events: none;
    cursor: default;
    background: none;
    border: none;
    padding: 0;
    width: 100%;
    text-align: left;
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ffffff;
    margin-bottom: 1rem;
  }
  .footer-chevron {
    display: none;
  }
  .footer-col__list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .footer-link {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    transition: color 180ms;
    display: inline-block;
    padding-block: 2px;
  }
  .footer-link:hover { color: #ffffff; }

  /* Newsletter CTA */
  .footer-cta { align-self: start; }
  .footer-cta__title {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }
  .footer-cta__desc {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }
  .footer-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 100%;
  }
  .footer-form__row {
    display: flex;
    gap: 0.4rem;
  }
  .footer-input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0.6rem 0.8rem;
    border-radius: var(--r-btn);
    border: 1px solid var(--border);
    background: var(--surface);
    color: #ffffff;
    font-size: var(--fs-sm);
  }
  .footer-input:focus {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }
  .footer-submit {
    min-height: 44px;
    padding: 0 1.1rem;
    flex-shrink: 0;
  }
  .footer-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    cursor: pointer;
    line-height: 1.4;
    user-select: none;
  }
  .footer-checkbox {
    margin-top: 2px;
    flex-shrink: 0;
    accent-color: var(--red);
    width: 14px;
    height: 14px;
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .footer-made { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .footer-brand { grid-column: 1 / -1; max-width: none; }
  }

  /* Phones (<= 768px): link groups as accordions */
  @media (max-width: 768px) {
    .site-footer {
      padding-block: 36px 20px;
      background: #111418;
    }
    .footer-grid { grid-template-columns: 1fr; gap: 1rem; }
    .footer-brand { margin-bottom: 0.75rem; }
    .footer-col__header {
      pointer-events: auto;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 44px;
      margin-bottom: 0;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--border);
    }
    .footer-chevron {
      display: inline-flex;
      align-items: center;
      transition: transform 180ms ease;
      color: var(--text-muted);
    }
    .footer-col.is-open .footer-chevron {
      transform: rotate(180deg);
    }
    .footer-col__list {
      display: none;
      padding-top: 0.75rem;
      padding-bottom: 0.5rem;
    }
    .footer-col.is-open .footer-col__list {
      display: flex;
    }
    .footer-cta {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 2rem;
      padding-top: 1.25rem;
      gap: 0.5rem;
      font-size: var(--fs-xs);
    }
  }
</style>
