---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.split('#')[0]) && href !== '/#how-it-works';

const centerLinks = [
  { label: 'Projects', href: '/projects' },
  { label: 'How it works', href: '/how-it-works' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="site-header" id="site-header" data-header>
  <div class="container site-header__inner">
    <Logo size={28} />

    <nav class="nav-desktop" aria-label="Primary">
      {centerLinks.map((item) => (
        <a href={item.href} class:list={['nav-link', { 'is-active': isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a href="/account/downloads" class:list={['nav-link', 'nav-link--downloads', { 'is-active': isActive('/account/downloads') }]}>
        My downloads
      </a>
      <a href="/projects?price=free" class="btn btn-primary btn--header">
        Free resources <Icon name="arrow-right" size={15} />
      </a>

      <!-- Mobile actions: Search icon + Menu toggle -->
      <a href="/projects" class="mobile-search-btn" aria-label="Search projects">
        <Icon name="search" size={22} />
      </a>
      <button class="nav-toggle" data-nav-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Backdrop & Full-Height Sheet -->
  <div class="mobile-sheet-wrap" id="mobile-nav" data-mobile-nav hidden>
    <div class="mobile-backdrop" data-backdrop></div>
    <div class="mobile-sheet" role="dialog" aria-modal="true" aria-label="Site menu">
      <div class="mobile-sheet__header">
        <Logo size={26} />
        <button type="button" class="mobile-sheet__close" data-nav-close aria-label="Close menu">&times;</button>
      </div>

      <nav class="mobile-sheet__nav" aria-label="Mobile Navigation">
        {centerLinks.map((item) => (
          <a href={item.href} class:list={['mobile-sheet__link', { 'is-active': isActive(item.href) }]}>
            {item.label}
          </a>
        ))}
        <a href="/account/downloads" class:list={['mobile-sheet__link', { 'is-active': isActive('/account/downloads') }]}>
          <Icon name="download" size={18} /> My downloads
        </a>
      </nav>

      <div class="mobile-sheet__footer">
        <a href="/projects?price=free" class="btn btn-primary btn-block">
          Free resources <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const header = document.querySelector('[data-header]');
    const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const wrap = document.querySelector<HTMLElement>('[data-mobile-nav]');
    const backdrop = document.querySelector<HTMLElement>('[data-backdrop]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-nav-close]');

    function openMenu() {
      if (!wrap || !toggle) return;
      wrap.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      if (!wrap || !toggle) return;
      wrap.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    toggle?.addEventListener('click', () => {
      const isHidden = wrap?.hasAttribute('hidden');
      if (isHidden) openMenu();
      else closeMenu();
    });

    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !wrap?.hasAttribute('hidden')) {
        closeMenu();
      }
    });

    wrap?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    height: 64px;
    display: flex;
    align-items: center;
    background-color: var(--bg);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 180ms ease, border-color 180ms ease;
  }
  .site-header.is-stuck {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }

  /* Center links on desktop */
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline: auto;
  }
  .nav-link {
    padding: 0.5rem 0.85rem;
    border-radius: var(--r-btn);
    font-size: var(--fs-sm);
    font-weight: 550;
    color: var(--ink-2);
    transition: color 180ms, background 180ms;
    text-decoration: none;
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--bg-soft);
  }
  .nav-link.is-active {
    color: var(--ink);
    font-weight: 600;
  }

  /* Right actions */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav-link--downloads {
    color: var(--ink);
    font-weight: 550;
  }
  .btn--header {
    min-height: 40px;
    padding: 0 1rem;
    font-size: var(--fs-sm);
  }

  /* Mobile icons hidden on desktop */
  .mobile-search-btn,
  .mobile-dl-btn,
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-btn);
    color: var(--ink);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
  }
  .mobile-search-btn:hover,
  .mobile-dl-btn:hover,
  .nav-toggle:hover {
    background: var(--bg-soft);
    border-color: var(--line);
  }

  /* Full-height mobile sheet */
  .mobile-sheet-wrap {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
  }
  .mobile-sheet-wrap[hidden] {
    display: none;
  }
  .mobile-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(21, 19, 20, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .mobile-sheet {
    position: relative;
    width: 100%;
    max-width: 320px;
    height: 100dvh;
    margin-left: auto;
    background: var(--bg);
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    z-index: 10;
    animation: slideIn 180ms ease;
  }
  @keyframes slideIn {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .mobile-sheet__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
    min-height: 64px;
  }
  .mobile-sheet__close {
    background: transparent;
    border: none;
    font-size: 1.75rem;
    color: var(--ink);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    line-height: 1;
    border-radius: var(--r-btn);
  }
  .mobile-sheet__nav {
    display: flex;
    flex-direction: column;
    padding: 1rem 0.75rem;
    flex: 1;
    overflow-y: auto;
    gap: 0.25rem;
  }
  .mobile-sheet__link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    font-weight: 550;
    color: var(--ink);
    border-radius: var(--r-btn);
    text-decoration: none;
    min-height: 44px;
  }
  .mobile-sheet__link:hover,
  .mobile-sheet__link.is-active {
    background: var(--bg-soft);
    color: var(--red);
  }
  .mobile-sheet__footer {
    padding: 1rem 1.25rem 1.5rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 880px) {
    .nav-desktop { display: none; }
    .nav-link--downloads { display: none; }
    .btn--header { display: none; }
    .mobile-search-btn,
    .nav-toggle { display: inline-flex; }
    .mobile-dl-btn { display: none; }
  }
</style>
