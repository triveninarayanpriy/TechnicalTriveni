---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.split('#')[0]) && href !== '/#how-it-works';

const centerLinks = [
  { label: 'Projects', href: '/projects' },
  { label: 'How it works', href: '/how-it-works' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="site-header" id="site-header" data-header>
  <div class="container site-header__inner">
    <Logo size={28} />

    <nav class="nav-desktop" aria-label="Primary">
      {centerLinks.map((item) => (
        <a href={item.href} class:list={['nav-link', { 'is-active': isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a href="/account/downloads" class:list={['nav-link', 'nav-link--downloads', { 'is-active': isActive('/account/downloads') }]}>
        <Icon name="download" size={16} />
        <span>My downloads</span>
      </a>

      <!-- Desktop Search Pill -->
      <form action="/projects" method="get" class="desktop-search-pill" role="search">
        <Icon name="search" size={16} class="search-pill-icon" />
        <input type="search" name="q" placeholder="Search projects" class="search-pill-input" aria-label="Search projects" />
      </form>

      <a href="/resources/free-tools-for-students-india-2026" class="btn btn-primary btn--header">
        Free resources
      </a>

      <!-- Mobile actions: Search icon + Menu toggle -->
      <a href="/projects" class="mobile-search-btn" aria-label="Search projects">
        <Icon name="search" size={22} />
      </a>
      <button class="nav-toggle" data-nav-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <!-- Mobile Full-Screen Menu Overlay -->
  <div class="mobile-sheet-wrap" id="mobile-nav" data-mobile-nav hidden>
    <div class="mobile-backdrop" data-backdrop></div>
    <div class="mobile-sheet" role="dialog" aria-modal="true" aria-label="Site menu">
      <div class="mobile-sheet__header">
        <Logo size={26} />
        <button type="button" class="mobile-sheet__close" data-nav-close aria-label="Close menu">
          <Icon name="close" size={22} />
        </button>
      </div>

      <div class="mobile-sheet__body">
        <!-- Mobile Search Input at top of menu -->
        <form action="/projects" method="get" class="mobile-menu-search" role="search">
          <Icon name="search" size={18} />
          <input type="search" name="q" placeholder="Search projects (e.g. Drone, ESP32)..." class="mobile-menu-search-input" aria-label="Search projects" />
        </form>

        <nav class="mobile-sheet__nav" aria-label="Mobile Navigation">
          {centerLinks.map((item) => (
            <a href={item.href} class:list={['mobile-sheet__link', { 'is-active': isActive(item.href) }]}>
              {item.label}
            </a>
          ))}
        </nav>

        <!-- "My downloads" Card -->
        <a href="/account/downloads" class:list={['mobile-menu-dl-card', { 'is-active': isActive('/account/downloads') }]}>
          <div class="mobile-menu-dl-card__icon">
            <Icon name="download" size={20} />
          </div>
          <div class="mobile-menu-dl-card__info">
            <span class="mobile-menu-dl-card__title">My downloads</span>
            <span class="mobile-menu-dl-card__sub">Access your purchased project packs</span>
          </div>
          <div class="mobile-menu-dl-card__arrow">
            <Icon name="chevron-right" size={18} />
          </div>
        </a>
      </div>

      <div class="mobile-sheet__footer">
        <a href="/resources/free-tools-for-students-india-2026" class="btn btn-primary btn-block mobile-menu-free-btn">
          Free resources <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const header = document.querySelector('[data-header]');
    const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const wrap = document.querySelector<HTMLElement>('[data-mobile-nav]');
    const backdrop = document.querySelector<HTMLElement>('[data-backdrop]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-nav-close]');

    function openMenu() {
      if (!wrap || !toggle) return;
      wrap.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      if (!wrap || !toggle) return;
      wrap.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    toggle?.addEventListener('click', () => {
      const isHidden = wrap?.hasAttribute('hidden');
      if (isHidden) openMenu();
      else closeMenu();
    });

    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !wrap?.hasAttribute('hidden')) {
        closeMenu();
      }
    });

    wrap?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    height: 72px;
    display: flex;
    align-items: center;
    background-color: var(--bg);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 180ms ease, border-color 180ms ease;
  }
  @media (max-width: 768px) {
    .site-header {
      height: 60px;
    }
  }
  .site-header.is-stuck {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
  }

  /* Center links on desktop */
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline: auto;
  }
  .nav-link {
    padding: 0.5rem 0.85rem;
    border-radius: var(--r-btn);
    font-size: 15px;
    font-weight: 550;
    color: var(--ink-2);
    transition: color 180ms, background 180ms;
    text-decoration: none;
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--bg-soft);
  }
  .nav-link.is-active {
    color: var(--red);
    font-weight: 600;
  }

  /* Right actions */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav-link--downloads {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    font-weight: 550;
    font-size: 15px;
  }
  .nav-link--downloads.is-active {
    color: var(--red);
  }

  /* Desktop Search Pill */
  .desktop-search-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0 16px;
    height: 42px;
    width: 190px;
    transition: width 180ms ease, border-color 180ms ease, background 180ms ease;
  }
  .desktop-search-pill:focus-within {
    width: 230px;
    border-color: var(--ink);
    background: #FFFFFF;
  }
  .search-pill-icon {
    color: var(--muted);
    flex-shrink: 0;
  }
  .search-pill-input {
    border: none;
    background: transparent;
    font-family: inherit;
    font-size: 14px;
    color: var(--ink);
    width: 100%;
    outline: none;
  }

  .btn--header {
    min-height: 42px;
    height: 42px;
    padding: 0 18px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 12px;
    background: var(--red);
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: opacity 150ms ease;
  }
  .btn--header:hover {
    opacity: 0.92;
  }

  /* Mobile icons hidden on desktop */
  .mobile-search-btn,
  .mobile-dl-btn,
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-btn);
    color: var(--ink);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
  }
  .mobile-search-btn:hover,
  .mobile-dl-btn:hover,
  .nav-toggle:hover {
    background: var(--bg-soft);
    border-color: var(--line);
  }

  /* Full-Screen Mobile Menu Overlay */
  .mobile-sheet-wrap {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    width: 100vw;
    height: 100dvh;
  }
  .mobile-sheet-wrap[hidden] {
    display: none;
  }
  .mobile-backdrop {
    display: none; /* Full screen overlay replaces side drawer */
  }
  .mobile-sheet {
    position: relative;
    width: 100%;
    height: 100dvh;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    z-index: 10;
    animation: fadeIn 180ms ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .mobile-sheet__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    min-height: 64px;
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }
  .mobile-sheet__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-btn);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    color: var(--ink);
    cursor: pointer;
    transition: background 150ms ease, border-color 150ms ease;
  }
  .mobile-sheet__close:hover {
    background: var(--line);
  }

  .mobile-sheet__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
  }
  .mobile-menu-search {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0 14px;
    min-height: 48px;
    margin-bottom: 1.5rem;
    color: var(--muted);
  }
  .mobile-menu-search-input {
    border: none;
    background: transparent;
    font-family: inherit;
    font-size: 16px;
    color: var(--ink);
    width: 100%;
    outline: none;
  }
  .mobile-sheet__nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .mobile-sheet__link {
    display: flex;
    align-items: center;
    font-size: clamp(1.625rem, 1.4rem + 1.2vw, 2rem);
    font-weight: 700;
    font-family: var(--font-display, 'Space Grotesk', system-ui, sans-serif);
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    padding: 0.5rem 0;
    min-height: 48px;
    transition: color 150ms ease, transform 150ms ease;
  }
  .mobile-sheet__link:hover {
    color: var(--ink);
    transform: translateX(2px);
  }
  .mobile-sheet__link.is-active {
    color: var(--red);
  }

  /* "My downloads" Card */
  .mobile-menu-dl-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
    margin-top: 2rem;
    transition: border-color 150ms ease, background 150ms ease;
    min-height: 60px;
  }
  .mobile-menu-dl-card:hover {
    border-color: var(--ink-3);
  }
  .mobile-menu-dl-card.is-active {
    border-color: var(--red);
    background: rgba(217, 31, 38, 0.04);
  }
  .mobile-menu-dl-card__icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(217, 31, 38, 0.08);
    color: var(--red);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .mobile-menu-dl-card__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .mobile-menu-dl-card__title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ink);
  }
  .mobile-menu-dl-card__sub {
    font-size: 0.8125rem;
    color: var(--ink-3);
    line-height: 1.3;
  }
  .mobile-menu-dl-card__arrow {
    color: var(--ink-3);
    flex-shrink: 0;
  }

  /* Pinned "Free resources" button at bottom */
  .mobile-sheet__footer {
    margin-top: auto;
    padding: 1rem 1.25rem calc(1rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    background: var(--bg);
    flex-shrink: 0;
  }
  .mobile-menu-free-btn {
    height: 48px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
  }

  @media (max-width: 880px) {
    .nav-desktop { display: none; }
    .nav-link--downloads { display: none; }
    .desktop-search-pill { display: none; }
    .btn--header { display: none; }
    .mobile-search-btn,
    .nav-toggle { display: inline-flex; }
    .mobile-dl-btn { display: none; }
  }
</style>
