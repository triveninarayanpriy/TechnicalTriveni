---
import Icon from './Icon.astro';
import type { ProjectFull, Component } from '../lib/db';
import { DIFFICULTIES, FILE_KINDS } from '../lib/site';
import { formatBytes } from '../lib/format';

interface Props {
  project: ProjectFull | null;
  csrf: string;
  components?: Component[];
  categories?: string[];
  tags?: string[];
  hasSnapshot?: boolean;
}
const { project, csrf, components = [], categories = [], tags = [], hasSnapshot = false } = Astro.props;
const p = project;
const isNew = !p;
const val = (v: unknown) => (v === undefined || v === null ? '' : String(v));

const isPaid = p?.combo_enabled === 1;
const hasCover = p?.images && p.images.length > 0;
const hasPrice = p?.price_inr && p.price_inr > 0;
const hasBom = p?.bom && p.bom.length > 0;

const missingPublishChecks: string[] = [];
if (!isNew) {
  if (!hasCover) missingPublishChecks.push('Cover image missing');
  if (isPaid && !hasPrice) missingPublishChecks.push('Price missing for paid combo');
  if (isPaid && !hasBom) missingPublishChecks.push('BOM is empty for paid combo');
}

let showStalePriceWarning = false;
if (p?.cost_checked) {
  const checkDate = new Date(p.cost_checked);
  if (!isNaN(checkDate.getTime())) {
    const daysOld = (new Date().getTime() - checkDate.getTime()) / (1000 * 60 * 60 * 24);
    if (daysOld > 60) {
      showStalePriceWarning = true;
    }
  }
}

const distinctModules = Array.from(new Set([
  'ESP32',
  'NodeMCU ESP8266',
  'Arduino Uno',
  'Raspberry Pi Pico',
  ...(p?.wiring_diagrams?.map((d: any) => d.module).filter(Boolean) || []),
  ...(p?.pins?.map((pin: any) => pin.module).filter(Boolean) || [])
]));
---

<div class="editor-page-container" data-project-id={p?.id || 0}>
  <!-- Hidden main project form anchor for all inputs -->
  <form id="main-project-form" method="post" action="/api/admin/project/save" class="editor-main-form">
    <input type="hidden" name="csrf" value={csrf} />
    {p && <input type="hidden" name="id" value={p.id} />}
  </form>

  <!-- ==============================================
       STANDARD PROJECT EDITOR VIEW
       ============================================== -->
  <div id="editor-standard-view">

  <!-- ==============================================
       DESKTOP TOP BAR (>= 769px)
       Matches media_1791934786618_7c25eb4a.png
       ============================================== -->
  <header class="desktop-editor-header">
    <div class="desktop-header-left">
      <h1 class="desktop-editor-title" title={isNew ? 'New project' : p?.title || 'Project details'}>{isNew ? 'New project' : p?.title || 'Project details'}</h1>
      <span class:list={['admin-chip', p?.published ? 'admin-chip--live' : 'admin-chip--draft']}>
        {p?.published ? 'Live' : 'Draft'}
      </span>
      <span id="autosave-indicator" class="autosave-status" aria-live="polite">Saved</span>
    </div>
    <div class="desktop-header-right">
      {p && (
        <a href={`/projects/${p.slug}`} target="_blank" rel="noopener noreferrer" class="admin-btn admin-btn--secondary">
          <Icon name="eye" size={16} /> Preview
        </a>
      )}
      <div class="desktop-more-menu-wrap">
        <button type="button" class="admin-btn admin-btn--secondary admin-btn--icon" id="desktop-more-menu-btn" aria-label="More actions">
          <Icon name="more-horizontal" size={18} />
        </button>
        <div class="desktop-more-dropdown" id="desktop-more-dropdown" style="display: none;">
          <button type="button" class="dropdown-item"><Icon name="copy" size={15} /> Duplicate</button>
          <button type="button" class="dropdown-item"><Icon name="archive" size={15} /> Archive</button>
          <button type="button" class="dropdown-item"><Icon name="history" size={15} /> Version History</button>
        </div>
      </div>
      <button
        type="button"
        class="admin-btn admin-btn--secondary"
        id="ai-revert-btn"
        style={hasSnapshot ? 'color: var(--admin-red); border-color: rgba(217, 31, 38, 0.4); font-weight: 600;' : 'display: none; color: var(--admin-red); border-color: rgba(217, 31, 38, 0.4); font-weight: 600;'}
        title="Revert project to pre-AI snapshot"
      >
        <Icon name="history" size={16} /> Revert AI changes
      </button>
      <button type="submit" form="main-project-form" name="action" value="draft" class="admin-btn admin-btn--secondary">
        Save draft
      </button>
      <button
        type="submit"
        form="main-project-form"
        name="action"
        value="publish"
        class="admin-btn admin-btn--primary"
        disabled={missingPublishChecks.length > 0}
        title={missingPublishChecks.length > 0 ? missingPublishChecks.join(', ') : 'Publish live to store'}
      >
        Publish
      </button>
    </div>
  </header>

  <!-- ==============================================
       MOBILE EDITOR HEADER (<= 768px)
       ============================================== -->
  <header class="mobile-editor-header">
    <div class="mobile-editor-header__left">
      <a href="/admin/projects" class="mobile-back-btn" aria-label="Back to projects">
        <Icon name="chevron-left" size={24} />
      </a>
      <div class="mobile-editor-title-wrap">
        <h1 class="mobile-editor-title">{isNew ? 'New project' : p?.title || 'Project editor'}</h1>
        <span class:list={['admin-chip', p?.published ? 'admin-chip--live' : 'admin-chip--draft']}>
          {p?.published ? 'Live' : 'Draft'}
        </span>
        <span id="mobile-autosave-indicator" class="autosave-status autosave-status--mobile" aria-live="polite">Saved</span>
      </div>
    </div>
    <div class="mobile-editor-header__right">
      {p && (
        <a href={`/projects/${p.slug}`} target="_blank" rel="noopener noreferrer" class="mobile-header-icon-btn" aria-label="Preview">
          <Icon name="eye" size={22} />
        </a>
      )}
      <div class="mobile-more-menu-wrap">
        <button type="button" class="mobile-header-icon-btn" id="mobile-more-menu-btn" aria-label="More actions">
          <Icon name="more-horizontal" size={22} />
        </button>
        <div class="mobile-more-dropdown" id="mobile-more-dropdown" style="display: none;">
          <button type="button" class="more-dropdown-item"><Icon name="copy" size={16} /> Duplicate</button>
          <button type="button" class="more-dropdown-item"><Icon name="archive" size={16} /> Archive</button>
          <button type="button" class="more-dropdown-item"><Icon name="history" size={16} /> Version History</button>
          <button
            type="button"
            class="more-dropdown-item"
            id="mobile-ai-revert-btn"
            style={hasSnapshot ? 'color: var(--admin-red); font-weight: 600;' : 'display: none; color: var(--admin-red); font-weight: 600;'}
          >
            <Icon name="history" size={16} /> Revert AI changes
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ==============================================
       AMBER ISSUE BANNER
       ============================================== -->
  {missingPublishChecks.length > 0 && (
    <div class="admin-issue-banner-wrap">
      <div class="admin-issue-banner" id="admin-issue-banner">
        <div class="admin-issue-banner__left">
          <Icon name="alert-triangle" size={18} />
          <span>{missingPublishChecks.length} issue{missingPublishChecks.length > 1 ? 's' : ''} block{missingPublishChecks.length === 1 ? 's' : ''} publishing</span>
        </div>
        <button type="button" class="admin-issue-banner__btn" id="review-issues-btn">Review</button>
      </div>
      <ul class="admin-issue-dropdown" id="admin-issue-dropdown" style="display: none;">
        {missingPublishChecks.map((issue) => (
          <li>{issue}</li>
        ))}
      </ul>
    </div>
  )}

  <!-- ==============================================
       GEMINI AI DRAFTING ASSISTANT
       ============================================== -->
  <div class="ai-draft-assistant-box">
    <details class="ai-draft-details" open={isNew}>
      <summary class="ai-draft-summary">
        <div class="ai-summary-left">
          <span class="ai-spark-icon"><Icon name="spark" size={18} /></span>
          <strong>Draft from Notes with Gemini AI</strong>
          <span class="mini-tag ai-tag">Gemini 3.8 Flash</span>
        </div>
        <span class="dim ai-draft-summary-hint">Paste rough notes, code, or BOM to auto-populate editable draft fields</span>
      </summary>
      <div class="ai-draft-body">
        <div class="ai-input-group">
          <label class="label" for="ai-notes-input">
            <span>Rough Project Notes, Description, or Idea</span>
            <span class="dim" style="font-weight: 400;">Your thoughts, overview, features, or terminal logs</span>
          </label>
          <textarea
            class="textarea mono"
            id="ai-notes-input"
            rows="3"
            placeholder="e.g. Build an ESP32 smart home IoT relay controller with Blynk 2.0 app. Uses 5V optocoupled relay on GPIO 23, AC appliance control, manual override switch, brownout capacitor fix..."
          ></textarea>
        </div>

        <!-- Optional Attachments Drawer / Tabs -->
        <div class="ai-attachments-wrap">
          <div class="ai-attachments-header">
            <span class="ai-attachments-title"><Icon name="paperclip" size={14} /> Optional Attachments (Code, BOM, Wiring)</span>
            <div class="ai-attachments-tabs" role="tablist">
              <button type="button" class="ai-attach-tab is-active" data-ai-tab="code">Arduino / ESP Code</button>
              <button type="button" class="ai-attach-tab" data-ai-tab="bom">Pasted BOM</button>
              <button type="button" class="ai-attach-tab" data-ai-tab="wiring">Wiring Notes</button>
            </div>
          </div>

          <!-- Code Panel -->
          <div class="ai-attach-panel" data-ai-panel="code">
            <div class="ai-code-head">
              <span class="dim" style="font-size: 12px;">Paste sketch or upload .ino / .cpp file:</span>
              <label class="admin-btn admin-btn--secondary admin-btn--xs" style="cursor: pointer;">
                <Icon name="upload" size={12} /> Upload File
                <input type="file" id="ai-code-file-input" accept=".ino,.cpp,.h,.c,.py,.txt" style="display: none;" />
              </label>
              <span id="ai-code-file-name" class="dim" style="font-size: 12px; font-style: italic;"></span>
            </div>
            <textarea
              class="textarea mono"
              id="ai-code-input"
              rows="3"
              placeholder="#define RELAY_PIN 23&#10;#define BLYNK_TEMPLATE_ID &quot;TMPLxxxx&quot;&#10;void setup() { pinMode(RELAY_PIN, OUTPUT); ... }"
            ></textarea>
          </div>

          <!-- BOM Panel -->
          <div class="ai-attach-panel" data-ai-panel="bom" hidden>
            <textarea
              class="textarea mono"
              id="ai-bom-input"
              rows="3"
              placeholder="Paste hardware list or parts: e.g.&#10;1x ESP32 DevKit v1 30-pin&#10;1x 5V Relay module (1 channel)&#10;1x 470uF 16V electrolytic capacitor&#10;1x 230V AC terminal block"
            ></textarea>
          </div>

          <!-- Wiring Panel -->
          <div class="ai-attach-panel" data-ai-panel="wiring" hidden>
            <textarea
              class="textarea mono"
              id="ai-wiring-input"
              rows="3"
              placeholder="Pin notes: e.g.&#10;ESP32 GPIO 23 -> Relay IN1&#10;ESP32 VIN (5V) -> Relay VCC&#10;ESP32 GND -> Relay GND"
            ></textarea>
          </div>
        </div>

        <div class="ai-draft-options">
          <label class="ai-checkbox-label" for="ai-include-context">
            <input type="checkbox" id="ai-include-context" checked />
            <span>Include current project fields (Title, Category, Summary) as grounding context</span>
          </label>
        </div>

        <div class="ai-draft-foot">
          <div id="ai-notes-status" class="ai-notes-status-area"></div>
          <button type="button" class="admin-btn admin-btn--primary" id="ai-generate-notes-btn">
            <Icon name="spark" size={15} /> Draft with Gemini
          </button>
        </div>
      </div>
    </details>
  </div>

  <!-- ==============================================
       MOBILE SECTIONS MENU (11-Row Task-Per-Screen App)
       ============================================== -->
  <div class="mobile-sections-menu" id="mobile-sections-menu">
    <div class="mobile-sections-card">
      <!-- 1. Basics -->
      <button type="button" class="mobile-section-row" data-open-section="basics" data-section-title="Basics">
        <div class="section-row-info">
          <span class="section-row-title">Basics</span>
          <span class="section-row-sub">Title, slug, summary, category</span>
        </div>
        <Icon name="chevron-right" size={18} class="section-row-arrow" />
      </button>

      <!-- 2. Media -->
      <button type="button" class="mobile-section-row" data-open-section="media" data-section-title="Media">
        <div class="section-row-info">
          <span class="section-row-title">Media</span>
          <span class="section-row-sub">Photos and 3D, first item is the cover</span>
        </div>
        <Icon name="chevron-right" size={18} class="section-row-arrow" />
      </button>

      <!-- 3. Description -->
      <button type="button" class="mobile-section-row" data-open-section="description" data-section-title="Description">
        <div class="section-row-info">
          <span class="section-row-title">Description</span>
          <span class="section-row-sub">Markdown, safety notice, credits</span>
        </div>
        <Icon name="chevron-right" size={18} class="section-row-arrow" />
      </button>

      <!-- 4. Steps -->
      <button type="button" class="mobile-section-row" data-open-section="steps" data-section-title="Steps">
        <div class="section-row-info">
          <span class="section-row-title">Steps</span>
          <span class="section-row-sub">{p?.steps?.length ? `${p.steps.length} steps` : 'No steps yet'}</span>
        </div>
        {p?.steps?.length ? <Icon name="chevron-right" size={18} class="section-row-arrow" /> : <span class="section-row-add">Add</span>}
      </button>

      <!-- 5. Wiring and connections -->
      <button type="button" class="mobile-section-row" data-open-section="wiring" data-section-title="Wiring and connections">
        <div class="section-row-info">
          <span class="section-row-title">Wiring and connections</span>
          <span class="section-row-sub">{p?.pins?.length ? `${p.pins.length} connections` : 'No connections yet'}</span>
        </div>
        {p?.pins?.length ? <Icon name="chevron-right" size={18} class="section-row-arrow" /> : <span class="section-row-add">Add</span>}
      </button>

      <!-- 6. Troubleshooting -->
      <button type="button" class="mobile-section-row" data-open-section="troubleshooting" data-section-title="Troubleshooting">
        <div class="section-row-info">
          <span class="section-row-title">Troubleshooting</span>
          <span class="section-row-sub">{p?.troubleshooting?.length ? `${p.troubleshooting.length} tips` : 'No tips yet'}</span>
        </div>
        {p?.troubleshooting?.length ? <Icon name="chevron-right" size={18} class="section-row-arrow" /> : <span class="section-row-add">Add</span>}
      </button>

      <!-- 7. Resource links -->
      <button type="button" class="mobile-section-row" data-open-section="links" data-section-title="Resource links">
        <div class="section-row-info">
          <span class="section-row-title">Resource links</span>
          <span class="section-row-sub">{p?.links?.length ? `${p.links.length} links` : 'No links yet'}</span>
        </div>
        {p?.links?.length ? <Icon name="chevron-right" size={18} class="section-row-arrow" /> : <span class="section-row-add">Add</span>}
      </button>

      <!-- 8. Pricing and visibility (opens both combo and visibility) -->
      <button type="button" class="mobile-section-row" data-open-section="combo,visibility" data-section-title="Pricing and visibility">
        <div class="section-row-info">
          <span class="section-row-title">Pricing and visibility</span>
          <span class="section-row-sub">{p?.combo_enabled ? `₹${p.price_inr || 0} combo, ${p?.published ? 'live on site' : 'draft'}` : `Free, ${p?.published ? 'live on site' : 'draft'}`}</span>
        </div>
        <Icon name="chevron-right" size={18} class="section-row-arrow" />
      </button>

      <!-- 9. Search and social -->
      <button type="button" class="mobile-section-row" data-open-section="seo" data-section-title="Search and social">
        <div class="section-row-info">
          <span class="section-row-title">Search and social</span>
          <span class="section-row-sub">Uses title and summary by default</span>
        </div>
        <Icon name="chevron-right" size={18} class="section-row-arrow" />
      </button>

      <!-- 10. Files -->
      <button type="button" class="mobile-section-row" data-open-section="files" data-section-title="Files">
        <div class="section-row-info">
          <span class="section-row-title">Files</span>
          <span class="section-row-sub">{p?.files?.length ? `${p.files.length} files` : 'Paid combo downloads'}</span>
        </div>
        <Icon name="chevron-right" size={18} class="section-row-arrow" />
      </button>

      <!-- 11. Parts (BOM) -->
      <button type="button" class="mobile-section-row" data-open-section="parts" data-section-title="Parts (BOM)">
        <div class="section-row-info">
          <span class="section-row-title">Parts (BOM)</span>
          <span class="section-row-sub">{p?.bom?.length ? `${p.bom.length} parts` : 'No parts yet'}</span>
        </div>
        {p?.bom?.length ? <Icon name="chevron-right" size={18} class="section-row-arrow" /> : <span class="section-row-add">Add</span>}
      </button>
    </div>
  </div>

  <!-- Mobile Drilldown Header (Only visible when a section sub-page is active) -->
  <div class="mobile-drilldown-header" id="mobile-drilldown-header" style="display: none;">
    <button type="button" class="mobile-drilldown-back" id="mobile-drilldown-back-btn">
      <Icon name="chevron-left" size={22} />
      <span id="mobile-drilldown-title">Section</span>
    </button>
  </div>

  <!-- ==============================================
       TWO-COLUMN EDITOR LAYOUT
       Desktop: 2 Columns (Main + 340px sticky rail)
       Mobile: Task-per-screen sub-pages
       ============================================== -->
  <div class="editor-layout">
    <!-- ==================== MAIN COLUMN ==================== -->
    <div class="editor-main-col">
      <!-- 1. Basics Card -->
      <div class="editor-section-card admin-card" data-section="basics">
        <h3 class="card-section-title">Basics</h3>

        <div class="grid-2">
          <div class="field">
            <label class="label" for="title">Title *</label>
            <input class="input" id="title" name="title" form="main-project-form" required maxlength="140" value={val(p?.title)} data-title placeholder="e.g. ESP32 + Blynk IoT Project" />
          </div>
          <div class="field">
            <label class="label" for="slug">Slug (URL)</label>
            <input class="input mono" id="slug" name="slug" form="main-project-form" maxlength="80" placeholder="auto-from-title" value={val(p?.slug)} data-slug />
            <span class="field-hint">Leave blank to auto-generate from the title.</span>
          </div>
        </div>

        <div class="field">
          <label class="label" for="summary">Summary *</label>
          <input class="input" id="summary" name="summary" form="main-project-form" required maxlength="500" placeholder="In this project, we explore how to build..." value={val(p?.summary)} />
        </div>

        <div class="grid-3">
          <div class="field">
            <label class="label" for="category">Category</label>
            <input class="input" id="category" name="category" form="main-project-form" list="cat-list" value={val(p?.category) || 'Electronics'} />
            <datalist id="cat-list">
              <option value="Electronics"></option>
              <option value="Robotics"></option>
              <option value="AI"></option>
              <option value="IoT"></option>
              <option value="Software"></option>
            </datalist>
          </div>
          <div class="field">
            <label class="label" for="difficulty">Difficulty</label>
            <select class="select" id="difficulty" name="difficulty" form="main-project-form">
              {DIFFICULTIES.map((d) => <option value={d} selected={p?.difficulty === d}>{d}</option>)}
            </select>
          </div>
          <div class="field">
            <label class="label" for="build_time">Build time</label>
            <input class="input" id="build_time" name="build_time" form="main-project-form" placeholder="2–3 hours" value={val(p?.build_time)} />
          </div>
        </div>

        <div class="field">
          <label class="label" for="video_url">Video URL (YouTube)</label>
          <input class="input mono" id="video_url" name="video_url" form="main-project-form" placeholder="https://youtube.com/watch?v=…" value={val(p?.video_url)} />
        </div>

        <div class="field">
          <label class="label" for="tags">Tags (comma-separated)</label>
          <input class="input" id="tags" name="tags" form="main-project-form" placeholder="ESP32, Drone, Sensors, Robotics" value={val(p?.tags)} />
        </div>
      </div>

      <!-- 2. Media Card -->
      <div class="editor-section-card admin-card" data-section="media">
        <h3 class="card-section-title">Media</h3>
        <p class="field-hint" style="margin-top:-0.5rem; margin-bottom:1rem;">
          The first item is the cover thumbnail. Photos and .glb 3D files can be reordered.
        </p>

        {isNew ? (
          <div class="empty-state-notice">
            <Icon name="spark" size={24} />
            <p>Save draft first to initialize this project, then you can upload photos, cover thumbnails, and 3D models.</p>
          </div>
        ) : (
          <div class="media-container">
            <!-- 4-Up Grid for Media -->
            <div class="media-grid-4up">
              {p.images.map((img, i) => {
                const isUnused = img.kind !== 'cover' && img.kind !== 'model' && !(p.description?.includes(img.url)) && !(p.safety_note?.includes(img.url));
                const displayName = img.url.split('/').pop()?.replace(/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}-/, '') || 'file';
                return (
                  <div class="media-thumb-card" data-id={img.id} data-index={i} draggable="true">
                    {i === 0 && <span class="media-cover-badge">Cover</span>}
                    <div class="media-thumb-top-actions">
                      <button type="button" class="media-drag-handle" tabindex="0" role="button" aria-label="Drag to reorder" title="Drag to reorder (or press Space + Arrow keys)">
                        <Icon name="grip-vertical" size={14} />
                      </button>
                      <div class="media-del-wrap">
                        <button type="button" class="thumb-ctrl-btn thumb-ctrl-btn--del media-del-trigger" title="Delete photo" aria-label="Delete photo">
                          <Icon name="close" size={13} />
                        </button>
                        <div class="media-del-popover" style="display: none;" role="dialog" aria-label="Confirm deletion">
                          <span class="popover-text">Remove this photo?</span>
                          <div class="popover-actions">
                            <button type="button" class="popover-btn popover-btn--del">Remove</button>
                            <button type="button" class="popover-btn popover-btn--cancel">Cancel</button>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="media-thumb-preview">
                      {img.kind === 'model' ? (
                        <div class="media-model-icon"><Icon name="layers" size={24} /><span>3D</span></div>
                      ) : (
                        <img src={img.url} alt={img.caption || displayName} loading="lazy" />
                      )}
                    </div>
                    <div class="media-thumb-footer">
                      <span class="media-thumb-filename mono" title={img.url}>{displayName}</span>
                      <div class="media-thumb-actions">
                        <button class="thumb-ctrl-btn media-move-left-btn" type="button" disabled={i === 0} title="Move left / earlier"><Icon name="chevron-left" size={13} /></button>
                        <button class="thumb-ctrl-btn media-move-right-btn" type="button" disabled={i === p.images.length - 1} title="Move right / later"><Icon name="chevron-right" size={13} /></button>
                      </div>
                    </div>
                  </div>
                );
              })}

              <!-- Upload slot -->
              <div class="media-upload-slot">
                <form method="post" action="/api/admin/media/add" enctype="multipart/form-data" class="media-upload-form" data-media-form>
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="project_id" value={p.id} />
                  <label class="media-upload-label">
                    <input class="media-upload-input" type="file" name="files" accept="image/*,.glb,.gltf,model/gltf-binary,model/gltf+json" multiple data-media-input />
                    <Icon name="upload-cloud" size={24} />
                    <span class="upload-label-text">Upload</span>
                  </label>
                  <div class="upload-progress" data-progress hidden>
                    <div class="upload-progress__bar"><span data-progress-fill></span></div>
                    <span class="upload-progress__pct mono" data-progress-pct>0%</span>
                  </div>
                </form>
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- 3. Description Card -->
      <div class="editor-section-card admin-card" data-section="description">
        <h3 class="card-section-title">Description</h3>

        <div class="field">
          <label class="label" for="description">Overview &amp; Description (Markdown) *</label>
          <textarea class="textarea editor-desc" id="description" name="description" form="main-project-form" placeholder="## What you'll build…" data-markdown>{val(p?.description)}</textarea>
        </div>

        <div class="field">
          <label class="label">What you will learn / Outcomes</label>
          <div class="list-editor" data-name="outcomes_json" data-type="string" data-value={val(p?.outcomes_json) || '[]'}></div>
        </div>

        <div class="field">
          <label class="label">Prerequisites</label>
          <div class="list-editor" data-name="prereqs_json" data-type="string" data-value={val(p?.prereqs_json) || '[]'}></div>
        </div>

        <div class="field">
          <label class="label">Frequently Asked Questions (FAQ)</label>
          <div class="list-editor" data-name="faq_json" data-type="faq" data-value={val(p?.faq_json) || '[]'}></div>
        </div>

        <div class="field">
          <label class="label" for="safety_note">Safety note (Markdown) — required for mains / battery / motor builds</label>
          <textarea class="textarea" id="safety_note" name="safety_note" form="main-project-form" placeholder="This project uses 230V AC mains. Work with power off…" data-markdown data-templates="safety">{val(p?.safety_note)}</textarea>
        </div>

        <div class="field">
          <label class="label" for="credits">Credits &amp; attributions (Markdown)</label>
          <textarea class="textarea" id="credits" name="credits" form="main-project-form" placeholder="Library X by … (MIT). Wiring based on …" data-markdown>{val(p?.credits)}</textarea>
        </div>
      </div>

      <!-- 4. Steps Card -->
      <div class="editor-section-card admin-card" data-section="steps">
        <div class="card-header-split">
          <div>
            <h3 class="card-section-title">Steps</h3>
            <p class="field-hint" style="margin: 0;">{p?.steps?.length ? `${p.steps.length} build steps configured` : 'No steps yet'}</p>
          </div>
          <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="toggle-add-step-btn">
            <Icon name="plus" size={14} /> Add
          </button>
        </div>

        {isNew ? (
          <div class="empty-state-notice">
            <Icon name="spark" size={24} />
            <p>Save draft first to initialize this project, then you can write build instructions.</p>
          </div>
        ) : (
          <div class="steps-container" style="margin-top: 1rem;">
            <div class="rows">
              {p.steps.map((s, i) => (
                <details class="data-row-edit" style="background: var(--admin-bg); border: 1px solid var(--admin-line); border-radius: 12px; margin-bottom: 0.5rem;">
                  <summary class="data-row" style="cursor: pointer; padding: 0.85rem 1rem; display: flex; align-items: center; border: none; background: transparent; list-style: none;">
                    <span class="data-row__icon step-badge">{i + 1}</span>
                    <div class="data-row__main" style="flex: 1; min-width: 0;">
                      <strong style="display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{s.title || s.body.slice(0, 50) || 'Step'}</strong>
                      {s.why && <span class="dim" style="font-size: 13px;">Why: {s.why}</span>}
                    </div>
                    <div class="row-ctrl" style="display: flex; gap: 0.35rem; align-items: center;">
                      <span class="admin-btn admin-btn--secondary admin-btn--sm" style="pointer-events: none; padding: 2px 8px; font-size: 12px;"><Icon name="edit" size={13} /> Edit</span>
                      {['up', 'down'].map((dir) => (
                        <form method="post" action="/api/admin/step/move" class="inline-form">
                          <input type="hidden" name="csrf" value={csrf} />
                          <input type="hidden" name="id" value={s.id} />
                          <input type="hidden" name="project_id" value={p.id} />
                          <input type="hidden" name="dir" value={dir} />
                          <button class="thumb-ctrl-btn" type="submit" onclick="event.stopPropagation();" disabled={dir === 'up' ? i === 0 : i === p.steps.length - 1} title={dir === 'up' ? 'Move earlier' : 'Move later'}>
                            <Icon name={dir === 'up' ? 'chevron-up' : 'chevron-down'} size={13} />
                          </button>
                        </form>
                      ))}
                      <form method="post" action="/api/admin/step/delete" class="inline-form">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="id" value={s.id} />
                        <input type="hidden" name="project_id" value={p.id} />
                        <button class="thumb-ctrl-btn thumb-ctrl-btn--del" type="submit" onclick="event.stopPropagation();"><Icon name="trash" size={13} /></button>
                      </form>
                    </div>
                  </summary>
                  <form method="post" action="/api/admin/step/update" class="stack-add" style="padding: 1rem; border-top: 1px dashed var(--admin-line); background: #FAFBFD; border-radius: 0 0 12px 12px;">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="id" value={s.id} />
                    <input type="hidden" name="project_id" value={p.id} />
                    <input class="input" name="title" value={s.title || ''} placeholder="Title (optional)" />
                    <textarea class="textarea" name="body" placeholder="Step instructions (Markdown)…" required data-markdown>{s.body}</textarea>
                    <input class="input" name="why" value={s.why || ''} placeholder="Why are we doing this? (optional)" />
                    <button class="admin-btn admin-btn--primary admin-btn--sm" type="submit"><Icon name="check" size={15} /> Save Step</button>
                  </form>
                </details>
              ))}
            </div>

            <!-- Add Step Form (Expandable) -->
            <form method="post" action="/api/admin/step/add" class="stack-add add-card-box" id="add-step-form" style="display: none; margin-top: 1rem;">
              <h4 style="margin: 0; font-size: 15px; font-weight: 700;">Add a Build Step</h4>
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="project_id" value={p.id} />
              <input class="input" name="title" placeholder="Step title (e.g. Flash the Microcontroller)" />
              <textarea class="textarea" name="body" placeholder="Step instruction details (supports Markdown, code chips, bullet points)…" required data-markdown></textarea>
              <div class="grid-2">
                <input class="input" name="why" placeholder="Why / gotcha note (optional)" />
                <input class="input mono" name="image_url" placeholder="Diagram or photo URL (optional)" />
              </div>
              <div style="display:flex; justify-content: flex-end; gap: 0.5rem;">
                <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="cancel-add-step-btn">Cancel</button>
                <button class="admin-btn admin-btn--primary admin-btn--sm" type="submit"><Icon name="plus" size={14} /> Add Step</button>
              </div>
            </form>
          </div>
        )}
      </div>

      <!-- 5. Wiring and connections Card -->
      <div class="editor-section-card admin-card" data-section="wiring">
        <div class="card-header-split">
          <div>
            <h3 class="card-section-title">Wiring and connections</h3>
            <p class="field-hint" style="margin: 0;">{p?.pins?.length ? `${p.pins.length} pin connections` : 'No connections yet'}</p>
          </div>
          <div style="display: flex; gap: 0.5rem; align-items: center;">
            <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="toggle-add-diagram-btn">
              <Icon name="layers" size={14} /> Add Diagram
            </button>
            <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="toggle-add-pin-btn">
              <Icon name="plus" size={14} /> Add Pin
            </button>
          </div>
        </div>

        {isNew ? (
          <div class="empty-state-notice">
            <Icon name="spark" size={24} />
            <p>Save draft first to initialize this project, then you can configure pin connections and diagrams.</p>
          </div>
        ) : (
          <div class="wiring-container" style="margin-top: 1rem;">
            <!-- Datalist for modules/boards -->
            <datalist id="wiring-module-list">
              {distinctModules.map((m) => (
                <option value={m} />
              ))}
            </datalist>

            <!-- Subpanel: Circuit Diagrams & Schematics by Board/Module -->
            <div class="wiring-diagrams-subpanel" style="margin-bottom: 1.5rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--admin-line);">
              <div style="margin-bottom: 0.75rem;">
                <h4 style="margin: 0; font-size: 14.5px; font-weight: 700; color: #0F172A; display: flex; align-items: center; gap: 6px;">
                  <Icon name="layers" size={16} /> Circuit Diagrams & Schematics
                </h4>
                <p class="field-hint" style="margin: 2px 0 0 0; font-size: 12.5px;">
                  Upload schematics tagged by board (e.g. <strong>ESP32</strong> vs <strong>NodeMCU</strong>) so users follow the right wiring for their board & code.
                </p>
              </div>

              <!-- List of uploaded diagrams -->
              {p.wiring_diagrams && p.wiring_diagrams.length > 0 ? (
                <div class="wiring-diagram-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; margin-bottom: 1rem;">
                  {p.wiring_diagrams.map((d, di) => (
                    <div class="wiring-diagram-card" style="border: 1px solid var(--admin-line); border-radius: 10px; overflow: hidden; background: #FFF;">
                      <div style="position: relative; height: 130px; background: #F8FAFC; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                        <img src={d.url} alt={d.label} style="width: 100%; height: 100%; object-fit: contain;" />
                        {d.module && (
                          <span style="position: absolute; top: 6px; left: 6px; background: #EEF2FF; color: #4338CA; border: 1px solid #C7D2FE; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 4px;">
                            {d.module}
                          </span>
                        )}
                      </div>
                      <div style="padding: 10px; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                        <div style="min-width: 0; flex: 1;">
                          <div style="font-size: 13px; font-weight: 600; color: #0F172A; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            {d.label || 'Wiring diagram'}
                          </div>
                          <div style="font-size: 11.5px; color: #64748B;">Board: <strong>{d.module || 'All Boards'}</strong></div>
                        </div>
                        <div style="display: flex; gap: 4px; align-items: center;">
                          {['up', 'down'].map((dir) => (
                            <form method="post" action="/api/admin/wiring/move" class="inline-form">
                              <input type="hidden" name="csrf" value={csrf} />
                              <input type="hidden" name="id" value={d.id} />
                              <input type="hidden" name="project_id" value={p.id} />
                              <input type="hidden" name="dir" value={dir} />
                              <button class="thumb-ctrl-btn" type="submit" disabled={dir === 'up' ? di === 0 : di === p.wiring_diagrams.length - 1} title={dir === 'up' ? 'Move earlier' : 'Move later'}>
                                <Icon name={dir === 'up' ? 'chevron-up' : 'chevron-down'} size={12} />
                              </button>
                            </form>
                          ))}
                          <form method="post" action="/api/admin/wiring/delete" class="inline-form">
                            <input type="hidden" name="csrf" value={csrf} />
                            <input type="hidden" name="id" value={d.id} />
                            <input type="hidden" name="project_id" value={p.id} />
                            <button class="thumb-ctrl-btn thumb-ctrl-btn--del" type="submit" title="Delete diagram">
                              <Icon name="trash" size={12} />
                            </button>
                          </form>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <p style="font-size: 13px; color: #64748B; font-style: italic; margin: 0.5rem 0 1rem 0;">No circuit diagrams uploaded yet. Upload schematics for your target boards (e.g. ESP32, NodeMCU).</p>
              )}

              <!-- Add Diagram Form -->
              <form method="post" action="/api/admin/wiring/add" enctype="multipart/form-data" class="add-card-box" id="add-diagram-form" style="display: none; margin-top: 0.75rem; background: #F8FAFC; border: 1px dashed var(--admin-line); padding: 1rem; border-radius: 10px;">
                <h5 style="margin: 0 0 0.5rem 0; font-size: 14px; font-weight: 700;">Upload Circuit Diagram / Schematic</h5>
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="project_id" value={p.id} />
                <div class="grid-2">
                  <div>
                    <label class="field-label" style="font-size: 12px;">Diagram Label / Title</label>
                    <input class="input" name="label" placeholder="e.g. ESP32 Pinout & Circuit Schematic" required />
                  </div>
                  <div>
                    <label class="field-label" style="font-size: 12px;">Target Board / Module</label>
                    <input class="input" name="module" list="wiring-module-list" placeholder="e.g. ESP32 or NodeMCU ESP8266" />
                  </div>
                </div>
                <div class="grid-2" style="margin-top: 0.5rem;">
                  <div>
                    <label class="field-label" style="font-size: 12px;">Upload Image File</label>
                    <input type="file" name="file" accept="image/*" class="input" />
                  </div>
                  <div>
                    <label class="field-label" style="font-size: 12px;">Or Diagram Image URL</label>
                    <input class="input mono" name="url" placeholder="https://..." />
                  </div>
                </div>
                <div style="display:flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.75rem;">
                  <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="cancel-add-diagram-btn">Cancel</button>
                  <button class="admin-btn admin-btn--primary admin-btn--sm" type="submit"><Icon name="upload" size={14} /> Upload Diagram</button>
                </div>
              </form>
            </div>

            <!-- Subpanel: Pin Connections List -->
            <div style="margin-bottom: 0.75rem;">
              <h4 style="margin: 0; font-size: 14.5px; font-weight: 700; color: #0F172A;">
                Pin-to-Pin Connections
              </h4>
            </div>

            <div class="rows">
              {p.pins.map((pin, i) => (
                <details class="data-row-edit" style="background: var(--admin-bg); border: 1px solid var(--admin-line); border-radius: 12px; margin-bottom: 0.5rem;">
                  <summary class="data-row" style="cursor: pointer; padding: 0.85rem 1rem; display: flex; align-items: center; border: none; background: transparent; list-style: none;">
                    <div class="data-row__main" style="flex: 1; min-width: 0;">
                      <strong class="mono" style="font-size: 14px;">{pin.from_pin} → {pin.to_pin}</strong>
                      {pin.module && <span class="mini-tag" style="margin-left: 0.5rem; background: #EEF2FF; color: #4338CA;">{pin.module}</span>}
                      {pin.note && <span class="dim" style="display: block; font-size: 13px; margin-top: 0.2rem;">{pin.note}</span>}
                    </div>
                    <div class="row-ctrl" style="display: flex; gap: 0.35rem; align-items: center;">
                      <span class="admin-btn admin-btn--secondary admin-btn--sm" style="pointer-events: none; padding: 2px 8px; font-size: 12px;"><Icon name="edit" size={13} /> Edit</span>
                      {['up', 'down'].map((dir) => (
                        <form method="post" action="/api/admin/pin/move" class="inline-form">
                          <input type="hidden" name="csrf" value={csrf} />
                          <input type="hidden" name="id" value={pin.id} />
                          <input type="hidden" name="project_id" value={p.id} />
                          <input type="hidden" name="dir" value={dir} />
                          <button class="thumb-ctrl-btn" type="submit" onclick="event.stopPropagation();" disabled={dir === 'up' ? i === 0 : i === p.pins.length - 1} title={dir === 'up' ? 'Move earlier' : 'Move later'}>
                            <Icon name={dir === 'up' ? 'chevron-up' : 'chevron-down'} size={13} />
                          </button>
                        </form>
                      ))}
                      <form method="post" action="/api/admin/pin/delete" class="inline-form">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="id" value={pin.id} />
                        <input type="hidden" name="project_id" value={p.id} />
                        <button class="thumb-ctrl-btn thumb-ctrl-btn--del" type="submit" onclick="event.stopPropagation();"><Icon name="trash" size={13} /></button>
                      </form>
                    </div>
                  </summary>
                  <form method="post" action="/api/admin/pin/update" class="add-row" style="padding: 1rem; border-top: 1px dashed var(--admin-line); background: #FAFBFD; border-radius: 0 0 12px 12px;">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="id" value={pin.id} />
                    <input type="hidden" name="project_id" value={p.id} />
                    <input class="input mono" name="from_pin" value={pin.from_pin} placeholder="From (ESP32 D5)" required />
                    <input class="input mono" name="to_pin" value={pin.to_pin} placeholder="To (Relay IN1)" required />
                    <input class="input" name="module" value={pin.module || ''} list="wiring-module-list" placeholder="Module / Board (e.g. ESP32)" />
                    <input class="input" name="note" value={pin.note || ''} placeholder="Note (optional)" />
                    <button class="admin-btn admin-btn--primary admin-btn--sm" type="submit"><Icon name="check" size={15} /> Save</button>
                  </form>
                </details>
              ))}
            </div>

            <!-- Add Pin Form -->
            <form method="post" action="/api/admin/pin/add" class="add-card-box" id="add-pin-form" style="display: none; margin-top: 1rem;">
              <h4 style="margin: 0 0 0.5rem 0; font-size: 15px; font-weight: 700;">Add Pin Connection</h4>
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="project_id" value={p.id} />
              <div class="grid-2">
                <input class="input mono" name="from_pin" id="wiring-from-pin" placeholder="From (e.g. ESP32 D5)" required />
                <input class="input mono" name="to_pin" id="wiring-to-pin" placeholder="To (e.g. Relay IN1)" required />
              </div>
              <div class="grid-2" style="margin-top: 0.5rem;">
                <input class="input" name="module" list="wiring-module-list" placeholder="Module / Board (e.g. ESP32 or NodeMCU)" />
                <input class="input" name="note" id="wiring-note" placeholder="Note (e.g. 10k Pull-up)" />
              </div>
              <div style="display:flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.75rem;">
                <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="cancel-add-pin-btn">Cancel</button>
                <button class="admin-btn admin-btn--primary admin-btn--sm" type="submit"><Icon name="plus" size={14} /> Add Pin</button>
              </div>
            </form>
          </div>
        )}
      </div>

      <!-- 6. Troubleshooting Card -->
      <div class="editor-section-card admin-card" data-section="troubleshooting">
        <div class="card-header-split">
          <div>
            <h3 class="card-section-title">Troubleshooting</h3>
            <p class="field-hint" style="margin: 0;">{p?.troubleshooting?.length ? `${p.troubleshooting.length} tips` : 'No tips yet'}</p>
          </div>
          <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="toggle-add-trouble-btn">
            <Icon name="plus" size={14} /> Add
          </button>
        </div>

        {isNew ? (
          <div class="empty-state-notice">
            <Icon name="spark" size={24} />
            <p>Save draft first to initialize this project, then you can add troubleshooting tips.</p>
          </div>
        ) : (
          <div class="troubleshooting-container" style="margin-top: 1rem;">
            <div class="rows">
              {p.troubleshooting.map((t, i) => (
                <details class="data-row-edit" style="background: var(--admin-bg); border: 1px solid var(--admin-line); border-radius: 12px; margin-bottom: 0.5rem;">
                  <summary class="data-row" style="cursor: pointer; padding: 0.85rem 1rem; display: flex; align-items: center; border: none; background: transparent; list-style: none;">
                    <div class="data-row__main" style="flex: 1; min-width: 0;">
                      <strong style="display: block; font-size: 14px;">{t.symptom}</strong>
                      {t.cause && (
                        <span class="dim" style="display: block; font-size: 13px; margin-top: 0.2rem;">
                          <strong style="color: var(--admin-red);">Cause:</strong> {t.cause}
                        </span>
                      )}
                      <span class="dim" style="display: block; font-size: 13px; margin-top: 0.2rem;">
                        <strong>Fix:</strong> {t.fix}
                      </span>
                    </div>
                    <div class="row-ctrl" style="display: flex; gap: 0.35rem; align-items: center;">
                      <span class="admin-btn admin-btn--secondary admin-btn--sm" style="pointer-events: none; padding: 2px 8px; font-size: 12px;"><Icon name="edit" size={13} /> Edit</span>
                      {['up', 'down'].map((dir) => (
                        <form method="post" action="/api/admin/trouble/move" class="inline-form">
                          <input type="hidden" name="csrf" value={csrf} />
                          <input type="hidden" name="id" value={t.id} />
                          <input type="hidden" name="project_id" value={p.id} />
                          <input type="hidden" name="dir" value={dir} />
                          <button class="thumb-ctrl-btn" type="submit" onclick="event.stopPropagation();" disabled={dir === 'up' ? i === 0 : i === p.troubleshooting.length - 1} title={dir === 'up' ? 'Move earlier' : 'Move later'}>
                            <Icon name={dir === 'up' ? 'chevron-up' : 'chevron-down'} size={13} />
                          </button>
                        </form>
                      ))}
                      <form method="post" action="/api/admin/trouble/delete" class="inline-form">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="id" value={t.id} />
                        <input type="hidden" name="project_id" value={p.id} />
                        <button class="thumb-ctrl-btn thumb-ctrl-btn--del" type="submit" onclick="event.stopPropagation();"><Icon name="trash" size={13} /></button>
                      </form>
                    </div>
                  </summary>
                  <form method="post" action="/api/admin/trouble/update" class="stack-add" style="padding: 1rem; border-top: 1px dashed var(--admin-line); background: #FAFBFD; border-radius: 0 0 12px 12px;">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="id" value={t.id} />
                    <input type="hidden" name="project_id" value={p.id} />
                    <div class="field">
                      <label class="label">Symptom *</label>
                      <input class="input" name="symptom" value={t.symptom} required />
                    </div>
                    <div class="field">
                      <label class="label">Probable Cause</label>
                      <input class="input" name="cause" value={t.cause || ''} />
                    </div>
                    <div class="field">
                      <label class="label">Fix (Markdown) *</label>
                      <textarea class="textarea" name="fix" required data-markdown>{t.fix}</textarea>
                    </div>
                    <button class="admin-btn admin-btn--primary admin-btn--sm" type="submit"><Icon name="check" size={15} /> Save Tip</button>
                  </form>
                </details>
              ))}
            </div>

            <!-- Add Tip Form -->
            <form method="post" action="/api/admin/trouble/add" class="add-card-box" id="add-trouble-form" style="display: none; margin-top: 1rem;">
              <h4 style="margin: 0 0 0.5rem 0; font-size: 15px; font-weight: 700;">Add Troubleshooting Tip</h4>
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="project_id" value={p.id} />
              <div class="field">
                <label class="label">Symptom *</label>
                <input class="input" name="symptom" id="trouble-symptom-input" placeholder="e.g. 'Timed out waiting for packet header'" required />
              </div>
              <div class="field">
                <label class="label">Probable Cause</label>
                <input class="input" name="cause" id="trouble-cause-input" placeholder="e.g. GPIO0 not pulled low during reset" />
              </div>
              <div class="field">
                <label class="label">Fix (Markdown) *</label>
                <textarea class="textarea" name="fix" id="trouble-fix-input" placeholder="The fix (Markdown)..." required data-markdown></textarea>
              </div>
              <div style="display:flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.75rem;">
                <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="cancel-add-trouble-btn">Cancel</button>
                <button class="admin-btn admin-btn--primary admin-btn--sm" type="submit"><Icon name="plus" size={14} /> Add Tip</button>
              </div>
            </form>
          </div>
        )}
      </div>

      <!-- 7. Resource links Card -->
      <div class="editor-section-card admin-card" data-section="links">
        <div class="card-header-split">
          <div>
            <h3 class="card-section-title">Resource links</h3>
            <p class="field-hint" style="margin: 0;">{p?.links?.length ? `${p.links.length} links` : 'No links yet'}</p>
          </div>
          <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="toggle-add-link-btn">
            <Icon name="plus" size={14} /> Add
          </button>
        </div>

        {isNew ? (
          <div class="empty-state-notice">
            <Icon name="spark" size={24} />
            <p>Save draft first to initialize this project, then you can add external links.</p>
          </div>
        ) : (
          <div class="links-container" style="margin-top: 1rem;">
            <div class="rows">
              {p.links.map((l, i) => (
                <div class="data-row" style="background: var(--admin-bg); border: 1px solid var(--admin-line); border-radius: 12px; padding: 0.85rem 1rem; display: flex; align-items: center; margin-bottom: 0.5rem;">
                  <div class="data-row__main" style="flex: 1; min-width: 0;">
                    <strong style="font-size: 14px;">{l.label}</strong>
                    <span class="dim mono" style="font-size: 13px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{l.url}</span>
                  </div>
                  <div class="row-ctrl" style="display: flex; gap: 0.35rem; align-items: center;">
                    {['up', 'down'].map((dir) => (
                      <form method="post" action="/api/admin/link/move" class="inline-form">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="id" value={l.id} />
                        <input type="hidden" name="project_id" value={p.id} />
                        <input type="hidden" name="dir" value={dir} />
                        <button class="thumb-ctrl-btn" type="submit" disabled={dir === 'up' ? i === 0 : i === p.links.length - 1} title={dir === 'up' ? 'Move earlier' : 'Move later'}>
                          <Icon name={dir === 'up' ? 'chevron-up' : 'chevron-down'} size={13} />
                        </button>
                      </form>
                    ))}
                    <form method="post" action="/api/admin/link/delete" class="inline-form">
                      <input type="hidden" name="csrf" value={csrf} />
                      <input type="hidden" name="id" value={l.id} />
                      <input type="hidden" name="project_id" value={p.id} />
                      <button class="thumb-ctrl-btn thumb-ctrl-btn--del" type="submit"><Icon name="close" size={13} /></button>
                    </form>
                  </div>
                </div>
              ))}
            </div>

            <!-- Add Link Form -->
            <form method="post" action="/api/admin/link/add" class="add-card-box" id="add-link-form" style="display: none; margin-top: 1rem;">
              <h4 style="margin: 0 0 0.5rem 0; font-size: 15px; font-weight: 700;">Add External Link</h4>
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="project_id" value={p.id} />
              <div class="grid-2">
                <input class="input" name="label" placeholder="Label e.g. GitHub repo" required />
                <input class="input mono" name="url" placeholder="https://…" required />
              </div>
              <div class="grid-2" style="margin-top: 0.5rem;">
                <select class="select" name="kind">
                  <option value="video">Video</option>
                  <option value="github">GitHub</option>
                  <option value="doc">Doc</option>
                  <option value="demo">Demo</option>
                  <option value="other">Other</option>
                </select>
                <div style="display:flex; justify-content: flex-end; gap: 0.5rem;">
                  <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="cancel-add-link-btn">Cancel</button>
                  <button class="admin-btn admin-btn--primary admin-btn--sm" type="submit">Add Link</button>
                </div>
              </div>
            </form>
          </div>
        )}
      </div>

      <!-- 8. Parts (BOM) Card -->
      <div class="editor-section-card admin-card" data-section="parts">
        <div class="card-header-split">
          <div>
            <h3 class="card-section-title">Parts (BOM)</h3>
            <p class="field-hint" style="margin: 0;">{p?.bom?.length ? `${p.bom.length} components listed` : 'No parts yet'}</p>
          </div>
          <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="toggle-add-bom-btn">
            <Icon name="plus" size={14} /> Add
          </button>
        </div>

        {isNew ? (
          <div class="empty-state-notice">
            <Icon name="spark" size={24} />
            <p>Save draft first to initialize this project, then you can build the Bill of Materials.</p>
          </div>
        ) : (
          <div class="bom-container" style="margin-top: 1rem;">
            <!-- Cost summary -->
            <div class="grid-2" style="margin-bottom: 1rem;">
              <div class="field">
                <label class="label" for="est_cost">Approx build cost <span id="computed-cost" class="dim mono"></span></label>
                <input class="input" id="est_cost" name="est_cost" form="main-project-form" placeholder="₹800" value={val(p?.est_cost)} />
              </div>
              <div class="field">
                <label class="label" for="cost_checked">Cost checked on</label>
                <input class="input" id="cost_checked" name="cost_checked" form="main-project-form" placeholder="Sep 2026" value={val(p?.cost_checked)} />
              </div>
            </div>

            {showStalePriceWarning && (
              <div class="stale-warning" style="background: var(--admin-warning-bg); color: var(--admin-warning-text); padding: 0.75rem 1rem; border: 1px solid #FFE6B3; border-radius: 12px; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; font-size: 13.5px;">
                <Icon name="alert-triangle" size={16} />
                <span><strong>Stale Price Warning:</strong> Cost checked date is older than 60 days. Please verify component pricing.</span>
              </div>
            )}

            <!-- BOM items list -->
            <div class="rows">
              {p.bom.map((b, i) => (
                <details class="data-row-edit bom-row" style="background: var(--admin-bg); border: 1px solid var(--admin-line); border-radius: 12px; margin-bottom: 0.5rem;">
                  <summary class="data-row" style="cursor: pointer; padding: 0.85rem 1rem; display: flex; align-items: center; border: none; background: transparent; list-style: none;">
                    <div class="data-row__main" style="flex: 1; min-width: 0;">
                      <strong style="font-size: 14px;">{b.name} <span class="dim mono">x{b.qty}</span>{b.unit_price_inr > 0 && <span class="dim mono"> • ₹{b.unit_price_inr}</span>}</strong>
                      <span class="dim" style="font-size: 12.5px; display: block; margin-top: 0.2rem;">{b.store || '—'}{b.affiliate_url ? ' • link set' : ' • no link'}{b.component_id > 0 ? ' • library part' : ''}</span>
                    </div>
                    <div class="row-ctrl" style="display: flex; gap: 0.35rem; align-items: center;">
                      <span class="admin-btn admin-btn--secondary admin-btn--sm" style="pointer-events: none; padding: 2px 8px; font-size: 12px;"><Icon name="edit" size={13} /> Edit</span>
                      {['up', 'down'].map((dir) => (
                        <form method="post" action="/api/admin/bom/move" class="inline-form">
                          <input type="hidden" name="csrf" value={csrf} />
                          <input type="hidden" name="id" value={b.id} />
                          <input type="hidden" name="project_id" value={p.id} />
                          <input type="hidden" name="dir" value={dir} />
                          <button class="thumb-ctrl-btn" type="submit" onclick="event.stopPropagation();" disabled={dir === 'up' ? i === 0 : i === p.bom.length - 1} title={dir === 'up' ? 'Move earlier' : 'Move later'}>
                            <Icon name={dir === 'up' ? 'chevron-up' : 'chevron-down'} size={13} />
                          </button>
                        </form>
                      ))}
                      <form method="post" action="/api/admin/bom/delete" class="inline-form">
                        <input type="hidden" name="csrf" value={csrf} />
                        <input type="hidden" name="id" value={b.id} />
                        <input type="hidden" name="project_id" value={p.id} />
                        <button class="thumb-ctrl-btn thumb-ctrl-btn--del" type="submit" onclick="event.stopPropagation();"><Icon name="trash" size={13} /></button>
                      </form>
                    </div>
                  </summary>
                  <form method="post" action="/api/admin/bom/update" class="bom-add" style="padding: 1rem; border-top: 1px dashed var(--admin-line); background: #FAFBFD; border-radius: 0 0 12px 12px;">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="id" value={b.id} />
                    <input type="hidden" name="project_id" value={p.id} />
                    <div class="grid-3">
                      <input class="input" name="name" value={b.name} placeholder="Component" required />
                      <input class="input" name="qty" value={b.qty} placeholder="Qty" />
                      <input class="input" name="unit_price_inr" value={b.unit_price_inr || ''} type="number" min="0" placeholder="₹ price" />
                    </div>
                    <div class="grid-2" style="margin-top: 0.5rem;">
                      <input class="input" name="store" value={b.store || ''} placeholder="Store (Amazon, Robu…)" />
                      <input class="input mono" name="affiliate_url" value={b.affiliate_url || ''} placeholder="Buy link" />
                    </div>
                    <div style="display:flex; justify-content: flex-end; margin-top: 0.75rem;">
                      <button class="admin-btn admin-btn--primary admin-btn--sm" type="submit"><Icon name="check" size={15} /> Save Changes</button>
                    </div>
                  </form>
                </details>
              ))}
            </div>

            <!-- Library data -->
            <script id="component-library-data" type="application/json" set:html={JSON.stringify(components.map((c) => ({
              id: c.id,
              name: c.name,
              store: c.store || '',
              price: c.unit_price_inr || 0,
              buy_url: c.buy_url || '',
              is_affiliate: c.is_affiliate || 0,
              price_checked: c.price_checked || '',
            })))}></script>

            <!-- Add BOM Part Form -->
            <div class="add-card-box" id="add-bom-form" style="display: none; margin-top: 1rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <h4 style="margin: 0; font-size: 15px; font-weight: 700;">Add Component</h4>
                <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="cancel-add-bom-btn">Cancel</button>
              </div>
              <form method="post" action="/api/admin/bom/add" id="bom-lib-add-form">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="project_id" value={p.id} />
                <input type="hidden" name="component_id" id="typeahead-comp-id" value="0" />

                <div class="typeahead-wrapper" style="position: relative;">
                  <label class="label" for="bom-typeahead-input">Search Component Library</label>
                  <input class="input" type="text" id="bom-typeahead-input" placeholder="Type component name (e.g. ESP32, BME280, Servo)..." autocomplete="off" />
                  <div id="bom-typeahead-results" class="typeahead-results" hidden></div>
                </div>

                <div id="typeahead-selected-card" class="typeahead-selected-card" hidden style="background: var(--admin-bg); border: 1px solid var(--admin-red); border-radius: 8px; padding: 0.75rem 1rem; margin-top: 0.5rem;">
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                      <strong id="selected-comp-name" style="font-size: 14px;"></strong>
                      <span id="selected-comp-price" class="dim mono" style="margin-left: 0.5rem;"></span>
                    </div>
                    <button type="button" id="typeahead-clear-btn" class="admin-btn admin-btn--secondary admin-btn--sm" style="padding: 2px 6px;">Clear</button>
                  </div>
                  <div class="grid-2" style="margin-top: 0.5rem;">
                    <input class="input" name="qty" id="selected-comp-qty" value="1" placeholder="Qty" />
                    <button class="admin-btn admin-btn--primary admin-btn--sm" type="submit">Add to BOM</button>
                  </div>
                </div>
              </form>

              <div style="text-align: center; margin-top: 0.75rem;">
                <button type="button" class="admin-btn admin-btn--ghost admin-btn--sm" id="toggle-custom-comp-btn">
                  Or enter custom component manually &rarr;
                </button>
              </div>

              <!-- Custom Component Form -->
              <form method="post" action="/api/admin/bom/add" id="bom-custom-add-form" hidden style="margin-top: 0.75rem; border-top: 1px dashed var(--admin-line); padding-top: 0.75rem;">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="project_id" value={p.id} />
                <div class="grid-3">
                  <input class="input" id="custom-name" name="name" placeholder="Component Name *" required />
                  <input class="input" id="custom-qty" name="qty" placeholder="Qty (e.g. 1)" value="1" />
                  <input class="input" id="custom-price" name="unit_price_inr" type="number" min="0" placeholder="₹ Price" />
                </div>
                <div class="grid-2" style="margin-top: 0.5rem;">
                  <input class="input" id="custom-store" name="store" placeholder="Store (Amazon, Robu…)" />
                  <input class="input mono" name="affiliate_url" placeholder="Direct link" />
                </div>
                <div style="display:flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.75rem;">
                  <button type="button" class="admin-btn admin-btn--secondary admin-btn--sm" id="close-custom-comp-btn">Cancel</button>
                  <button class="admin-btn admin-btn--primary admin-btn--sm" type="submit">Add Custom Component</button>
                </div>
              </form>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- ==================== RIGHT RAIL (Sticky 340px) ==================== -->
    <aside class="editor-rail-col">
      <!-- 1. Visibility Card -->
      <div class="editor-section-card admin-card" data-section="visibility">
        <h3 class="card-section-title">Visibility</h3>

        <div class="rail-switch-row">
          <span class="rail-switch-text">Published, live on site</span>
          <label class="admin-switch">
            <input type="checkbox" name="published" form="main-project-form" checked={p?.published === 1} />
            <span class="admin-switch__slider"></span>
          </label>
        </div>

        <div class="rail-switch-row">
          <span class="rail-switch-text">Featured on home</span>
          <label class="admin-switch">
            <input type="checkbox" name="featured" form="main-project-form" checked={p?.featured === 1} />
            <span class="admin-switch__slider"></span>
          </label>
        </div>

        <div class="rail-switch-row">
          <span class="rail-switch-text">Show NEW badge</span>
          <label class="admin-switch">
            <input type="checkbox" name="is_new" form="main-project-form" checked={p?.is_new === 1} />
            <span class="admin-switch__slider"></span>
          </label>
        </div>

        <div class="field" style="margin-top: 0.75rem;">
          <label class="label" for="sort">Sort order</label>
          <input class="input" id="sort" name="sort" form="main-project-form" type="number" value={val(p?.sort ?? 0)} />
        </div>
      </div>

      <!-- 2. Paid Combo Card -->
      <div class="editor-section-card admin-card" data-section="combo">
        <h3 class="card-section-title">Paid combo</h3>

        <div class="field">
          <label class="label" for="price_inr">Price (₹)</label>
          <input class="input" id="price_inr" name="price_inr" form="main-project-form" type="number" min="0" step="1" value={p?.price_inr && p.price_inr > 0 ? p.price_inr : ''} placeholder="e.g. 499" />
        </div>

        <div class="field">
          <label class="label" for="combo_title">Combo title</label>
          <input class="input" id="combo_title" name="combo_title" form="main-project-form" value={val(p?.combo_title) || 'Complete Project Combo'} />
        </div>

        <div class="field">
          <label class="label" for="combo_description">What the buyer gets</label>
          <textarea class="textarea" id="combo_description" name="combo_description" form="main-project-form" rows="3" placeholder="Source code, schematic (PDF), 3D files (STL), build guide…">{val(p?.combo_description)}</textarea>
        </div>

        <div class="rail-switch-row">
          <span class="rail-switch-text">Combo is purchasable</span>
          <label class="admin-switch">
            <input type="checkbox" name="combo_enabled" form="main-project-form" checked={p?.combo_enabled === 1} />
            <span class="admin-switch__slider"></span>
          </label>
        </div>

        {p && (
          <div style="margin-top: 1rem;">
            <button
              type="submit"
              form={`free-${p.id}`}
              class="admin-btn admin-btn--secondary"
              style="width: 100%; justify-content: center;"
            >
              Make it completely free
            </button>
          </div>
        )}
      </div>

      <!-- 3. Search and Social Card -->
      <div class="editor-section-card admin-card" data-section="seo">
        <h3 class="card-section-title">Search and social</h3>

        <div class="field">
          <label class="label" for="meta_title">
            <span>Meta title</span>
            <span id="meta-title-count" class="dim mono" style="font-size: 12px;">(0/60)</span>
          </label>
          <input class="input" id="meta_title" name="meta_title" form="main-project-form" maxlength="70" placeholder={val(p?.title) || 'Defaults to project title'} value={val(p?.meta_title)} />
        </div>

        <div class="field">
          <label class="label" for="meta_description">
            <span>Meta description</span>
            <span id="meta-desc-count" class="dim mono" style="font-size: 12px;">(0/160)</span>
          </label>
          <textarea class="textarea" id="meta_description" name="meta_description" form="main-project-form" rows="3" maxlength="180" placeholder="Defaults to project summary">{val(p?.meta_description)}</textarea>
        </div>

        <div class="field">
          <label class="label" for="og_image">Social share image URL</label>
          <input class="input mono" id="og_image" name="og_image" form="main-project-form" placeholder="/media/… (defaults to cover)" value={val(p?.og_image)} />
        </div>

        <div class="field">
          <label class="label" for="code_repo_url">GitHub repo URL</label>
          <input class="input mono" id="code_repo_url" name="code_repo_url" form="main-project-form" placeholder="https://github.com/…" value={val(p?.code_repo_url)} />
        </div>

        <div class="field">
          <label class="label" for="license">Code license</label>
          <input class="input" id="license" name="license" form="main-project-form" placeholder="MIT" value={val(p?.license) || 'MIT'} />
        </div>
      </div>

      <!-- 4. Files Card -->
      <div class="editor-section-card admin-card" data-section="files">
        <h3 class="card-section-title">Files</h3>
        <p class="field-hint" style="margin-top:-0.5rem; margin-bottom:0.75rem;">
          {p?.files?.length ? `${p.files.length} downloadable files in combo` : 'Paid combo downloads'}
        </p>

        {isNew ? (
          <div class="empty-state-notice">
            <Icon name="download" size={20} />
            <p>Save draft first to upload resource files.</p>
          </div>
        ) : (
          <div class="files-rail-list">
            <div class="rows">
              {p.files.map((f) => (
                <div class="rail-file-row">
                  <div style="display:flex; align-items:center; gap:0.5rem; min-width:0; flex:1;">
                    <Icon name={FILE_KINDS.find((k) => k.key === f.kind)?.icon || 'file'} size={18} />
                    <div style="min-width:0; flex:1;">
                      <div class="rail-file-name" title={f.label}>{f.label}</div>
                      <div class="rail-file-meta dim mono">{f.filename || '-'}</div>
                    </div>
                  </div>
                  <form method="post" action="/api/admin/file/delete" class="inline-form" onsubmit="return confirm('Delete this file?');">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="id" value={f.id} />
                    <input type="hidden" name="project_id" value={p.id} />
                    <button class="thumb-ctrl-btn thumb-ctrl-btn--del" type="submit" title="Delete file"><Icon name="trash" size={13} /></button>
                  </form>
                </div>
              ))}
            </div>

            <!-- Upload file mini-form -->
            <form method="post" action="/api/admin/file/add" enctype="multipart/form-data" class="rail-file-upload-form" style="margin-top: 1rem; border-top: 1px dashed var(--admin-line); padding-top: 0.75rem;">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="project_id" value={p.id} />
              <label class="label" style="font-size: 13px;">Upload new resource file</label>
              <input class="input" type="file" name="file" id="file-upload-input" required style="padding: 4px;" />
              <input class="input" name="label" id="file-label-input" placeholder="Display label (e.g. Arduino Code)" required style="margin-top: 0.5rem;" />
              <div class="grid-2" style="margin-top: 0.5rem;">
                <select class="select" name="kind">
                  {FILE_KINDS.map((k) => <option value={k.key}>{k.label}</option>)}
                </select>
                <select class="select" name="access_level">
                  <option value="combo">Combo Pack</option>
                  <option value="free">Free Public</option>
                </select>
              </div>
              <button class="admin-btn admin-btn--primary admin-btn--sm" type="submit" style="width: 100%; justify-content: center; margin-top: 0.75rem;">
                <Icon name="upload-cloud" size={14} /> Upload File
              </button>
            </form>
          </div>
        )}
      </div>
    </aside>
  </div>

  <!-- Make free fallback form -->
  {p && (
    <form id={`free-${p.id}`} method="post" action="/api/admin/project/action" hidden>
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="id" value={p.id} />
      <input type="hidden" name="action" value="makefree" />
    </form>
  )}

  <!-- Mobile Sticky Bottom Save Bar (On sections menu view) -->
  <div class="mobile-sticky-savebar" id="mobile-sticky-savebar">
    <button type="submit" form="main-project-form" name="action" value="draft" class="btn-mobile-draft">
      Save draft
    </button>
    <button
      type="submit"
      form="main-project-form"
      name="action"
      value="publish"
      class:list={['btn-mobile-publish', { 'is-disabled': missingPublishChecks.length > 0 }]}
      disabled={missingPublishChecks.length > 0}
      title={missingPublishChecks.length > 0 ? missingPublishChecks.join(', ') : 'Publish'}
    >
      Publish
    </button>
  </div>

  <!-- Mobile Drilldown Done Bar (Sticky bottom when a section is open) -->
  <div class="mobile-drilldown-done-bar" id="mobile-drilldown-done-bar" style="display: none;">
    <button type="button" class="mobile-done-btn" id="mobile-drilldown-done-btn">
      Done
    </button>
  </div>

  </div>
  <!-- /#editor-standard-view -->

  <!-- ==============================================
       AI DRAFT REVIEW SCREEN (Desktop & Mobile)
