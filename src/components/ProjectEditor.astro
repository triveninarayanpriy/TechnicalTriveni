  // --- Delegated Handlers for Delete, Move, and Update in Editor Layout ---
  const editorLayout = document.querySelector('.editor-layout');
  if (editorLayout) {
    // Intercept DELETE forms with 4-second undo toast
    editorLayout.addEventListener('submit', (e) => {
      const form = e.target as HTMLFormElement;
      if (!form || !form.action || !form.action.includes('/delete')) return;
      e.preventDefault();
      e.stopPropagation();

      const row = form.closest('.data-row-edit, .data-row') as HTMLElement | null;
      if (!row) return;

      const sectionCard = form.closest('.editor-section-card') as HTMLElement | null;
      const sectionName = sectionCard?.dataset.section || '';
      const parentContainer = row.parentElement;

      row.style.display = 'none';
      if (sectionName) updateSectionCount(sectionName, -1);
      if (parentContainer) updateListMoveButtons(parentContainer);

      showUndoToast('Item removed', () => {
        row.style.display = '';
        if (sectionName) updateSectionCount(sectionName, 1);
        if (parentContainer) updateListMoveButtons(parentContainer);
      }, async () => {
        try {
          const fd = new FormData(form);
          await fetch(form.action, {
            method: 'POST',
            body: fd,
            headers: { 'X-Requested-With': 'fetch', 'Accept': 'application/json' },
          });
          row.remove();
        } catch {}
      });
    });

    // Intercept MOVE forms
    editorLayout.addEventListener('submit', async (e) => {
      const form = e.target as HTMLFormElement;
      if (!form || !form.action || !form.action.includes('/move')) return;
      e.preventDefault();
      e.stopPropagation();

      const row = form.closest('.data-row-edit, .data-row') as HTMLElement | null;
      if (!row || !row.parentElement) return;

      const fd = new FormData(form);
      const dir = fd.get('dir') as string;
      const parent = row.parentElement;

      if (dir === 'up') {
        const prev = row.previousElementSibling;
        if (prev) {
          parent.insertBefore(row, prev);
          updateListMoveButtons(parent);
        }
      } else if (dir === 'down') {
        const next = row.nextElementSibling;
        if (next) {
          parent.insertBefore(next, row);
          updateListMoveButtons(parent);
        }
      }

      try {
        await fetch(form.action, {
          method: 'POST',
          body: fd,
          headers: { 'X-Requested-With': 'fetch', 'Accept': 'application/json' },
        });
      } catch {}
    });

    // Intercept UPDATE forms
    editorLayout.addEventListener('submit', async (e) => {
      const form = e.target as HTMLFormElement;
      if (!form || !form.action || !form.action.includes('/update')) return;
      e.preventDefault();
      e.stopPropagation();

      const fd = new FormData(form);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: fd,
          headers: { 'X-Requested-With': 'fetch', 'Accept': 'application/json' },
        });
        const data = await res.json();
        if (res.ok && data.success) {
          const details = form.closest('details');
          if (details) details.open = false;
          const summary = details?.querySelector('summary');
          if (summary) {
            const strong = summary.querySelector('strong');
            if (strong && fd.has('title') && fd.get('title')) strong.textContent = String(fd.get('title'));
            else if (strong && fd.has('name') && fd.get('name')) strong.textContent = String(fd.get('name'));
            else if (strong && fd.has('symptom') && fd.get('symptom')) strong.textContent = String(fd.get('symptom'));
            else if (strong && fd.has('from_pin') && fd.has('to_pin')) strong.textContent = `${fd.get('from_pin')} → ${fd.get('to_pin')}`;
          }
          if ((window as any).toast) (window as any).toast('Saved successfully.', 'success');
        } else {
          alert(data.error || 'Failed to update');
        }
      } catch {
        alert('Network error updating');
      }
    });
  }

  // --- Media Engine: Popover Delete, Drag & Drop, Touch Drag, Keyboard Reorder, Mobile Buttons ---
  const mediaGrid = document.querySelector('.media-grid-4up');
  const mainCsrf = (document.querySelector('input[name="csrf"]') as HTMLInputElement)?.value || '';
  const mainProjId = Number((document.querySelector('input[name="id"]') as HTMLInputElement)?.value || 0);

  function updateMediaCoverBadge() {
    if (!mediaGrid) return;
    const cards = Array.from(mediaGrid.querySelectorAll<HTMLElement>('.media-thumb-card'));
    cards.forEach((card, i) => {
      let badge = card.querySelector('.media-cover-badge');
      if (i === 0) {
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'media-cover-badge';
          badge.textContent = 'Cover';
          card.prepend(badge);
        }
      } else {
        if (badge) badge.remove();
      }
      const leftBtn = card.querySelector<HTMLButtonElement>('.media-move-left-btn');
      const rightBtn = card.querySelector<HTMLButtonElement>('.media-move-right-btn');
      if (leftBtn) leftBtn.disabled = (i === 0);
      if (rightBtn) rightBtn.disabled = (i === cards.length - 1);
    });
  }

  async function persistMediaOrder() {
    if (!mediaGrid || !mainProjId) return;
    const cards = Array.from(mediaGrid.querySelectorAll<HTMLElement>('.media-thumb-card[data-id]'));
    const ids = cards.map(c => c.dataset.id).filter(Boolean).join(',');
    const fd = new FormData();
    fd.set('csrf', mainCsrf);
    fd.set('id', String(mainProjId));
    fd.set('action', 'reorder');
    fd.set('media_ids', ids);
    try {
      await fetch('/api/admin/project/action', {
        method: 'POST',
        body: fd,
        headers: { 'X-Requested-With': 'fetch', 'Accept': 'application/json' }
      });
    } catch {}
  }

  if (mediaGrid) {
    // 1. Popover Delete with Confirm
    mediaGrid.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest('.media-del-trigger');
      if (trigger) {
        e.stopPropagation();
        const wrap = trigger.closest('.media-del-wrap');
        const pop = wrap?.querySelector('.media-del-popover') as HTMLElement | null;
        if (pop) {
          const isOpen = pop.style.display !== 'none';
          document.querySelectorAll<HTMLElement>('.media-del-popover').forEach(p => p.style.display = 'none');
          pop.style.display = isOpen ? 'none' : 'flex';
        }
        return;
      }

      const cancelBtn = target.closest('.popover-btn--cancel');
      if (cancelBtn) {
        e.stopPropagation();
        const pop = cancelBtn.closest('.media-del-popover') as HTMLElement | null;
        if (pop) pop.style.display = 'none';
        return;
      }

      const delBtn = target.closest('.popover-btn--del');
      if (delBtn) {
        e.stopPropagation();
        const card = delBtn.closest('.media-thumb-card') as HTMLElement | null;
        if (!card || !card.parentElement) return;

        const pop = delBtn.closest('.media-del-popover') as HTMLElement | null;
        if (pop) pop.style.display = 'none';

        const parent = card.parentElement;
        const nextSibling = card.nextElementSibling;
        const mediaId = card.dataset.id;

        card.remove();
        updateMediaCoverBadge();
        persistMediaOrder();

        showUndoToast('Photo removed', () => {
          if (nextSibling && nextSibling.parentElement === parent) {
            parent.insertBefore(card, nextSibling);
          } else {
            const uploadSlot = parent.querySelector('.media-upload-slot');
            if (uploadSlot) parent.insertBefore(card, uploadSlot);
            else parent.appendChild(card);
          }
          updateMediaCoverBadge();
          persistMediaOrder();
        }, async () => {
          if (mediaId && mainProjId) {
            const fd = new FormData();
            fd.set('csrf', mainCsrf);
            fd.set('id', mediaId);
            fd.set('project_id', String(mainProjId));
            try {
              await fetch('/api/admin/media/delete', {
                method: 'POST',
                body: fd,
                headers: { 'X-Requested-With': 'fetch', 'Accept': 'application/json' }
              });
            } catch {}
          }
        });
        return;
      }

      document.querySelectorAll<HTMLElement>('.media-del-popover').forEach(p => p.style.display = 'none');
    });

    // 2. Mobile Move Left / Move Right Buttons
    mediaGrid.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const leftBtn = target.closest('.media-move-left-btn');
      if (leftBtn) {
        const card = leftBtn.closest('.media-thumb-card') as HTMLElement | null;
        const prev = card?.previousElementSibling as HTMLElement | null;
        if (card && prev && prev.classList.contains('media-thumb-card')) {
          card.parentElement?.insertBefore(card, prev);
          updateMediaCoverBadge();
          persistMediaOrder();
        }
        return;
      }
      const rightBtn = target.closest('.media-move-right-btn');
      if (rightBtn) {
        const card = rightBtn.closest('.media-thumb-card') as HTMLElement | null;
        const next = card?.nextElementSibling as HTMLElement | null;
        if (card && next && next.classList.contains('media-thumb-card')) {
          card.parentElement?.insertBefore(next, card);
          updateMediaCoverBadge();
          persistMediaOrder();
        }
        return;
      }
    });

    // 3. HTML5 Drag and Drop
    let draggedCard: HTMLElement | null = null;
    mediaGrid.addEventListener('dragstart', (e) => {
      const target = (e.target as HTMLElement).closest('.media-thumb-card') as HTMLElement | null;
      if (!target) return;
      draggedCard = target;
      target.classList.add('is-dragging');
      e.dataTransfer?.setData('text/plain', target.dataset.id || '');
      if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
    });

    mediaGrid.addEventListener('dragover', (e) => {
      e.preventDefault();
      if (!draggedCard) return;
      const overCard = (e.target as HTMLElement).closest('.media-thumb-card') as HTMLElement | null;
      if (!overCard || overCard === draggedCard) return;

      const rect = overCard.getBoundingClientRect();
      const midX = rect.left + rect.width / 2;
      const isAfter = e.clientX > midX;

      if (isAfter) {
        overCard.parentElement?.insertBefore(draggedCard, overCard.nextSibling);
      } else {
        overCard.parentElement?.insertBefore(draggedCard, overCard);
      }
      updateMediaCoverBadge();
    });

    mediaGrid.addEventListener('dragend', () => {
      if (draggedCard) {
        draggedCard.classList.remove('is-dragging');
        draggedCard = null;
        updateMediaCoverBadge();
        persistMediaOrder();
      }
    });

    // 4. Touch Drag Reordering
    let touchDraggingCard: HTMLElement | null = null;
    mediaGrid.addEventListener('touchstart', (e) => {
      const handle = (e.target as HTMLElement).closest('.media-drag-handle');
      if (!handle) return;
      const card = handle.closest('.media-thumb-card') as HTMLElement | null;
      if (card) {
        touchDraggingCard = card;
        card.classList.add('is-dragging');
      }
    }, { passive: true });

    mediaGrid.addEventListener('touchmove', (e) => {
      if (!touchDraggingCard) return;
      const touch = e.touches[0];
      const elBelow = document.elementFromPoint(touch.clientX, touch.clientY);
      const targetCard = elBelow?.closest('.media-thumb-card') as HTMLElement | null;
      if (targetCard && targetCard !== touchDraggingCard && targetCard.parentElement === mediaGrid) {
        const rect = targetCard.getBoundingClientRect();
        const midX = rect.left + rect.width / 2;
        if (touch.clientX > midX) {
          targetCard.parentElement.insertBefore(touchDraggingCard, targetCard.nextSibling);
        } else {
          targetCard.parentElement.insertBefore(touchDraggingCard, targetCard);
        }
        updateMediaCoverBadge();
      }
    }, { passive: true });

    mediaGrid.addEventListener('touchend', () => {
      if (touchDraggingCard) {
        touchDraggingCard.classList.remove('is-dragging');
        touchDraggingCard = null;
        updateMediaCoverBadge();
        persistMediaOrder();
      }
    });

    // 5. Keyboard Reordering on Handle (Space to pick up, Arrows to move, Space to drop)
    let pickedUpCard: HTMLElement | null = null;
    mediaGrid.addEventListener('keydown', (e) => {
      const handle = (e.target as HTMLElement).closest('.media-drag-handle');
      if (!handle) return;
      const card = handle.closest('.media-thumb-card') as HTMLElement | null;
      if (!card) return;

      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        if (pickedUpCard === card) {
          card.classList.remove('is-keyboard-picked-up');
          pickedUpCard = null;
          updateMediaCoverBadge();
          persistMediaOrder();
          if ((window as any).toast) (window as any).toast('Media dropped.', 'info');
        } else {
          if (pickedUpCard) pickedUpCard.classList.remove('is-keyboard-picked-up');
          pickedUpCard = card;
          card.classList.add('is-keyboard-picked-up');
          if ((window as any).toast) (window as any).toast('Media picked up. Use Arrow keys to move, Space to drop.', 'info');
        }
      } else if (pickedUpCard === card) {
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = card.previousElementSibling as HTMLElement | null;
          if (prev && prev.classList.contains('media-thumb-card')) {
            card.parentElement?.insertBefore(card, prev);
            updateMediaCoverBadge();
            handle.focus();
          }
        } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const next = card.nextElementSibling as HTMLElement | null;
          if (next && next.classList.contains('media-thumb-card')) {
            card.parentElement?.insertBefore(next, card);
            updateMediaCoverBadge();
            handle.focus();
          }
        } else if (e.key === 'Escape') {
          e.preventDefault();
          card.classList.remove('is-keyboard-picked-up');
          pickedUpCard = null;
        }
      }
    });
  }

  // --- Debounced Autosave (800ms) ---
  let autosaveTimer: any = null;
  let isSaving = false;
  const autosaveEl = document.getElementById('autosave-indicator');
  const mobileAutosaveEl = document.getElementById('mobile-autosave-indicator');

  const setAutosaveState = (state: 'saving' | 'saved' | 'offline') => {
    [autosaveEl, mobileAutosaveEl].forEach(el => {
      if (!el) return;
      if (state === 'saving') {
        el.textContent = 'Saving...';
        el.className = 'autosave-status is-saving';
        el.style.opacity = '1';
      } else if (state === 'saved') {
        el.textContent = 'Saved';
        el.className = 'autosave-status is-saved';
        el.style.opacity = '1';
        setTimeout(() => {
          if (!isSaving && el.textContent === 'Saved') {
            el.style.opacity = '0.6';
          }
        }, 2000);
      } else if (state === 'offline') {
        el.textContent = 'Offline';
        el.className = 'autosave-status is-offline';
        el.style.opacity = '1';
      }
    });
  };

  const triggerAutosave = () => {
    if (!mainProjId) return;
    if (autosaveTimer) clearTimeout(autosaveTimer);
    autosaveTimer = setTimeout(async () => {
      const mainForm = document.getElementById('main-project-form') as HTMLFormElement | null;
      if (!mainForm) return;
      isSaving = true;
      setAutosaveState('saving');
      try {
        const fd = new FormData(mainForm);
        document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[form="main-project-form"]').forEach(input => {
          if (!input.name) return;
          if (input.type === 'checkbox') {
            fd.set(input.name, (input as HTMLInputElement).checked ? 'on' : 'off');
          } else {
            fd.set(input.name, input.value);
          }
        });
        fd.set('action', 'draft');

        const res = await fetch(mainForm.action, {
          method: 'POST',
          body: fd,
          headers: { 'X-Requested-With': 'fetch', 'Accept': 'application/json' },
        });
        if (res.ok) {
          setAutosaveState('saved');
        } else {
          setAutosaveState('offline');
        }
      } catch {
        setAutosaveState('offline');
      } finally {
        isSaving = false;
      }
    }, 800);
  };

  document.querySelectorAll('[form="main-project-form"]').forEach(el => {
    el.addEventListener('input', triggerAutosave);
    el.addEventListener('change', triggerAutosave);
  });


  // Media upload progress
  const mediaForm = document.querySelector('[data-media-form]') as HTMLFormElement | null;
  if (mediaForm) {
    const input = mediaForm.querySelector('[data-media-input]') as HTMLInputElement | null;
    const progress = mediaForm.querySelector('[data-progress]') as HTMLElement | null;
    const fill = mediaForm.querySelector('[data-progress-fill]') as HTMLElement | null;
    const pct = mediaForm.querySelector('[data-progress-pct]') as HTMLElement | null;

    input?.addEventListener('change', () => {
      if (input.files?.length) {
        mediaForm.requestSubmit();
      }
    });

    mediaForm.addEventListener('submit', (e) => {
      const hasFiles = (input?.files?.length || 0) > 0;
      if (!hasFiles) return;
      e.preventDefault();
      const xhr = new XMLHttpRequest();
      const fd = new FormData(mediaForm);
      xhr.open('POST', mediaForm.action);
      xhr.setRequestHeader('X-Requested-With', 'fetch');
      if (progress) progress.hidden = false;

      xhr.upload.addEventListener('progress', (ev) => {
        if (!ev.lengthComputable) return;
        const p = Math.round((ev.loaded / ev.total) * 100);
        if (fill) fill.style.width = p + '%';
        if (pct) pct.textContent = p + '%';
      });
      xhr.addEventListener('load', () => {
        if (xhr.status >= 200 && xhr.status < 300) {
          window.location.reload();
        } else {
          alert('Upload failed. Please check file format and try again.');
          if (progress) progress.hidden = true;
        }
      });
      xhr.addEventListener('error', () => {
        alert('Network error during upload.');
        if (progress) progress.hidden = true;
      });
      xhr.send(fd);
    });
  }

  // BOM Typeahead
  const compDataEl = document.getElementById('component-library-data');
  let compLibrary: any[] = [];
  try {
    if (compDataEl && compDataEl.textContent) compLibrary = JSON.parse(compDataEl.textContent);
  } catch {}

  const typeaheadInput = document.getElementById('bom-typeahead-input') as HTMLInputElement | null;
  const typeaheadResults = document.getElementById('bom-typeahead-results');
  const typeaheadCompId = document.getElementById('typeahead-comp-id') as HTMLInputElement | null;
  const selectedCard = document.getElementById('typeahead-selected-card');
  const selectedName = document.getElementById('selected-comp-name');
  const selectedPrice = document.getElementById('selected-comp-price');
  const clearBtn = document.getElementById('typeahead-clear-btn');
  const toggleCustomBtn = document.getElementById('toggle-custom-comp-btn');
  const closeCustomBtn = document.getElementById('close-custom-comp-btn');
  const customForm = document.getElementById('bom-custom-add-form');

  if (typeaheadInput && typeaheadResults && typeaheadCompId) {
    typeaheadInput.addEventListener('input', () => {
      const q = typeaheadInput.value.trim().toLowerCase();
      if (!q) {
        typeaheadResults.setAttribute('hidden', '');
        return;
      }
      const matches = compLibrary.filter(c => c.name.toLowerCase().includes(q)).slice(0, 8);
      if (!matches.length) {
        typeaheadResults.innerHTML = '<div style="padding:8px 12px; font-size:12px; color:#5A6270;">No matching parts found in library.</div>';
      } else {
        typeaheadResults.innerHTML = matches.map(c => `
          <div class="typeahead-item" data-id="${c.id}">
            <strong>${c.name}</strong>
            <span class="dim mono">${c.price > 0 ? `₹${c.price}` : ''}</span>
          </div>
        `).join('');
      }
      typeaheadResults.removeAttribute('hidden');

      typeaheadResults.querySelectorAll<HTMLElement>('.typeahead-item').forEach(item => {
        item.addEventListener('click', () => {
          const id = Number(item.dataset.id);
          const comp = compLibrary.find(c => c.id === id);
          if (comp) {
            typeaheadCompId.value = String(comp.id);
            if (selectedName) selectedName.textContent = comp.name;
            if (selectedPrice) selectedPrice.textContent = comp.price > 0 ? `₹${comp.price}` : '';
            selectedCard?.removeAttribute('hidden');
            typeaheadResults.setAttribute('hidden', '');
            typeaheadInput.value = '';
          }
        });
      });
    });

    document.addEventListener('click', (e) => {
      if (!typeaheadInput.contains(e.target as Node) && !typeaheadResults.contains(e.target as Node)) {
        typeaheadResults.setAttribute('hidden', '');
      }
    });

    clearBtn?.addEventListener('click', () => {
      typeaheadCompId.value = '0';
      selectedCard?.setAttribute('hidden', '');
    });
  }

  toggleCustomBtn?.addEventListener('click', () => {
    customForm?.removeAttribute('hidden');
    toggleCustomBtn.style.display = 'none';
  });
  closeCustomBtn?.addEventListener('click', () => {
    customForm?.setAttribute('hidden', '');
    if (toggleCustomBtn) toggleCustomBtn.style.display = 'inline-block';
  });

  // List Editor for JSON fields
  document.querySelectorAll<HTMLElement>('.list-editor').forEach((el) => {
    const name = el.dataset.name;
    const type = el.dataset.type;
    let items: any[] = [];
    try { items = JSON.parse(el.dataset.value || '[]'); } catch { items = []; }
    if (!Array.isArray(items)) items = [];

    const hidden = document.createElement('input');
    hidden.type = 'hidden';
    if (name) hidden.name = name;
    hidden.setAttribute('form', 'main-project-form');
    el.appendChild(hidden);

    const container = document.createElement('div');
    container.style.display = 'flex';
    container.style.flexDirection = 'column';
    container.style.gap = '8px';
    container.style.marginBottom = '8px';
    el.appendChild(container);

    const addBtn = document.createElement('button');
    addBtn.type = 'button';
    addBtn.className = 'admin-btn admin-btn--secondary admin-btn--sm';
    addBtn.textContent = '+ Add Item';
    el.appendChild(addBtn);

    const updateHidden = () => { hidden.value = JSON.stringify(items); };

    const render = () => {
      container.innerHTML = '';
      items.forEach((item, i) => {
        const row = document.createElement('div');
        row.style.display = 'flex';
        row.style.gap = '8px';
        row.style.alignItems = 'flex-start';

        if (type === 'faq') {
          const col = document.createElement('div');
          col.style.flex = '1';
          col.style.display = 'flex';
          col.style.flexDirection = 'column';
          col.style.gap = '4px';

          const qInput = document.createElement('input');
          qInput.className = 'input';
          qInput.placeholder = 'Question';
          qInput.value = item.q || '';
          qInput.oninput = (e) => { items[i].q = (e.target as HTMLInputElement).value; updateHidden(); };

          const aInput = document.createElement('textarea');
          aInput.className = 'textarea';
          aInput.placeholder = 'Answer';
          aInput.value = item.a || '';
          aInput.style.minHeight = '50px';
          aInput.oninput = (e) => { items[i].a = (e.target as HTMLTextAreaElement).value; updateHidden(); };

          col.appendChild(qInput);
          col.appendChild(aInput);
          row.appendChild(col);
        } else {
          const input = document.createElement('input');
          input.className = 'input';
          input.style.flex = '1';
          input.value = item || '';
          input.oninput = (e) => { items[i] = (e.target as HTMLInputElement).value; updateHidden(); };
          row.appendChild(input);
        }

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'thumb-ctrl-btn thumb-ctrl-btn--del';
        delBtn.style.padding = '8px';
        delBtn.textContent = '✕';
        delBtn.onclick = () => { items.splice(i, 1); updateHidden(); render(); };
        row.appendChild(delBtn);

        container.appendChild(row);
      });
      updateHidden();
    };

    addBtn.onclick = () => { items.push(type === 'faq' ? { q: '', a: '' } : ''); updateHidden(); render(); };
    (el as any).__setListItems = (newItems: any[]) => { items = Array.isArray(newItems) ? newItems : []; updateHidden(); render(); };
    render();
  });

  // Markdown Toolbar
  document.querySelectorAll<HTMLTextAreaElement>('textarea[data-markdown]').forEach((textarea) => {
    const wrap = document.createElement('div');
    wrap.style.display = 'flex';
    wrap.style.flexDirection = 'column';
    wrap.style.gap = '4px';
    textarea.parentNode?.insertBefore(wrap, textarea);
    wrap.appendChild(textarea);

    const tb = document.createElement('div');
    tb.className = 'markdown-toolbar';
    tb.style.display = 'flex';
    tb.style.gap = '4px';
    tb.style.padding = '4px 6px';
    tb.style.background = '#FAFBFD';
    tb.style.border = 'var(--admin-border)';
    tb.style.borderBottom = 'none';
    tb.style.borderRadius = '12px 12px 0 0';

    textarea.style.borderRadius = '0 0 12px 12px';

    const insert = (prefix: string, suffix: string) => {
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;
      textarea.value = text.substring(0, start) + prefix + text.substring(start, end) + suffix + text.substring(end);
      textarea.selectionStart = start + prefix.length;
      textarea.selectionEnd = start + prefix.length + (end - start);
      textarea.focus();
    };

    const mkBtn = (label: string, pref: string, suf: string) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'admin-btn admin-btn--secondary admin-btn--sm';
      b.style.padding = '2px 8px';
      b.style.fontSize = '12px';
      b.textContent = label;
      b.onclick = () => insert(pref, suf);
      tb.appendChild(b);
    };

    mkBtn('B', '**', '**');
    mkBtn('I', '*', '*');
    mkBtn('Link', '[', '](url)');
    mkBtn('Code', '`', '`');
    mkBtn('List', '- ', '');

    if (textarea.dataset.templates === 'safety') {
      const sel = document.createElement('select');
      sel.className = 'select';
      sel.style.marginLeft = 'auto';
      sel.style.width = 'auto';
      sel.style.fontSize = '12px';
      sel.style.padding = '2px 8px';
      sel.style.minHeight = '30px';
      sel.innerHTML = `<option value="">+ Quick Template</option>
        <option value="lipo">LiPo Warning</option>
        <option value="mains">Mains Voltage (230V)</option>
        <option value="motor">Motor / Propeller Warning</option>`;
      sel.onchange = (e) => {
        const v = (e.target as HTMLSelectElement).value;
        if (!v) return;
        let t = '';
        if (v === 'lipo') t = '**⚠️ LiPo Battery Warning:** Use a dedicated balance charger and never leave lithium batteries charging unattended.';
        if (v === 'mains') t = '**⚡ DANGER: HIGH VOLTAGE.** This project connects to 230V AC mains electricity. Ensure power is completely disconnected before servicing.';
        if (v === 'motor') t = '**⚠️ ROTATING PARTS:** Always remove drone propellers before testing motors on workbench.';
        insert(t, '');
        sel.value = '';
      };
      tb.appendChild(sel);
    }

    wrap.insertBefore(tb, textarea);
  });

  // ============================================================
  // GEMINI AI DRAFT & REVIEW INTEGRATION
  // ============================================================
  const aiGenerateNotesBtn = document.getElementById('ai-generate-notes-btn') as HTMLButtonElement | null;
  const aiNotesInput = document.getElementById('ai-notes-input') as HTMLTextAreaElement | null;
  const aiCodeInput = document.getElementById('ai-code-input') as HTMLTextAreaElement | null;
  const aiBomInput = document.getElementById('ai-bom-input') as HTMLTextAreaElement | null;
  const aiWiringInput = document.getElementById('ai-wiring-input') as HTMLTextAreaElement | null;
  const aiIncludeContext = document.getElementById('ai-include-context') as HTMLInputElement | null;
  const aiCodeFileInput = document.getElementById('ai-code-file-input') as HTMLInputElement | null;
  const aiCodeFileName = document.getElementById('ai-code-file-name');
  const aiNotesStatus = document.getElementById('ai-notes-status');

  const editorContainer = document.querySelector('.editor-page-container') as HTMLElement | null;
  const currentProjectId = Number(editorContainer?.dataset.projectId || 0);

  // Attachment tabs switching
  const attachTabs = document.querySelectorAll<HTMLButtonElement>('.ai-attach-tab');
  const attachPanels = document.querySelectorAll<HTMLElement>('.ai-attach-panel');
  attachTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.aiTab;
      attachTabs.forEach(t => t.classList.toggle('is-active', t.dataset.aiTab === target));
      attachPanels.forEach(p => { p.hidden = p.dataset.aiPanel !== target; });
    });
  });

  // Code file upload reader (.ino, .cpp, .h, .py, .txt)
  if (aiCodeFileInput && aiCodeInput && aiCodeFileName) {
    aiCodeFileInput.addEventListener('change', () => {
      const file = aiCodeFileInput.files?.[0];
      if (!file) return;
      aiCodeFileName.textContent = `Reading ${file.name}...`;
      const reader = new FileReader();
      reader.onload = (e) => {
        aiCodeInput.value = String(e.target?.result || '');
        aiCodeFileName.textContent = `✓ ${file.name} (${Math.round(file.size / 1024)} KB)`;
      };
      reader.readAsText(file);
    });
  }

  // SessionStorage notes caching so notes are never lost
  const AI_NOTES_KEY = 'tt_ai_notes_cache';
  try {
    const cached = sessionStorage.getItem(AI_NOTES_KEY);
    if (cached && aiNotesInput && !aiNotesInput.value.trim()) {
      aiNotesInput.value = cached;
    }
    if (aiNotesInput) {
      aiNotesInput.addEventListener('input', () => {
        try { sessionStorage.setItem(AI_NOTES_KEY, aiNotesInput.value); } catch {}
      });
    }
  } catch {}

  // Revert AI changes buttons
  const aiRevertBtn = document.getElementById('ai-revert-btn') as HTMLButtonElement | null;
  const mobileAiRevertBtn = document.getElementById('mobile-ai-revert-btn') as HTMLButtonElement | null;

  async function handleRevertSnapshot() {
    if (!currentProjectId) {
      alert('Cannot revert a project that has not been saved yet.');
      return;
    }
    if (!confirm('Revert all project fields, BOM, steps, wiring, and troubleshooting to the state before the AI draft was applied?')) {
      return;
    }

    try {
      const res = await fetch('/api/admin/ai/revert', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ project_id: currentProjectId })
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        alert(data.message || 'Failed to revert snapshot.');
        return;
      }
      alert('Pre-AI snapshot restored successfully. The page will now reload.');
      window.location.reload();
    } catch (err: any) {
      alert(`Error reverting snapshot: ${err?.message || err}`);
    }
  }

  if (aiRevertBtn) aiRevertBtn.addEventListener('click', handleRevertSnapshot);
  if (mobileAiRevertBtn) mobileAiRevertBtn.addEventListener('click', handleRevertSnapshot);

  // ============================================================
  // AI REVIEW SCREEN CONTROLLER (Desktop & Mobile)
  // Matches media_1791971722111_a6868909.png and media_1791971722088_ab3d6bf2.png
  // ============================================================
  const standardView = document.getElementById('editor-standard-view') as HTMLElement | null;
  const reviewScreen = document.getElementById('ai-review-screen') as HTMLElement | null;
  const reviewDiscardBtn = document.getElementById('ai-review-discard-btn') as HTMLButtonElement | null;
  const reviewDiscardFootBtn = document.getElementById('ai-review-discard-foot-btn') as HTMLButtonElement | null;
  const reviewMobileBackBtn = document.getElementById('ai-review-mobile-back-btn') as HTMLButtonElement | null;
  const reviewApplyTopBtn = document.getElementById('ai-review-apply-top-btn') as HTMLButtonElement | null;
  const reviewApplyFootBtn = document.getElementById('ai-review-apply-foot-btn') as HTMLButtonElement | null;

  let activeDraftData: any = null;
  let activeMatchedBom: any[] = [];

  function escapeHtml(str: any): string {
    if (str === undefined || str === null) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function openReviewScreen() {
    document.body.classList.add('ai-review-active');
    if (standardView) standardView.style.display = 'none';
    if (reviewScreen) {
      reviewScreen.style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  function closeReviewScreen() {
    document.body.classList.remove('ai-review-active');
    if (reviewScreen) reviewScreen.style.display = 'none';
    if (standardView) {
      standardView.style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  if (reviewDiscardBtn) reviewDiscardBtn.addEventListener('click', closeReviewScreen);
  if (reviewDiscardFootBtn) reviewDiscardFootBtn.addEventListener('click', closeReviewScreen);
  if (reviewMobileBackBtn) reviewMobileBackBtn.addEventListener('click', closeReviewScreen);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && reviewScreen && reviewScreen.style.display !== 'none') {
      closeReviewScreen();
    }
  });

  // Collapsible cards chevrons on mobile
  document.querySelectorAll<HTMLButtonElement>('.ai-rev-chevron-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const targetId = btn.dataset.toggleTarget;
      if (!targetId) return;
      const body = document.getElementById(targetId);
      if (!body) return;
      const isHidden = body.hasAttribute('hidden') || body.style.display === 'none';
      if (isHidden) {
        body.removeAttribute('hidden');
        body.style.display = 'block';
        btn.classList.remove('is-collapsed');
      } else {
        body.setAttribute('hidden', '');
        body.style.display = 'none';
        btn.classList.add('is-collapsed');
      }
    });
  });

  function updateChangeCount() {
    let count = 0;

    // Card 1: Tags and SEO
    const seoToggle = document.querySelector<HTMLInputElement>('.ai-rev-section-toggle[data-section="seo"]');
    if (seoToggle?.checked) {
      let seoFields = 0;
      if (activeDraftData?.tags?.length) seoFields++;
      if (activeDraftData?.seo?.meta_title) seoFields++;
      if (activeDraftData?.seo?.meta_description) seoFields++;
      count += (seoFields || 1);
    }

    // Card 2: BOM
    const bomToggle = document.querySelector<HTMLInputElement>('.ai-rev-section-toggle[data-section="bom"]');
    if (bomToggle?.checked) {
      count += (activeMatchedBom?.length || activeDraftData?.bom?.length || 0);
    }

    // Card 3: Steps
    const stepsToggle = document.querySelector<HTMLInputElement>('.ai-rev-section-toggle[data-section="steps"]');
    if (stepsToggle?.checked) {
      count += (activeDraftData?.steps?.length || 0);
    }

    // Card 4: Wiring and connections
    const wiringToggle = document.querySelector<HTMLInputElement>('.ai-rev-section-toggle[data-section="wiring"]');
    if (wiringToggle?.checked) {
      count += (activeDraftData?.wiring?.length || 0);
    }

    // Card 5: Troubleshooting
    const tbToggle = document.querySelector<HTMLInputElement>('.ai-rev-section-toggle[data-section="troubleshooting"]');
    if (tbToggle?.checked) {
      count += (activeDraftData?.troubleshooting?.length || 0);
    }

    // Kept as they are replace switches
    document.querySelectorAll<HTMLInputElement>('.ai-rev-replace-switch').forEach(sw => {
      if (sw.checked) count++;
    });

    const totalCount = activeDraftData?.change_count !== undefined ? activeDraftData.change_count : count;
    const label = `Apply ${totalCount} change${totalCount === 1 ? '' : 's'}`;
    if (reviewApplyTopBtn) {
      reviewApplyTopBtn.textContent = label;
      reviewApplyTopBtn.disabled = totalCount === 0;
    }
    if (reviewApplyFootBtn) {
      reviewApplyFootBtn.textContent = label;
      reviewApplyFootBtn.disabled = totalCount === 0;
    }
  }

  function renderReviewModal(draft: any, matchedBom: any[]) {
    activeDraftData = draft;
    activeMatchedBom = matchedBom;

    // Reset section checkboxes to checked
    document.querySelectorAll<HTMLInputElement>('.ai-rev-section-toggle').forEach(cb => {
      cb.checked = true;
      cb.onchange = () => updateChangeCount();
    });

    // 1. Tags and SEO Card
    const tagsCount = (draft.tags || []).length;
    const seoPill = document.getElementById('ai-rev-pill-seo');
    if (seoPill) seoPill.textContent = draft.seo_pill_label || (tagsCount > 0 ? `${tagsCount + 1} fields` : '5 fields');

    const tagsListEl = document.getElementById('ai-rev-tags-list');
    if (tagsListEl) {
      tagsListEl.innerHTML = (draft.tags || []).map((t: string) => `<span class="ai-rev-tag-chip">${escapeHtml(t)}</span>`).join('');
    }

    const tagsPreviewEl = document.getElementById('ai-rev-tags-preview');
    if (tagsPreviewEl) {
      tagsPreviewEl.textContent = (draft.tags || []).join(', ');
    }

    const metaTextEl = document.getElementById('ai-rev-meta-text');
    if (metaTextEl) {
      metaTextEl.innerHTML = `Meta title: ${escapeHtml(draft.seo?.meta_title || draft.title || '')}. Summary: kept as it is.`;
    }

    // 2. Parts List (BOM) Card with live inline editing
    function renderBomReviewCard() {
      const matchedCount = activeMatchedBom.filter((m: any) => m.status === 'matched').length;
      const ambiguousCount = activeMatchedBom.filter((m: any) => m.status === 'ambiguous').length;
      const newCount = activeMatchedBom.filter((m: any) => m.status === 'new').length;

      const bomPillsEl = document.getElementById('ai-rev-bom-pills');
      if (bomPillsEl) {
        let pillsHtml = '';
        if (matchedCount > 0) pillsHtml += `<span class="ai-rev-pill ai-rev-pill--green desktop-only">${matchedCount} matched</span>`;
        if (ambiguousCount > 0) pillsHtml += `<span class="ai-rev-pill ai-rev-pill--yellow desktop-only">${ambiguousCount} to choose</span>`;
        if (newCount > 0) {
          pillsHtml += `<span class="ai-rev-pill ai-rev-pill--gray desktop-only">${newCount} new</span>`;
          pillsHtml += `<span class="ai-rev-pill ai-rev-pill--peach mobile-only">${newCount} new</span>`;
        } else {
          pillsHtml += `<span class="ai-rev-pill ai-rev-pill--green mobile-only">${matchedCount} matched</span>`;
        }
        bomPillsEl.innerHTML = pillsHtml;
      }

      // Desktop BOM Table
      const bomTbodyEl = document.getElementById('ai-rev-bom-tbody');
      if (bomTbodyEl) {
        bomTbodyEl.innerHTML = activeMatchedBom.map((m: any, idx: number) => {
          let matchHtml = '';
          const price = m.matched_component?.unit_price_inr ?? m.bom_item?.approx_price_inr ?? 0;
          const buyUrl = m.bom_item?.buy_url || m.matched_component?.buy_url || m.prepared_component?.buy_url || '';

          if (m.status === 'matched') {
            matchHtml = `<span class="ai-chip-matched">Matched</span> <span class="ai-rev-match-text" style="font-size:12px;">${escapeHtml(m.matched_component?.name || m.bom_item.name)}</span>`;
          } else if (m.status === 'ambiguous') {
            const candidates = m.candidates || [];
            matchHtml = `
              <select class="ai-rev-bom-select input--sm" data-bom-idx="${idx}" style="font-size:12px; max-width: 160px;">
                ${candidates.map((c: any) => `<option value="${c.component.id}">${escapeHtml(c.component.name)} (₹${c.component.unit_price_inr})</option>`).join('')}
                <option value="0">Standalone Custom</option>
              </select>
            `;
          } else {
            matchHtml = `<span class="ai-chip-new">New</span> <span class="ai-rev-match-text" style="font-size:11px;">Will save to library</span>`;
          }

          return `
            <tr data-bom-row="${idx}">
              <td>
                <input type="text" class="input input--sm ai-bom-input-name" data-bom-idx="${idx}" value="${escapeHtml(m.bom_item.name || '')}" placeholder="Component name" style="width: 100%; min-width: 140px; font-weight:600;" />
              </td>
              <td style="text-align: center;">
                <input type="text" class="input input--sm ai-bom-input-qty" data-bom-idx="${idx}" value="${escapeHtml(String(m.bom_item.qty || 1))}" style="width: 45px; text-align: center;" />
              </td>
              <td>
                <input type="url" class="input input--sm mono ai-bom-input-url" data-bom-idx="${idx}" value="${escapeHtml(buyUrl)}" placeholder="https://amzn.to/... or https://robu.in/..." style="width: 100%; min-width: 180px; font-size:12px;" />
              </td>
              <td>${matchHtml}</td>
              <td class="ai-rev-bom-price">
                <div style="display:flex; align-items:center; justify-content: flex-end; gap: 4px;">
                  <span>₹</span>
                  <input type="number" class="input input--sm ai-bom-input-price" data-bom-idx="${idx}" value="${price}" style="width: 65px; text-align: right;" />
                </div>
              </td>
              <td style="text-align: center;">
                <button type="button" class="ai-bom-del-btn" data-bom-del-idx="${idx}" title="Delete component">
                  <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
              </td>
            </tr>
          `;
        }).join('');
      }

      // Mobile BOM Stack
      const bomMobListEl = document.getElementById('ai-rev-bom-mobile-list');
      if (bomMobListEl) {
        bomMobListEl.innerHTML = activeMatchedBom.map((m: any, idx: number) => {
          let matchHtml = '';
          const price = m.matched_component?.unit_price_inr ?? m.bom_item?.approx_price_inr ?? 0;
          const buyUrl = m.bom_item?.buy_url || m.matched_component?.buy_url || m.prepared_component?.buy_url || '';

          if (m.status === 'matched') {
            matchHtml = `<span class="ai-chip-matched">Matched</span> <span class="ai-rev-match-text">${escapeHtml(m.matched_component?.name || m.bom_item.name)}</span>`;
          } else if (m.status === 'ambiguous') {
            const candidates = m.candidates || [];
            matchHtml = `
              <select class="ai-rev-bom-select input--sm" data-bom-idx="${idx}" style="font-size:12px; width: 100%;">
                ${candidates.map((c: any) => `<option value="${c.component.id}">${escapeHtml(c.component.name)}</option>`).join('')}
                <option value="0">Custom</option>
              </select>
            `;
          } else {
            matchHtml = `<span class="ai-chip-new">New</span> <span class="ai-rev-match-text">Will save to library</span>`;
          }

          return `
            <div class="ai-rev-bom-mob-card" data-bom-row="${idx}">
              <div style="display:flex; justify-content: space-between; align-items: center; gap: 8px;">
                <input type="text" class="input input--sm ai-bom-input-name" data-bom-idx="${idx}" value="${escapeHtml(m.bom_item.name || '')}" placeholder="Component name" style="flex:1; font-weight:700;" />
                <button type="button" class="ai-bom-del-btn" data-bom-del-idx="${idx}" title="Delete component">
                  <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
              </div>
              <div style="display:grid; grid-template-columns: 80px 1fr; gap: 8px;">
                <div>
                  <label style="font-size: 11px; color: #64748B;">Qty</label>
                  <input type="text" class="input input--sm ai-bom-input-qty" data-bom-idx="${idx}" value="${escapeHtml(String(m.bom_item.qty || 1))}" style="width: 100%; text-align:center;" />
                </div>
                <div>
                  <label style="font-size: 11px; color: #64748B;">Price (₹)</label>
                  <input type="number" class="input input--sm ai-bom-input-price" data-bom-idx="${idx}" value="${price}" style="width: 100%; text-align:right;" />
                </div>
              </div>
              <div>
                <label style="font-size: 11px; color: #64748B;">Affiliate Link</label>
                <input type="url" class="input input--sm mono ai-bom-input-url" data-bom-idx="${idx}" value="${escapeHtml(buyUrl)}" placeholder="Affiliate URL" style="width: 100%; font-size:12px;" />
              </div>
              <div class="ai-rev-bom-mob-sub" style="margin-top: 4px;">
                ${matchHtml}
              </div>
            </div>
          `;
        }).join('');
      }

      // Attach delete row handlers
      document.querySelectorAll<HTMLButtonElement>('.ai-bom-del-btn').forEach(btn => {
        btn.onclick = () => {
          const idx = Number(btn.dataset.bomDelIdx);
          if (!isNaN(idx) && idx >= 0 && idx < activeMatchedBom.length) {
            activeMatchedBom.splice(idx, 1);
            if (activeDraftData?.bom && activeDraftData.bom[idx]) {
              activeDraftData.bom.splice(idx, 1);
            }
            renderBomReviewCard();
            updateChangeCount();
          }
        };
      });

      // Attach input sync handlers
      const syncRow = (idx: number) => {
        const item = activeMatchedBom[idx];
        if (!item) return;
        const nameEl = document.querySelector<HTMLInputElement>(`.ai-bom-input-name[data-bom-idx="${idx}"]`);
        const qtyEl = document.querySelector<HTMLInputElement>(`.ai-bom-input-qty[data-bom-idx="${idx}"]`);
        const urlEl = document.querySelector<HTMLInputElement>(`.ai-bom-input-url[data-bom-idx="${idx}"]`);
        const priceEl = document.querySelector<HTMLInputElement>(`.ai-bom-input-price[data-bom-idx="${idx}"]`);

        if (nameEl) {
          item.bom_item.name = nameEl.value.trim();
          if (item.prepared_component) item.prepared_component.name = nameEl.value.trim();
        }
        if (qtyEl) item.bom_item.qty = qtyEl.value.trim() || '1';
        if (urlEl) {
          item.bom_item.buy_url = urlEl.value.trim();
          if (item.prepared_component) item.prepared_component.buy_url = urlEl.value.trim();
          if (item.matched_component) item.matched_component.buy_url = urlEl.value.trim();
        }
        if (priceEl) {
          const pVal = Number(priceEl.value || 0);
          item.bom_item.approx_price_inr = pVal;
          if (item.prepared_component) item.prepared_component.unit_price_inr = pVal;
        }
      };

      document.querySelectorAll<HTMLInputElement>('.ai-bom-input-name, .ai-bom-input-qty, .ai-bom-input-url, .ai-bom-input-price').forEach(inp => {
        inp.oninput = () => {
          const idx = Number(inp.dataset.bomIdx);
          if (!isNaN(idx)) syncRow(idx);
        };
      });

      // New Component Confirmation Banner
      const newCompBanner = document.getElementById('ai-rev-new-comp-banner');
      const newCompText = document.getElementById('ai-rev-new-comp-text');
      const newCompCb = document.getElementById('ai-rev-add-new-components-cb') as HTMLInputElement | null;
      if (newCompBanner && newCompText) {
        if (newCount > 0) {
          newCompBanner.style.display = 'block';
          newCompText.textContent = `Add ${newCount} new component${newCount > 1 ? 's' : ''} and affiliate links to library`;
          if (newCompCb) newCompCb.checked = true;
        } else {
          newCompBanner.style.display = 'none';
        }
      }
    }

    // Attach Add New Component buttons
    const bomAddBtn = document.getElementById('ai-rev-bom-add-btn');
    const bomAddBtnMob = document.getElementById('ai-rev-bom-add-btn-mob');
    const handleAddNewBomRow = () => {
      const newItem = {
        name: '',
        qty: '1',
        role: '',
        approx_price_inr: 0,
        buy_url: ''
      };
      activeMatchedBom.push({
        bom_item: newItem,
        status: 'new',
        prepared_component: {
          name: '',
          store: 'Robu / Amazon',
          category: 'Electronics',
          unit_price_inr: 0,
          buy_url: '',
          notes: ''
        },
        similarity: 0
      });
      if (activeDraftData?.bom) activeDraftData.bom.push(newItem);
      renderBomReviewCard();
      updateChangeCount();
      const allNames = document.querySelectorAll<HTMLInputElement>('.ai-bom-input-name');
      if (allNames.length > 0) {
        allNames[allNames.length - 1].focus();
      }
    };
    if (bomAddBtn) bomAddBtn.onclick = handleAddNewBomRow;
    if (bomAddBtnMob) bomAddBtnMob.onclick = handleAddNewBomRow;

    // Initial render of BOM card
    renderBomReviewCard();

    // 3. Steps Card
    const stepsPill = document.getElementById('ai-rev-pill-steps');
    if (stepsPill) stepsPill.textContent = draft.steps_pill_label || `${(draft.steps || []).length} steps`;

    const stepsListEl = document.getElementById('ai-rev-steps-list');
    if (stepsListEl) {
      stepsListEl.innerHTML = (draft.steps || []).map((s: any, idx: number) => `
        <div class="ai-rev-step-row">
          <span class="ai-rev-step-num">${idx + 1}</span>
          <span class="ai-rev-step-text">${escapeHtml(s.title || s.instruction_markdown)}</span>
        </div>
      `).join('');
    }

    // 4. Wiring and connections Card
    const wiringPill = document.getElementById('ai-rev-pill-wiring');
    if (wiringPill) wiringPill.textContent = draft.wiring_pill_label || `${(draft.wiring || []).length} connections`;

    const wiringListEl = document.getElementById('ai-rev-wiring-list');
    if (wiringListEl) {
      wiringListEl.innerHTML = (draft.wiring || []).map((w: any) => `
        <div class="ai-rev-wiring-row">
          <span class="ai-rev-wiring-arrow">→</span>
          <span class="ai-rev-wiring-text">${escapeHtml(w.from)} → ${escapeHtml(w.to)}${w.note ? ' (' + escapeHtml(w.note) + ')' : ''}</span>
        </div>
      `).join('');
    }

    // 5. Troubleshooting Card
    const tbPill = document.getElementById('ai-rev-pill-tb');
    if (tbPill) tbPill.textContent = draft.tb_pill_label || `${(draft.troubleshooting || []).length} tips`;

    const tbListEl = document.getElementById('ai-rev-tb-list');
    if (tbListEl) {
      tbListEl.innerHTML = (draft.troubleshooting || []).map((tb: any) => `
        <div class="ai-rev-tb-row">
          <span class="ai-rev-tb-mark">?</span>
          <span class="ai-rev-tb-text"><strong>${escapeHtml(tb.symptom)}:</strong> ${escapeHtml(tb.fix_markdown)}</span>
        </div>
      `).join('');
    }

    // Rail Card A: Review checklist
    const checklistListEl = document.getElementById('ai-rev-checklist-list');
    const needsReview = draft.needs_review || [];
    if (checklistListEl) {
      if (needsReview.length > 0) {
        checklistListEl.innerHTML = needsReview.map((item: any) => `
          <div class="ai-rev-check-row">
            <span class="ai-rev-check-icon">⚠️</span>
            <span class="ai-rev-check-text">${escapeHtml(item.reason || `${item.field}: confirm accuracy`)}</span>
          </div>
        `).join('');
      } else {
        checklistListEl.innerHTML = `
          <div class="ai-rev-check-row">
            <span class="ai-rev-check-icon">✓</span>
            <span class="ai-rev-check-text" style="color:#166534;">All statements verified against notes and code.</span>
          </div>
        `;
      }
    }

    // Mobile yellow alert banner
    const mobAlert = document.getElementById('ai-rev-mobile-alert');
    const mobAlertText = document.getElementById('ai-rev-mobile-alert-text');
    if (mobAlert && mobAlertText) {
      if (needsReview.length > 0) {
        mobAlert.style.display = 'flex';
        mobAlertText.textContent = `${needsReview.length} item${needsReview.length > 1 ? 's' : ''} need your check before publishing`;
      } else {
        mobAlert.style.display = 'none';
      }
    }

    // Rail Card B: Kept as they are switches
    document.querySelectorAll<HTMLInputElement>('.ai-rev-replace-switch').forEach(sw => {
      sw.checked = false; // default OFF as in reference mockup
      sw.onchange = () => updateChangeCount();
    });

    // Rail Card C: Source
    const sourceEl = document.getElementById('ai-rev-source-text');
    if (sourceEl) {
      const now = new Date();
      const dateStr = now.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      const timeStr = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
      sourceEl.textContent = `Notes, sketch and BOM text. Gemini 2.5 Flash, ${dateStr}, ${timeStr}.`;
    }

    // Mobile initial collapse state: Card 2 (BOM) expanded, others collapsed
    const isMobile = window.innerWidth <= 768;
    if (isMobile) {
      const collapseTargets = ['ai-rev-body-seo', 'ai-rev-body-steps', 'ai-rev-body-wiring', 'ai-rev-body-tb'];
      collapseTargets.forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.setAttribute('hidden', '');
          el.style.display = 'none';
        }
        const chevron = document.querySelector<HTMLButtonElement>(`.ai-rev-chevron-btn[data-toggle-target="${id}"]`);
        if (chevron) chevron.classList.add('is-collapsed');
      });
      const bomBody = document.getElementById('ai-rev-body-bom');
      if (bomBody) {
        bomBody.removeAttribute('hidden');
        bomBody.style.display = 'block';
      }
      const bomChevron = document.querySelector<HTMLButtonElement>('.ai-rev-chevron-btn[data-toggle-target="ai-rev-body-bom"]');
      if (bomChevron) bomChevron.classList.remove('is-collapsed');
    }

    updateChangeCount();
    openReviewScreen();
  }

  (window as any).renderReviewModal = renderReviewModal;
  (window as any).openReviewScreen = openReviewScreen;
  (window as any).closeReviewScreen = closeReviewScreen;

  // Handle Apply Changes
  async function handleApplyChanges() {
    if (!activeDraftData) return;

    if (reviewApplyTopBtn) reviewApplyTopBtn.disabled = true;
    if (reviewApplyFootBtn) reviewApplyFootBtn.disabled = true;

    // 1. Gather selections from section checkboxes
    const selections: Record<string, boolean> = {};
    document.querySelectorAll<HTMLInputElement>('.ai-rev-section-toggle').forEach(st => {
      const sec = st.dataset.section;
      if (sec) selections[sec] = st.checked;
    });

    // 2. Gather replace switches
    const replace_fields: Record<string, boolean> = {
      title: !!document.querySelector<HTMLInputElement>('.ai-rev-replace-switch[data-replace-field="title"]')?.checked,
      summary: !!document.querySelector<HTMLInputElement>('.ai-rev-replace-switch[data-replace-field="summary"]')?.checked,
      description: !!document.querySelector<HTMLInputElement>('.ai-rev-replace-switch[data-replace-field="description"]')?.checked,
    };

    if (replace_fields.title || replace_fields.summary) {
      selections.basics = true;
    }
    if (replace_fields.description) {
      selections.description = true;
    }

    // 3. Sync live DOM inputs into activeMatchedBom & activeDraftData
    activeMatchedBom.forEach((m: any, idx: number) => {
      const nameInput = document.querySelector<HTMLInputElement>(`.ai-bom-input-name[data-bom-idx="${idx}"]`);
      const qtyInput = document.querySelector<HTMLInputElement>(`.ai-bom-input-qty[data-bom-idx="${idx}"]`);
      const urlInput = document.querySelector<HTMLInputElement>(`.ai-bom-input-url[data-bom-idx="${idx}"]`);
      const priceInput = document.querySelector<HTMLInputElement>(`.ai-bom-input-price[data-bom-idx="${idx}"]`);

      const name = nameInput ? nameInput.value.trim() : (m.bom_item?.name || '');
      const qty = qtyInput ? qtyInput.value.trim() : (m.bom_item?.qty || '1');
      const buy_url = urlInput ? urlInput.value.trim() : (m.bom_item?.buy_url || m.matched_component?.buy_url || '');
      const price = priceInput ? Number(priceInput.value || 0) : (m.bom_item?.approx_price_inr || 0);

      m.bom_item.name = name;
      m.bom_item.qty = qty;
      m.bom_item.buy_url = buy_url;
      m.bom_item.approx_price_inr = price;

      if (m.prepared_component) {
        m.prepared_component.name = name;
        m.prepared_component.buy_url = buy_url;
        m.prepared_component.unit_price_inr = price;
      }
    });

    activeDraftData.bom = activeMatchedBom.map((m: any) => ({
      name: m.bom_item.name,
      qty: m.bom_item.qty || '1',
      role: m.bom_item.role || '',
      approx_price_inr: m.bom_item.approx_price_inr || 0,
      buy_url: m.bom_item.buy_url || ''
    }));

    // 4. Gather new components to create
    const newComponents: any[] = [];
    const addNewCb = document.getElementById('ai-rev-add-new-components-cb') as HTMLInputElement | null;
    if (addNewCb?.checked !== false) {
      activeMatchedBom.forEach((m: any, idx: number) => {
        if (m.status === 'new' || !m.matched_component?.id) {
          newComponents.push({
            bom_index: idx,
            name: m.bom_item.name,
            store: m.prepared_component?.store || 'Robu / Amazon',
            category: m.prepared_component?.category || 'Electronics',
            unit_price_inr: m.bom_item.approx_price_inr || 0,
            buy_url: m.bom_item.buy_url || '',
            notes: m.prepared_component?.notes || ''
          });
        }
      });
    }

    // 5. Gather ambiguous BOM selections & affiliate link updates for matched components
    const bomResolutions: any[] = [];
    activeMatchedBom.forEach((m: any, idx: number) => {
      const sel = document.querySelector<HTMLSelectElement>(`.ai-rev-bom-select[data-bom-idx="${idx}"]`);
      const compId = sel ? Number(sel.value || 0) : (m.matched_component?.id || 0);
      bomResolutions.push({
        bom_index: idx,
        component_id: compId,
        buy_url: m.bom_item.buy_url || '',
        unit_price_inr: m.bom_item.approx_price_inr || 0
      });
    });

    try {
      const res = await fetch('/api/admin/ai/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          project_id: currentProjectId,
          draft: activeDraftData,
          selections,
          replace_fields,
          new_components: newComponents,
          bom_resolutions: bomResolutions
        })
      });

      const resText = await res.text();
      let data: any = {};
      try {
        data = JSON.parse(resText);
      } catch (parseErr) {
        throw new Error(`Server returned non-JSON response (${res.status}): ${resText.slice(0, 160)}`);
      }

      if (!res.ok || !data.ok) {
        alert(data?.message || `Failed to apply AI changes (${res.status}).`);
        return;
      }

      // Directly update the active DOM form inputs in standard view
      if (replace_fields.title && activeDraftData.title) {
        const t = document.getElementById('title') as HTMLInputElement | null;
        if (t) t.value = activeDraftData.title;
      }
      if (replace_fields.summary && activeDraftData.summary) {
        const s = document.getElementById('summary') as HTMLInputElement | null;
        if (s) s.value = activeDraftData.summary;
      }
      if (replace_fields.description && activeDraftData.description_markdown) {
        const d = document.getElementById('description') as HTMLTextAreaElement | null;
        if (d) d.value = activeDraftData.description_markdown;
      }
      if (selections.seo) {
        if (activeDraftData.seo?.meta_title) {
          const mt = document.getElementById('meta_title') as HTMLInputElement | null;
          if (mt) mt.value = activeDraftData.seo.meta_title;
        }
        if (activeDraftData.seo?.meta_description) {
          const md = document.getElementById('meta_description') as HTMLInputElement | null;
          if (md) md.value = activeDraftData.seo.meta_description;
        }
        if (activeDraftData.tags?.length) {
          const tg = document.getElementById('tags') as HTMLInputElement | null;
          if (tg) tg.value = activeDraftData.tags.join(', ');
        }
      }

      // Reveal the Revert AI changes buttons
      if (aiRevertBtn) aiRevertBtn.style.display = 'inline-flex';
      if (mobileAiRevertBtn) mobileAiRevertBtn.style.display = 'inline-flex';

      closeReviewScreen();

      if (aiNotesStatus) {
        aiNotesStatus.innerHTML = `<span style="color:var(--admin-success-text); font-weight:600; font-size:13px;">✨ ${data.message} Pre-AI snapshot created.</span>`;
      }

      // If child database items were modified on existing project, prompt reload to display tables
      if (currentProjectId > 0 && (selections.bom || selections.steps || selections.wiring || selections.troubleshooting)) {
        setTimeout(() => {
          if (confirm('AI changes applied to database! Reload now to see newly matched BOM rows, steps, and wiring diagrams in the child panels?')) {
            window.location.reload();
          }
        }, 300);
      }
    } catch (err: any) {
      alert(`Error applying AI changes: ${err?.message || err}`);
    } finally {
      if (reviewApplyTopBtn) reviewApplyTopBtn.disabled = false;
      if (reviewApplyFootBtn) reviewApplyFootBtn.disabled = false;
    }
  }

  if (reviewApplyTopBtn) reviewApplyTopBtn.addEventListener('click', handleApplyChanges);
  if (reviewApplyFootBtn) reviewApplyFootBtn.addEventListener('click', handleApplyChanges);

  // Main Draft Button Click Handler
  if (aiGenerateNotesBtn && aiNotesInput && aiNotesStatus) {
    aiGenerateNotesBtn.addEventListener('click', async () => {
      const notes = aiNotesInput.value.trim();
      const code_snippet = aiCodeInput?.value.trim() || '';
      const bom_pasted = aiBomInput?.value.trim() || '';
      const wiring_notes = aiWiringInput?.value.trim() || '';

      if (!notes && !code_snippet && !bom_pasted && !wiring_notes) {
        aiNotesStatus.innerHTML = '<span style="color:var(--admin-red); font-size:13px;">Please paste some notes, sketch code, or parts list first.</span>';
        aiNotesInput.focus();
        return;
      }

      aiGenerateNotesBtn.disabled = true;
      aiNotesStatus.innerHTML = '<span class="dim" style="font-size:13px;">Drafting with Gemini model &amp; matching component library...</span>';

      const projectContext: any = {};
      if (aiIncludeContext?.checked) {
        projectContext.title = (document.getElementById('title') as HTMLInputElement)?.value.trim() || '';
        projectContext.category = (document.getElementById('category') as HTMLInputElement)?.value.trim() || '';
        projectContext.summary = (document.getElementById('summary') as HTMLInputElement)?.value.trim() || '';
        projectContext.description = (document.getElementById('description') as HTMLTextAreaElement)?.value.trim() || '';
      }

      try {
        const res = await fetch('/api/admin/ai/draft', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            notes,
            code_snippet,
            bom_pasted,
            wiring_notes,
            project_context: projectContext,
            project_id: currentProjectId
          }),
        });

        const data = await res.json();
        if (!res.ok || !data.ok) {
          aiNotesStatus.innerHTML = `
            <div style="display:flex; align-items:center; gap:8px;">
              <span style="color:var(--admin-red); font-size:13px;">⚠️ ${data?.message || 'Failed to generate draft.'}</span>
              <button type="button" class="admin-btn admin-btn--secondary admin-btn--xs" id="ai-quick-retry-btn">Retry</button>
            </div>
          `;
          const retryBtn = document.getElementById('ai-quick-retry-btn');
          if (retryBtn) retryBtn.addEventListener('click', () => aiGenerateNotesBtn.click());
          return;
        }

        aiNotesStatus.innerHTML = '<span style="color:var(--admin-success-text); font-size:13px;">✨ Draft generated! Opening review screen...</span>';
        renderReviewModal(data.draft, data.matched_bom);
      } catch (err: any) {
        aiNotesStatus.innerHTML = `
          <div style="display:flex; align-items:center; gap:8px;">
            <span style="color:var(--admin-red); font-size:13px;">⚠️ Error: ${err?.message || 'Failed to call Gemini.'}</span>
            <button type="button" class="admin-btn admin-btn--secondary admin-btn--xs" id="ai-quick-retry-btn">Retry</button>
          </div>
        `;
        const retryBtn = document.getElementById('ai-quick-retry-btn');
        if (retryBtn) retryBtn.addEventListener('click', () => aiGenerateNotesBtn.click());
      } finally {
        aiGenerateNotesBtn.disabled = false;
      }
    });
  }
</script>
