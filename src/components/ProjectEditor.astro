---
import Icon from './Icon.astro';
import type { ProjectFull } from '../lib/db';
import { DIFFICULTIES, FILE_KINDS } from '../lib/site';
import { formatBytes } from '../lib/format';

interface Props {
  project: ProjectFull | null;
  csrf: string;
}
const { project, csrf } = Astro.props;
const p = project;
const isNew = !p;
const val = (v: unknown) => (v === undefined || v === null ? '' : String(v));
---

<div class="editor">
  <!-- ===== Main details ===== -->
  <form method="post" action="/api/admin/project/save" class="editor-form panel">
    <input type="hidden" name="csrf" value={csrf} />
    {p && <input type="hidden" name="id" value={p.id} />}

    <div class="editor-form__head">
      <h2>{isNew ? 'New project' : 'Project details'}</h2>
      <button type="submit" class="btn btn-primary"><Icon name="check" size={16} /> {isNew ? 'Create project' : 'Save changes'}</button>
    </div>

    <div class="grid-2">
      <div class="field">
        <label class="label" for="title">Title *</label>
        <input class="input" id="title" name="title" required maxlength="140" value={val(p?.title)} data-title />
      </div>
      <div class="field">
        <label class="label" for="slug">Slug (URL)</label>
        <input class="input mono" id="slug" name="slug" maxlength="80" placeholder="auto-from-title" value={val(p?.slug)} data-slug />
        <span class="field-hint">Leave blank to auto-generate from the title.</span>
      </div>
    </div>

    <div class="field">
      <label class="label" for="summary">Summary *</label>
      <input class="input" id="summary" name="summary" required maxlength="240" placeholder="One-line hook shown on cards & search" value={val(p?.summary)} />
    </div>

    <div class="field">
      <label class="label" for="description">Description (Markdown)</label>
      <textarea class="textarea editor-desc" id="description" name="description" placeholder="## What you'll build…">{val(p?.description)}</textarea>
      <span class="field-hint">Supports Markdown: ## headings, **bold**, lists, `code`, links.</span>
    </div>

    <div class="grid-3">
      <div class="field">
        <label class="label" for="category">Category</label>
        <input class="input" id="category" name="category" list="cat-list" value={val(p?.category) || 'Electronics'} />
        <datalist id="cat-list">
          <option value="Electronics"></option><option value="Robotics"></option>
          <option value="AI"></option><option value="IoT"></option><option value="Software"></option>
        </datalist>
      </div>
      <div class="field">
        <label class="label" for="difficulty">Difficulty</label>
        <select class="select" id="difficulty" name="difficulty">
          {DIFFICULTIES.map((d) => <option value={d} selected={p?.difficulty === d}>{d}</option>)}
        </select>
      </div>
      <div class="field">
        <label class="label" for="build_time">Build time</label>
        <input class="input" id="build_time" name="build_time" placeholder="2–3 hours" value={val(p?.build_time)} />
      </div>
    </div>

    <div class="grid-2">
      <div class="field">
        <label class="label" for="cover_image">Cover image URL</label>
        <input class="input mono" id="cover_image" name="cover_image" placeholder="/media/… or https://…" value={val(p?.cover_image)} />
        <span class="field-hint">Upload in the Gallery below, then “Make cover”.</span>
      </div>
      <div class="field">
        <label class="label" for="video_url">Video URL (YouTube)</label>
        <input class="input mono" id="video_url" name="video_url" placeholder="https://youtube.com/…" value={val(p?.video_url)} />
      </div>
    </div>

    <div class="field">
      <label class="label" for="tags">Tags (comma-separated)</label>
      <input class="input" id="tags" name="tags" placeholder="ESP32, IoT, Sensors" value={val(p?.tags)} />
    </div>

    <fieldset class="editor-fieldset">
      <legend>Paid combo</legend>
      <div class="grid-2">
        <div class="field">
          <label class="label" for="price_inr">Price (₹)</label>
          <input class="input" id="price_inr" name="price_inr" type="number" min="0" step="1" value={val(p?.price_inr ?? 0)} />
        </div>
        <div class="field">
          <label class="label" for="combo_title">Combo title</label>
          <input class="input" id="combo_title" name="combo_title" value={val(p?.combo_title) || 'Complete Project Combo'} />
        </div>
      </div>
      <div class="field">
        <label class="label" for="combo_description">What the buyer gets</label>
        <textarea class="textarea" id="combo_description" name="combo_description" placeholder="Source code, schematic (PDF), 3D files (STL), build guide…">{val(p?.combo_description)}</textarea>
      </div>
      <label class="switch"><input type="checkbox" name="combo_enabled" checked={p?.combo_enabled === 1} /> <span>Combo is purchasable</span></label>
    </fieldset>

    <div class="editor-toggles">
      <label class="switch"><input type="checkbox" name="published" checked={p?.published === 1} /> <span>Published (live on site)</span></label>
      <label class="switch"><input type="checkbox" name="featured" checked={p?.featured === 1} /> <span>Featured on home</span></label>
      <div class="field field--inline">
        <label class="label" for="sort">Sort</label>
        <input class="input input--sm" id="sort" name="sort" type="number" value={val(p?.sort ?? 0)} />
      </div>
    </div>

    <div class="editor-form__foot">
      <button type="submit" class="btn btn-primary btn-lg"><Icon name="check" size={16} /> {isNew ? 'Create project' : 'Save changes'}</button>
      {p && <a href={`/projects/${p.slug}`} target="_blank" class="btn btn-ghost">Preview <Icon name="external" size={14} /></a>}
    </div>
  </form>

  {isNew && (
    <p class="editor-note dim"><Icon name="spark" size={14} /> Save the project first — then you can add gallery images, resource files, the parts list and links.</p>
  )}

  {p && (
    <div class="editor-children">
      <!-- ===== Gallery ===== -->
      <section class="child-panel panel">
        <h3><Icon name="layers" size={18} /> Gallery</h3>
        <div class="thumbs-admin">
          {p.images.map((img) => (
            <div class="thumb-admin">
              <img src={img.url} alt={img.caption} />
              <div class="thumb-admin__actions">
                <form method="post" action="/api/admin/project/action" class="inline-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="id" value={p.id} />
                  <input type="hidden" name="action" value="setcover" />
                  <input type="hidden" name="url" value={img.url} />
                  <button class="thumb-btn" type="submit" title="Make cover"><Icon name="check" size={14} /></button>
                </form>
                <form method="post" action="/api/admin/media/delete" class="inline-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="id" value={img.id} />
                  <input type="hidden" name="project_id" value={p.id} />
                  <button class="thumb-btn thumb-btn--del" type="submit" title="Delete"><Icon name="close" size={14} /></button>
                </form>
              </div>
            </div>
          ))}
          {p.images.length === 0 && <p class="dim">No images yet.</p>}
        </div>
        <form method="post" action="/api/admin/media/add" enctype="multipart/form-data" class="add-row">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="project_id" value={p.id} />
          <input class="input" type="file" name="file" accept="image/*" />
          <input class="input" name="caption" placeholder="Caption (optional)" />
          <button class="btn btn-ghost" type="submit"><Icon name="download" size={15} /> Upload</button>
        </form>
        <details class="url-add">
          <summary class="dim">…or add by image URL</summary>
          <form method="post" action="/api/admin/media/add" class="add-row" style="margin-top:0.75rem">
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="project_id" value={p.id} />
            <input class="input mono" name="url" placeholder="https://…" />
            <input class="input" name="caption" placeholder="Caption" />
            <button class="btn btn-ghost" type="submit">Add</button>
          </form>
        </details>
      </section>

      <!-- ===== Resource files ===== -->
      <section class="child-panel panel">
        <h3><Icon name="download" size={18} /> Resource files</h3>
        <p class="dim child-lead">Files in the combo are delivered after purchase. Mark a file “free” to offer it as a public download.</p>
        <div class="rows">
          {p.files.map((f) => (
            <div class="data-row">
              <span class="data-row__icon"><Icon name={FILE_KINDS.find((k) => k.key === f.kind)?.icon || 'file'} size={16} /></span>
              <div class="data-row__main">
                <strong>{f.label}</strong>
                <span class="dim mono">{f.filename || '—'}{f.size_bytes ? ` · ${formatBytes(f.size_bytes)}` : ''}{!f.r2_key ? ' · not uploaded' : ''}</span>
              </div>
              <div class="data-row__tags">
                {f.is_free === 1 && <span class="mini-tag mini-tag--free">free</span>}
                {f.in_combo === 1 && <span class="mini-tag">combo</span>}
              </div>
              <form method="post" action="/api/admin/file/delete" class="inline-form">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={f.id} />
                <input type="hidden" name="project_id" value={p.id} />
                <button class="btn btn-ghost btn-xs btn-danger" type="submit"><Icon name="close" size={13} /></button>
              </form>
            </div>
          ))}
          {p.files.length === 0 && <p class="dim">No files yet.</p>}
        </div>
        <form method="post" action="/api/admin/file/add" enctype="multipart/form-data" class="file-add">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="project_id" value={p.id} />
          <div class="grid-2">
            <input class="input" name="label" placeholder="Label e.g. Arduino source (.ino)" required />
            <select class="select" name="kind">
              {FILE_KINDS.map((k) => <option value={k.key}>{k.label}</option>)}
            </select>
          </div>
          <input class="input" type="file" name="file" required />
          <div class="file-add__opts">
            <label class="switch"><input type="checkbox" name="in_combo" checked /> <span>In combo</span></label>
            <label class="switch"><input type="checkbox" name="is_free" /> <span>Free download</span></label>
            <button class="btn btn-primary" type="submit"><Icon name="download" size={15} /> Upload file</button>
          </div>
        </form>
      </section>

      <!-- ===== BOM ===== -->
      <section class="child-panel panel">
        <h3><Icon name="cart" size={18} /> Parts list (BOM)</h3>
        <div class="rows">
          {p.bom.map((b) => (
            <div class="data-row">
              <div class="data-row__main">
                <strong>{b.name} <span class="dim mono">×{b.qty}</span></strong>
                <span class="dim">{b.store}{b.affiliate_url ? ' · link set' : ' · no link'}</span>
              </div>
              <form method="post" action="/api/admin/bom/delete" class="inline-form">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={b.id} />
                <input type="hidden" name="project_id" value={p.id} />
                <button class="btn btn-ghost btn-xs btn-danger" type="submit"><Icon name="close" size={13} /></button>
              </form>
            </div>
          ))}
          {p.bom.length === 0 && <p class="dim">No components yet.</p>}
        </div>
        <form method="post" action="/api/admin/bom/add" class="bom-add">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="project_id" value={p.id} />
          <div class="grid-bom">
            <input class="input" name="name" placeholder="Component" required />
            <input class="input" name="qty" placeholder="Qty" value="1" />
            <input class="input" name="store" placeholder="Store" />
          </div>
          <input class="input mono" name="affiliate_url" placeholder="Affiliate URL (https://…)" />
          <div class="grid-2">
            <input class="input" name="notes" placeholder="Notes (optional)" />
            <button class="btn btn-primary" type="submit"><Icon name="cart" size={15} /> Add component</button>
          </div>
        </form>
      </section>

      <!-- ===== Links ===== -->
      <section class="child-panel panel">
        <h3><Icon name="external" size={18} /> Resource links</h3>
        <div class="rows">
          {p.links.map((l) => (
            <div class="data-row">
              <div class="data-row__main"><strong>{l.label}</strong><span class="dim mono">{l.url}</span></div>
              <form method="post" action="/api/admin/link/delete" class="inline-form">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={l.id} />
                <input type="hidden" name="project_id" value={p.id} />
                <button class="btn btn-ghost btn-xs btn-danger" type="submit"><Icon name="close" size={13} /></button>
              </form>
            </div>
          ))}
          {p.links.length === 0 && <p class="dim">No links yet.</p>}
        </div>
        <form method="post" action="/api/admin/link/add" class="add-row">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="project_id" value={p.id} />
          <input class="input" name="label" placeholder="Label e.g. GitHub repo" required />
          <input class="input mono" name="url" placeholder="https://…" required />
          <select class="select select--sm" name="kind">
            <option value="video">Video</option><option value="github">GitHub</option>
            <option value="doc">Doc</option><option value="demo">Demo</option><option value="other">Other</option>
          </select>
          <button class="btn btn-ghost" type="submit">Add</button>
        </form>
      </section>
    </div>
  )}
</div>

<style>
  .editor { display: flex; flex-direction: column; gap: 1.25rem; max-width: 900px; }
  .editor-form { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.1rem; }
  .editor-form__head { display: flex; align-items: center; justify-content: space-between; }
  .editor-form__head h2 { font-size: var(--fs-md); }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
  .grid-bom { display: grid; grid-template-columns: 2fr 0.7fr 1fr; gap: 0.6rem; }
  .editor-desc { min-height: 200px; font-family: var(--font-mono); font-size: var(--fs-sm); }
  .editor-fieldset { border: 1px solid var(--border); border-radius: var(--r-md); padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }
  .editor-fieldset legend { padding: 0 0.5rem; font-family: var(--font-display); font-weight: 600; color: var(--brand-red); font-size: var(--fs-sm); }
  .switch { display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--fs-sm); cursor: pointer; }
  .switch input { width: 18px; height: 18px; accent-color: var(--brand-red); }
  .editor-toggles { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; padding: 1rem; background: var(--bg-2); border-radius: var(--r-md); }
  .field--inline { flex-direction: row; align-items: center; gap: 0.5rem; }
  .input--sm { width: 80px; }
  .select--sm { width: auto; }
  .editor-form__foot { display: flex; gap: 0.75rem; padding-top: 0.5rem; border-top: 1px solid var(--hairline); }
  .editor-note { display: flex; align-items: center; gap: 0.5rem; font-size: var(--fs-sm); }

  .editor-children { display: flex; flex-direction: column; gap: 1.25rem; }
  .child-panel { padding: 1.5rem; }
  .child-panel h3 { display: flex; align-items: center; gap: 0.5rem; font-size: var(--fs-md); margin-bottom: 1rem; }
  .child-panel h3 :global(svg) { color: var(--brand-red); }
  .child-lead { font-size: var(--fs-sm); margin-bottom: 1rem; margin-top: -0.5rem; }
  .rows { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.25rem; }
  .data-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 0.85rem; background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--r-sm); }
  .data-row__icon { color: var(--brand-red); }
  .data-row__main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .data-row__main strong { font-weight: 550; font-size: var(--fs-sm); }
  .data-row__main span { font-size: var(--fs-xs); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .data-row__tags { display: flex; gap: 0.3rem; }
  .mini-tag { font-family: var(--font-mono); font-size: 0.65rem; padding: 0.15rem 0.4rem; border-radius: var(--r-full); background: var(--surface-3); color: var(--text-muted); }
  .mini-tag--free { background: rgba(52,211,153,0.15); color: var(--success); }
  .add-row { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; }
  .add-row .input { flex: 1; min-width: 140px; }
  .file-add, .bom-add { display: flex; flex-direction: column; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--hairline); }
  .file-add__opts { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  .url-add { margin-top: 1rem; }
  .url-add summary { cursor: pointer; font-size: var(--fs-sm); }
  .thumbs-admin { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; }
  .thumb-admin { position: relative; width: 120px; height: 84px; border-radius: var(--r-sm); overflow: hidden; border: 1px solid var(--border); }
  .thumb-admin img { width: 100%; height: 100%; object-fit: cover; }
  .thumb-admin__actions { position: absolute; top: 4px; right: 4px; display: flex; gap: 3px; }
  .thumb-btn { width: 24px; height: 24px; display: grid; place-items: center; border-radius: 5px; border: none; background: rgba(10,10,12,0.8); color: #fff; cursor: pointer; }
  .thumb-btn--del { background: rgba(231,36,42,0.85); }
  .btn-xs { padding: 0.3rem 0.5rem; font-size: var(--fs-xs); }
  .btn-danger { color: var(--danger); }
  .inline-form { display: inline; }

  @media (max-width: 640px) { .grid-2, .grid-3, .grid-bom { grid-template-columns: 1fr; } }
</style>

<script>
  // Auto-suggest slug from title for new projects (only if slug is empty).
  const title = document.querySelector('[data-title]') as HTMLInputElement | null;
  const slug = document.querySelector('[data-slug]') as HTMLInputElement | null;
  if (title && slug && !slug.value) {
    title.addEventListener('input', () => {
      slug.value = title.value.toLowerCase().trim()
        .replace(/[^a-z0-9\s-]/g, '').replace(/[\s_]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '').slice(0, 80);
    });
  }
</script>
