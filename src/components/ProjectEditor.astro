    color: var(--admin-muted);
    font-size: 13.5px;
    border: 1px dashed var(--admin-line);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .add-card-box {
    background: #FAFBFD;
    border: 1px solid var(--admin-line);
    border-radius: 12px;
    padding: 16px;
  }

  /* AI Assistant Box */
  .ai-draft-assistant-box {
