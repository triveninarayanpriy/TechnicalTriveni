    flex-direction: column;
    gap: 12px;
  }
  .ai-draft-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .ai-input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ai-attachments-wrap {
    background: #F8FAFC;
    border: 1px solid var(--admin-line);
    border-radius: var(--admin-r-card);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ai-attachments-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ai-attachments-title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--admin-ink);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .ai-attachments-tabs {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .ai-attach-tab {
    background: #FFFFFF;
    border: 1px solid var(--admin-line);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--admin-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .ai-attach-tab.is-active {
    background: var(--admin-red-soft);
