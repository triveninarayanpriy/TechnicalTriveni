<script>
  // Auto-suggest slug from title for new projects (only if slug is empty).
  const title = document.querySelector('[data-title]') as HTMLInputElement | null;
  const slug = document.querySelector('[data-slug]') as HTMLInputElement | null;
  if (title && slug && !slug.value) {
    title.addEventListener('input', () => {
      slug.value = title.value.toLowerCase().trim()
        .replace(/[^a-z0-9\s-]/g, '').replace(/[\s_]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '').slice(0, 80);
    });
  }

  // --- Keep the scroll position across editor POSTs (reorder / delete / upload)
  //     so the page never jumps back to the top after an action. ---
  const SCROLL_KEY = 'tt-editor-scroll';
  try {
    const y = sessionStorage.getItem(SCROLL_KEY);
    if (y !== null) { sessionStorage.removeItem(SCROLL_KEY); window.scrollTo(0, parseInt(y, 10) || 0); }
  } catch { /* ignore */ }
  const saveScroll = () => { try { sessionStorage.setItem(SCROLL_KEY, String(window.scrollY)); } catch { /* ignore */ } };
  document.querySelectorAll('.editor form').forEach((f) => f.addEventListener('submit', saveScroll));

  // --- Media upload: real progress bar + no full-page redirect ---
  const mediaForm = document.querySelector('[data-media-form]') as HTMLFormElement | null;
  const toast = (window as any).toast as ((m: string, t?: string) => void) | undefined;
  if (mediaForm) {
    const input = mediaForm.querySelector('[data-media-input]') as HTMLInputElement | null;
    const label = mediaForm.querySelector('[data-media-label]') as HTMLElement | null;
    const submit = mediaForm.querySelector('[data-media-submit]') as HTMLButtonElement | null;
    const progress = mediaForm.querySelector('[data-progress]') as HTMLElement | null;
    const fill = mediaForm.querySelector('[data-progress-fill]') as HTMLElement | null;
    const pct = mediaForm.querySelector('[data-progress-pct]') as HTMLElement | null;
    const labelDefault = label?.innerHTML || '';

    // Show how many files were picked.
    input?.addEventListener('change', () => {
      if (!label) return;
      const n = input.files?.length || 0;
      label.textContent = n ? `${n} file${n > 1 ? 's' : ''} ready to upload` : '';
      if (!n) label.innerHTML = labelDefault;
    });

    mediaForm.addEventListener('submit', (e) => {
      const hasFiles = (input?.files?.length || 0) > 0;
      if (!hasFiles) return; // URL-only / empty → let it post normally
      e.preventDefault();
      const xhr = new XMLHttpRequest();
      const fd = new FormData(mediaForm);
      xhr.open('POST', mediaForm.action);
      xhr.setRequestHeader('X-Requested-With', 'fetch');
      if (submit) submit.disabled = true;
      if (progress) progress.hidden = false;

      xhr.upload.addEventListener('progress', (ev) => {
        if (!ev.lengthComputable) return;
        const p = Math.round((ev.loaded / ev.total) * 100);
        if (fill) fill.style.width = p + '%';
        if (pct) pct.textContent = p + '%';
      });
      xhr.addEventListener('load', () => {
        let body: any = {};
        try { body = JSON.parse(xhr.responseText); } catch { /* ignore */ }
        if (xhr.status >= 200 && xhr.status < 300) {
          if (pct) pct.textContent = 'Done';
          saveScroll();
          window.location.reload();
        } else {
          if (submit) submit.disabled = false;
          if (progress) progress.hidden = true;
          if (fill) fill.style.width = '0%';
          toast?.(body.err || 'Upload failed. Please try again.', 'error');
        }
      });
      xhr.addEventListener('error', () => {
        if (submit) submit.disabled = false;
        if (progress) progress.hidden = true;
        toast?.('Network error during upload.', 'error');
      });
      xhr.send(fd);
    });
  }

  // --- BOM: dim custom fields when a library component is picked ---
  const compPick = document.querySelector('[data-comp-pick]') as HTMLSelectElement | null;
  const compFields = document.querySelector('[data-comp-fields]') as HTMLElement | null;
  const syncComp = () => {
    if (!compFields) return;
    const usingLib = compPick && compPick.value !== '0';
    compFields.style.opacity = usingLib ? '0.4' : '1';
    compFields.querySelectorAll('input').forEach((el) => { (el as HTMLInputElement).disabled = !!usingLib; });
  };
  compPick?.addEventListener('change', syncComp);

// Auto-fill file label from filename
const fileUploadInput = document.getElementById('file-upload-input');
const fileLabelInput = document.getElementById('file-label-input');
if (fileUploadInput && fileLabelInput) {
  fileUploadInput.addEventListener('change', (e) => {
    if (fileLabelInput.value === '') {
      const file = e.target.files[0];
      if (file) {
        let name = file.name;
        // Remove extension
        const dotIndex = name.lastIndexOf('.');
        if (dotIndex > 0) name = name.substring(0, dotIndex);
        // Replace dashes and underscores with spaces
        name = name.replace(/[-_]/g, ' ');
        // Capitalize first letter of each word
        name = name.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
        fileLabelInput.value = name;
      }
    }
  });
}
</script>
