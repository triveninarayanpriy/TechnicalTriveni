---
import Icon from './Icon.astro';
import type { ProjectFull, Component } from '../lib/db';
import { DIFFICULTIES, FILE_KINDS } from '../lib/site';
import { formatBytes } from '../lib/format';

interface Props {
  project: ProjectFull | null;
  csrf: string;
  components?: Component[];
}
const { project, csrf, components = [] } = Astro.props;
const p = project;
const isNew = !p;
const val = (v: unknown) => (v === undefined || v === null ? '' : String(v));
---

<div class="editor">
  <!-- ===== Main details ===== -->
  <form method="post" action="/api/admin/project/save" class="editor-form panel">
    <input type="hidden" name="csrf" value={csrf} />
    {p && <input type="hidden" name="id" value={p.id} />}

    <div class="editor-form__head">
      <h2>{isNew ? 'New project' : 'Project details'}</h2>
      <button type="submit" class="btn btn-primary"><Icon name="check" size={16} /> {isNew ? 'Create project' : 'Save changes'}</button>
    </div>

    <div class="grid-2">
      <div class="field">
        <label class="label" for="title">Title *</label>
        <input class="input" id="title" name="title" required maxlength="140" value={val(p?.title)} data-title />
      </div>
      <div class="field">
        <label class="label" for="slug">Slug (URL)</label>
        <input class="input mono" id="slug" name="slug" maxlength="80" placeholder="auto-from-title" value={val(p?.slug)} data-slug />
        <span class="field-hint">Leave blank to auto-generate from the title.</span>
      </div>
    </div>

    <div class="field">
      <label class="label" for="summary">Summary *</label>
      <input class="input" id="summary" name="summary" required maxlength="500" placeholder="One-line hook shown on cards & search" value={val(p?.summary)} />
    </div>

    <div class="field">
      
      <div class="field">
        <label class="label" for="layout_version">Layout Version</label>
        <select class="select" id="layout_version" name="layout_version">
          <option value="1" selected={(!p?.layout_version || p.layout_version === 1)}>Legacy Layout (v1)</option>
          <option value="2" selected={p?.layout_version === 2}>Structured Layout (v2)</option>
        </select>
      </div>
      
      <div class="field">
        <label class="label" for="prereqs_json">Prerequisites (JSON Array)</label>
        <textarea class="textarea" id="prereqs_json" name="prereqs_json">{val(p?.prereqs_json) || '[]'}</textarea>
      </div>

      <div class="field">
        <label class="label" for="not_included_json">Not Included (JSON Array)</label>
        <textarea class="textarea" id="not_included_json" name="not_included_json">{val(p?.not_included_json) || '[]'}</textarea>
      </div>

      <div class="field">
        <label class="label" for="outcomes_json">What you will learn / Outcomes (JSON Array)</label>
        <textarea class="textarea" id="outcomes_json" name="outcomes_json">{val(p?.outcomes_json) || '[]'}</textarea>
      </div>

      <div class="field">
        <label class="label" for="faq_json">FAQ (JSON Array of &#123;q, a&#125; objects)</label>
        <textarea class="textarea" id="faq_json" name="faq_json">{val(p?.faq_json) || '[]'}</textarea>
      </div>

      <label class="label" for="description">Description (Markdown) - Used for v1 or as intro for v2</label>
      <textarea class="textarea editor-desc" id="description" name="description" placeholder="## What you'll build…">{val(p?.description)}</textarea>
      <span class="field-hint">Supports Markdown: ## headings, **bold**, lists, `code`, links.</span>
    </div>

    <div class="grid-3">
      <div class="field">
        <label class="label" for="category">Category</label>
        <input class="input" id="category" name="category" list="cat-list" value={val(p?.category) || 'Electronics'} />
        <datalist id="cat-list">
          <option value="Electronics"></option><option value="Robotics"></option>
          <option value="AI"></option><option value="IoT"></option><option value="Software"></option>
        </datalist>
      </div>
      <div class="field">
        <label class="label" for="difficulty">Difficulty</label>
        <select class="select" id="difficulty" name="difficulty">
          {DIFFICULTIES.map((d) => <option value={d} selected={p?.difficulty === d}>{d}</option>)}
        </select>
      </div>
      <div class="field">
        <label class="label" for="build_time">Build time</label>
        <input class="input" id="build_time" name="build_time" placeholder="2–3 hours" value={val(p?.build_time)} />
      </div>
    </div>

    <div class="field">
      <label class="label" for="video_url">Video URL (YouTube)</label>
      <input class="input mono" id="video_url" name="video_url" placeholder="https://youtube.com/…" value={val(p?.video_url)} />
    </div>

    <div class="field-hint field-hint--block">
      <Icon name="layers" size={14} /> The cover thumbnail and the 3D showcase are set automatically from the <strong>Media</strong> section below — whatever you drag to the front becomes the lead. Add images and <span class="mono">.glb</span> 3D files there.
    </div>

    <div class="field">
      <label class="label" for="tags">Tags (comma-separated)</label>
      <input class="input" id="tags" name="tags" placeholder="ESP32, IoT, Sensors" value={val(p?.tags)} />
    </div>

    <fieldset class="editor-fieldset">
      <legend>Project page details</legend>
      <div class="field">
        <label class="label" for="outcome_line">Outcome line</label>
        <input class="input" id="outcome_line" name="outcome_line" maxlength="240" placeholder="₹800 me phone se chalne wala home automation system" value={val(p?.outcome_line)} />
        <span class="field-hint">One concrete result shown under the title.</span>
      </div>
      <div class="grid-3">
        <div class="field">
          <label class="label" for="est_cost">Approx build cost</label>
          <input class="input" id="est_cost" name="est_cost" placeholder="₹800" value={val(p?.est_cost)} />
        </div>
        <div class="field">
          <label class="label" for="cost_checked">Cost checked on</label>
          <input class="input" id="cost_checked" name="cost_checked" placeholder="Sep 2026" value={val(p?.cost_checked)} />
        </div>
        <div class="field">
          <label class="label" for="license">Code license</label>
          <input class="input" id="license" name="license" placeholder="MIT" value={val(p?.license) || 'MIT'} />
        </div>
      </div>
      <div class="field">
        <label class="label" for="code_repo_url">GitHub repo URL</label>
        <input class="input mono" id="code_repo_url" name="code_repo_url" placeholder="https://github.com/…" value={val(p?.code_repo_url)} />
      </div>
      <div class="field">
        <label class="label" for="safety_note">Safety note (Markdown) — required for mains / battery / motor builds</label>
        <textarea class="textarea" id="safety_note" name="safety_note" placeholder="This project uses 230V AC mains. Work with power off…">{val(p?.safety_note)}</textarea>
        <span class="field-hint">Shown as a red safety callout at the top of the build.</span>
      </div>
      <div class="field">
        <label class="label" for="credits">Credits &amp; attributions (Markdown)</label>
        <textarea class="textarea" id="credits" name="credits" placeholder="Library X by … (MIT). Wiring based on …">{val(p?.credits)}</textarea>
      </div>
    </fieldset>

    <fieldset class="editor-fieldset">
      <legend>Search &amp; social (SEO)</legend>
      <p class="field-hint" style="margin-top:-0.25rem">Leave blank to auto-use the title, summary and cover image.</p>
      <div class="field">
        <label class="label" for="meta_title">Meta title</label>
        <input class="input" id="meta_title" name="meta_title" maxlength="70" placeholder={val(p?.title) || 'Defaults to the project title'} value={val(p?.meta_title)} />
        <span class="field-hint">~60 characters shows best in Google.</span>
      </div>
      <div class="field">
        <label class="label" for="meta_description">Meta description</label>
        <textarea class="textarea" id="meta_description" name="meta_description" maxlength="180" placeholder="Defaults to the summary">{val(p?.meta_description)}</textarea>
        <span class="field-hint">~155 characters. This is the snippet under your link in search results.</span>
      </div>
      <div class="field">
        <label class="label" for="og_image">Social share image URL</label>
        <input class="input mono" id="og_image" name="og_image" placeholder="/media/… (defaults to the cover)" value={val(p?.og_image)} />
      </div>
    </fieldset>

    <fieldset class="editor-fieldset">
      <legend>Paid combo</legend>
      <div class="grid-2">
        <div class="field">
          <label class="label" for="price_inr">Price (₹)</label>
          <input class="input" id="price_inr" name="price_inr" type="number" min="0" step="1" value={val(p?.price_inr ?? 0)} />
        </div>
        <div class="field">
          <label class="label" for="combo_title">Combo title</label>
          <input class="input" id="combo_title" name="combo_title" value={val(p?.combo_title) || 'Complete Project Combo'} />
        </div>
      </div>
      <div class="field">
        <label class="label" for="combo_description">What the buyer gets</label>
        <textarea class="textarea" id="combo_description" name="combo_description" placeholder="Source code, schematic (PDF), 3D files (STL), build guide…">{val(p?.combo_description)}</textarea>
      </div>
      <div class="combo-foot">
        <label class="switch"><input type="checkbox" name="combo_enabled" checked={p?.combo_enabled === 1} /> <span>Combo is purchasable</span></label>
        {p && (
          <button
            type="submit"
            form={`free-${p.id}`}
            class="btn btn-free"
            title="Set price to ₹0 and turn off the paid combo"
          ><Icon name="spark" size={15} /> Make it completely free</button>
        )}
      </div>
    </fieldset>

    <div class="editor-toggles">
      <label class="switch"><input type="checkbox" name="published" checked={p?.published === 1} /> <span>Published (live on site)</span></label>
      <label class="switch"><input type="checkbox" name="featured" checked={p?.featured === 1} /> <span>Featured on home</span></label>
      <label class="switch"><input type="checkbox" name="is_new" checked={p?.is_new === 1} /> <span>Show “NEW” badge</span></label>
      <div class="field field--inline">
        <label class="label" for="sort">Sort</label>
        <input class="input input--sm" id="sort" name="sort" type="number" value={val(p?.sort ?? 0)} />
      </div>
    </div>

    <div class="editor-form__foot">
      <button type="submit" class="btn btn-primary btn-lg"><Icon name="check" size={16} /> {isNew ? 'Create project' : 'Save changes'}</button>
      {p && <a href={`/projects/${p.slug}`} target="_blank" class="btn btn-ghost">Preview <Icon name="external" size={14} /></a>}
    </div>
  </form>

  {p && (
    <form id={`free-${p.id}`} method="post" action="/api/admin/project/action" hidden>
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="id" value={p.id} />
      <input type="hidden" name="action" value="makefree" />
    </form>
  )}

  {isNew && (
    <p class="editor-note dim"><Icon name="spark" size={14} /> Save the project first — then you can add media, resource files, the parts list and links.</p>
  )}

  {p && (
    <div class="editor-children">
      <!-- ===== Media (photos + 3D) ===== -->
      <section class="child-panel panel">
        <h3><Icon name="layers" size={18} /> Media — photos & 3D</h3>
        <p class="dim child-lead">Upload photos and <span class="mono">.glb / .gltf</span> 3D files together. Reorder with the arrows — the <strong>first item is the cover thumbnail</strong>, and if it’s a 3D file it shows as the rotatable showcase.</p>

        <div class="media-list">
          {p.images.map((img, i) => (
            <div class:list={['media-item', { 'media-item--lead': i === 0 }]}>
              <div class="media-item__preview">
                {img.kind === 'model' ? (
                  <div class="media-item__model"><Icon name="layers" size={20} /><span>3D</span></div>
                ) : (
                  <img src={img.url} alt={img.caption} loading="lazy" />
                )}
                {i === 0 && <span class="media-item__lead-tag">{img.kind === 'model' ? '3D showcase' : 'Thumbnail'}</span>}
              </div>
              <div class="media-item__body">
                <span class:list={['kind-badge', img.kind === 'model' ? 'kind-badge--3d' : 'kind-badge--img']}>
                  {img.kind === 'model' ? '3D model' : 'Photo'}
                </span>
                <span class="dim mono media-item__name">{img.url.split('/').pop()}</span>
                {img.caption && <span class="dim media-item__cap">{img.caption}</span>}
              </div>
              <div class="media-item__ctrl">
                <form method="post" action="/api/admin/project/action" class="inline-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="id" value={p.id} />
                  <input type="hidden" name="media_id" value={img.id} />
                  <input type="hidden" name="action" value="moveup" />
                  <button class="ctrl-btn" type="submit" title="Move earlier" disabled={i === 0}><Icon name="chevron-up" size={15} /></button>
                </form>
                <form method="post" action="/api/admin/project/action" class="inline-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="id" value={p.id} />
                  <input type="hidden" name="media_id" value={img.id} />
                  <input type="hidden" name="action" value="movedown" />
                  <button class="ctrl-btn" type="submit" title="Move later" disabled={i === p.images.length - 1}><Icon name="chevron-down" size={15} /></button>
                </form>
                <form method="post" action="/api/admin/media/delete" class="inline-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="id" value={img.id} />
                  <input type="hidden" name="project_id" value={p.id} />
                  <button class="ctrl-btn ctrl-btn--del" type="submit" title="Delete"><Icon name="close" size={14} /></button>
                </form>
              </div>
            </div>
          ))}
          {p.images.length === 0 && <p class="dim">No media yet — add photos or 3D files below.</p>}
        </div>

        <form method="post" action="/api/admin/media/add" enctype="multipart/form-data" class="media-add" data-media-form>
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="project_id" value={p.id} />
          <label class="media-drop">
            <input class="media-drop__input" type="file" name="files" accept="image/*,.glb,.gltf,model/gltf-binary,model/gltf+json" multiple data-media-input />
            <span class="media-drop__text" data-media-label><Icon name="download" size={16} /> Choose photos &amp; 3D files — you can select several at once</span>
          </label>
          <div class="add-row">
            <input class="input" name="caption" placeholder="Caption for the first item (optional)" />
            <button class="btn btn-primary" type="submit" data-media-submit><Icon name="download" size={15} /> Upload media</button>
          </div>
          <div class="upload-progress" data-progress hidden>
            <div class="upload-progress__bar"><span data-progress-fill></span></div>
            <span class="upload-progress__pct mono" data-progress-pct>0%</span>
          </div>
        </form>
        <details class="url-add">
          <summary class="dim">…or add by URL</summary>
          <form method="post" action="/api/admin/media/add" class="add-row" style="margin-top:0.75rem">
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="project_id" value={p.id} />
            <input class="input mono" name="url" placeholder="https://… (image or .glb)" />
            <input class="input" name="caption" placeholder="Caption" />
            <button class="btn btn-ghost" type="submit">Add</button>
          </form>
        </details>
      </section>

            <!-- ===== Resource files ===== -->
      <section class="child-panel panel" id="resource-files">
        <h3><Icon name="download" size={18} /> Resource Documents & Files</h3>
        <p class="dim child-lead">Manage all downloadable files for this project (Code, PDFs, 3D files). You can set files as completely free for anyone to download, or restrict them to only buyers of the Combo Pack.</p>
        <div class="rows">
          {p.files.map((f) => (
            <div class="data-row" style="background: var(--bg); border: 1px solid var(--border); border-radius: var(--r-sm); padding: 0.75rem; display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem;">
              <span class="data-row__icon" style="color: var(--brand-red);"><Icon name={FILE_KINDS.find((k) => k.key === f.kind)?.icon || 'file'} size={24} /></span>
              <div class="data-row__main" style="flex: 1;">
                <strong style="font-size: 1rem;">{f.label}</strong>
                <div style="font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 0.25rem;">
                  {f.filename || '-'}{f.size_bytes ? ` • ${formatBytes(f.size_bytes)}` : ''}{!f.r2_key ? ' • error missing' : ''}
                </div>
              </div>
              <div class="data-row__tags" style="display: flex; flex-direction: column; gap: 0.25rem; align-items: flex-end;">
                {f.is_free === 1 && <span class="mini-tag" style="background: rgba(21, 128, 61, 0.1); color: #15803d; border: 1px solid #15803d; font-size: 0.7rem; padding: 0.15rem 0.4rem; border-radius: 4px;">Free Public Download</span>}
                {f.in_combo === 1 && <span class="mini-tag" style="background: rgba(245, 158, 11, 0.1); color: #d97706; border: 1px solid #d97706; font-size: 0.7rem; padding: 0.15rem 0.4rem; border-radius: 4px;">Paid Combo Pack</span>}
              </div>
              <form method="post" action="/api/admin/file/delete" class="inline-form" onsubmit="return confirm('Are you sure you want to permanently delete this file?');">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={f.id} />
                <input type="hidden" name="project_id" value={p.id} />
                <button class="btn btn-ghost btn-danger" type="submit" style="padding: 0.5rem;" title="Delete file"><Icon name="trash" size={18} /></button>
              </form>
            </div>
          ))}
          {p.files.length === 0 && <div class="dim" style="padding: 1.5rem; text-align: center; border: 1px dashed var(--border); border-radius: var(--r-md);">No files uploaded yet. Add your first file below!</div>}
        </div>
        
        <form method="post" action="/api/admin/file/add" enctype="multipart/form-data" class="file-add panel" style="background: var(--surface-2); padding: 1.5rem; border: 1px solid var(--border); margin-top: 1rem;">
          <h4 style="font-size: 1.1rem; margin-bottom: 1rem; color: var(--text); display: flex; align-items: center; gap: 0.5rem;"><Icon name="plus-circle" size={18} /> Upload a new file</h4>
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="project_id" value={p.id} />
          
          <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div class="grid-2">
              <div>
                <label class="label">1. Choose File</label>
                <input class="input" type="file" name="file" id="file-upload-input" required />
              </div>
              <div>
                <label class="label">2. File Type</label>
                <select class="select" name="kind">
                  {FILE_KINDS.map((k) => <option value={k.key}>{k.label}</option>)}
                </select>
              </div>
            </div>

            <div>
              <label class="label">3. Display Label (Auto-fills from file name)</label>
              <input class="input" name="label" id="file-label-input" placeholder="e.g. Schematic PDF, Arduino Code..." required />
            </div>

            <div class="file-add__access" style="background: var(--bg); padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--r-md);">
              <label class="label" style="font-size: 1rem; color: var(--text);">4. Who can download this?</label>
              <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.75rem;">
                <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; background: var(--surface); padding: 0.75rem; border: 1px solid var(--border); border-radius: 6px;">
                  <input type="radio" name="access_level" value="free" checked style="width: 18px; height: 18px;" />
                  <div>
                    <strong style="display: block; font-size: 0.95rem;">Free (Public Download)</strong>
                    <span class="dim" style="font-size: 0.8rem;">Anyone can download this file without paying.</span>
                  </div>
                </label>
                <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; background: var(--surface); padding: 0.75rem; border: 1px solid var(--border); border-radius: 6px;">
                  <input type="radio" name="access_level" value="combo" style="width: 18px; height: 18px;" />
                  <div>
                    <strong style="display: block; font-size: 0.95rem;">Paid Combo Pack</strong>
                    <span class="dim" style="font-size: 0.8rem;">Only customers who purchased the combo pack can download this.</span>
                  </div>
                </label>
              </div>
            </div>
            
            <div style="display: flex; justify-content: flex-end; margin-top: 0.5rem;">
              <button class="btn btn-primary" type="submit" style="font-size: 1.05rem; padding: 0.75rem 1.5rem;"><Icon name="upload-cloud" size={18} /> Upload & Save File</button>
            </div>
          </div>
        </form>
      </section>

      <!-- ===== BOM ===== -->
      <section class="child-panel panel">
        <h3><Icon name="cart" size={18} /> Parts list (BOM)</h3>
        <div class="rows">
          {p.bom.map((b) => (
            <div class="data-row">
              <div class="data-row__main">
                <strong>{b.name} <span class="dim mono">×{b.qty}</span>{b.unit_price_inr > 0 && <span class="dim mono"> · ₹{b.unit_price_inr}</span>}</strong>
                <span class="dim">{b.store || '—'}{b.affiliate_url ? ' · link set' : ' · no link'}{b.is_affiliate === 1 ? ' · affiliate' : ''}</span>
              </div>
              <form method="post" action="/api/admin/bom/delete" class="inline-form">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={b.id} />
                <input type="hidden" name="project_id" value={p.id} />
                <button class="btn btn-ghost btn-xs btn-danger" type="submit"><Icon name="close" size={13} /></button>
              </form>
            </div>
          ))}
          {p.bom.length === 0 && <p class="dim">No components yet.</p>}
        </div>
        <form method="post" action="/api/admin/bom/add" class="bom-add">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="project_id" value={p.id} />
          {components.length > 0 && (
            <div class="field">
              <label class="label">From library <span class="dim">(optional — keeps price live)</span></label>
              <select class="select" name="component_id" data-comp-pick>
                <option value="0">— Custom component (fill fields below) —</option>
                {components.map((c) => (
                  <option value={c.id}>{c.name}{c.unit_price_inr > 0 ? ` · ₹${c.unit_price_inr}` : ''}{c.store ? ` · ${c.store}` : ''}</option>
                ))}
              </select>
              <span class="field-hint">Pick a saved part and the fields below are ignored — its live price/link are used everywhere.</span>
            </div>
          )}
          <div class="grid-bom" data-comp-fields>
            <input class="input" name="name" placeholder="Component" />
            <input class="input" name="qty" placeholder="Qty" value="1" />
            <input class="input" name="unit_price_inr" type="number" min="0" placeholder="₹ price" />
          </div>
          <div class="grid-3">
            <input class="input" name="store" placeholder="Store (Amazon, Robu…)" />
            <input class="input" name="price_checked" placeholder="Checked (Sep 2026)" />
            <input class="input mono" name="affiliate_url" placeholder="Buy / affiliate URL" />
          </div>
          <div class="grid-2">
            <input class="input" name="notes" placeholder="Notes / substitutes (optional)" />
            <div class="bom-add__foot">
              <label class="switch"><input type="checkbox" name="is_affiliate" /> <span>Affiliate link</span></label>
              <button class="btn btn-primary" type="submit"><Icon name="cart" size={15} /> Add</button>
            </div>
          </div>
        </form>
      </section>

      <!-- ===== Build steps ===== -->
      <section class="child-panel panel">
        <h3><Icon name="check-circle" size={18} /> Build steps</h3>
        <p class="dim child-lead">Numbered instructions with an optional “why”. Use the arrows to reorder.</p>
        <div class="rows">
          {p.steps.map((s, i) => (
            <div class="data-row">
              <span class="data-row__icon step-badge">{i + 1}</span>
              <div class="data-row__main">
                <strong>{s.title || s.body.slice(0, 60) || 'Step'}</strong>
                {s.why && <span class="dim">Why: {s.why}</span>}
              </div>
              <div class="row-ctrl">
                {['up', 'down'].map((dir) => (
                  <form method="post" action="/api/admin/step/move" class="inline-form">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="id" value={s.id} />
                    <input type="hidden" name="project_id" value={p.id} />
                    <input type="hidden" name="dir" value={dir} />
                    <button class="btn btn-ghost btn-xs" type="submit" disabled={dir === 'up' ? i === 0 : i === p.steps.length - 1}><Icon name={dir === 'up' ? 'chevron-up' : 'chevron-down'} size={13} /></button>
                  </form>
                ))}
                <form method="post" action="/api/admin/step/delete" class="inline-form">
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="id" value={s.id} />
                  <input type="hidden" name="project_id" value={p.id} />
                  <button class="btn btn-ghost btn-xs btn-danger" type="submit"><Icon name="close" size={13} /></button>
                </form>
              </div>
            </div>
          ))}
          {p.steps.length === 0 && <p class="dim">No steps yet.</p>}
        </div>
        <form method="post" action="/api/admin/step/add" class="stack-add">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="project_id" value={p.id} />
          <input class="input" name="title" placeholder="Step title (optional)" />
          <textarea class="textarea" name="body" placeholder="Instruction (Markdown)…" required></textarea>
          <div class="grid-2">
            <input class="input" name="why" placeholder="Why / gotcha (optional)" />
            <input class="input mono" name="image_url" placeholder="Photo /media URL (optional)" />
          </div>
          <button class="btn btn-primary" type="submit"><Icon name="check" size={15} /> Add step</button>
        </form>
      </section>

      <!-- ===== Wiring / pins ===== -->
      <section class="child-panel panel">
        <h3><Icon name="layers" size={18} /> Wiring &amp; connections</h3>
        <p class="dim child-lead">A text pin-map (from → to). Searchable and accessible — always add this alongside the diagram image.</p>
        <div class="rows">
          {p.pins.map((pin) => (
            <div class="data-row">
              <div class="data-row__main"><strong class="mono">{pin.from_pin} → {pin.to_pin}</strong>{pin.note && <span class="dim">{pin.note}</span>}</div>
              <form method="post" action="/api/admin/pin/delete" class="inline-form">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={pin.id} />
                <input type="hidden" name="project_id" value={p.id} />
                <button class="btn btn-ghost btn-xs btn-danger" type="submit"><Icon name="close" size={13} /></button>
              </form>
            </div>
          ))}
          {p.pins.length === 0 && <p class="dim">No connections yet.</p>}
        </div>
        <form method="post" action="/api/admin/pin/add" class="add-row">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="project_id" value={p.id} />
          <input class="input mono" name="from_pin" placeholder="From (ESP32 D5)" required />
          <input class="input mono" name="to_pin" placeholder="To (Relay IN1)" required />
          <input class="input" name="note" placeholder="Note (optional)" />
          <button class="btn btn-ghost" type="submit">Add</button>
        </form>
      </section>

      <!-- ===== Troubleshooting ===== -->
      <section class="child-panel panel">
        <h3><Icon name="spark" size={18} /> Troubleshooting</h3>
        <p class="dim child-lead">Symptom → fix. These rank well in search when people paste error messages.</p>
        <div class="rows">
          {p.troubleshooting.map((t) => (
            <div class="data-row">
              <div class="data-row__main"><strong>{t.symptom}</strong><span class="dim">{t.fix}</span></div>
              <form method="post" action="/api/admin/trouble/delete" class="inline-form">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={t.id} />
                <input type="hidden" name="project_id" value={p.id} />
                <button class="btn btn-ghost btn-xs btn-danger" type="submit"><Icon name="close" size={13} /></button>
              </form>
            </div>
          ))}
          {p.troubleshooting.length === 0 && <p class="dim">No tips yet.</p>}
        </div>
        <form method="post" action="/api/admin/trouble/add" class="stack-add">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="project_id" value={p.id} />
          <input class="input" name="symptom" placeholder="Symptom e.g. LED not lighting up" required />
          <textarea class="textarea" name="fix" placeholder="The fix (Markdown)…" required></textarea>
          <button class="btn btn-primary" type="submit"><Icon name="check" size={15} /> Add tip</button>
        </form>
      </section>

      <!-- ===== Links ===== -->
      <section class="child-panel panel">
        <h3><Icon name="external" size={18} /> Resource links</h3>
        <div class="rows">
          {p.links.map((l) => (
            <div class="data-row">
              <div class="data-row__main"><strong>{l.label}</strong><span class="dim mono">{l.url}</span></div>
              <form method="post" action="/api/admin/link/delete" class="inline-form">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={l.id} />
                <input type="hidden" name="project_id" value={p.id} />
                <button class="btn btn-ghost btn-xs btn-danger" type="submit"><Icon name="close" size={13} /></button>
              </form>
            </div>
          ))}
          {p.links.length === 0 && <p class="dim">No links yet.</p>}
        </div>
        <form method="post" action="/api/admin/link/add" class="add-row">
          <input type="hidden" name="csrf" value={csrf} />
          <input type="hidden" name="project_id" value={p.id} />
          <input class="input" name="label" placeholder="Label e.g. GitHub repo" required />
          <input class="input mono" name="url" placeholder="https://…" required />
          <select class="select select--sm" name="kind">
            <option value="video">Video</option><option value="github">GitHub</option>
            <option value="doc">Doc</option><option value="demo">Demo</option><option value="other">Other</option>
          </select>
          <button class="btn btn-ghost" type="submit">Add</button>
        </form>
      </section>
    </div>
  )}
</div>

<style>
