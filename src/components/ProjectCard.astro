---
import type { Project } from '../lib/db';
import Icon from './Icon.astro';
import { formatINR } from '../lib/format';

interface Props {
  project: Project;
  reveal?: boolean;
}
const { project, reveal = true } = Astro.props;
const paid = (project.price_inr ?? 0) > 0;

const fileKindsStr = (project.file_kinds || '').toLowerCase();
const hasCode = fileKindsStr.includes('code') || fileKindsStr.includes('sketch') || fileKindsStr.includes('hex');
const hasSchematic = fileKindsStr.includes('schematic') || fileKindsStr.includes('circuit');
const has3D = fileKindsStr.includes('model') || fileKindsStr.includes('3d') || !!project.model_url;
const hasPdf = fileKindsStr.includes('pdf') || fileKindsStr.includes('doc') || (!hasCode && !hasSchematic && !has3D);

// Badges: max two, plain text with icon
const badges: { label: string; icon: string }[] = [];
if (hasCode) badges.push({ label: 'Code', icon: 'code' });
if (hasSchematic && badges.length < 2) badges.push({ label: 'Schematic', icon: 'schematic' });
if (has3D && badges.length < 2) badges.push({ label: '3D', icon: 'cube' });
if (hasPdf && badges.length < 2) badges.push({ label: 'PDF', icon: 'file-text' });

// Meta row: "Beginner · 2 h · Core cost ≈ ₹1,480"
const metaParts: string[] = [];
if (project.difficulty) metaParts.push(project.difficulty);
if (project.build_time) metaParts.push(project.build_time);
else metaParts.push('2 h');

if (project.cost_override && project.cost_override > 0) {
  metaParts.push(`Core cost ≈ ${formatINR(project.cost_override)}`);
}
const metaRow = metaParts.join(' · ');
---

<article class="pcard" data-reveal={reveal ? '' : undefined}>
  <a href={`/projects/${project.slug}`} class="pcard__stretch" aria-label={`View ${project.title}`}></a>
  
  <div class="pcard__media">
    {project.cover_image ? (
      <img src={project.cover_image} alt={project.title} loading="lazy" decoding="async" width="640" height="400" />
    ) : (
      <div class="pcard__placeholder grid-bg" aria-hidden="true">
        <svg viewBox="-4 -4 120 100" class="pcard__mark">
          <defs><path id={`m-${project.id}`} d="M12 0 L62 0 L62 18 L41 18 L41 74 L31 92 L21 74 L21 18 L0 18 L0 7 L12 7 Z"/></defs>
          <use href={`#m-${project.id}`} x="0" fill="var(--red)" opacity="0.9"/>
          <use href={`#m-${project.id}`} x="50" fill="var(--ink-2)"/>
        </svg>
      </div>
    )}

    {badges.length > 0 && (
      <div class="pcard__badges">
        {badges.map((b) => (
          <span class="pcard__badge">
            <Icon name={b.icon} size={11} /> {b.label}
          </span>
        ))}
      </div>
    )}

    {project.video_url && (
      <span class="pcard__video" title="Video walkthrough included">
        <Icon name="play" size={12} />
      </span>
    )}
  </div>

  <div class="pcard__body">
    <span class="pcard__cat">{project.category || 'PROJECT'}</span>
    <h3 class="pcard__title">{project.title}</h3>
    <div class="pcard__meta-row">{metaRow}</div>
    {project.summary && <p class="pcard__summary">{project.summary}</p>}

    <div class="pcard__foot">
      <div class="pcard__price-wrap">
        {paid ? (
          <span class="pcard__price">{formatINR(project.price_inr)}</span>
        ) : (
          <span class="pcard__free">Free</span>
        )}
      </div>
      <span class="pcard__cta">View &rarr;</span>
    </div>
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 16px;
    box-shadow: var(--shadow);
    transition: transform 180ms var(--ease), border-color 180ms var(--ease), box-shadow 180ms var(--ease);
  }
  @media (hover: hover) and (min-width: 768px) {
    .pcard:hover {
      transform: translateY(-2px);
      border-color: var(--ink-2);
      box-shadow: 0 1px 2px rgba(0,0,0,.06), 0 12px 28px rgba(0,0,0,.08);
    }
  }
  .pcard__stretch {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  /* 16:10 Media ratio */
  .pcard__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--bg-soft);
    border-radius: 10px;
    overflow: hidden;
  }
  .pcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 300ms var(--ease);
  }
  @media (hover: hover) {
    .pcard:hover .pcard__media img {
      transform: scale(1.03);
    }
  }
  .pcard__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }
  .pcard__mark { width: 36%; opacity: 0.85; }

  /* Max two badges overlay */
  .pcard__badges {
    position: absolute;
    top: 8px;
    left: 8px;
    display: flex;
    gap: 5px;
    z-index: 1;
  }
  .pcard__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 550;
    padding: 3px 7px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(4px);
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--ink);
  }
  .pcard__video {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--red);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    z-index: 1;
  }

  /* Card content */
  .pcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 14px;
    gap: 6px;
  }
  .pcard__cat {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    font-weight: 600;
    line-height: 1.2;
  }
  .pcard__title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 180ms ease;
  }
  .pcard:hover .pcard__title {
    color: var(--red);
  }
  .pcard__meta-row {
    font-size: 13px;
    color: var(--ink-3);
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pcard__summary {
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Foot row */
  .pcard__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .pcard__price {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
  }
  .pcard__free {
    font-size: 15px;
    font-weight: 600;
    color: var(--success);
  }
  .pcard__cta {
    font-size: 14px;
    font-weight: 600;
    color: var(--red);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 640px) {
    .pcard {
      padding: 10px;
      border-radius: var(--r-sm);
    }
    .pcard__body {
      padding-top: 8px;
      gap: 4px;
    }
    .pcard__cat {
      font-size: 10px;
    }
    .pcard__title {
      font-size: 14px;
      line-height: 1.25;
      -webkit-line-clamp: 2;
    }
    .pcard__meta-row {
      font-size: 11px;
    }
    .pcard__summary {
      font-size: 12px;
      -webkit-line-clamp: 1;
      display: none; /* Hide summary preview on 2-col mobile cards to preserve clean density */
    }
    .pcard__foot {
      padding-top: 8px;
      margin-top: 6px;
    }
    .pcard__price {
      font-size: 14px;
    }
    .pcard__free {
      font-size: 13px;
    }
    .pcard__cta {
      font-size: 12px;
    }
    .pcard__badge {
      font-size: 9px;
      padding: 2px 5px;
    }
  }
</style>
