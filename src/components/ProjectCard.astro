---
import type { Project } from '../lib/db';
import Icon from './Icon.astro';
import { formatINR } from '../lib/format';

interface Props {
  project: Project;
  reveal?: boolean;
}
const { project, reveal = true } = Astro.props;
const paid = (project.price_inr ?? 0) > 0;

const fileKindsStr = (project.file_kinds || '').toLowerCase();
const hasCode = fileKindsStr.includes('code') || fileKindsStr.includes('sketch') || fileKindsStr.includes('hex');
const hasSchematic = fileKindsStr.includes('schematic') || fileKindsStr.includes('circuit');
const has3D = fileKindsStr.includes('model') || fileKindsStr.includes('3d') || !!project.model_url;
const hasPdf = fileKindsStr.includes('pdf') || fileKindsStr.includes('doc');
const hasVideo = !!project.video_url;

const chips: { label: string; icon: string; isVideo?: boolean }[] = [];
if (hasCode) chips.push({ label: 'Code', icon: 'code' });
if (hasSchematic) chips.push({ label: 'Schematic', icon: 'schematic' });
if (has3D) chips.push({ label: '3D', icon: 'cube' });
if (hasPdf) chips.push({ label: 'PDF', icon: 'file-text' });
if (hasVideo) chips.push({ label: 'Video', icon: 'play', isVideo: true });

if (chips.length === 0) {
  if (project.category?.toLowerCase() === 'resource') {
    chips.push({ label: 'PDF', icon: 'file-text' });
  } else {
    chips.push({ label: 'Code', icon: 'code' });
    chips.push({ label: 'Schematic', icon: 'schematic' });
  }
}

const metaParts: string[] = [];
if (project.difficulty) metaParts.push(project.difficulty);
if (project.build_time) metaParts.push(project.build_time);
else metaParts.push('2 hours');
const metaRight = metaParts.join(', ');
---

<article class="pcard" data-reveal={reveal ? '' : undefined}>
  <a href={`/projects/${project.slug}`} class="pcard__stretch" aria-label={`View pack ${project.title}`}></a>
  
  <!-- Clean 16:9 Cover Image (NO text, tags, badges, or play overlays on top) -->
  <div class="pcard__media">
    {project.cover_image ? (
      <img
        src={project.cover_image}
        alt={project.title}
        loading="lazy"
        decoding="async"
        width="640"
        height="360"
        class="pcard__img"
      />
    ) : (
      <div class="pcard__placeholder" aria-hidden="true">
        <Icon name="cube" size={36} />
      </div>
    )}
  </div>

  <div class="pcard__body">
    <!-- Category (left) and Level/Time (right) -->
    <div class="pcard__top-meta">
      <span class="pcard__cat">{project.category || 'Electronics'}</span>
      <span class="pcard__level-time">{metaRight}</span>
    </div>

    <!-- Full Title (wraps up to 3 lines, never truncated) -->
    <h3 class="pcard__title">{project.title}</h3>

    <!-- Chip Row: 28px high, 14px icon, 13px text -->
    <div class="pcard__chips">
      {chips.map((c) => (
        <span class:list={['pcard__chip', { 'pcard__chip--video': c.isVideo }]}>
          <Icon name={c.icon} size={14} />
          <span>{c.label}</span>
        </span>
      ))}
    </div>

    <!-- Foot Row: Price on left, View pack on right -->
    <div class="pcard__foot">
      <div class="pcard__price-wrap">
        {paid ? (
          <span class="pcard__price">{formatINR(project.price_inr)}</span>
        ) : (
          <span class="pcard__price pcard__price--free">Free</span>
        )}
      </div>
      <span class="pcard__btn">View pack</span>
    </div>
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 16px;
    box-shadow: var(--shadow);
    transition: transform 180ms var(--ease), border-color 180ms var(--ease), box-shadow 180ms var(--ease);
  }
  @media (hover: hover) and (min-width: 768px) {
    .pcard:hover {
      transform: translateY(-2px);
      border-color: #C0C5CD;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    }
    .pcard:hover .pcard__btn {
      opacity: 0.92;
    }
  }
  .pcard__stretch {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  /* Fixed 16:9 ratio, object-fit cover, clean */
  .pcard__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--bg-soft);
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .pcard__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 250ms var(--ease);
  }
  @media (hover: hover) {
    .pcard:hover .pcard__img {
      transform: scale(1.02);
    }
  }
  .pcard__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--muted);
    background: #F4F5F7;
  }

  /* Card Body */
  .pcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 14px;
  }

  /* Top Meta Row */
  .pcard__top-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }
  .pcard__cat {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    text-transform: capitalize;
  }
  .pcard__level-time {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }

  /* Full Title */
  .pcard__title {
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
    margin: 0 0 12px 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Chip Row */
  .pcard__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: 16px;
  }
  .pcard__chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 550;
    background: #ECEEF2;
    color: var(--ink);
  }
  .pcard__chip--video {
    background: var(--video-chip-bg);
    color: var(--video-chip-text);
  }
  .pcard__chip--video svg {
    color: var(--video-chip-text);
  }

  /* Foot Row */
  .pcard__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 8px;
  }
  .pcard__price {
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .pcard__price--free {
    color: var(--success);
    font-size: 18px;
  }
  .pcard__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    padding: 0 16px;
    border-radius: 12px;
    background: var(--red);
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    transition: background 150ms ease;
  }
</style>
