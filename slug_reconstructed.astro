---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import BomTable from '../../components/BomTable.astro';
import StageCard from '../../components/StageCard.astro';
import TroubleTable from '../../components/TroubleTable.astro';
import { env } from 'cloudflare:workers';
import { getProjectFull } from '../../lib/db';
import { SITE, FILE_KINDS } from '../../lib/site';
import { formatINR, renderMarkdown, parseTags, difficultyClass, formatBytes, youtubeId } from '../../lib/format';
import { razorpayConfigured } from '../../lib/razorpay';

const { slug } = Astro.params;
const project = await getProjectFull(env.DB, slug!);
if (!project) {
  return Astro.rewrite('/404');
}

const tags = parseTags(project.tags);
const paid = project.combo_enabled === 1 && project.price_inr > 0;
const paymentsOn = razorpayConfigured(env);
const gallery = [
  ...(project.cover_image ? [{ url: project.cover_image, caption: project.title }] : []),
  ...project.images,
];
const freeFiles = project.files.filter((f) => f.is_free === 1);
const comboFiles = project.files.filter((f) => f.in_combo === 1);
const kindLabel = (k: string) => FILE_KINDS.find((x) => x.key === k)?.label ?? 'File';
const kindIcon = (k: string) => FILE_KINDS.find((x) => x.key === k)?.icon ?? 'file';
const yt = youtubeId(project.video_url);
const descHtml = renderMarkdown(project.description).replace(/^<h2[^>]*>\s*Overview\s*<\/h2>\s*/i, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: project.title,
  description: project.summary,
  image: project.cover_image ? new URL(project.cover_image, Astro.site ?? Astro.url.origin).toString() : undefined,
  brand: { '@type': 'Brand', name: SITE.name },
  ...(paid
    ? {
        offers: {
          '@type': 'Offer',
          price: project.price_inr,
          priceCurrency: 'INR',
          availability: 'https://schema.org/InStock',
          url: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString(),
        },
      }
    : {}),
};
---

<Base
  title={project.title}
  description={project.summary}
  ogImage={project.cover_image || '/og-default.png'}
  jsonLd={jsonLd}
>
  <div class="container detail">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span>/</span>
      <a href="/projects">Projects</a> <span>/</span>
      <span class="muted">{project.title}</span>
    </nav>

    <header class="detail__head">
      <div class="detail__headmeta">
        <span class="chip chip--cat">{project.category}</span>
        <span class:list={['badge', difficultyClass(project.difficulty)]}>{project.difficulty}</span>
        {project.build_time && <span class="chip"><Icon name="clock" size={14} /> {project.build_time}</span>}
      </div>
      <h1>{project.title}</h1>
      <p class="detail__summary">{project.summary}</p>
    </header>

    <div class="detail__grid">
      <!-- MAIN COLUMN -->
      <div class="detail__main">
        <!-- Interactive 3D model -->
        {project.model_url && (
          <section class="model3d">
            <model-viewer
              src={project.model_url}
              camera-controls
              auto-rotate
              auto-rotate-delay="600"
              rotation-per-second="16deg"
              shadow-intensity="0.7"
              exposure="1.1"
              ar
              aria-label={`3D model of ${project.title}`}
              class="model3d__viewer"
            ></model-viewer>
            <span class="model3d__tag mono"><Icon name="cube" size={13} /> Drag to rotate Â· scroll to zoom</span>
          </section>
        )}
        <!-- Gallery -->
        {gallery.length > 0 && (
          <section class="gallery" data-gallery>
            <div class="gallery__main">
              <img src={gallery[0].url} alt={gallery[0].caption || project.title} id="gallery-main" width="960" height="600" />
            </div>
            {gallery.length > 1 && (
              <div class="gallery__thumbs">
                {gallery.map((g, i) => (
                  <button class:list={['gallery__thumb', { 'is-active': i === 0 }]} data-src={g.url} data-caption={g.caption} aria-label={`View image ${i + 1}`}>
                    <img src={g.url} alt={g.caption || ''} loading="lazy" />
                  </button>
                ))}
              </div>
            )}
          </section>
        )}

        <!-- Video -->
        {yt && (
          <section class="section-block">
            <h2 class="block-title"><Icon name="play" size={20} /> Watch the build</h2>
            <div class="video-embed">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${yt}`}
                title={`${project.title} â€” video`}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </section>
        )}

        <!-- Description -->
        {descHtml && (
          <section class="section-block">
            <div class="prose" set:html={descHtml} />
          </section>
        )}

        <!-- Bill of materials -->
        {project.bom.length > 0 && (
          <section class="section-block" id="parts">
            <h2 class="block-title"><Icon name="cart" size={20} /> Components & parts list</h2>
            <p class="muted block-lead">Everything you need to build this. Links help support the channel at no extra cost to you.</p>
            <div class="table-wrap">
              <table class="bom">
                <thead>
                  <tr><th>Component</th><th>Qty</th><th class="hide-sm">Notes</th><th></th></tr>
                </thead>
                <tbody>
                  {project.bom.map((item) => (
                    <tr>
                      <td>
                        <span class="bom__name">{item.name}</span>
                        {item.store && <span class="bom__store mono">{item.store}</span>}
                      </td>
                      <td class="bom__qty mono">{item.qty}</td>
                      <td class="hide-sm muted">{item.notes}</td>
                      <td class="bom__buy">
                        {item.affiliate_url ? (
                          <a href={item.affiliate_url} target="_blank" rel="nofollow sponsored noopener" class="btn btn-ghost btn-buy">
                            Buy <Icon name="arrow-up-right" size={14} />
                          </a>
                        ) : (
                          <span class="dim mono" style="font-size:var(--fs-xs)">â€”</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="affiliate-note dim"><Icon name="tag" size={13} /> Some links are affiliate links. Prices shown are indicative â€” check the store for current pricing.</p>
          </section>
        )}

        <!-- Free resources -->
        {freeFiles.length > 0 && (
          <section class="section-block" id="free-files">
            <h2 class="block-title"><Icon name="download" size={20} /> Free downloads</h2>
            <div class="files">
              {freeFiles.map((f) => (
                <a href={`/api/download/free/${f.id}`} class="file-row">
                  <span class="file-row__icon"><Icon name={kindIcon(f.kind)} size={18} /></span>
                  <span class="file-row__meta">
                    <span class="file-row__label">{f.label}</span>
                    <span class="file-row__sub mono">{kindLabel(f.kind)}{f.size_bytes ? ` Â· ${formatBytes(f.size_bytes)}` : ''}</span>
                  </span>
                  <Icon name="download" size={18} />
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <!-- SIDEBAR -->
      <aside class="detail__side">
        <div class="buy-card panel" data-buy
          data-project-id={project.id}
          data-slug={project.slug}
          data-payments={paymentsOn ? '1' : '0'}
        >
          {paid ? (
            <>
              <div class="buy-card__top">
                <span class="buy-card__kicker mono">{project.combo_title}</span>
                <div class="buy-card__price">{formatINR(project.price_inr)}<span>one-time</span></div>
              </div>
              {project.combo_description && <p class="buy-card__desc">{project.combo_description}</p>}
              <ul class="buy-card__list">
                {comboFiles.length > 0
                  ? comboFiles.map((f) => (
                      <li><Icon name="check" size={16} /> {f.label}</li>
                    ))
                  : (
                    <>
                      <li><Icon name="check" size={16} /> Full source code</li>
                      <li><Icon name="check" size={16} /> Schematic & wiring</li>
                      <li><Icon name="check" size={16} /> 3D files & build guide</li>
                    </>
                  )}
              </ul>

              <div class="field buy-card__email">
                <label class="label" for="buy-email">Email for your download</label>
                <input class="input" type="email" id="buy-email" placeholder="you@email.com" autocomplete="email" required />
                <span class="field-hint">We'll send your secure download link here.</span>
              </div>

              <button class="btn btn-primary btn-block btn-lg" data-buy-btn>
                <Icon name="lock" size={16} /> Buy &amp; download
              </button>
              <p class="buy-card__secure dim"><Icon name="shield" size={13} /> Secure payment via Razorpay Â· UPI, cards &amp; more</p>
              {!paymentsOn && (
                <p class="buy-card__note">Online payments are being set up. <a href="/contact">Contact us</a> to purchase in the meantime.</p>
              )}
            </>
          ) : (
            <>
              <div class="buy-card__top">
                <span class="buy-card__kicker mono">Open resource</span>
                <div class="buy-card__free">Free</div>
              </div>
              <p class="buy-card__desc">This project's resources are free. Scroll down to download everything you need.</p>
              <a href="#free-files" class="btn btn-primary btn-block btn-lg"><Icon name="download" size={16} /> Get the files</a>
            </>
          )}
        </div>

        <!-- Quick facts -->
        <div class="facts panel">
          <h3 class="facts__title">At a glance</h3>
          <dl class="facts__list">
            <div><dt>Category</dt><dd>{project.category}</dd></div>
            <div><dt>Difficulty</dt><dd>{project.difficulty}</dd></div>
            {project.build_time && <div><dt>Build time</dt><dd>{project.build_time}</dd></div>}
            <div><dt>Parts</dt><dd>{project.bom.length} components</dd></div>
            <div><dt>Resources</dt><dd>{project.files.length} files</dd></div>
          </dl>
          {tags.length > 0 && (
            <div class="facts__tags">
              {tags.map((t) => <span class="chip">{t}</span>)}
            </div>
          )}
          {project.links.length > 0 && (
            <div class="facts__links">
              {project.links.map((l) => (
                <a href={l.url} target="_blank" rel="noopener" class="facts__link">
                  <Icon name={l.kind === 'video' ? 'play' : l.kind === 'github' ? 'github' : 'external'} size={15} /> {l.label}
                </a>
              ))}
            </div>
          )}
        </div>
      </aside>
    </div> <!-- End .content -->
    </div> <!-- End .proj-layout -->
  </div> <!-- End .container.dp -->

  <!-- Mobile Sticky CTA -->
  <div class="mobile-cta">
    <div class="mobile-cta__info">
      <span class="mobile-cta__price">{paid ? formatINR(project.price_inr) : 'Free'}</span>
      <span class="mobile-cta__sub">{paid ? 'digital pack' : 'open resource'}</span>
    </div>
    <a href="#buy" class="btn btn-primary btn-sm">{paid ? 'Get combo pack' : 'Get files'}</a>
  </div>

  <!-- Image Zoom Modal -->
  <div id="zoom-modal" class="zoom-modal" aria-hidden="true">
    <img id="zoom-img" src="" alt="Zoomed view" />
    <button id="zoom-close" class="zoom-close" aria-label="Close">×</button>
  </div>

  {paid && paymentsOn && (
    <script is:inline src="https://checkout.razorpay.com/v1/checkout.js" defer></script>
  )}
  {project.model_url && (
    <script is:inline type="module" src="https://cdn.jsdelivr.net/npm/@google/model-viewer@4.0.0/dist/model-viewer.min.js"></script>
  )}
</Base>

<style>
  .detail { padding-block: 1.5rem 4rem; }
  .model3d { position: relative; border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--border); background: radial-gradient(120% 120% at 50% 0%, #1b1f2b, #0c0d11); box-shadow: var(--shadow-md); }
  .model3d__viewer { width: 100%; height: clamp(320px, 42vw, 460px); display: block; --poster-color: transparent; }
  .model3d__tag { position: absolute; bottom: 0.75rem; right: 0.75rem; display: inline-flex; align-items: center; gap: 0.35rem; font-size: var(--fs-xs); padding: 0.35rem 0.65rem; border-radius: var(--r-full); background: rgba(12,13,17,0.65); color: #fff; backdrop-filter: blur(6px); }
  .crumbs { display: flex; gap: 0.5rem; font-size: var(--fs-sm); color: var(--text-muted); margin-bottom: 1.75rem; flex-wrap: wrap; }
  .crumbs a:hover { color: var(--brand-red); }
  .crumbs span { color: var(--text-dim); }

  .detail__head { max-width: 60ch; margin-bottom: 2rem; }
  .detail__headmeta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .detail__head h1 { font-size: var(--fs-2xl); }
  .detail__summary { color: var(--text-muted); font-size: var(--fs-md); margin-top: 0.75rem; }

  .detail__grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 2.5rem; align-items: start; }
  .detail__main { min-width: 0; display: flex; flex-direction: column; gap: 2.5rem; }

  /* gallery */
  .gallery__main { border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--border); background: var(--surface-2); aspect-ratio: 16/10; }
  .gallery__main img { width: 100%; height: 100%; object-fit: cover; }
  .gallery__thumbs { display: flex; gap: 0.6rem; margin-top: 0.75rem; flex-wrap: wrap; }
  .gallery__thumb { width: 84px; height: 60px; border-radius: var(--r-sm); overflow: hidden; border: 1px solid var(--border); background: var(--surface-2); cursor: pointer; padding: 0; transition: border-color 0.2s; }
  .gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .gallery__thumb.is-active { border-color: var(--brand-red); }

  .block-title { display: flex; align-items: center; gap: 0.55rem; font-size: var(--fs-lg); margin-bottom: 1rem; }
  .block-title :global(svg) { color: var(--brand-red); }
  .block-lead { margin-bottom: 1.25rem; font-size: var(--fs-sm); }

  .video-embed { position: relative; aspect-ratio: 16/9; border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--border); }
  .video-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  /* BOM table */
  .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--r-lg); }
  .bom { width: 100%; border-collapse: collapse; min-width: 460px; }
  .bom th { text-align: left; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-dim); padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); background: var(--surface-2); }
  .bom td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--hairline); vertical-align: middle; }
  .bom tr:last-child td { border-bottom: 0; }
  .bom__name { display: block; font-weight: 550; }
  .bom__store { display: block; font-size: var(--fs-xs); color: var(--text-dim); margin-top: 2px; }
  .bom__qty { white-space: nowrap; }
  .btn-buy { padding: 0.4rem 0.8rem; font-size: var(--fs-xs); }
  .affiliate-note { display: flex; align-items: center; gap: 0.4rem; margin-top: 0.85rem; font-size: var(--fs-xs); }

  /* files */
  .files { display: flex; flex-direction: column; gap: 0.6rem; }
  .file-row { display: flex; align-items: center; gap: 0.9rem; padding: 0.85rem 1rem; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--surface); transition: border-color 0.2s, transform 0.2s; }
  .file-row:hover { border-color: var(--brand-red); transform: translateX(2px); }
  .file-row__icon { color: var(--brand-red); display: grid; place-items: center; }
  .file-row__meta { flex: 1; display: flex; flex-direction: column; }
  .file-row__label { font-weight: 550; }
  .file-row__sub { font-size: var(--fs-xs); color: var(--text-dim); }

  /* sidebar */
  .detail__side { position: sticky; top: calc(var(--header-h) + 1rem); display: flex; flex-direction: column; gap: 1.25rem; }
  .buy-card { padding: 1.5rem; }
  .buy-card__top { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; margin-bottom: 1rem; }
  .buy-card__kicker { font-size: var(--fs-xs); color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; }
  .buy-card__price { font-family: var(--font-display); font-weight: 700; font-size: 2rem; color: var(--text); display: flex; align-items: baseline; gap: 0.4rem; }
  .buy-card__price span { font-size: var(--fs-xs); color: var(--text-dim); font-weight: 500; }
  .buy-card__free { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--success); }
  .buy-card__desc { color: var(--text-muted); font-size: var(--fs-sm); margin-bottom: 1.1rem; }
  .buy-card__list { display: flex; flex-direction: column; gap: 0.55rem; margin-bottom: 1.25rem; }
  .buy-card__list li { display: flex; align-items: flex-start; gap: 0.5rem; font-size: var(--fs-sm); color: var(--text); }
  .buy-card__list :global(svg) { color: var(--success); flex-shrink: 0; margin-top: 2px; }
  .buy-card__email { margin-bottom: 1rem; }
  .buy-card__secure { display: flex; align-items: center; justify-content: center; gap: 0.4rem; margin-top: 0.75rem; font-size: var(--fs-xs); }
  .buy-card__note { margin-top: 0.85rem; padding: 0.7rem 0.85rem; background: rgba(231,36,42,0.08); border: 1px solid color-mix(in srgb, var(--brand-red) 25%, transparent); border-radius: var(--r-sm); font-size: var(--fs-xs); color: var(--text-muted); }
  .buy-card__note a { color: var(--brand-red); text-decoration: underline; }

  .facts { padding: 1.5rem; }
  .facts__title { font-size: var(--fs-md); margin-bottom: 1rem; }
  .facts__list { display: flex; flex-direction: column; gap: 0.6rem; }
  .facts__list div { display: flex; justify-content: space-between; gap: 1rem; font-size: var(--fs-sm); padding-bottom: 0.6rem; border-bottom: 1px solid var(--hairline); }
  .facts__list div:last-child { border-bottom: 0; padding-bottom: 0; }
  .facts__list dt { color: var(--text-dim); }
  .facts__list dd { color: var(--text); font-weight: 550; text-align: right; }
  .facts__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.1rem; }
  .facts__links { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 1.1rem; padding-top: 1.1rem; border-top: 1px solid var(--hairline); }
  .facts__link { display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--fs-sm); color: var(--text-muted); }
  .facts__link:hover { color: var(--brand-red); }

  .hide-sm { }
  @media (max-width: 980px) {
    .detail__grid { display: flex; flex-direction: column-reverse; gap: 1.75rem; }
    .detail__side { position: static; display: flex; flex-direction: row; flex-wrap: wrap; width: 100%; }
    .detail__side > * { flex: 1 1 280px; }
  }
  @media (max-width: 560px) {
    .hide-sm { display: none; }
    .detail { padding-block: 1rem 3rem; }
    .detail__head h1 { font-size: clamp(1.5rem, 7vw, 2rem); }
    /* Parts table fits without horizontal scroll; Buy stays visible */
    .table-wrap { overflow-x: visible; }
    .bom { min-width: 0; }
    .bom th, .bom td { padding: 0.65rem 0.6rem; }
    .bom__name { font-size: var(--fs-sm); }
    .btn-buy { padding: 0.35rem 0.55rem; }
    .block-title { font-size: var(--fs-md); }
    .gallery__thumb { width: 64px; height: 46px; }
    .buy-card, .facts { padding: 1.25rem; }
    .buy-card__price { font-size: 1.7rem; }
  }
  /* ===== PRINT STYLES ===== */
  @media print {
    .proj-sidebar, .header, .footer, .hero-actions, .crumbs, .read-progress, .mobile-cta, .btn-buy, .bom-tools { display: none !important; }
    .proj-layout { display: block; }
    .content { gap: 1rem; }
    .sec { page-break-inside: avoid; }
    .trouble__item[open] summary::before, .trouble__item summary::before { display: none; }
    .trouble__item > div { display: block !important; padding-left: 0; }
    .bom-table-wrapper { border: none; }
  }
</style>

<script>
  // --- Gallery thumbnail switching ---
  const main = document.getElementById('gallery-main') as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>('.gallery__thumb').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!main) return;
      const src = btn.dataset.src;
      if (src) main.src = src;
      main.alt = btn.dataset.caption || main.alt;
      document.querySelectorAll('.gallery__thumb').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
    });
  });

  // --- Combo checkout via Razorpay ---
  const card = document.querySelector('[data-buy]') as HTMLElement | null;
  const buyBtn = document.querySelector('[data-buy-btn]') as HTMLButtonElement | null;
  const initBuyBtn = document.getElementById('init-buy-btn') as HTMLButtonElement | null;
  const buyStep1 = document.getElementById('buy-step-1');
  const buyStep2 = document.getElementById('buy-step-2');
  const emailInput = document.getElementById('buy-email') as HTMLInputElement | null;
  const toast = (window as any).toast as (m: string, t?: string) => void;

  initBuyBtn?.addEventListener('click', () => {
    if (buyStep1 && buyStep2) {
      buyStep1.style.display = 'none';
      buyStep2.style.display = 'block';
      emailInput?.focus();
    }
  });

  buyBtn?.addEventListener('click', async () => {
    if (!card) return;
    const paymentsOn = card.dataset.payments === '1';
    const email = (emailInput?.value || '').trim();

    if (!paymentsOn) {
      toast?.('Online payments are being set up â€” please contact us to purchase.', 'info');
      return;
    }
    if (!email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      toast?.('Please enter a valid email for your download link.', 'error');
      emailInput?.focus();
      return;
    }

    buyBtn.disabled = true;
    const original = buyBtn.innerHTML;
    buyBtn.textContent = 'Starting secure checkoutâ€¦';

    try {
      const res = await fetch('/api/razorpay/create-order', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ projectId: Number(card.dataset.projectId), email }),
      });
      const data = (await res.json()) as any;
      if (!res.ok) throw new Error(data.error || 'Could not start checkout.');

      const rzp = new (window as any).Razorpay({
        key: data.keyId,
        order_id: data.razorpayOrderId,
        amount: data.amount,
        currency: 'INR',
        name: 'Technical Triveni',
        description: data.projectTitle,
        prefill: { email },
        theme: { color: '#e7242a' },
        handler: async (resp: any) => {
          const v = await fetch('/api/razorpay/verify', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              orderId: data.orderId,
              razorpay_order_id: resp.razorpay_order_id,
              razorpay_payment_id: resp.razorpay_payment_id,
              razorpay_signature: resp.razorpay_signature,
            }),
          });
          const vd = (await v.json()) as any;
          if (v.ok && vd.redirect) window.location.href = vd.redirect;
          else toast?.(vd.error || 'Payment verification failed. If charged, contact us.', 'error');
        },
        modal: {
          ondismiss: () => {
            buyBtn.disabled = false;
            buyBtn.innerHTML = original;
          },
        },
      });
      rzp.on('payment.failed', () => {
        toast?.('Payment failed. Please try again.', 'error');
        buyBtn.disabled = false;
        buyBtn.innerHTML = original;
      });
      rzp.open();
    } catch (err: any) {
      toast?.(err.message || 'Something went wrong. Please try again.', 'error');
      buyBtn.disabled = false;
      buyBtn.innerHTML = original;
    }
  });

  // Image Zoom Logic
  const modal = document.getElementById('zoom-modal');
  const modalImg = document.getElementById('zoom-img') as HTMLImageElement;
  const modalClose = document.getElementById('zoom-close');

  if (modal && modalImg && modalClose) {
    document.querySelectorAll('.prose img').forEach((img) => {
      img.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLImageElement;
        modalImg.src = target.src;
        modal.classList.add('is-active');
      });
    });

    const closeModal = () => modal.classList.remove('is-active');
    modalClose.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  }

  // --- Scroll Spy & Read Progress ---
  const progressBar = document.getElementById('read-progress');
  const sections = Array.from(document.querySelectorAll('.content section[id]'));
  const navLinks = Array.from(document.querySelectorAll('.toc-link'));
  
  if (progressBar || navLinks.length > 0) {
    window.addEventListener('scroll', () => {
      // 1. Progress Bar
      if (progressBar) {
        const scrollTop = window.scrollY;
        const docHeight = document.body.scrollHeight - window.innerHeight;
        const progress = Math.min(100, Math.max(0, (scrollTop / docHeight) * 100));
        progressBar.style.width = `${progress}%`;
      }
      
      // 2. Scroll Spy (TOC Active Link)
      if (navLinks.length > 0 && sections.length > 0) {
        const scrollPos = window.scrollY + window.innerHeight / 3;
        let currentId = '';
        
        for (const section of sections) {
          const el = section as HTMLElement;
          if (el.offsetTop <= scrollPos) {
            currentId = el.id;
          }
        }
        
        navLinks.forEach(link => {
          link.classList.remove('is-active');
          if (link.getAttribute('href') === `#${currentId}`) {
            link.classList.add('is-active');
          }
        });
      }
    }, { passive: true });
  }
</script>
